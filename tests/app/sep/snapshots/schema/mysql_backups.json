{
  "capabilities": {
    "alert_on_fail": true,
    "chaining": true,
    "pii_anonymization": false,
    "scheduling": true,
    "stats": false
  },
  "description": "Run XtraBackup, Mydumper, and Binlog backups against MySQL hosts.",
  "detail_view": {
    "sections": [
      {
        "fields": [
          {
            "label": "Execution Host",
            "path": "data.meta.target"
          },
          {
            "highlight": "yaml",
            "label": "Config (YAML)",
            "path": "data.meta.config"
          }
        ],
        "title": "Backup Configuration"
      }
    ]
  },
  "display_name": "MySQL Backups",
  "fail_when": [
    {
      "error_fields": [
        "mydumper_dump_triggers"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "mydumper_dump_triggers"
          },
          {
            "not_equals": {
              "backup_type": "M"
            }
          }
        ]
      },
      "message": "'mydumper_dump_triggers' must not be set when backup_type is not 'M'."
    },
    {
      "error_fields": [
        "mydumper_desync_pxc"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "mydumper_desync_pxc"
          },
          {
            "not_equals": {
              "backup_type": "M"
            }
          }
        ]
      },
      "message": "'mydumper_desync_pxc' must not be set when backup_type is not 'M'."
    },
    {
      "error_fields": [
        "mydumper_use_numa"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "mydumper_use_numa"
          },
          {
            "not_equals": {
              "backup_type": "M"
            }
          }
        ]
      },
      "message": "'mydumper_use_numa' must not be set when backup_type is not 'M'."
    },
    {
      "error_fields": [
        "xtrabackup_kill_queries"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "xtrabackup_kill_queries"
          },
          {
            "not_equals": {
              "backup_type": "X"
            }
          }
        ]
      },
      "message": "'xtrabackup_kill_queries' must not be set when backup_type is not 'X'."
    },
    {
      "error_fields": [
        "xtrabackup_verify"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "xtrabackup_verify"
          },
          {
            "not_equals": {
              "backup_type": "X"
            }
          }
        ]
      },
      "message": "'xtrabackup_verify' must not be set when backup_type is not 'X'."
    },
    {
      "error_fields": [
        "xtrabackup_prepare"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "xtrabackup_prepare"
          },
          {
            "not_equals": {
              "backup_type": "X"
            }
          }
        ]
      },
      "message": "'xtrabackup_prepare' must not be set when backup_type is not 'X'."
    },
    {
      "error_fields": [
        "xtrabackup_desync_pxc"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "xtrabackup_desync_pxc"
          },
          {
            "not_equals": {
              "backup_type": "X"
            }
          }
        ]
      },
      "message": "'xtrabackup_desync_pxc' must not be set when backup_type is not 'X'."
    },
    {
      "error_fields": [
        "xtrabackup_rsync"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "xtrabackup_rsync"
          },
          {
            "not_equals": {
              "backup_type": "X"
            }
          }
        ]
      },
      "message": "'xtrabackup_rsync' must not be set when backup_type is not 'X'."
    },
    {
      "error_fields": [
        "xtrabackup_replica_info"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "xtrabackup_replica_info"
          },
          {
            "not_equals": {
              "backup_type": "X"
            }
          }
        ]
      },
      "message": "'xtrabackup_replica_info' must not be set when backup_type is not 'X'."
    },
    {
      "error_fields": [
        "xtrabackup_stop_replica"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "xtrabackup_stop_replica"
          },
          {
            "not_equals": {
              "backup_type": "X"
            }
          }
        ]
      },
      "message": "'xtrabackup_stop_replica' must not be set when backup_type is not 'X'."
    },
    {
      "error_fields": [
        "xtrabackup_lock_ddl"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "xtrabackup_lock_ddl"
          },
          {
            "not_equals": {
              "backup_type": "X"
            }
          }
        ]
      },
      "message": "'xtrabackup_lock_ddl' must not be set when backup_type is not 'X'."
    },
    {
      "error_fields": [
        "xtrabackup_quiet"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "xtrabackup_quiet"
          },
          {
            "not_equals": {
              "backup_type": "X"
            }
          }
        ]
      },
      "message": "'xtrabackup_quiet' must not be set when backup_type is not 'X'."
    },
    {
      "error_fields": [
        "encrypt"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "encrypt"
          },
          {
            "not": {
              "any": [
                {
                  "equals": {
                    "encryption_format": "gpg"
                  }
                },
                {
                  "equals": {
                    "encryption_format": "dual"
                  }
                }
              ]
            }
          }
        ]
      },
      "message": "'encrypt' must not be set when 'encryption_format' does not include GPG."
    },
    {
      "error_fields": [
        "post_run_encrypt"
      ],
      "fail_when": {
        "all": [
          {
            "truthy": "post_run_encrypt"
          },
          {
            "not": {
              "any": [
                {
                  "equals": {
                    "encryption_format": "gpg"
                  }
                },
                {
                  "equals": {
                    "encryption_format": "dual"
                  }
                }
              ]
            }
          }
        ]
      },
      "message": "'post_run_encrypt' must not be set when 'encryption_format' does not include GPG."
    },
    {
      "error_fields": [
        "encrypt",
        "post_run_encrypt"
      ],
      "fail_when": {
        "all": [
          {
            "any": [
              {
                "equals": {
                  "encryption_format": "gpg"
                }
              },
              {
                "equals": {
                  "encryption_format": "dual"
                }
              }
            ]
          },
          {
            "all_falsy": [
              "encrypt",
              "post_run_encrypt"
            ]
          }
        ]
      },
      "message": "A GPG 'encryption_format' requires 'encrypt' or 'post_run_encrypt' to select when the backup is encrypted."
    }
  ],
