      "TopologyCollectResponse": {
        "description": "Represent the response body for ``POST /collect``.\n\n``task_history_ids`` lists the dispatched ``run-python`` tasks the\nfrontend then polls (``/result``) to assemble the topology graph.\n``targets`` echoes the executor hosts the work was sharded across so\nthe UI can surface where the collection ran.\n\n:param task_history_ids: Created task history ids, one per shard.\n:type task_history_ids: list[int]\n:param targets: Executor hosts selected for topology collection.\n:type targets: list[str]\n:param host_count: Number of MySQL hosts included in the collection.\n:type host_count: int\n:param shard_count: Number of dispatched topology shards.\n:type shard_count: int",
        "properties": {
          "host_count": {
            "title": "Host Count",
            "type": "integer"
          },
          "shard_count": {
            "title": "Shard Count",
            "type": "integer"
          },
          "targets": {
            "items": {
              "type": "string"
            },
            "title": "Targets",
            "type": "array"
          },
          "task_history_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Task History Ids",
            "type": "array"
          }
        },
        "required": [
          "task_history_ids",
          "targets",
          "host_count",
          "shard_count"
        ],
        "title": "TopologyCollectResponse",
        "type": "object"
      },
      "TopologyCollectWrite": {
        "description": "Describe the request body for ``POST /collect``.\n\n:param shards: Number of executor hosts to dispatch in parallel. Hosts\n    are split round-robin across the chosen executors. Capped at\n    :data:`MAX_TOPOLOGY_SHARDS`.\n:type shards: int\n:param executor_host: Optional explicit executor. Must be used with\n    ``shards=1`` because it selects a single-shard run.\n:type executor_host: str | None\n:param connect_timeout: Per-host MySQL TCP connect timeout (seconds).\n:type connect_timeout: int\n:param read_timeout: Per-host MySQL read/write timeout (seconds).\n:type read_timeout: int",
        "properties": {
          "connect_timeout": {
            "default": 5,
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Connect Timeout",
            "type": "integer"
          },
          "executor_host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Executor Host"
          },
          "read_timeout": {
            "default": 10,
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Read Timeout",
            "type": "integer"
          },
          "shards": {
            "default": 1,
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Shards",
            "type": "integer"
          }
        },
        "title": "TopologyCollectWrite",
        "type": "object"
      },
