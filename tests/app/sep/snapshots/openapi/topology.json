  "paths": {
    "/api/apps/topology/collect": {
      "post": {
        "description": "Dispatch one or more topology collector tasks. Returns the task ids.\n\nHosts are pulled from the inventory MySQL service list; no inventory\npersistence side effects occur. With ``shards > 1`` the host list is\nsplit round-robin across the first N executor hosts so geographically\nsplit inventories run in parallel.",
        "operationId": "topology_topology_collect_api_apps_topology_collect_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TopologyCollectWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopologyCollectResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Topology Collect",
        "tags": [
          "topology"
        ]
      }
    },
    "/api/apps/topology/result": {
      "get": {
        "description": "Return the merged graph for the supplied task history ids.\n\nStatus mirrors the underlying tasks: ``running`` while any are pending\nor running, ``failed`` when any task failed and produced no usable\noutput, ``ok`` once every task is finished. The React client caches\nthe response via TanStack Query (long ``staleTime``) and stops\npolling once status flips to ``ok``, so the server doesn't bother\nwith HTTP cache validation here.",
        "operationId": "topology_topology_result_api_apps_topology_result_get",
        "parameters": [
          {
            "description": "Comma-separated task history ids",
            "in": "query",
            "name": "ids",
            "required": true,
            "schema": {
              "description": "Comma-separated task history ids",
              "title": "Ids",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopologyResultResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
