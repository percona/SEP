      "TopologyResultResponse": {
        "description": "Represent the response body for ``GET /result``.\n\n``status`` is ``running`` while any of the underlying tasks is\nstill pending, ``ok`` once every task has finished, and ``failed``\nwhen at least one task failed and produced no usable output.\n``graph`` is the merged React-Flow graph; ``pending_task_ids``\nlists the still-running tasks for the UI's progress chip, and\n``failed_task_ids`` lets the UI warn when only some shards failed.\n\n:param status: Aggregate topology collection status.\n:type status: Literal[\"running\", \"ok\", \"failed\"]\n:param graph: Merged React-Flow graph when collection output is ready.\n:type graph: TopologyGraph | None\n:param pending_task_ids: Task ids still pending or running.\n:type pending_task_ids: list[int]\n:param failed_task_ids: Terminal task ids that did not finish successfully.\n:type failed_task_ids: list[int]",
        "properties": {
          "failed_task_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Failed Task Ids",
            "type": "array"
          },
          "graph": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TopologyGraph"
              },
              {
                "type": "null"
              }
            ]
          },
          "pending_task_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Pending Task Ids",
            "type": "array"
          },
          "status": {
            "enum": [
              "running",
              "ok",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "TopologyResultResponse",
        "type": "object"
      },
