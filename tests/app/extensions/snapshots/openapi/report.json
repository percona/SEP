      "report__BackupEntry": {
        "additionalProperties": true,
        "description": "A single backup record.\n\n:param id: Unique identifier for this backup entry.\n:type id: str\n:param alias: Human-readable alias for the backup schedule.\n:type alias: str\n:param name: Node name where the backup was taken.\n:type name: str\n:param type: Backup type (e.g. ``\"physical\"``, ``\"logical\"``).\n:type type: str\n:param status: Result status of the backup.\n:type status: BackupStatus\n:param size: Raw backup size value from the metric label, or ``\"0\"`` if unknown.\n:type size: str\n:param estimated_data: ``True`` when the time period or size data is estimated.\n:type estimated_data: bool\n:param enabled: Whether the backup schedule is currently enabled, if available.\n:type enabled: bool | None\n:param encryption: Encryption state label reported by PMM.\n:type encryption: str\n:param period: Dictionary with ``start``, ``end``, and ``duration`` of the backup.\n:type period: dict[str, Any]",
        "properties": {
          "alias": {
            "default": "",
            "title": "Alias",
            "type": "string"
          },
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "encryption": {
            "default": "Unknown",
            "title": "Encryption",
            "type": "string"
          },
          "estimated_data": {
            "default": true,
            "title": "Estimated Data",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "period": {
            "additionalProperties": true,
            "title": "Period",
            "type": "object"
          },
          "size": {
            "default": "0",
            "title": "Size",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/report__BackupStatus",
            "default": "unknown"
          },
          "type": {
            "default": "",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "BackupEntry",
        "type": "object"
      },
