      "report__AdvisorCheck": {
        "description": "A single advisor check definition (enabled only).\n\n:param name: The unique check name.\n:type name: str\n:param description: Human-readable description of what the check tests.\n:type description: str\n:param summary: Short one-line summary of the check.\n:type summary: str\n:param family: The advisor family key this check belongs to, if any.\n:type family: str | None",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "summary"
        ],
        "title": "AdvisorCheck",
        "type": "object"
      },
      "report__AdvisorFamily": {
        "description": "A group of advisor checks that share the same family.\n\n:param family_key: Internal family key (e.g. ``\"FAMILY_MYSQL\"``).\n:type family_key: str\n:param display_name: Human-readable name shown in the report (e.g. ``\"MySQL\"``).\n:type display_name: str\n:param checks: All enabled checks belonging to this family.\n:type checks: list[AdvisorCheck]\n:param failed: Mapping of check name to its list of failed results.\n:type failed: dict[str, list[FailedCheck]]",
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/report__AdvisorCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "failed": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/report__FailedCheck"
              },
              "type": "array"
            },
            "title": "Failed",
            "type": "object"
          },
          "family_key": {
            "title": "Family Key",
            "type": "string"
          }
        },
        "required": [
          "family_key",
          "display_name"
        ],
        "title": "AdvisorFamily",
        "type": "object"
      },
      "report__AdvisorSection": {
        "description": "Aggregated advisor data for the report.\n\n``total_failed`` counts failed advisor results (rows), not distinct check names.",
