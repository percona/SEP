// vim: ts=8:sts=8:sw=8:ft=groovy:noai:noet

pipeline {
	agent {
		node {
			label 'stream9'
		}
	}

	parameters {
		string(
			name: 'releaseTag',
			description: 'Commit reference'
		)
		string(
			name: 'defaultCmd',
			defaultValue: '--log-level=DEBUG'
		)
		choice(
			name: 'pyVersion',
			choices: [
				'3.11'
			]
		)
		booleanParam(
			name: 'notifySlack',
			defaultValue: false,
			description: 'Send notifications to Slack'
		)
	}

	options {
		timestamps()
	}


	environment {
		BUILD_OPTIONS = ''
		CMD = "${defaultCmd}"

		NOTIFY_SLACK = "${notifySlack}"

		POETRY_VIRTUALENVS_IN_PROJECT = "true"
		PYTHON = "python${pyVersion}"
		PYTHON_VERSION = "${pyVersion}"

		// Pinned to match `.github/workflows/ci.yml` (setup-node + npm i -g pnpm).
		NODE_VERSION = "22.13.0"
		PNPM_VERSION = "11.1.2"

		// Make Node/pnpm available to every stage. The directory is created in
		// the Prepare environment stage below; PATH just needs to resolve at
		// command-lookup time, not at pipeline-parse time.
		PATH = "${env.WORKSPACE}/build/node/bin:${env.PATH}"

		RELEASE_VER = "${releaseTag}"

	}

	stages {
		stage('Prepare workspace') {
			steps {
				checkout scmGit(
					branches: [
						[
							name: "${params.releaseTag}"
						]
					],
					extensions: [
						cloneOption(shallow: true)
					],
					userRemoteConfigs: [
						[
							credentialsId: '9024f3ea-4c7e-46a6-acf5-4b2c768f0930',
							url: 'https://github.com/percona/SEP.git'
						]
					]
				)
			}
		}

		stage('Prepare environment') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			steps {
				sh '''
					set -o errexit
					set -o pipefail

					${PYTHON} -m venv venv
					ln -s venv .venv
					venv/bin/${PYTHON} -m pip install --no-cache -U pip wheel

					${PYTHON} -m venv build/venv
					build/venv/bin/${PYTHON} -m pip install --no-cache -U pip wheel 'poetry==2.4.1'
					# Pre-install poetry-plugin-export into Poetry's venv so Poetry
					# skips its project-scoped plugin self-install. That self-install
					# is a separate solver run whose transitive graph (keyring →
					# importlib-metadata → zipp, etc.) is NOT pinned by poetry.lock
					# and therefore hits PyPI live — where `[solver] min-release-age`
					# in poetry.toml filters out fresh releases and breaks resolution.
					# Mirrors `pipx inject` from .github/actions/setup-python-job.
					build/venv/bin/${PYTHON} -m pip install --no-cache 'poetry-plugin-export>=1.9.0,<2.0.0'
					build/venv/bin/poetry install --with audit

					# Provision Node + pnpm for the frontend pre-commit hooks
					# (oxfmt, oxlint). The stream9 Jenkins agent has no Node/pnpm
					# tooling, but the React frontend (added in SEP-945) is gated
					# by hooks that call `pnpm exec ...`. Install Node via the
					# official tarball into build/node/ (no root needed), then
					# install pnpm globally into the same tree via npm, matching
					# exactly what .github/workflows/ci.yml does
					# (`npm install -g pnpm@${PNPM_VERSION}`).
					#
					# We deliberately don't use corepack here: corepack bundled
					# with Node 22.13.0 has an outdated signing-key list and
					# rejects recent pnpm releases ("Cannot find matching keyid").
					# Using `npm i -g` sidesteps the signature check entirely and
					# keeps parity with GitHub Actions.
					NODE_TARBALL="node-v${NODE_VERSION}-linux-x64"
					curl -fsSL -o "/tmp/${NODE_TARBALL}.tar.xz" "https://nodejs.org/dist/v${NODE_VERSION}/${NODE_TARBALL}.tar.xz"
					tar -xJf "/tmp/${NODE_TARBALL}.tar.xz" -C /tmp
					rm -rf build/node
					mv "/tmp/${NODE_TARBALL}" build/node
					build/node/bin/node --version
					build/node/bin/npm install -g "pnpm@${PNPM_VERSION}"
					(cd frontend && pnpm install --frozen-lockfile)
				'''
			}
		}

		stage('Lockfile hygiene') {
			options {
				timeout(time: 5, unit: 'MINUTES')
			}

			steps {
				echo 'Checking poetry.lock is in sync with pyproject.toml ..'
				sh '''
					set -o errexit
					set -o pipefail

					build/venv/bin/poetry check --lock --strict
				'''
			}
		}

		stage('Pre-commit checks') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			steps {
				echo 'Running pre-commit ..'
				sh '''
					set -o errexit
					set -o pipefail

					make run-pre-commit
				'''
			}
		}

		stage('Audit : Bandit') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			steps {
				echo 'Running bandit ..'
				sh '''
					set -o errexit
					set -o pipefail

					make bandit
				'''
			}
		}

		stage('Audit : pip-audit' ) {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			steps {
				echo 'Running pip-audit ..'
				sh '''
					set -o errexit
					set -o pipefail

					POETRY=build/venv/bin/poetry make pip-audit
				'''
			}
		}
	}

	post {
		always {
			cleanWs()
		}
	}
}
