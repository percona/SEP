// vim: ts=8:sts=8:sw=8:ft=groovy:noai:noet

pipeline {
	agent {
		node {
			label 'stream9'
		}
	}

	parameters {
		gitParameter branchFilter: 'origin/(main|SEP.*|v.*)',
	        defaultValue: 'main',
	        name: 'releaseTag',
	        selectedValue: 'DEFAULT',
	        sortMode: 'DESCENDING_SMART',
	        type: 'PT_REVISION',
	        requiredParameter: true,
			useRepository: 'https://github.com/percona/SEP.git'
		string(
			name: 'defaultCmd',
			defaultValue: '--log-level=DEBUG'
		)
		choice(
			name: 'pyVersion',
			choices: [
				'3.11'
			]
		)
		choice(
			name: 'notifySlack',
			choices: ['true', 'false'],
			defaultValue: 'true'
		)
	}

	options {
		timestamps()
	}


	environment {
		BUILD_OPTIONS = ''
		CMD = "${defaultCmd}"
		
		NOTIFY_SLACK = "${notifySlack}"

		POETRY_VIRTUALENVS_IN_PROJECT = "true"
		PYTHON = "python${pyVersion}"
		PYTHON_VERSION = "${pyVersion}"

		RELEASE_VER = "${releaseTag}"

	}

	stages {
		stage('Prepare workspace') {
			steps {
				checkout scmGit(
					branches: [
						[
							name: "${params.releaseTag}"
						]
					],
					extensions: [
						cloneOption(shallow: true)
					],
					userRemoteConfigs: [
						[
							credentialsId: '9024f3ea-4c7e-46a6-acf5-4b2c768f0930',
							url: 'https://github.com/percona/SEP.git'
						]
					]
				)
			}
		}
	}

	post {
		failure {
			when {
				env.NOTIFY_SLACK == "true"
			{
					slackSend color: "danger", message: "Failed to build $JOB_NAME : $BUILD_URL"
			}
		}
		always {
			cleanWs()
		}
	}
}
