// vim: ts=8:sts=8:sw=8:ft=groovy:noai:noet

pipeline {
	agent {
		node {
			label 'stream9'
		}
	}

	parameters {
		string(
			name: 'releaseTag',
			description: 'Commit reference'
		)
		string(
			name: 'defaultCmd',
			defaultValue: '--log-level=DEBUG'
		)
		choice(
			name: 'pyVersion',
			choices: [
				'3.11'
			]
		)
		booleanParam(
			name: 'notifySlack',
			defaultValue: false,
			description: 'Send notifications to Slack'
		)
		booleanParam(
			name: 'pushImage',
			defaultValue: false,
			description: 'Push the image to the registry'
		)
		booleanParam(
			name: 'pushImageDocker',
			defaultValue: false,
			description: 'Push the image to the Docker registry'
		)
		string(
			name: 'customImageTag',
			defaultValue: '',
			description: 'Optional image tag override (OCI tag: starts [A-Za-z0-9_], then [A-Za-z0-9._-], max 128; the latest* family and release tags vX.Y.Z are reserved); skips git-tag naming, never pushes :latest'
		)
	}

	options {
		timestamps()
	}


	environment {
		BUILD_OPTIONS = ''
		CMD = "${defaultCmd}"

		NOTIFY_SLACK = "${notifySlack}"

		POETRY_VIRTUALENVS_IN_PROJECT = "true"
		PYTHON = "python${pyVersion}"
		PYTHON_VERSION = "${pyVersion}"

		RELEASE_VER = "${releaseTag}"

	}

	stages {
		stage('Prepare workspace') {
			steps {
				checkout scmGit(
					branches: [
						[
							name: "${params.releaseTag}"
						]
					],
					extensions: [
						cloneOption(shallow: true)
					],
					userRemoteConfigs: [
						[
							credentialsId: '9024f3ea-4c7e-46a6-acf5-4b2c768f0930',
							url: 'https://github.com/percona/SEP.git'
						]
					]
				)

				script {
					env.GIT_COMMIT_SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
					env.GIT_TAG_COUNT = sh(returnStdout: true, script: "git tag --contains ${env.GIT_COMMIT_SHA} | wc -l").trim()

					if (env.GIT_TAG_COUNT.toInteger() > 1) {
						currentBuild.result = "FAILURE"
						throw new Exception("Multiple tags (${env.GIT_TAG_COUNT}) matched for ${env.GIT_COMMIT_SHA}")
					}

					if (env.GIT_COMMIT_SHA != params.releaseTag)  {
						currentBuild.result = "FAILURE"
						throw new Exception("Unexpected revision: expected ${params.releaseTag}, found ${env.GIT_COMMIT_SHA}")
					}

					if (env.GIT_TAG_COUNT.toInteger() == 0) {
						echo "Setting GIT_TAG to match commit reference"
						env.GIT_TAG = env.GIT_COMMIT_SHA
					} else {
						echo "Setting GIT_TAG to matching tag"
						env.GIT_TAG = sh(returnStdout: true, script: "git tag --contains ${env.GIT_COMMIT_SHA}").trim()
					}
					echo "Git commit SHA: ${env.GIT_COMMIT_SHA}"
					echo "Git tag: ${env.GIT_TAG}"

					env.GIT_TAG_SHORT =  sh(returnStdout: true, script: "echo ${env.GIT_TAG} | cut -f1-2 -d.").trim()

					def isStableSemverTag = (env.GIT_TAG ==~ /^v\d+\.\d+\.\d+$/)
					env.PUSH_LATEST = (env.GIT_TAG_COUNT.toInteger() > 0 && isStableSemverTag) ? "true" : "false"

					def customTag = (params.customImageTag ?: '').trim()
					if (customTag) {
						if (!(customTag ==~ /^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$/)) {
							currentBuild.result = "FAILURE"
							throw new Exception("Invalid customImageTag '${customTag}': must match ^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}\$ (max 128 chars)")
						}
						// GIT_TAG drives the unguarded primary push, so a "latest" family or
						// release-semver tag would republish an image the registry already
						// maps to a different commit
						if (customTag ==~ /^latest([._-].*)?$/ || customTag ==~ /^v\d+\.\d+\.\d+$/) {
							currentBuild.result = "FAILURE"
							throw new Exception("Reserved customImageTag: ${customTag}")
						}
						env.GIT_TAG = customTag
						env.GIT_TAG_SHORT = customTag
						env.RELEASE_VER = customTag
						env.PUSH_LATEST = "false"
						sh "git tag -f -- \"${customTag}\" HEAD"
						echo "Using custom image tag: ${customTag}"
					}
				}
			}
		}

		stage('Build base image') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			// TODO: if possible, build this only when necessary - TBC how to automatically determine this
			steps {
				echo 'Building base image ..'
				sh '''
					set -o errexit
					set -o pipefail

					podman image exists "sep:builder" && podman image rm "sep:builder" || true
					buildah build -f Containerfile.base --compress --force-rm --squash --no-cache --format oci --memory 100M --isolation rootless --tag "sep:builder"
				'''
			}
		}

		stage('Build SEP image') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			// TODO: if possible, build this only when necessary - TBC how to automatically determine this
			steps {
				echo "Building SEP image for ${RELEASE_VER} .."
				sh '''
					set -o errexit
					set -o pipefail

					RELEASE_VER="${GIT_TAG}" make image
				'''
			}
		}

		stage('Build SEP side-car image') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			steps {
				echo "Building SEP side-car image for ${RELEASE_VER} .."
				sh '''
					set -o errexit
					set -o pipefail

					RELEASE_VER="${GIT_TAG}" make image-sidecar
				'''
			}
		}

		stage('Build SEP embedded image') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			steps {
				echo "Building SEP embedded image for ${RELEASE_VER} .."
				sh '''
					set -o errexit
					set -o pipefail

					RELEASE_VER="${GIT_TAG}" make image-sidecar-embedded
				'''
			}
		}

		stage('Push SEP image') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			when {
				expression {
					return params.pushImage
				}
			}

			// TODO: if possible, build this only when necessary - TBC how to automatically determine this
			steps {

				withCredentials([string(credentialsId: 'SEP_DOCKER_HUB_WRITE_TOKEN', variable: 'DOCKER_TOKEN')]) {
					sh '''
						set -o errexit
						set -o pipefail

						podman image push sep:${GIT_TAG} labbox-mini.tp.int.percona.com:5555/sep:${GIT_TAG}

						if [ "${PUSH_LATEST}" = "true" ]; then
							podman image tag sep:${GIT_TAG} sep:${GIT_TAG_SHORT}
							podman image push sep:${GIT_TAG_SHORT} labbox-mini.tp.int.percona.com:5555/sep:${GIT_TAG_SHORT}
							echo "Pushing labbox-mini.tp.int.percona.com:5555/sep:latest"
							podman image push sep:${GIT_TAG} labbox-mini.tp.int.percona.com:5555/sep:latest
						else
							echo "Skipping internal :${GIT_TAG_SHORT} and :latest push (not a stable release tag): ${GIT_TAG}"
						fi
					'''

					script {
						if (params.pushImageDocker) {
							sh '''
							set -o errexit
							set -o pipefail

							echo -n "${DOCKER_TOKEN}" | podman login --authfile .dockerhub --username percona --password-stdin docker.io
							podman image push --authfile .dockerhub sep:${GIT_TAG} docker.io/percona/percona-sep:${GIT_TAG}

							if [ "${PUSH_LATEST}" = "true" ]; then
								podman image push --authfile .dockerhub sep:${GIT_TAG_SHORT} docker.io/percona/percona-sep:${GIT_TAG_SHORT}
								echo "Pushing docker.io/percona/percona-sep:latest"
								podman image push --authfile .dockerhub sep:${GIT_TAG} docker.io/percona/percona-sep:latest
							else
								echo "Skipping Docker Hub :${GIT_TAG_SHORT} and :latest push (not a stable release tag): ${GIT_TAG}"
							fi

							podman logout --authfile .dockerhub docker.io
							'''
						}
					}
				}
			}
		}

		stage('Push SEP side-car image') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			when {
				expression {
					return params.pushImage
				}
			}

			steps {

				withCredentials([string(credentialsId: 'SEP_DOCKER_HUB_WRITE_TOKEN', variable: 'DOCKER_TOKEN')]) {
					sh '''
						set -o errexit
						set -o pipefail

						podman image push sep:${GIT_TAG}-sidecar labbox-mini.tp.int.percona.com:5555/sep:${GIT_TAG}-sidecar

						if [ "${PUSH_LATEST}" = "true" ]; then
							podman image tag sep:${GIT_TAG}-sidecar sep:${GIT_TAG_SHORT}-sidecar
							podman image push sep:${GIT_TAG_SHORT}-sidecar labbox-mini.tp.int.percona.com:5555/sep:${GIT_TAG_SHORT}-sidecar
							echo "Pushing labbox-mini.tp.int.percona.com:5555/sep:latest-sidecar"
							podman image push sep:${GIT_TAG}-sidecar labbox-mini.tp.int.percona.com:5555/sep:latest-sidecar
						else
							echo "Skipping internal :${GIT_TAG_SHORT}-sidecar and :latest-sidecar push (not a stable release tag): ${GIT_TAG}"
						fi
					'''

					script {
						if (params.pushImageDocker) {
							sh '''
							set -o errexit
							set -o pipefail

							echo -n "${DOCKER_TOKEN}" | podman login --authfile .dockerhub --username percona --password-stdin docker.io
							podman image push --authfile .dockerhub sep:${GIT_TAG}-sidecar docker.io/percona/percona-sep:${GIT_TAG}-sidecar

							if [ "${PUSH_LATEST}" = "true" ]; then
								podman image push --authfile .dockerhub sep:${GIT_TAG_SHORT}-sidecar docker.io/percona/percona-sep:${GIT_TAG_SHORT}-sidecar
								echo "Pushing docker.io/percona/percona-sep:latest-sidecar"
								podman image push --authfile .dockerhub sep:${GIT_TAG}-sidecar docker.io/percona/percona-sep:latest-sidecar
							else
								echo "Skipping Docker Hub :${GIT_TAG_SHORT}-sidecar and :latest-sidecar push (not a stable release tag): ${GIT_TAG}"
							fi

							podman logout --authfile .dockerhub docker.io
							'''
						}
					}
				}
			}
		}

		stage('Push SEP embedded image') {
			options {
				timeout(time: 10, unit: 'MINUTES')
			}

			when {
				expression {
					return params.pushImage
				}
			}

			steps {

				withCredentials([string(credentialsId: 'SEP_DOCKER_HUB_WRITE_TOKEN', variable: 'DOCKER_TOKEN')]) {
					sh '''
						set -o errexit
						set -o pipefail

						podman image push sep:${GIT_TAG}-embedded labbox-mini.tp.int.percona.com:5555/sep:${GIT_TAG}-embedded

						if [ "${PUSH_LATEST}" = "true" ]; then
							podman image tag sep:${GIT_TAG}-embedded sep:${GIT_TAG_SHORT}-embedded
							podman image push sep:${GIT_TAG_SHORT}-embedded labbox-mini.tp.int.percona.com:5555/sep:${GIT_TAG_SHORT}-embedded
							echo "Pushing labbox-mini.tp.int.percona.com:5555/sep:latest-embedded"
							podman image push sep:${GIT_TAG}-embedded labbox-mini.tp.int.percona.com:5555/sep:latest-embedded
						else
							echo "Skipping internal :${GIT_TAG_SHORT}-embedded and :latest-embedded push (not a stable release tag): ${GIT_TAG}"
						fi
					'''

					script {
						if (params.pushImageDocker) {
							sh '''
							set -o errexit
							set -o pipefail

							echo -n "${DOCKER_TOKEN}" | podman login --authfile .dockerhub --username percona --password-stdin docker.io
							podman image push --authfile .dockerhub sep:${GIT_TAG}-embedded docker.io/percona/percona-sep:${GIT_TAG}-embedded

							if [ "${PUSH_LATEST}" = "true" ]; then
								podman image push --authfile .dockerhub sep:${GIT_TAG_SHORT}-embedded docker.io/percona/percona-sep:${GIT_TAG_SHORT}-embedded
								echo "Pushing docker.io/percona/percona-sep:latest-embedded"
								podman image push --authfile .dockerhub sep:${GIT_TAG}-embedded docker.io/percona/percona-sep:latest-embedded
							else
								echo "Skipping Docker Hub :${GIT_TAG_SHORT}-embedded and :latest-embedded push (not a stable release tag): ${GIT_TAG}"
							fi

							podman logout --authfile .dockerhub docker.io
							'''
						}
					}
				}
			}
		}

	}

	post {
		always {
			cleanWs()
		}
	}
}
