// vim: ts=8:sts=8:sw=8:ft=groovy:noai:noet

// TODO: move to shared, or refactor to a single job that calls the others
Boolean notifyStatusViaSlack(String buildStatus) {
	println("buildStatus: " + buildStatus);

	if (env.NOTIFY_SLACK != true || env.BRANCH_NAME != "main") {
		return true;
	}

	println("checking status");

	Boolean status = true

	String color = "good";
	String base_message = "${env.JOB_NAME} ${env.BUILD_NUMBER} (<${env.BUILD_URL}|View>)";
	String message_prefix = buildStatus;

	switch (buildStatus) {
		case "SUCCESS":
			break;
		case "UNSTABLE":
			color = "warning";
			break;
		case "FAILURE":
			color = "danger";
			break;
	}

	try {
		println("slackSend color: " + color + " message: " + message_prefix + " " + base_message);
		slackSend (color: color, message: message_prefix + " " + base_message);
	} catch (Exception e) {
		status = false;
	} finally {
		return status;
	}
}

pipeline {
	agent {
		node {
			label 'stream9'
		}
	}

	parameters {
		gitParameter branchFilter: 'origin/(main|SEP.*|v.*)',
			name: 'releaseTag',
			selectedValue: 'NONE',
			sortMode: 'DESCENDING_SMART',
			type: 'PT_REVISION',
			requiredParameter: true,
			useRepository: 'https://github.com/percona/SEP.git'
		string(
			name: 'defaultCmd',
			defaultValue: '--log-level=DEBUG'
		)
		choice(
			name: 'pyVersion',
			choices: [
				'3.11'
			]
		)
		booleanParam(
			name: 'notifySlack',
			defaultValue: false,
			description: 'Send notifications to Slack'
		)
		booleanParam(
			name: 'pushImage',
			defaultValue: false,
			description: 'Push the image to the registry'
		)
	}

	options {
		timestamps()
	}


	environment {
		BUILD_OPTIONS = ''
		CMD = "${defaultCmd}"

		PYTHON = "python${pyVersion}"
		PYTHON_VERSION = "${pyVersion}"

		RELEASE_VER = "${releaseTag}"

	}

	stages {
		stage('Prepare workspace') {
			steps {
				checkout scmGit(
					branches: [
						[
							name: "${params.releaseTag}"
						]
					],
					extensions: [
						cloneOption(shallow: true)
					],
					userRemoteConfigs: [
						[
							credentialsId: '9024f3ea-4c7e-46a6-acf5-4b2c768f0930',
							url: 'https://github.com/percona/SEP.git'
						]
					]
				)
			}
		}

		stage('Perform audit') {
			steps {
				build job: 'SEP/Audit', parameters: [
					[$class: 'StringParameterValue', name: 'releaseTag', value: "${RELEASE_VER}"],
					[$class: 'StringParameterValue', name: 'pyVersion', value: "${PYTHON_VERSION}"],
					[$class: 'BooleanParameterValue', name: 'notifySlack', value: Boolean.valueOf("${params.notifySlack}")]
				], propagate: true, wait: true
			}
		}

		stage('Build image') {
			steps {
				build job: 'SEP/Build', parameters: [
					[$class: 'StringParameterValue', name: 'releaseTag', value: "${RELEASE_VER}"],
					[$class: 'StringParameterValue', name: 'pyVersion', value: "${PYTHON_VERSION}"],
					[$class: 'BooleanParameterValue', name: 'notifySlack', value: Boolean.valueOf("${params.notifySlack}")],
					[$class: 'BooleanParameterValue', name: 'pushImage', value: Boolean.valueOf("${params.pushImage}")]
				], propagate: true, wait: true
			}
		}

		/*stage('Deploy') {
			steps {
				build job: 'SEP/Deploy', parameters: [
					string(name: 'releaseTag', value: "${RELEASE_VER}"),
					string(name: 'pyVersion', value: "${PYTHON_VERSION}")
				], propagate: true, wait: true
			}
		}*/
	}

	post {
		always {
			notifyStatusViaSlack(currentBuild.currentResult)
			cleanWs()
		}
	}
}
