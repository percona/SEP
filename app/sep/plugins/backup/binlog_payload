def queue_get_maybe(queue, timeout=None):
    block = timeout is not None
    try:
        item = queue.get(block, timeout)
    except Queue.Empty:
        item = None
    return item


def get_source_status(server_data):
    try:
        conn = MySQLdb.connect(
            host=server_data["HOST"],
            port=server_data["PORT"],
            read_default_file=server_data.get("DEFAULTS_FILE", DEFAULT_MYCNF),
            read_default_group="client",
        )
    except Exception:
        LOGGER.exception("problem connecting to source")
        return None

    cursor = conn.cursor()
    for query in ["SHOW BINARY LOG STATUS", "SHOW MASTER STATUS"]:
        try:
            cursor.execute(query)
        except ProgrammingError:
            continue
    source_status = cursor.fetchone()

    conn.close()

    return source_status


def get_dir_size(start_path: Path) -> int:
    total_size = start_path.stat().st_blocks * ST_BLOCKS_SIZE
    try:
        for file in start_path.rglob("*"):
            if not file.is_symlink():
                total_size += file.stat().st_blocks * ST_BLOCKS_SIZE
    except Exception as e:
        logging.warning(
            "Error traversing directory %s: %s", start_path, e, exc_info=True
        )
    return total_size


def main() -> None:
    run_all, config, alias, parser = parse_args()

    run_all = (
        LocalConfig(config).raw_cfg_data["ALL_SERVERS"].get("BINLOG_RUN_ALL", False)
    )

    if (alias and run_all) or not (alias or run_all):
        sys.stderr.write("must only specify server or run-all\n")
        parser.print_help()
        sys.exit(1)

    command_queue = multiprocessing.Queue()
    binlog_runner = BinlogRunner(command_queue, config, alias)
    binlog_runner.run()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    group = parser.add_mutually_exclusive_group()
    group.add_argument(
        "--run-all",
        default=False,
        action="store_true",
        help="Subprocess all servers specified in --config",
    )
    group.add_argument(
        "--server",
        action="store",
        help="Name of the host binlogs will be pulled off of. "
        "Alias should map to server name in config file",
    )
    parser.add_argument(
        "--config", help="File name of the YAML config for --run-all and --server"
    )
    options = parser.parse_args()
    return options.run_all, options.config, options.server, parser


class Upload(Backup):

    def __init__(
        self,
        upload_type: str,
        upload_provider: Any,
        settings: dict[str, Any],
        logger: logging.Logger,
        native_upload: bool = False,
    ) -> None:
        backup_code = settings["BACKUP_TYPE"]
        super().__init__(settings, backup_code, logger, native_upload)
        self.upload_type = upload_type
        self.upload_provider = upload_provider(settings, logger)
        self.last_uploaded_number = 0
        self.last_to_upload_number = 0
        logging_dir = settings.get("LOGGING_DIR", DEFAULT_LOGGING_DIR)
        log_path = Path(logging_dir) / "upload-binlog.log"
        self.log_stream = log_path.open("a")
        self.backup_type = BACKUP_TYPES[self.backup_code]
        self.encrypt = settings.get("ENCRYPT", True)
        self.encrypt_using_tmpdir = settings.get("ENCRYPT_USING_TMPDIR", False)
        self.post_run_encrypt = settings.get("POST_RUN_ENCRYPT", False)
        self.prepare_backup = settings.get("XTRABACKUP_PREPARE")
        self.xtrabackup_aes256 = settings.get("XTRABACKUP_AES256_KEYFILE", False)

        if self.post_run_encrypt or not self.encrypt:
            self.encrypt_using_tmpdir = False

        self.cdba_report = {}
        self.cdba_report["upload"] = 1
        self.report_options["options"] = {
            "upload_to": self.upload_type,
            "encrypt": self.encrypt or self.post_run_encrypt,
        }

        if self.encrypt or self.post_run_encrypt:
            self.report_options["encryption"] = "gpg"

        root_backup_dir = settings["BACKUP_DIR"]
        root_backup_path = Path(root_backup_dir)
        self.backup_type_dir = ""
        if self.backup_code == "B":
            self.backup_type_dir = "binlogs"


        self.relative_backup_path = Path(self.backup_type_dir) / self.alias
        self.full_backup_path = root_backup_path / self.relative_backup_path
        self.tmpdir_for_enc_upload = (
            root_backup_path / "_tmpdir_for_enc_upload" / self.relative_backup_path
        )

        self.paths: list[dict[str, str]] = []

    def _collect_paths(self) -> None:
        for datedir in self.full_backup_path.iterdir():
            if datedir.is_dir():
                conditions_to_upload = [
                    re.search(BACKUP_DIR_REGEX[self.backup_code], datedir.name),
                    (datedir / UPLOADME_FILE).is_file(),
                ]
                if all(conditions_to_upload):
                    self.paths.append(
                        {
                            "source": str(datedir),
                            "rel_destination": str(
                                self.relative_backup_path / datedir.name
                            ),
                            "tmpdir": str(self.tmpdir_for_enc_upload / datedir.name),
                        }
                    )

    def _copy_to_tmpdir(self) -> None:
        if not self.encrypt_using_tmpdir:
            return

        self.logger.info("Copying backup to tmpdir for encryption...")
        for path in self.paths:
            tmpdir = Path(path["tmpdir"])
            if tmpdir.is_dir():
                shutil.rmtree(str(tmpdir))
                self.logger.info("Removed old tmpdir %s", tmpdir)

            source_path = Path(path["source"])
            self.logger.info(
                "Checking available disk space to copy %s ...", source_path
            )
            bkp_size = get_dir_size(str(source_path))
            tmpdir_base = tmpdir
            while not tmpdir_base.is_dir():
                tmpdir_base = tmpdir_base.parent
            free_size = get_free_space(str(tmpdir_base))
            self.logger.info("Backup size: %sMB free space: %sMB", bkp_size, free_size)
            if free_size > bkp_size * 1.1:
                shutil.copytree(str(source_path), str(tmpdir))
            else:
                msg = "No free space to use tmp dir for encryption."
                raise BackupError(msg)

        self.logger.info("OK Copy complete.")

    def _encrypt(self) -> None:

        if not (self.encrypt or self.post_run_encrypt):
            self.logger.warning("UPLOADING UNENCRYPTED BACKUP!!!")
            return

        for path in self.paths:
            dir_ = Path(path["tmpdir"] if self.encrypt_using_tmpdir else path["source"])
            encrypt_dir(str(dir_), self.logger, **self.dir_encrypt_config)

    def _upload(self) -> None:
        for path in self.paths:
            dir_ = path["tmpdir"] if self.encrypt_using_tmpdir else path["source"]
            dest_path = self.upload_provider.upload(dir_, path["rel_destination"])
            self.report_options["options"]["remote_path"] = dest_path
            self._mark_as_uploaded(path["source"])

    def _mark_as_uploaded(self, dir_: str) -> None:
        uploadme_file = Path(dir_) / UPLOADME_FILE
        if self.backup_code in ["B", "O"]:
            with uploadme_file.open("w+") as file_:
                file_.write(str(self.last_to_upload_number))
        elif uploadme_file.is_file():
            uploadme_file.unlink(missing_ok=True)

    def _cleanup(self) -> None:
        if not self.encrypt_using_tmpdir:
            return

        for path in self.paths:
            tmpdir = Path(path["tmpdir"])
            if tmpdir.is_dir():
                shutil.rmtree(str(tmpdir))
                self.logger.info("Removed tmpdir %s", tmpdir)

    def run(self) -> str:
        logging_set_host(self.alias, "upload-binlog.log")

        if self.full_backup_path.is_dir():
            self._collect_paths()

        if not self.paths:
            self.logger.debug("Nothing to upload of %s backup.", self.backup_type)
            self.textfile_collector_write_status(0, MSPAction.UPLOAD)
            return "OK no new binlogs to upload." if self.backup_code == "B" else ""

        start_time = time.time()
        self.logger.info(
            "Starting %s upload of %s backup: %s",
            self.upload_type,
            self.backup_type.lower(),
            ", ".join([str(p["source"]) for p in self.paths]),
        )

        #self.textfile_collector_write_status(-1, self.backup_code, self.alias, True)

        self._copy_to_tmpdir()
        self._encrypt()
        self._upload()
        self._cleanup()

        time_spent = format_seconds_to_hhmmss(time.time() - start_time)
        msg = f"OK {self.upload_type} upload complete. Duration: {time_spent}."
        self.logger.info(msg)
        self.textfile_collector_write_status(0, MSPAction.UPLOAD)
        #self.textfile_collector_write_status(0, self.backup_code, self.alias, True)

        return msg

def format_seconds_to_hhmmss(seconds: int | float) -> str:
    seconds = round(seconds)
    hours = seconds // 3600
    seconds %= 3600
    minutes = seconds // 60
    seconds %= 60
    return f"{hours:02d}:{minutes:02d}:{seconds:02d}"

class BinaryLogUpload(Upload):

    def __init__(self, *args, **kwargs):
        super(BinaryLogUpload, self).__init__(*args, **kwargs)
        # use tmpdir despite encrypt or not
        self.encrypt_using_tmpdir = True
        self.upload_list = []
        self.report_options['options']['upload_interval'] = 'recurrent'

    def _collect_paths(self):
        uploadme_file = os.path.join(self.full_backup_path, UPLOADME_FILE)
        if os.path.isfile(uploadme_file):
            with open(uploadme_file, 'r') as file_:
                try:
                    self.last_uploaded_number = int(file_.read())
                except ValueError:
                    pass

        # Gather all binlogs
        files = [f for f in os.listdir(self.full_backup_path)
                 if re.search(r'^.+%s\.gz$' % (BACKUP_DIR_REGEX['B'],), f) and
                 os.path.isfile(os.path.join(self.full_backup_path, f))]

        # Filter binlogs on which to upload
        for file_ in files:
            try:
                file_number = int(file_.split('.')[1])
            except (ValueError, IndexError):
                file_number = 0

            if file_number > self.last_uploaded_number:
                self.upload_list.append(file_)
                if file_number > self.last_to_upload_number:
                    self.last_to_upload_number = file_number

        if self.upload_list:
            self.paths = [{
                'source': self.full_backup_path,
                'rel_destination': self.relative_backup_path,
                'tmpdir': self.tmpdir_for_enc_upload
            }]

    def _copy_to_tmpdir(self):
        # Create tmpdir
        if not os.path.isdir(self.tmpdir_for_enc_upload):
            os.makedirs(self.tmpdir_for_enc_upload)

        self.logger.info('Copying binlogs to tmpdir for encryption starting binlog .%06d', self.last_uploaded_number)
        for file_ in self.upload_list:
            shutil.copy(os.path.join(self.full_backup_path, file_), self.tmpdir_for_enc_upload)

        self.logger.info('OK Copied %s binlogs.', len(self.upload_list))


class S3UploadProvider:

    def __init__(self, settings: dict[str, Any], logger: logging.Logger) -> None:
        self.logger = logger
        host = settings.get("HOST", "localhost")
        self.alias = settings.get("ALIAS", host)
        self.s3_bucket = settings.get("S3_BUCKET")
        self.fake_s3_upload = settings.get("FAKE_S3_UPLOAD")
        self.s3_limit_rate = settings.get("S3_LIMIT_RATE")
        self.s3_storage_class = settings.get("S3_STORAGE_CLASS", "STANDARD")
        self.backup_type = settings.get("BACKUP_TYPE")
        self.skip_s3_safety_check = settings.get("SKIP_S3_SAFETY_CHECK", False)
        self.logging_dir = settings.get("LOGGING_DIR", DEFAULT_LOGGING_DIR)

        if self.s3_bucket is None:
            msg = "S3_BUCKET is not set."
            raise BackupError(msg)

        log_file = (
            Path(self.logging_dir)
            / "s3cmd-{}-{}-{}.log".format(self.alias, self.backup_type, time.strftime("%Y%m%d"))
        )
        self.log_stream = log_file.open("a")

        bucket_str = self.s3_bucket
        if bucket_str.startswith("s3://"):
            bucket_str = bucket_str[5:]
        parts = bucket_str.split("/", 1)
        self.bucket_name = parts[0]
        self.bucket_prefix = parts[1] if len(parts) > 1 else ""

        self.s3 = boto3.client("s3")

    def _check_bucket_safety(self) -> None:
        if self.skip_s3_safety_check:
            self.logger.info("Skipping S3 bucket safety check as requested.")
            return

        self.logger.info("Checking S3 bucket safety...")
        try:
            resp = self.s3.get_public_access_block(Bucket=self.bucket_name)
            public_block = resp.get("PublicAccessBlockConfiguration", {})
            if not all(public_block.get(k, True) for k in public_block):
                msg = "Unsafe S3 bucket: public access is allowed!"
                raise BackupError(msg)
        except ClientError as e:
            self.logger.warning("Could not check S3 bucket safety: %s", e)
        self.logger.info("OK S3 bucket looks to be safe or safety check skipped.")

    def upload(self, source_dir: str, dest_dir: str) -> str:
        if not self.skip_s3_safety_check:
            self._check_bucket_safety()

        full_prefix = str(Path(self.bucket_prefix) / dest_dir)
        if not full_prefix.endswith("/"):
            full_prefix += "/"

        if self.fake_s3_upload:
            self.logger.warning("*** Fake S3 upload in action ***")
            return f"s3://{self.bucket_name}/{full_prefix}"

        self.logger.info("Uploading backup...")
        source_path = Path(source_dir)
        for root, _, files in os.walk(str(source_path)):
            for file_ in files:
                local_path = Path(root) / file_
                relative_path = local_path.relative_to(source_path)
                key = str(Path(full_prefix) / relative_path)

                extra_args = {
                    "StorageClass": self.s3_storage_class,
                    "ServerSideEncryption": "AES256",
                }

                self.logger.info(
                    "Uploading %s to s3://%s/%s", local_path, self.bucket_name, key
                )
                try:
                    self.s3.upload_file(
                        str(local_path), self.bucket_name, key, ExtraArgs=extra_args
                    )
                except (boto3.exceptions.S3UploadFailedError, ClientError) as err:
                    raise BackupError(f"S3 upload failed: {err}") from err

        # Upload a "latest" file for convenience if needed
        if self.backup_type not in ["B", "O"] and not (
            self.backup_type == "X" and "_incrementals" in dest_dir
        ):
            latest_key = str(Path(full_prefix).parent / "latest")
            try:
                tmp_dir = Path("/tmp/percona_backup_latest")
                tmp_dir.mkdir(parents=True, exist_ok=True)
                latest_local_path = tmp_dir / "latest"
                with latest_local_path.open("w") as fn:
                    fn.write(f"s3://{self.bucket_name}/{full_prefix}")

                self.s3.upload_file(
                    str(latest_local_path),
                    self.bucket_name,
                    latest_key,
                    ExtraArgs={
                        "StorageClass": self.s3_storage_class,
                        "ServerSideEncryption": "AES256",
                    },
                )
            except Exception as e:
                self.logger.warning("S3 latest file upload failed: %s", e)

        return f"s3://{self.bucket_name}/{full_prefix}"


class RsyncUploadProvider:

    def __init__(self, settings: dict[str, Any], logger: logging.Logger) -> None:
        self.logger = logger
        host = settings.get("HOST", "localhost")
        self.alias = settings.get("ALIAS", host)
        self.rsync_dir = settings.get("RSYNC_PATH")
        self.backup_type = settings.get("BACKUP_TYPE")
        if self.rsync_dir is None:
            msg = "RSYNC_PATH is not set."
            raise BackupError(msg)

        logging_dir = settings.get("LOGGING_DIR", DEFAULT_LOGGING_DIR)
        log_file = (
            Path(logging_dir)
            / "rsync-{}-{}-{}.log".format(self.alias, self.backup_type, time.strftime("%Y%m%d"))
        )
        self.log_stream = log_file.open("a")

    def upload(self, source_dir: str, dest_dir: str) -> str:
        if not Path(RSYNC_BIN).exists():
            msg = f"Missing {RSYNC_BIN}. Install rsync package."
            raise BackupError(msg)

        # Convert dest_dir to string for string operations
        dest_dir_str = str(dest_dir)

        if "_incrementals" in dest_dir_str:
            _, inc_dir_name = dest_dir_str.rsplit("/", 1)
            dest_path = str(Path(self.rsync_dir) / inc_dir_name / "")
        else:
            dest_path = str(Path(self.rsync_dir) / "")

        #Ensure source_dir is a string
        source_dir_str = str(source_dir)

        cmd = [
            RSYNC_BIN,
            "-avH",
            "--numeric-ids",
            "--no-owner",
            "--no-group",
            source_dir_str,
            dest_path,
        ]
        self.logger.info("Starting rsync...")
        self.logger.info("Running: %s", " ".join(cmd))
        proc = subprocess.Popen(cmd, stdout=self.log_stream, stderr=subprocess.PIPE)
        _, err = proc.communicate()
        if proc.returncode != 0:
            msg = f"Rsync failed. Error: {err}"
            raise BackupError(msg)

        return dest_path

class GSUploadProvider:
    """Google Cloud Storage upload."""

    def __init__(self, settings: dict[str, Any], logger: logging.Logger) -> None:
        """Initialize GSUploadProvider.

        :param settings: Backup/server settings.
        :param logger: Logger instance.
        :raises BackupError: If GS_BUCKET not set.
        """
        self.logger = logger
        host = settings.get("HOST", "localhost")
        self.alias = settings.get("ALIAS", host)
        self.gs_bucket = settings.get("GS_BUCKET")
        self.backup_type = settings.get('BACKUP_TYPE')
        if self.gs_bucket is None:
            msg = 'GS_BUCKET is not set.'
            raise BackupError(msg)

        self.logging_dir = settings.get('LOGGING_DIR', DEFAULT_LOGGING_DIR)
        os.makedirs(logging_dir, exist_ok=True)
        log_file = os.path.join(self.logging_dir, 'gsutil-%s-%s-%s.log' %
                                (self.alias,
                                 self.backup_type,
                                 time.strftime('%Y%m%d')
                                )
                               )
        self.log_stream = open(log_file, 'a')

        bucket_str = self.gs_bucket
        if bucket_str.startswith("gs://"):
            bucket_str = bucket_str[5:]
        parts = bucket_str.split("/", 1)
        self.bucket_name = parts[0]
        self.bucket_prefix = parts[1] if len(parts) > 1 else ""

    def upload(self, source_dir: str, dest_dir: str) -> str:
        """Upload given directory to provided GS destination.

        :param source_dir: Local source directory.
        :param dest_dir: Destination path (relative) on GS.
        :return: GS URI of the uploaded backup.
        :raises BackupError: If GS upload fails.
        """
        source_path = Path(source_dir)
        full_prefix = (
            str(Path(self.bucket_prefix) / dest_dir)
            if self.bucket_prefix else dest_dir
        )
        dest_path = f"gs://{self.bucket_name}/{full_prefix}"
        gs_cmd = [GSUTIL_BIN, 'rsync', '-r', str(source_path), dest_path]
        self.logger.info('Uploading backup...')
        self.logger.info('Running: %s', ' '.join(gs_cmd))

        proc = subprocess.Popen(gs_cmd, stdout=self.log_stream, stderr=subprocess.PIPE)
        _, err = proc.communicate()
        if proc.returncode != 0:
            msg = f"GS upload failed. Error: {err}"
            raise BackupError(msg)

        if self.backup_type not in ["B", "O"] and not (
            self.backup_type == "X" and "_incrementals" in dest_dir
        ):
            with tempfile.NamedTemporaryFile("w", delete=False) as tmpf:
                tmpf.write(dest_path)
                tmpf.flush()
                latest_file_local_path = tmpf.name
            try:
                latest_file_remote_dir = (
                       f"gs://{self.bucket_name}/{Path(full_prefix).parent}/latest"
                )
                gs_cmd = [GSUTIL_BIN,'cp',latest_file_local_path, latest_file_remote_dir]
                proc = subprocess.Popen(gs_cmd, stdout=self.log_stream, stderr=subprocess.PIPE)
                _, err = proc.communicate()
                if proc.returncode != 0:
                    msg = f"GS upload failed. Error: {err}"
                    raise BackupError(msg)
            finally:
                if Path(latest_file_local_path).exists():
                    Path(latest_file_local_path).unlink()

        return dest_path

