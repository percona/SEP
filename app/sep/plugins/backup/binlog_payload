class DirectoryEncryptor:

    def __init__(self, cfg_path: Path, **cfg) -> None:
        self.config = {}
        self._setup_cfgs(cfg_path)
        self.config.update(cfg)

    def _setup_cfgs(self, cfg_path: Path) -> None:
        if cfg_path.exists():
            try:
                with cfg_path.open(encoding="utf-8") as cfg_f:
                    self.config = yaml.safe_load(cfg_f) or {}
            except (FileNotFoundError, yaml.YAMLError):
                self._set_default_config()
        else:
            self._set_default_config()

        gpg_bin = self.config.get("gpg bin", "/usr/bin/gpg")

    def _set_default_config(self) -> None:
        self.config = {
            "encryption recipient": "directory.encryption@percona.com",
            "encryption home dir": "~/.gnupg",
            "max encryption processes": 5,
            "encryption nice": False,
            "gpg bin": "/usr/bin/gpg",
            "encryption file filter": "",
        }

    def _start_gpg_subp(
        self,
        filename: str,
        recipient: str = "",
        *,
        nice: bool = False,
    ) -> subprocess.Popen:
        gpg_bin = self.config["gpg bin"]
        home_dir = self.config.get("encryption home dir", "")
        output_filename = filename + ".gpg"
        stdin = None
        cmd = [
            gpg_bin,
            "--batch",
            "--yes",
            "--encrypt",
            "--always-trust",
            "--quiet",
            f"--recipient={recipient}",
            f"--output={output_filename}",
            filename,
        ]

        if nice:
            cmd.insert(0, "nice")
        if home_dir:
            cmd.insert(-1, f"--homedir={home_dir}")
        return subprocess.Popen(cmd, stdin=stdin)

    def _prune_finished_procs(
        self, proc_dict: dict[str, subprocess.Popen], max_live_proc: int = 0
    ) -> bool:
        ok = True
        while proc_dict:
            for fp, proc in list(proc_dict.items()):
                rc = proc.poll()
                if rc is None:
                    continue
                if rc == 0:
                    with suppress(OSError):
                        Path(fp).unlink()
                else:
                    ok = False
                    logging.error("%r did not encrypt correctly.", fp)
                    sys.exit(1)
                del proc_dict[fp]
            if len(proc_dict) < max_live_proc:
                break
            time.sleep(0.1)
        return ok

    def encrypt_dir(
        self,
        encr_dir: Path,
    ) -> bool:
        recipient = self.config.get("encryption recipient", "directory.encryption@percona.com")
        nice = bool(self.config.get("encryption nice", False))
        max_proc = int(self.config.get("max encryption processes", 5))

        enc_procs = {}
        all_ok = True

        exclude_names = {
            "md5sum",
            ".uploadme",
            "xtrabackup_info",
            "xtrabackup_checkpoints",
        }

        for file_path in encr_dir.rglob("*"):
            if (
                not file_path.is_file()
                or file_path.name.endswith(".gpg")
                or file_path.name in exclude_names
            ):
                continue

            p = self._start_gpg_subp(str(file_path), recipient=recipient, nice=nice)
            enc_procs[file_path] = p
            ok = self._prune_finished_procs(enc_procs, max_proc)
            all_ok = all_ok and ok

        ok = self._prune_finished_procs(enc_procs)
        return all_ok and ok


def encrypt_dir(path: str, logger: logging.Logger | None = None, **cfg: Any) -> None:
    if logger:
        logger.info("Encrypting backup...")
        logger.info("Running on: %s", path)

    dir_encrypt = DirectoryEncryptor(cfg_path=DIR_ENCRYPT_CFG_PATH, **cfg)
    if not dir_encrypt.encrypt_dir(encr_dir=Path(path)):
        raise BackupError("Encryption failed.")

    if not is_encrypted_dir(path, logger=logger):
        raise BackupError("Something wrong, there are still unencrypted files!")

    if logger:
        logger.info("OK Encryption complete and verified.")


def is_encrypted_dir(
    path: str,
    exclude_files: tuple[str, ...] = (
        MD5SUM_FILE,
        UPLOADME_FILE,
        XTRABACKUP_INFO,
        XTRABACKUP_CHECKPOINTS,
    ),
    logger: logging.Logger | None = None,
) -> bool:
    ppath = Path(path)
    for p in ppath.rglob("*"):
        if p.is_file() and p.name not in exclude_files:
            cmd = [
                GPG_BIN,
                "--batch",
                "--list-only",
                "--status-fd",
                "1",
                "--decrypt",
                str(p),
            ]
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            _, err = proc.communicate()
            if proc.returncode != 0:
                if logger:
                    logger.error("Running: %s", " ".join(cmd))
                    logger.error(
                        'Problem verifying encryption of the file "%s". Error: %s',
                        p.name,
                        err,
                    )
                return False
    return True


def is_public_ip(ip_addr):
    try:
        ip_addr = socket.gethostbyname(ip_addr)
    except Exception:
        # Unable to resolve, unknown host or invalid host or IP
        return False
    pton = struct.unpack("!I", socket.inet_pton(socket.AF_INET, ip_addr))[0]
    private = (
        ["127.0.0.0", "255.0.0.0"],
        ["192.168.0.0", "255.255.0.0"],
        ["172.16.0.0", "255.240.0.0"],
        ["10.0.0.0", "255.0.0.0"],
    )
    for net in private:
        mask = struct.unpack("!I", socket.inet_aton(net[1]))[0]
        aton = struct.unpack("!I", socket.inet_aton(net[0]))[0]
        if (pton & mask) == aton:
            return False

    return True


def get_max_subdir_size(start_path, unit="m"):
    cmd = [DU_BIN, "-%s" % (unit,), "--max-depth=1", start_path]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out, err = proc.communicate()
    if proc.returncode != 0:
        logging.error("Error running %s: %s", " ".join(cmd), err)
        return 0

    # Sort subdir sizes and exclude the first element - an empty value '' from du output
    # and the last one - the parent dir size itself.
    subdir_size = sorted([int(i.split("\t")[0]) for i in out.decode().split("\n") if i])
    # No subdirs
    if len(subdir_size) == 1:
        return 0

    return subdir_size[-2]


def get_free_space(dir_path, pct=False):
    vfs = os.statvfs(dir_path)
    free_mb = vfs.f_bavail * vfs.f_bsize / 1024**2
    if pct:
        total_mb = vfs.f_blocks * vfs.f_bsize / 1024**2
        free_mb = free_mb * 100 / total_mb
    return free_mb


def is_free_space(
    dir_path,
    logging_host="localhost",
    double_space_needed=False,
    threshold_pct=None,
    logger=None,
):
    max_size = 0
    ratio = 1
    if threshold_pct:
        free_pct = get_free_space(dir_path, pct=True)
        if free_pct <= threshold_pct:
            output = "Not enough disk space to pull binlogs: free %s%%, needed %s%%" % (
                free_pct,
                threshold_pct + 1,
            )
            return False, output

        logging.debug(
            "Disk space OK: free %s%%, needed %s%%", free_pct, threshold_pct + 1
        )
    else:
        free_mb = get_free_space(dir_path)
        max_backup_size = get_max_subdir_size(dir_path)
        if double_space_needed:
            ratio = 2

        if max_backup_size > 0:
            # Reserving +10% to the largest backup
            max_size = int(max_backup_size * ratio * 1.1)

        if free_mb < max_size:
            output = (
                "Not enough disk space to run the backup: free %s Mb, needed %s Mb"
                % (free_mb, max_size)
            )
            return False, output

        if logger:
            logger.info("Disk space OK: free %s Mb, needed %s Mb.", free_mb, max_size)

    return True, ""


