def is_public_ip(ip_addr):
    """Checks whether IP is public."""
    try:
        ip_addr = socket.gethostbyname(ip_addr)
    except Exception:
        # Unable to resolve, unknown host or invalid host or IP
        return False
    pton = struct.unpack("!I", socket.inet_pton(socket.AF_INET, ip_addr))[0]
    private = (
        ["127.0.0.0", "255.0.0.0"],
        ["192.168.0.0", "255.255.0.0"],
        ["172.16.0.0", "255.240.0.0"],
        ["10.0.0.0", "255.0.0.0"],
    )
    for net in private:
        mask = struct.unpack("!I", socket.inet_aton(net[1]))[0]
        aton = struct.unpack("!I", socket.inet_aton(net[0]))[0]
        if (pton & mask) == aton:
            return False

    return True


def get_max_subdir_size(start_path, unit="m"):
    """Return the max size among all subdirs within the given path.

    Unit: m (MB), b (bytes).
    """
    cmd = [DU_BIN, "-%s" % (unit,), "--max-depth=1", start_path]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out, err = proc.communicate()
    if proc.returncode != 0:
        logging.error("Error running %s: %s", " ".join(cmd), err)
        return 0

    # Sort subdir sizes and exclude the first element - an empty value '' from du output
    # and the last one - the parent dir size itself.
    subdir_size = sorted([int(i.split("\t")[0]) for i in out.decode().split("\n") if i])
    # No subdirs
    if len(subdir_size) == 1:
        return 0

    return subdir_size[-2]


def get_free_space(dir_path, pct=False):
    """Return free space in MB or %"""
    vfs = os.statvfs(dir_path)
    free_mb = vfs.f_bavail * vfs.f_bsize / 1024**2
    if pct:
        total_mb = vfs.f_blocks * vfs.f_bsize / 1024**2
        free_mb = free_mb * 100 / total_mb
    return free_mb


def is_free_space(
    dir_path,
    logging_host="localhost",
    double_space_needed=False,
    threshold_pct=None,
    logger=None,
):
    """Check for free disk space for the current backup run.

    dir_path: a path for which we determine a partition to be checked.
    logging_host: a host to include into log messages.
    double_space_needed: if true, we will require double space for the backup, Used by with mydumper and option
                         MYDUMPER_USE_TMPDIR_FOR_ENC_S3UPLOAD enabled.
    threshold_pct: if defined, this is a check for binlog backup and reflects a threshold when backup is run.
                   When disk space free percentage is larger than this threshold, mysqlbinlog will be running.

    Return False is no space available.
    """
    max_size = 0
    ratio = 1
    if threshold_pct:
        free_pct = get_free_space(dir_path, pct=True)
        if free_pct <= threshold_pct:
            output = "Not enough disk space to pull binlogs: free %s%%, needed %s%%" % (
                free_pct,
                threshold_pct + 1,
            )
            return False, output

        logging.debug(
            "Disk space OK: free %s%%, needed %s%%", free_pct, threshold_pct + 1
        )
    else:
        free_mb = get_free_space(dir_path)
        max_backup_size = get_max_subdir_size(dir_path)
        if double_space_needed:
            ratio = 2

        if max_backup_size > 0:
            # Reserving +10% to the largest backup
            max_size = int(max_backup_size * ratio * 1.1)

        if free_mb < max_size:
            output = (
                "Not enough disk space to run the backup: free %s Mb, needed %s Mb"
                % (free_mb, max_size)
            )
            return False, output

        if logger:
            logger.info("Disk space OK: free %s Mb, needed %s Mb.", free_mb, max_size)

    return True, ""


