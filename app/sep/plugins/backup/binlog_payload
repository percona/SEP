def logging_setup(
    logging_dir: Path, log_name: str, level: int = logging.INFO
) -> logging.Logger:
    os.umask(0o007)
    real_logging_dir = logging_dir.expanduser().resolve()

    if not real_logging_dir.is_dir():
        real_logging_dir.mkdir(parents=True, exist_ok=True)

    try:
        test_file = real_logging_dir / ".write_test"
        test_file.touch()
        test_file.unlink()
    except OSError:
        print(f"Logging directory {logging_dir} is not writable.")
        sys.exit(4)

    for handler in logging.root.handlers[:]:
        logging.root.removeHandler(handler)

    # Configure root logger to prevent stderr output
    logging.root.setLevel(logging.WARNING)  # Set to WARNING to suppress INFO messages
    # Or alternatively, add a null handler to suppress all root logger output
    # logging.root.addHandler(logging.NullHandler())

    name = log_name.replace(".log", "")
    logger = logging.getLogger(name)
    log_file = real_logging_dir / log_name

    if not any(
        isinstance(h, logging.FileHandler)
        and getattr(h, "baseFilename", None) == str(log_file)
        for h in logger.handlers
    ):
        file_handler = logging.FileHandler(str(log_file))
        file_formatter = logging.Formatter(LOGGING_FORMAT)
        file_handler.setFormatter(file_formatter)
        logger.addHandler(file_handler)

    if not any(
        isinstance(h, logging.StreamHandler) and h.stream == sys.stdout
        for h in logger.handlers
    ):
        stream_handler = logging.StreamHandler(sys.stdout)
        if level <= logging.DEBUG:
            stream_formatter = logging.Formatter(LOGGING_FORMAT_DEBUG)
        else:
            stream_formatter = logging.Formatter(LOGGING_FORMAT)
        stream_handler.setFormatter(stream_formatter)
        logger.addHandler(stream_handler)

    logger.setLevel(level)
    logging_set_host(None, name)
    return logger


def logging_set_host(alias: str | None, log_name: str) -> None:

    class ContextFilter(logging.Filter):
        def filter(self, record: logging.LogRecord) -> bool:
            record.alias = f"[{alias}] " if alias else ""
            return True

    log_name = log_name.replace(".log", "")
    logging.getLogger(log_name).addFilter(ContextFilter())


class LocalConfig:

    default_nowrite_timeout = 1800  # 30 minutes
    default_purge_days = 30

    def __init__(self, cfg_path: Path) -> None:
        self.server_data_list: list[dict[str, Any]] = []
        self.base: dict[str, Any] = {}
        self.cfg_path = Path(cfg_path)
        self.populated = False
        self.raw_cfg_data: dict[str, Any] = {}
        self._populate_cfg()

    def _populate_cfg(self) -> None:
        try:
            with self.cfg_path.open("r") as cfg_file:
                cfg_file_contents = cfg_file.read()
                data = yaml.safe_load(cfg_file_contents)
        except Exception:
            logging.exception("Could not read config file %r", self.cfg_path)
            return

        self.raw_cfg_data = data

        default_server = {
            "PORT": 3306,
            "NOWRITE_TIMEOUT": LocalConfig.default_nowrite_timeout,
            "BINLOG_PURGE_DAYS": LocalConfig.default_purge_days,
        }
        default_server.update(data["ALL_SERVERS"])
        self.base = default_server.copy()

        for server in data["SERVER_LIST"]:
            if (
                "HOST" in server
                and isinstance(server["HOST"], str)
                and server["HOST"].count(":") > 1
            ):
                logging.warning("Unsupported host format %s", server["HOST"])
                continue
            server_data = default_server.copy()
            server_data.update(server)
            self.server_data_list.append(server_data)
        self.populated = True


class LockInUse(Exception):
    """Error for active locks"""


class LockFile:

    def __init__(self, lock_fname, timeout=300):
        self.lock_fname = lock_fname
        self.timeout = timeout
        self.lock_time = time.time()
        self.cur_pid = os.getpid()
        self.cur_all_cpu_time = self._get_all_cpu_time(self.cur_pid)
        self.lock_file_data = None

    def get_lock(self):
        if not self._is_lock_free():
            msg = "Could not acquire lock file"
            logging.debug(msg)
            raise LockInUse(msg)
        self._write_lock_file()

    def get_lock_or_exit(self):
        try:
            self.get_lock()
        except LockInUse:
            sys.exit(-1)

    def free_lock(self):
        # TODO: check what happens if this is called when the lock is not held
        if os.path.isfile(self.lock_fname):
            os.unlink(self.lock_fname)

    def update_lock(self):
        self.lock_time = time.time()
        self._write_lock_file()

    def _is_lock_free(self):
        lock_free = False
        if not os.path.isfile(self.lock_fname):
            lock_free = True
        elif not self._is_process_running():
            self.free_lock()
            lock_free = True
        return lock_free

    def _is_process_running(self):
        proc_running = False
        self._read_lock_file()
        self.lock_time = time.time()
        if os.path.isdir("/proc/%d" % self.lock_file_data["PID"]):
            pid_cmdline = self._get_process_cmdline(self.lock_file_data["PID"])
            lockfile_cmdline = self.lock_file_data.get("CMD_LINE").encode("utf-8")
            if lockfile_cmdline is not None and lockfile_cmdline != pid_cmdline:
                # The pid is being re-used by another process.
                proc_running = False
            elif (self.lock_file_data["UPDATE_TIME"] + self.timeout) > self.lock_time:
                proc_running = True
            else:
                old_cpu_time = self.lock_file_data["ALL_CPU_TIME"]
                cur_cpu_time = self._get_all_cpu_time(self.lock_file_data["PID"])
                if len(old_cpu_time) != len(cur_cpu_time):
                    proc_running = True
                else:
                    old_pids = list(old_cpu_time.keys())
                    cur_pids = list(cur_cpu_time.keys())
                    old_pids.sort()
                    cur_pids.sort()
                    for i, j in enumerate(old_pids):
                        if j != cur_pids[i]:
                            proc_running = True
                            break
                        if old_cpu_time[j] < cur_cpu_time[cur_pids[i]]:
                            proc_running = True
                            break
                    if proc_running:
                        # Update the current CPU TIME in the lock file
                        self._update_cpu_time()
                if not proc_running:
                    # kill the old process
                    msg = "Killing hung process %s" % self.lock_file_data["PID"]
                    logging.error(msg)
                    os.kill(int(self.lock_file_data["PID"]), signal.SIGKILL)
                    for cpid in self._get_child_pids(self.lock_file_data["PID"]):
                        msg = "Killing hung child process %s" % cpid
                        logging.error(msg)
                        os.kill(int(cpid), signal.SIGKILL)
        return proc_running

    def _read_lock_file(self):
        try:
            with open(self.lock_fname, "rb") as lock_fstream:
                self.lock_file_data = json.loads(lock_fstream.read().decode())
        except Exception:
            self.free_lock()
            raise

    def _update_cpu_time(self):
        with open(self.lock_fname, "rb") as lock_fstream:
            existing_lock_file_data = json.loads(lock_fstream.read().decode())
        existing_lock_file_data["ALL_CPU_TIME"] = self._get_all_cpu_time(
            existing_lock_file_data["PID"]
        )  # pylint: disable=line-too-long
        existing_lock_file_data["UPDATE_TIME"] = time.time()
        tmp_fname = self.lock_fname + ".update_tmp"
        with open(tmp_fname, "wb") as tmp_fstream:
            tmp_fstream.write(json.dumps(existing_lock_file_data).encode("utf-8"))
        os.rename(tmp_fname, self.lock_fname)

    def _write_lock_file(self):
        self.lock_time = time.time()
        self.cur_all_cpu_time = self._get_all_cpu_time(self.cur_pid)
        lock_data = {
            "CMD": " ".join(sys.argv),
            "PID": self.cur_pid,
            "UPDATE_TIME": self.lock_time,
            "ALL_CPU_TIME": self.cur_all_cpu_time,
            "CMD_LINE": self._get_process_cmdline(self.cur_pid).decode(),
        }
        tmp_fname = self.lock_fname + ".tmp"
        with open(tmp_fname, "wb") as tmp_fstream:
            tmp_fstream.write(json.dumps(lock_data).encode("utf-8"))
        os.rename(tmp_fname, self.lock_fname)

    def _get_all_cpu_time(self, pid):
        ret = {str(pid): self._get_process_cpu_time(pid)}
        for cpid in self._get_child_pids(pid):
            ret.update(self._get_all_cpu_time(cpid))
        return ret

    @staticmethod
    def _get_process_cpu_time(pid):
        with open("/proc/%d/stat" % pid, "rb") as stat_fstream:
            stat_data = stat_fstream.read()
        stat_list = stat_data.split()
        return int(stat_list[PROC_STAT_UTIME_IDX]) + int(stat_list[PROC_STAT_STIME_IDX])

    @staticmethod
    def _get_process_cmdline(pid):
        cmdline_fp = f"/proc/{pid:d}/cmdline"
        try:
            with open(cmdline_fp, "rb") as cmdline_f:
                command_line = cmdline_f.read()
        except Exception:
            logging.debug(
                "could not read command line file for pid %r", pid, exc_info=True
            )
            command_line = None
        return command_line

    @staticmethod
    def _get_child_pids(pid):
        child_pids = []
        for fname in os.listdir("/proc"):
            try:
                if fname.isdigit() and os.path.isdir(os.path.join("/proc", fname)):
                    if os.path.isfile(os.path.join("/proc", fname, "stat")):
                        with open(
                            os.path.join("/proc", fname, "stat"), "rb"
                        ) as stat_fstream:
                            stat_data = stat_fstream.read()
                        stat_list = stat_data.split()
                        if int(stat_list[PROC_STAT_PPID_IDX]) == pid:
                            child_pids.append(int(stat_list[PROC_STAT_PID_IDX]))
            except Exception:
                pass  # This is to account for processes that have ended since the listdir()
        return child_pids


class BackupError(Exception):

    def __init__(self, message) -> None:
        super().__init__(self, message)
        self.message = message


class BinlogRunner(multiprocessing.Process):
    def __init__(
        self,
        command_queue,
        config_path: Path,
        run_only_server: bool,
        *args: Any,
        **kwargs: Any,
    ) -> None:
        multiprocessing.Process.__init__(self, *args, **kwargs)

        self.command_queue = command_queue
        self.local_cfg = None
        self.config_path = config_path
        self.run_only_server = run_only_server
        self.logger = None

    def run(self) -> None:
        self.local_cfg = LocalConfig(self.config_path)

        logging_dir = Path(
            self.local_cfg.raw_cfg_data["ALL_SERVERS"].get(
                "LOGGING_DIR", DEFAULT_LOGGING_DIR
            )
        )

        servers = self.local_cfg.server_data_list
        settings = servers[0]
        if settings.get("DEBUG") or self.local_cfg.raw_cfg_data["ALL_SERVERS"].get(
            "DEBUG"
        ):
            self.logger = logging_setup(logging_dir, LOGGING_NAME, logging.DEBUG)
        if self.logger is None:
            self.logger = logging_setup(logging_dir, LOGGING_NAME)

        procs = []
        queues = []
        for server_data in self.local_cfg.server_data_list:
            try:
                srv_bkup_type = server_data.get("BACKUP_TYPE", "ALL")
                if srv_bkup_type != "ALL" and "B" not in srv_bkup_type:
                    continue
                if (
                    self.run_only_server is not None
                    and server_data["HOST"] != self.run_only_server
                ):
                    continue
                server_command_queue = multiprocessing.Queue()
                proc = multiprocessing.Process(
                    target=run_binlog_backup, args=(server_data, server_command_queue)
                )
                proc.start()
                procs.append(proc)
                queues.append(server_command_queue)
            except Exception as err:
                self.logger.error("Unhandled Exception")
                sys.exit(1)

        exit_initiated = None
        while procs:
            if exit_initiated is None:
                command = queue_get_maybe(self.command_queue, 60)
                if command is not None:
                    if command == "exit":
                        self.logger.info("BinlogRunner received exit command")
                        for que in queues:
                            que.put("exit")
                        exit_initiated = time.time()
                    else:
                        self.logger.error("invalid command received: %r", command)
            else:
                time.sleep(1)

            alive_procs = []
            for proc in procs:
                if proc.is_alive():
                    alive_procs.append(proc)
                else:
                    proc.join()
                    # Check if the process exited with an error
                    if proc.returncode != 0:
                        self.logger.error("Child process exited with code %d", proc.returncode)
                        sys.exit(1)

            procs = alive_procs

            if exit_initiated is not None and time.time() - exit_initiated >= 10:
                for proc in procs:
                    proc.terminate()
                return


class BaseBackup:
    def __init__(
        self,
        server_data: dict[str, Any],
        backup_code: str,
        logger: logging.Logger | None = None,
    ) -> None:
        self.server_data = server_data
        self.backup_code = backup_code
        self.backup_textfile_collector_dir = Path(
            self.server_data.get(
                "BACKUP_TEXTFILE_COLLECTOR_DIR", BACKUP_TEXTFILE_COLLECTOR_DIR
            )
        )
        self.alias = self.server_data.get("ALIAS")
        self.report_options: dict[str, Any] = {}
        self.logging_dir = Path(
            self.server_data.get("LOGGING_DIR", DEFAULT_LOGGING_DIR)
        )
        self.logger = LOGGER

        self.compress = self.server_data.get("COMPRESS", True)
        self.compression_algorithm = self.server_data.get(
            "COMPRESSION_ALGORITHM", DEFAULT_COMPRESSION_ALGORITHM
        )
        if self.compress:
            self.check_compression_algorithm(self.compression_algorithm)

        # Dynamically set
        self.is_replica = False
        self.last_backup_dir = None

    def check_compression_algorithm(self, algorithm: str) -> None:
        if not self.compress:
            self.logger.debug("Compression is disabled, skipping check")
            return
        if algorithm in AVAILABLE_COMPRESSION_ALGORITHMS:
            self.logger.debug(
                "Algorithm %s accepted for backup type %s", algorithm, self.backup_code
            )
            return
        raise BackupError(
            f"algorithm {algorithm} is not one of {AVAILABLE_COMPRESSION_ALGORITHMS}"
        )

    def notify(self, status: BackupNotifyStatus, output: str) -> None:
        if len(output) > 300:
            output = f"{output[:300]}..."

        if isinstance(self, Backup) and self.is_replica:
            output = f"Host {self.alias}. {output}"

        self.report_options["end_time"] = time.strftime(DATETIME_FORMAT, time.gmtime())

        if status == BackupNotifyStatus.OK:
            self.textfile_collector_notify(0)
            if "OK no new binlogs to upload" in output:
                self.textfile_collector_write_status(status, MSPAction.UPLOAD)
        else:
            self.textfile_collector_notify(1)

    def check_textcollector_dir(self) -> bool:
        backup_textfile_collector_dir = self.backup_textfile_collector_dir.parent
        if not backup_textfile_collector_dir.is_dir():
            self.logger.warning(
                "Textfile Collector directory %s does not exist.",
                backup_textfile_collector_dir,
            )
            return False
        return True

    def textfile_collector_write_status(
        self,
        backup_status: int,
        msp_action: MSPAction = MSPAction.BACKUP,
    ) -> None:
        if not self.check_textcollector_dir():
            return

        collector_file = (
            self.backup_textfile_collector_dir
            / f"{msp_action.value}.{BACKUP_TYPE}.{self.alias}.prom"
        )

        encryption_val = self.report_options.get("encryption", "")
        start_time_val = str(self.report_options.get("start_time", ""))
        end_time_val = str(self.report_options.get("end_time", ""))

        metrics_text = (
            f"# HELP msp_{msp_action.value}_status The status of the job\n"
            f"# TYPE msp_{msp_action.value}_status Untyped\n"
            f"# HELP msp_{msp_action.value}_last_report_ts The Last Report Time\n"
            f"# TYPE msp_{msp_action.value}_last_report_ts Untyped\n"
            f'msp_{msp_action.value}_status{{type="{BACKUP_TYPE}", alias="{self.alias}", encryption="{encryption_val}", '
            f'backup_id="", start_time="{start_time_val}", end_time="{end_time_val}"'
        )

        size_bytes = (
            get_dir_size(self.last_backup_dir)
            if self.last_backup_dir is not None
            else 0
        )
        metrics_text += f', backup_size="{size_bytes}"'

        metrics_text += f"}} {backup_status}\n"
        metrics_text += f'msp_{msp_action.value}_last_report_ts{{type="{BACKUP_TYPE}", alias="{self.alias}", backup_id=""}} {int(time.time())}\n'

        with collector_file.open("w") as outfile:
            outfile.write(metrics_text)

    def textfile_collector_notify(self, backup_status: int) -> None:
        self.textfile_collector_write_status(backup_status)

    def textfile_collector_write_enable(
        self, alias: str, backup_enabled: bool, job_type: str
    ) -> None:
        """Add the enabled backup types to the textfile collector.
        :param alias: Host alias.
        :param backup_enabled: Whether the backup type is enabled.
        :param job_type: Job type name.
        """
        if not self.check_textcollector_dir():
            return

        collector_file = (
            self.backup_textfile_collector_dir
            / f"driver.{job_type}.Binlogs.{alias}.prom"
        )

        with collector_file.open("w") as outfile:
            outfile.write(
                f"# HELP msp_{job_type}_enabled The status of the cron\n"
                f"# TYPE msp_{job_type}_enabled Untyped\n"
            )
            outfile.write(
                f'msp_{job_type}_enabled{{type="Binlogs", alias="{alias}"}} '
                f"{1 if backup_enabled else 0}\n"
            )


class Backup(BaseBackup):
    def __init__(
        self,
        server_data: dict[str, Any],
        backup_code: str,
        logger: logging.Logger,
        native_upload: bool = False,
    ) -> None:
        self.backup_code = backup_code
        super().__init__(server_data, backup_code, logger)
        self.host = server_data.get("HOST", "localhost")
        self.alias = server_data.get("ALIAS", self.host)
        self.port = server_data.get("PORT", 3306)
        self.hostname = str(
            server_data.get("HOSTNAME", socket.gethostname().split(".")[0])
        )
        self.check_disk_space = server_data.get("CHECK_DISK_SPACE", True)
        self.defaults_cnf_file = server_data.get("DEFAULTS_FILE", DEFAULT_MYCNF)
        self.hardlink = server_data.get("HARDLINK", True)
        self.dir_encrypt_config = server_data.get("DIR_ENCRYPT_CONFIG", {})
        self.post_run_encrypt = server_data.get("POST_RUN_ENCRYPT", False)
        self.only_if_read_only = server_data.get("ONLY_IF_READ_ONLY")
        self.only_if_running_replica = server_data.get("ONLY_IF_RUNNING_REPLICA")
        self.upload_type = server_data.get("UPLOAD", set())
        if isinstance(self.upload_type, str):
            self.upload_type = {self.upload_type}
        self.upload_interval = server_data.get("UPLOAD_INTERVAL", "weekly")
        self.all_cnf_files = []
        self.backup_textfile_collector_dir = Path(
            self.server_data.get(
                "BACKUP_TEXTFILE_COLLECTOR_DIR", BACKUP_TEXTFILE_COLLECTOR_DIR
            )
        )

        self.logger = (
            self.logger
            or logger
            or logging_setup(self.logging_dir, BACKUP_TYPE.lower() + ".log")
        )
        logging_set_host(self.alias, BACKUP_TYPE.lower() + ".log")

        self.report_options = {
            "host": self.alias,
            "status": "error",
            "start_time": time.strftime(DATETIME_FORMAT, time.gmtime()),
            "end_time": "",
            "size_mb": 0,
            "hl_mb": None,
            "options": {},
            "encryption": "none",
        }

    def enable_upload(self, backup_dir: Path) -> None:
        uploadme_path = backup_dir / UPLOADME_FILE
        if not uploadme_path.is_file():
            uploadme_path.touch()
            self.logger.info("Backup marked for upload.")

    def _query_mysql(self, sql: str) -> Any:
        try:
            conn = pymysql.connect(
                read_default_file=self.defaults_cnf_file,
                host=self.host,
                port=self.port,
                cursorclass=pymysql.cursors.DictCursor,
            )
            with conn, conn.cursor() as cursor:
                cursor.execute(sql)
                return cursor.fetchone()
        except (OperationalError, InternalError) as err:
            msg = f'Error running query "{sql}": {err}'
            raise BackupError(msg) from err


def run_binlog_backup(server_data, command_queue):
    alias = server_data.get("ALIAS", server_data["HOST"])
    logging_dir = Path(server_data.get("LOGGING_DIR", DEFAULT_LOGGING_DIR))

    if server_data.get("DEBUG"):
        logging_lvl = logging.DEBUG
    else:
        logging_lvl = logging.INFO

    global LOGGER
    LOGGER = logging_setup(logging_dir, "binlog_puller_%s.log" % (alias,), logging_lvl)

    server_data["BINLOG_BACKUP_START"] = time.strftime(
        "%Y-%m-%d %H:%M:%S", time.gmtime()
    )

    # enable textfile collector metric
    enable_backup = BaseBackup(server_data, "B", LOGGER)
    enable_backup.textfile_collector_write_enable(alias, True, "backup")

    lockfile_name = "/tmp/.lock_binlog_puller_%s_%s" % (
        server_data["HOST"],
        server_data["PORT"],
    )

    lock_file = LockFile(lockfile_name, timeout=600)
    try:
        lock_file.get_lock()
    except LockInUse:
        return

    server_data["last_success"] = time.time()
    server_data["last_fail_msg"] = "no specific failure recorded"

    # Create backup dir
    if not os.path.isdir(get_backup_dir(server_data)):
        os.makedirs(get_backup_dir(server_data))

    if is_public_ip(server_data["HOST"]):
        LOGGER.info("Pulling from an external IP, enabling --compress")
        # Add --compress option
        if "BINLOG_EXTRA_ARGS" in server_data:
            if server_data["BINLOG_EXTRA_ARGS"].find("--compress") == -1:
                server_data["BINLOG_EXTRA_ARGS"] = " ".join(
                    [server_data["BINLOG_EXTRA_ARGS"], "--compress"]
                )
        else:
            server_data["BINLOG_EXTRA_ARGS"] = "--compress"

        # Check for SSL connection
        conn = MySQLdb.connect(
            host=server_data["HOST"],
            port=server_data["PORT"],
            read_default_file=server_data.get("DEFAULTS_FILE", DEFAULT_MYCNF),
            read_default_group="client",
        )
        cursor = conn.cursor()
        cursor.execute('SHOW STATUS like "Ssl_cipher"')
        ssl = cursor.fetchone()
        if (not ssl or ssl[1] == "") and not server_data.get(
            "BINLOG_INSECURE_CONNECTION"
        ):
            LOGGER.warning("""Insecure connection: client is not enabled for SSL while pulling from an external IP.
                               Configure SSL or enable BINLOG_INSECURE_CONNECTION in the config.
                               Exiting...""")
            lock_file.free_lock()
            return

    try:
        while True:
            exit_now, restart_now = run_binlog_process(
                server_data, lock_file, command_queue
            )

            if exit_now:
                break

            if not restart_now:
                print("Sleeping in restart_now")
                LOGGER.info("Sleeping in restart_now")
                time.sleep(MYSQLBINLOG_RESTART_DELAY)

    finally:
        lock_file.free_lock()


def run_binlog_process(server_data, lock_file, command_queue):
    cleanup_binlogs(server_data)
    backup_proc = start_mysqlbinlog(server_data)

    if backup_proc is None:
        send_notifications(2, server_data, "server does not have binary logs enabled")
        return False, False

    alias = server_data.get("ALIAS", server_data["HOST"])
    last_binlog = None
    last_binlog_size = 0
    last_binlog_write = time.time()
    last_upload_time = time.time()
    killed = False
    restart_now = False
    exit_now = False
    last_source_status = None

    if time.time() - server_data["last_success"] > 60 * 50:
        send_notifications(
            2,
            server_data,
            "binlog_puller.py has encountered problems: %s"
            % (server_data["last_fail_msg"],),
        )
        server_data["last_success"] = time.time()

    check_disk_space = server_data.get("CHECK_DISK_SPACE", True)
    threshold = server_data.get("BINLOG_DISK_FREE_PCT", 5)
    backup_dir = get_backup_dir(server_data)
    while backup_proc.poll() is None:  # i.e. process is running
        # Check for free disk space
        if check_disk_space:
            res, output = is_free_space(backup_dir, alias, False, threshold, LOGGER)
            if not res:
                # Not enough space, killing mysqlbinlog
                LOGGER.error("Killing backup process. %s", output)
                server_data["last_fail_msg"] = output
                backup_proc.kill()
                return False, False

        cur_last_binlog = get_last_binlog(server_data)
        if os.path.isfile(cur_last_binlog):
            cur_last_binlog_size = os.path.getsize(cur_last_binlog)
            if last_binlog:
                if (cur_last_binlog > last_binlog) or (
                    cur_last_binlog == last_binlog
                    and cur_last_binlog_size > last_binlog_size
                ):
                    last_binlog = cur_last_binlog
                    last_binlog_size = cur_last_binlog_size
                    last_binlog_write = time.time()
                    send_notifications(
                        0, server_data, "OK Last binlog: %s" % (last_binlog,)
                    )
                    server_data["last_success"] = time.time()
                else:
                    # If the logs on the source haven't moved, infer the
                    # mysqlbinlog process is still OK even though the local
                    # logs haven't grown
                    source_status = get_source_status(server_data)
                    if source_status is not None:
                        binlog_name = os.path.basename(cur_last_binlog)
                        if (
                            source_status[0] == binlog_name
                            and last_source_status == source_status
                        ):
                            last_binlog_write = time.time()
                            server_data["last_success"] = time.time()
                            send_notifications(
                                0,
                                server_data,
                                "OK Last binlog: %s; no recent source writes"
                                % (last_binlog,),
                            )
                        last_source_status = source_status

                # Manage upload
                if last_upload_time + server_data.get("UPLOAD_INTERVAL", 60 * 3) < time.time():
                    if server_data.get("UPLOAD"):
                        # enable textfile collector metric
                        enable_backup = BaseBackup(server_data, "B")
                        enable_backup.textfile_collector_write_enable(alias, True, "upload")
                        LOGGER.info("Binlog upload starting ...")
                        for upload_type in server_data.get("UPLOAD"):
                            if upload_type == "rsync":
                                LOGGER.info("Binlog upload rsync ...")
                                BinaryLogUpload(upload_type=upload_type,
                                                upload_provider=RsyncUploadProvider,
                                                settings=server_data,
                                                logger=LOGGER).run()
                            elif upload_type == "s3":
                                LOGGER.info("Binlog upload s3 ...")
                                BinaryLogUpload(upload_type=upload_type,
                                                upload_provider=S3UploadProvider,
                                                settings=server_data,
                                                logger=LOGGER).run()
                            elif upload_type == "gsutil":
                                LOGGER.info("Binlog upload gs ...")
                                BinaryLogUpload(upload_type=upload_type,
                                                upload_provider=GSUploadProvider,
                                                settings=server_data,
                                                logger=LOGGER).run()
                            else:
                                LOGGER.warning("Unsupported upload type: %r", upload_type)
                    last_upload_time = time.time()
            else:
                last_binlog = cur_last_binlog
                last_binlog_size = cur_last_binlog_size

        if (last_binlog_write + server_data["NOWRITE_TIMEOUT"]) < time.time():
            msg = (
                "Killing backup process. No logs have been written for %s seconds."
                % server_data["NOWRITE_TIMEOUT"]
            )
            LOGGER.error(msg)
            server_data["last_success"] = time.time()
            backup_proc.kill()
            killed = True
            send_notifications(
                0,
                server_data,
                "OK No logs have been written for %s seconds."
                % (server_data["NOWRITE_TIMEOUT"],),
            )
            break

        cleanup_binlogs(server_data)
        lock_file.update_lock()

        command = queue_get_maybe(command_queue, 30)
        if command is not None:
            if command == "exit":
                LOGGER.info("run_binlog_process received exit command")
                backup_proc.terminate()
                return True, False
            LOGGER.error("invalid command received: %r", command)

    ret = backup_proc.returncode
    LOGGER.debug("Mysqlbinlog ret <%s>", ret)

    if ret != 0 and not killed:
        stderr_lines = backup_proc.stderr.readlines()
        stderr_lines = [
            line.decode("utf-8") for line in stderr_lines
        ]  # Decode each line to a string
        err = "\n".join(stderr_lines)
        LOGGER.error(err)
        if err.find("binlog truncated in the middle of event") > 0:
            LOGGER.warning("Caught truncated binlog %s. Skipping it.", cur_last_binlog)
            server_data["TRUNCATED_BINLOG"] = True
            server_data["last_fail_msg"] = "binlog truncated in the middle of event"
            restart_now = True
        elif err.find("Access denied for user") > 0:
            server_data["last_fail_msg"] = "check database credentials: %s" % err
            send_notifications(
                2,
                server_data,
                "binlog_puller.py has encountered problems: %s"
                % (server_data["last_fail_msg"],),
            )
        else:
            server_data["last_fail_msg"] = "mysqlbinlog has exited: %s" % err

    return exit_now, restart_now


def cleanup_binlogs(server_data):
    no_compress = server_data.get("NO_COMPRESS", 0)
    remove_partial_binlogs(server_data)
    purge_old_gzip_binlogs(server_data)
    if no_compress == 0:
        compress_complete_binlogs(server_data)


def compress_complete_binlogs(server_data):
    current_binlogs = get_file_list(
        get_backup_dir(server_data), server_data["BINLOG_PREFIX"], sort_by="binlog_id"
    )
    LOGGER.debug("current_binlogs 1: <%r>", current_binlogs)
    current_binlogs = current_binlogs[:-2]
    LOGGER.debug("current_binlogs 2: <%r>", current_binlogs)
    for binlog in current_binlogs:
        try:
            if binlog["ext"] == "":
                compress_file(binlog["path"], server_data)
        except Exception:
            pass


def purge_old_gzip_binlogs(server_data):
    no_compress = server_data.get("NO_COMPRESS", 0)
    dir_list = get_file_list(
        get_backup_dir(server_data),
        server_data["BINLOG_PREFIX"],
        False if no_compress else "gz",
    )
    mtime_dir_list = [(os.path.getmtime(f["path"]), f["path"]) for f in dir_list]
    ptime = time.time() - 86400 * server_data["BINLOG_PURGE_DAYS"]
    purge_file_list = [f[1] for f in mtime_dir_list if f[0] <= ptime]

    failed_cnt = 0
    for fname in purge_file_list:
        try:
            purge_file(fname)
        except Exception:
            failed_cnt += 1
    if failed_cnt:
        msg = "Failed to purge %d file(s)" % failed_cnt
        LOGGER.error(msg)


def remove_partial_binlogs(server_data):
    partial_list = get_file_list(
        get_backup_dir(server_data), server_data["BINLOG_PREFIX"], "partial"
    )
    msg = "partial_list: <%s>" % repr(partial_list)
    LOGGER.debug(msg)
    for fname in partial_list:
        # look for new download of this binlog and verify that it is at least
        # as far at the partial before removing
        # strip off the '.<EPOCH>.partial' suffix
        base_fname = fname["path"].replace(fname["ext"], "")
        if os.path.isfile(base_fname):
            if os.path.getsize(base_fname) >= os.path.getsize(fname["path"]):
                purge_file(fname["path"])


def start_mysqlbinlog(server_data):
    try:
        last_binlog = get_last_binlog(server_data)
    except MySQLdb.OperationalError as e:
        if e.args[0] == 1381:
            LOGGER.exception("Server does not have binlogs enabled.")
            return None
        raise

    if os.path.isfile(last_binlog):
        os.rename(last_binlog, "%s.%s.partial" % (last_binlog, time.strftime("%s")))

    default_args = [
        "--raw",
        "--read-from-remote-server",
        "--stop-never",
        "--verify-binlog-checksum",
        "--host=%s" % (server_data["HOST"],),
    ]

    cmd = [server_data.get("BINLOG_CMD", MYSQLBINLOG_CMD)]

    if "DEFAULTS_FILE" in server_data:
        cmd.append("--defaults-file=%s" % (server_data["DEFAULTS_FILE"],))
    if "BINLOG_EXTRA_ARGS" in server_data:
        cmd.extend(server_data["BINLOG_EXTRA_ARGS"].split(" "))
    cmd.extend(default_args)
    if "PORT" in server_data:
        cmd.append("--port=%s" % (server_data["PORT"],))
    if "BINLOG_SERVER_ID" in server_data:
        cmd.append(
            "--stop-never-slave-server-id=%s" % (server_data["BINLOG_SERVER_ID"],) # Still present in mysqlbinlog for 8.4
        )
    else:
        cmd.append(
            "--stop-never-slave-server-id=%s"
            % ((2**16 - int(uuid.getnode() % (2**14))),)
        )
    if last_binlog:
        cmd.append(os.path.basename(last_binlog))

    LOGGER.info("Running <%s>", " ".join(cmd))
    proc = subprocess.Popen(
        cmd,
        cwd=get_backup_dir(server_data),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return proc


def get_backup_dir(server_data):
    return os.path.join(
        server_data["BACKUP_DIR"],
        "binlogs",
        server_data.get("ALIAS", server_data["HOST"]),
    )


def get_last_binlog(server_data):
    current_binlogs = get_file_list(
        get_backup_dir(server_data), server_data["BINLOG_PREFIX"], sort_by="binlog_id"
    )
    last_binlog = ""

    if len(current_binlogs) > 0:
        last_binlog_meta = current_binlogs[-1]
        last_binlog = last_binlog_meta["path"].replace(last_binlog_meta["ext"], "")
    else:
        # Pull from server
        conn = MySQLdb.connect(
            host=server_data["HOST"],
            port=server_data["PORT"],
            read_default_file=server_data.get("DEFAULTS_FILE", DEFAULT_MYCNF),
            read_default_group="client",
        )
        cursor = conn.cursor(MySQLdb.cursors.DictCursor)
        cursor.execute("SHOW BINARY LOGS")
        rows = cursor.fetchall()
        for row in rows:
            if row["File_size"] > 0:
                last_binlog = row["Log_name"]
                break
    if len(last_binlog) and server_data.get("TRUNCATED_BINLOG"):
        file_parts = last_binlog.split(".")
        last_binlog = "{0}.{1:d}".format(
            "".join(file_parts[:-1]), int("".join(file_parts[-1:])) + 1
        )
        server_data["TRUNCATED_BINLOG"] = False
    return last_binlog


def get_file_list(dname, binlog_prefix="mysql-bin", filter=None, sort_by=None):
    file_regex = (
        r"^(?P<prefix>%s\.)(?P<binlog_id>[0-9]{6,})(?P<ext>(\.(gz|[0-9]{10,}\.partial))?)$"
        % binlog_prefix
    )
    fname_re = re.compile(file_regex)
    dir_list = []
    for f in os.listdir(dname):
        fname_match = fname_re.match(f)
        fname_path = os.path.join(dname, f)
        if fname_match and os.path.isfile(fname_path):
            fname_meta = fname_match.groupdict()
            if (
                (filter == "gz" and fname_meta["ext"] == ".gz")
                or (filter == "partial" and fname_meta["ext"] not in [".gz", ""])
                or not filter
            ):
                dir_list += [
                    {
                        "path": fname_path,
                        "binlog_id": fname_meta["binlog_id"],
                        "ext": fname_meta["ext"],
                    }
                ]
    if sort_by is not None:
        dir_list = sorted(dir_list, key=lambda x: x[sort_by])
    return dir_list


def purge_file(fname):
    os.unlink(fname)
    msg = "<%s> purged." % fname
    LOGGER.info(msg)


def compress_file(fname, server_data):
    if "BINLOG_COMPRESS_CMD" in server_data:
        cmd = server_data["BINLOG_COMPRESS_CMD"].split(" ") + [fname]
        LOGGER.debug("compress command = %s", cmd)
    else:
        cmd = [
            "/bin/gzip",
            "-q",
            "--suffix=.msp",
            fname,
            "&&",
            "mv",
            f"{fname}.msp",
            f"{fname}.gz",
        ]

    proc = subprocess.Popen(" ".join(cmd), shell=True)
    proc_ret = proc.wait()
    if proc_ret == 0:
        msg = "<%s> compressed." % fname
        LOGGER.info(msg)
    else:
        msg = "<%s> compression failed." % fname
        LOGGER.error(msg)
        raise Exception(msg)


def send_notifications(status_int, server_data, msg):
