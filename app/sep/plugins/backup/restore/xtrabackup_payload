    def signal_mysqld(self, action):  # pylint: disable=too-many-statements,too-many-branches
        """Send signals to mysqld"""
        self.logger.debug('Requesting MySQL service to %s', action)
        if self.custom_mysql_init_command:
            mysqld_cmd = []
            mysqld_cmd.extend(self.custom_mysql_init_command.split(' '))
            mysqld_cmd.append(action)
            if '/usr/bin/systemctl' in mysqld_cmd:
                mysqld_cmd.append('mysql')
            self.logger.info('Running: %s', ' '.join(mysqld_cmd))
            proc = subprocess.Popen(mysqld_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            proc.wait()
        else:
            init_commands = ['/usr/bin/systemctl',
                             '/sbin/service mysql',
                             '/usr/sbin/service mysql',
                             '/etc/init.d/mysql'
                            ]
            for init_cmd in init_commands:
                mysqld_cmd = []
                mysqld_cmd.extend(init_cmd.split(' '))
                mysqld_cmd.append(action)
                if '/usr/bin/systemctl' in mysqld_cmd:
                    mysqld_cmd.append('mysql')
                self.logger.info('Trying to run: %s', ' '.join(mysqld_cmd))
                try:
                    proc = subprocess.Popen(mysqld_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                    proc.wait()
                    if 'could not be found' in proc.stderr:
                        raise UserWarning('"could not be found" message was detected')
                except Exception:  # pylint: disable=broad-except
                    continue
                self.custom_mysql_init_command = init_cmd
                break

        if not self.custom_mysql_init_command:
            msg = '%s mysqld failed. Not init command found' % (action)
            raise BackupError(msg)

        if action != 'status' and proc.returncode != 0:
            msg = '%s mysqld failed.' % (action)
            raise BackupError(msg)
        if action == 'start':
            attempts = 0
            while True:
                try:
                    self._query_mysql('select 1')
                    self.logger.debug('MySQL is now accepting connections')
                    break
                except (BackupError, OperationalError):
                    self.logger.debug('Failed to connect after starting MySQL')
                    if attempts > MAX_ATTEMPTS:
                        raise BackupError('Failed to start MySQL in {total_attempts}'.format(total_attempts=attempts))
                    attempts += 1
                    time.sleep(SLEEP_INTERVAL)
        elif action == 'stop':
            attempts = 0
            while True:
                try:
                    self._query_mysql('select 1')
                    self.logger.debug('Connection are still accepted after stopping MySQL')
                    attempts += 1
                    if attempts > MAX_ATTEMPTS:
                        raise BackupError('Failed to stop MySQL in {total_attempts}'.format(total_attempts=attempts))
                    time.sleep(SLEEP_INTERVAL)
                except (BackupError, OperationalError):
                    self.logger.debug('MySQL is no longer accepting connections')
                    break
        return proc.returncode

    def decrypt_decompress(self, path):

        enc = self.is_encrypted(path)
        if enc == "gpg":
            self.decrypt_gpg(path)
        elif enc == "aes":
            self.decrypt_aes(path)

        comp = self.is_compressed(path)
        if comp == "qp":
            self.decompress_backup(path)
        elif comp == "zst":
            self.decompress_backup_zst(path)


    def is_compressed(self, path):
        """Rerturn compress extension or False is not."""

        for _, _, files in os.walk(path):
            for fname in files:
                if fname.endswith(".qp"):
                    return "qp"
                if fname.endswith(".zst"):
                    return "zst"

        return False

    def decrypt_aes(self, path):

        cmd = "find %s -name '*.xbcrypt' | rev | cut -f 2- -d '.' | rev | xargs -P %s -I {} sh -c '/usr/bin/xbcrypt -d --encrypt-key-file=%s --encrypt-algo=AES256 --input={}.xbcrypt --output={} && rm {}.xbcrypt'" % (path, self.xb_parallel, self.xtrabackup_aes256_keyfile)
        self.logger.info('Running: %s', cmd)
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=True)
        proc.communicate()
        if proc.returncode != 0:
            msg = "Decryption Failed."
            raise BackupError(msg)
        else:
            self.logger.info('Decryption Completed')

    def decompress_backup(self, path):
        """decompress qp files in path"""

        cmd = "find %s -name '*.qp' | rev | cut -f 2- -d '.' | rev | xargs -P %s -I {} sh -c '/usr/bin/qpress -d {}.qp `dirname {}.qp` && rm {}.qp'" % (path, self.xb_parallel)
        self.logger.info('Running: %s', cmd)
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=True)
        proc.communicate()
        if proc.returncode != 0:
            msg = "Decompression Failed."
            raise BackupError(msg)
        else:
            self.logger.info('OK Decompressing Completed')

    def decompress_backup_zst(self, path):
        """decompress zst files in path"""

        cmd = f"{XTRABACKUP_BIN_REAL} --decompress --parallel={self.xb_parallel} --target-dir={path}"
        self.logger.info('Running: %s', cmd)
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=True)
        proc.communicate()
        if proc.returncode != 0:
            msg = "Decompression Failed."
            raise BackupError(msg)
        else:
            self.logger.info('OK Decompressing Completed')

    def prepare_backup(self):
        """Prepare backup by applying logs."""
        incremental_dir = False

        if self.xtrabackup_bin_cmd == 'xtrabackup':
            xtrabackup_cmd = [XTRABACKUP_BIN_REAL, '--prepare']
            # Checking keyring config
            cnf_keyring = self._check_keyring_file()
            # If there is a keyring option in config and
            # not provided any in the cli it will use it from config
            # otherwise it will use it from command line
            if self.keyring_file_data:
                xtrabackup_cmd.append('--keyring-file-data={}'.format(self.keyring_file_data))
            elif cnf_keyring:
                xtrabackup_cmd.append('--keyring-file-data={}'.format(cnf_keyring))

        elif self.xtrabackup_bin_cmd == 'mariadb-backup':
            xtrabackup_cmd = [XTRABACKUP_BIN_MARIADB, '--prepare']
        elif self.xtrabackup_bin_cmd == 'innobackupex':
            xtrabackup_cmd = [XTRABACKUP_BIN, '--apply-log']
        else:
            msg = "Invalid XTRABACKUP_BIN_CMD or --xtrabackup-bin-cmd specified"
            raise BackupError(msg)

        if self.xtrabackup_restore_args:
            xtrabackup_cmd.extend(self.xtrabackup_restore_args.split(' '))

        xtrabackup_cmd.append('--use-memory=%s' % (self.prepare_memory,))
        xtrabackup_cmd.append('--target-dir={0}'.format(self.datadir)
                              if self.xtrabackup_bin_cmd in ['mariadb-backup', 'xtrabackup']
                              else self.datadir)

        if not self.is_last_restore:
            if self.xtrabackup_bin_cmd == 'xtrabackup':
                xtrabackup_cmd.append('--apply-log-only')
            elif self.xtrabackup_bin_cmd == 'innobackupex':
                xtrabackup_cmd.append('--redo-only')

        if self.backup_is_incremental:
            self.logger.info('Applying incremental to the base...')
            xtrabackup_cmd.append('--incremental-dir=%s' % (self.incremental_dest_path,))
        else:
            self.logger.info('Preparing base...')

        self.logger.info('Running: %s', ' '.join(xtrabackup_cmd))
        xb_log_stream = open(self.xb_log_file, 'a')
        proc = subprocess.Popen(xtrabackup_cmd, stdout=xb_log_stream, stderr=xb_log_stream)
        proc.communicate()
        if proc.returncode != 0:
            xb_log_stream = open(self.xb_log_file, 'r')
            err = xb_log_stream.readlines()[-1]
            msg = 'Xtrabackup prepare failed: %s For more details, see %s' % (err, self.xb_log_file)
            raise BackupError(msg)

        self.logger.info('OK Preparing complete.')

    def _check_keyring_file(self):
        # Get config files from restored datadir
        self.logger.info("Looking for Keyring File")
        for cnffile in os.listdir(self.datadir):
            if cnffile != 'backup-my.cnf' and cnffile.endswith(".cnf"):
                src = os.path.join(self.datadir, cnffile)
                try:
                    searchfile = open(src, "r")
                    for line in searchfile:
                        key_location = re.search('^(?!#)keyring[-_]file[-_]data *= *([^ ]+)', line)
                        if key_location:
                            self.logger.info(key_location.group(0))
                            self.logger.info("InnoDB tablespace encrytpion is enabled.")
                            return key_location.group(0)
                    searchfile.close()
                except IOError:
                    self.logger.info("my.cnf file does not appear to exist.")


    @staticmethod
    def _edit_copy_my_cnf(src, dst, new_server_id):
        """Edit cnf files and restore"""

        # Open files
        src_file = open(src)
        dst_file = open(dst, 'w')

        for line in src_file:
            # server-id
            line = re.sub(r'^([\s]*server[_-]id[\s]*=[\s]*)(\d*)', r'\1 %s' % new_server_id, line, flags=re.M)
            dst_file.write(line)

        src_file.close()
        dst_file.close()

    def _get_new_server_id(self):
        """ try to get the server ip"""
        active_ids = []

        # We check for server_id only if we know the master ip
        if self.master_ip:
            # get master server_id
            try:
                result = self._query_mysql('SELECT @@server_id', host=self.master_ip, port=self.master_port)
            except BackupError:
                pass

            if result and result['@@server_id']:
                active_ids.append(int(result['@@server_id']))

            # get slaves id
            try:
                result = self._query_mysql('SHOW SLAVE HOSTS', fetchall=True, host=self.master_ip, port=self.master_port)
            except BackupError:
                pass

            if result:
                for row in result:
                    active_ids.append(int(row['Server_id']))

        new_server_id = random.randint(1, 4294967295)
        while new_server_id in active_ids:
            new_server_id = random.randint(1, 4294967295)

        return new_server_id

    def _get_own_ssh_remote_addr(self, host):
        """Get own remote_addr when connecting to the host via SSH."""
        cmd = 'ssh -tt -i /home/%s/.ssh/id_rsa %s@%s -p %s env|grep SSH_CLIENT|cut -d= -f2|cut -d" " -f1' % (self.ssh_user, self.ssh_user, host, self.ssh_port)
        proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, err = proc.communicate()
        if proc.returncode != 0:
            self.logger.info('Running: %s', cmd)
            msg = 'Unable to determine own SSH remote address: %s' % (err,)
            raise BackupError(msg)

        return out.decode().rstrip()

    def _restore_cnf_files(self):
        """Copy back all my.cnf files"""

        # Get config files from restored datadir
        self.logger.info("Restoring my.cnf files")
        new_server_id = self._get_new_server_id()
        self.logger.info("New server-id will be: %s", new_server_id)
        for ffile in os.listdir(self.datadir):
            if ffile != 'backup-my.cnf' and ffile.endswith(".cnf"):
                src = os.path.join(self.datadir, ffile)
                dst = ffile.replace("_", "/").strip()
                # check if dest dir exist, else create it
                try:
                    if not os.path.isdir(os.path.dirname(dst)):
                        os.mkdir(os.path.dirname(dst))
                except (OSError) as err:
                    raise BackupError(str(err))
                self._edit_copy_my_cnf(src, dst, new_server_id)

class MyConfigParser(configparser.ConfigParser):

    def read(self, filename):
        try:
            text = open(filename).read()
        except IOError:
            pass
        else:
            file = StringIO.StringIO("[dummy]\n" + text)
            self.readfp(file, filename)

