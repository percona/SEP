                               )
        else:
            self.local_copy(os.path.join(self.backup_source, ""),
                            "/tmp/pxb_info/",
                            info_only=True
                           )

        self.decrypt_decompress("/tmp/pxb_info/")

        pxb_info = MyConfigParser()
        pxb_info.read("/tmp/pxb_info/xtrabackup_info")
