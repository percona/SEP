        self.hostname = str(server_data.get('HOSTNAME', socket.gethostname().split('.')[0]))
        self.slave_from_master = server_data.get('SLAVE_FROM_MASTER', False)
        self.continue_replication = server_data.get('CONTINUE_REPLICATION', False)
        self.run_checksum = server_data.get('RUN_CHECKSUM', False)
        self.wait_for_catchup = server_data.get('WAIT_FOR_CATCHUP', False)
