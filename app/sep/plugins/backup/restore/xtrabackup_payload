def logging_setup(logging_dir, log_name, level=LOGGING_LEVEL):
    """ Logger setup """

    # Tilde expand logging path if needed and resolve its real path
    real_logging_dir = os.path.realpath(os.path.expanduser(logging_dir))

    # Check and create logging dir
    if not os.path.isdir(real_logging_dir):
        os.makedirs(real_logging_dir)
    elif not os.access(real_logging_dir, os.W_OK):
        print('Logging directory %s is not writeable.' % logging_dir)
        sys.exit(4)

    # Remove existing loggers to re-define a new one
    for handler in logging.root.handlers[:]:
        logging.root.removeHandler(handler)

    name = log_name.replace(".log", "")
    logger = logging.getLogger(name)
    log_file = os.path.join(real_logging_dir, log_name)

    try:
        log_handlers = [x.stream.name for x in logger.handlers if hasattr(x, 'stream')]
    except AttributeError:
        for _handler in logger.handlers:
            logger.removeHandler(_handler)
        log_handlers = []

    if log_file not in log_handlers:
        handler = logging.FileHandler(log_file)
        formatter = logging.Formatter(LOGGING_FORMAT)
        handler.setFormatter(formatter)
        logger.addHandler(handler)

    if not any(isinstance(h, logging.StreamHandler) and h.stream == sys.stdout for h in logger.handlers):
        stream_handler = logging.StreamHandler(sys.stdout)
        stream_formatter = logging.Formatter(LOGGING_FORMAT)
        stream_handler.setFormatter(stream_formatter)
        logger.addHandler(stream_handler)

    logger.setLevel(level)
    logging_set_host(None, name)
    return logger


def format_seconds_to_hhmmss(seconds):
    """Formats seconds in HH:MM:SS format
    """
    hours = seconds // (60 * 60)
    seconds %= (60 * 60)
    minutes = seconds // 60
    seconds %= 60
    return "%02i:%02i:%02i" % (hours, minutes, seconds)

def logging_set_host(alias, log_name):
    """Prepend server alias to the logging messages until unset."""

    class ContextFilter(logging.Filter):  # pylint: disable=too-few-public-methods

        """Add server alias to the logging message format."""

        def filter(self, record):
            record.alias = '[%s] ' % (alias,) if alias else ''
            return True

    log_name = log_name.replace(".log", "")
    logging.getLogger(log_name).addFilter(ContextFilter())


def get_dir_size(start_path, unit='text'):
    """Return dir size in specified unit for the given path.

    Unit:  text (default), bytes, mb, gb
    """
    cmd = [DU_BIN, '-sB1', start_path]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out, err = proc.communicate()
    if proc.returncode != 0:
        logging.warning('Problem running %s: %s', ' '.join(cmd), err)
        return 0

    try:
        total_size, _ = out.strip().split()
        total_size = int(total_size)
    except Exception:
        logging.warning('Invalid du output: %s', out, exc_info=True)
        return 0

    if unit == 'bytes':
        return total_size
    mbyte = total_size / 1024 / 1024
    if unit == 'mb':
        return mbyte
    if unit == 'gb':
        return mbyte / 1024

    # unit 'text'
    if mbyte < 1024:
        out = "%d MB" % (mbyte,)
    else:
        out = "%d GB" % (mbyte / 1024,)
    return out

def _setup_cfgs():
    global cfg  # pylint: disable=global-statement

    if cfg is not None:
        return
    try:
        try:
            cfg_f = open(CFG_PATH, 'r')
            cfg = yaml.safe_load(cfg_f)

        except Exception:
            # Defaults
            cfg = {'encryption recipient': 'CHANGEME_GPG', #OSS
                   'encryption home dir': '~/.gnupg',
                   'max encryption processes': 5,
                   'encryption nice': False,
                   'gpg bin': '/usr/bin/gpg',
                   'encryption file filter': ''}

        try:
            # In all cases exit code is 2 so we need to catch it
            if cfg.get('use_pinentry') in [None, True, 1]:
                subprocess.check_output([cfg['gpg bin'], '--pinentry-mode'], stderr=subprocess.STDOUT)
        except subprocess.CalledProcessError as err:
            cfg['use_pinentry'] = 'missing' in err.output.decode()

    finally:
        try:
            cfg_f.close()
        except:
            pass

def _get_passphrase():
    try:
        import getpass  # pylint: disable=import-outside-toplevel
        _pass = getpass.getpass('Passphrase: ')
    except ImportError:
        try:
            _pass = raw_input('Passphrase: ')
        except NameError:
            _pass = input('Passphrase: ')
    return _pass
def _all_files_in_dir(root_dir, regex):
    """
    Generator that provides all of the files that exist under the root_dir, at
    any level of depth.

    """
    file_re = None
    file_re_opt = None
    if regex:
        file_re_opt = re.compile(regex)
    if cfg['encryption file filter']:
        file_re = re.compile(cfg['encryption file filter'])
    for root, _, files in os.walk(root_dir):
        for file_name in files:
            if file_re is not None and file_re.match(file_name):
                continue
            if file_re_opt is None or file_re_opt.match(file_name):
                yield os.path.join(root, file_name)

def _start_gpg_subp(filename, recipient='', nice=False, decrypt=False):
    """
    Start and return a gpg encryption process. If nice is true, the subprocess
    will start with the nice command.

    """
    if decrypt:
        output_filename = filename.replace('.gpg', '', 1)
        stdin = subprocess.PIPE
        if cfg['use_pinentry']:
            cmd = [cfg['gpg bin'],
                   '--batch',
                   '--pinentry-mode=loopback',
                   '--decrypt',
                   '--passphrase-fd=0',
                   '--quiet',
                   '--output=%s' % (output_filename,),
                   filename]
        else:
            cmd = [cfg['gpg bin'],
                   '--batch',
                   '--decrypt',
                   '--passphrase-fd=0',
                   '--quiet',
                   '--output=%s' % (output_filename,),
                   filename]
    else:
        output_filename = filename + '.gpg'
        stdin = None
        cmd = [cfg['gpg bin'],
               '--batch',
               '--yes',
               '--encrypt',
               '--always-trust',
               '--quiet',
               '--recipient=%s' % (recipient,),
               '--output=%s' % (output_filename,),
               filename]
    if nice:
        cmd.insert(0, 'nice')
    if cfg['encryption home dir']:
        cmd.insert(-1, '--homedir=%s' % (cfg['encryption home dir'],))
    p = subprocess.Popen(cmd, stdin=stdin)
    return p

def _prune_finished_procs(proc_dict, max_live_proc=0):
    """
    Goes through the dictionary of active processes and looks for those that
    have been completed. When completed, the proc is removed from the
    dictionary, and the file path (key) is unlinked.

    Returns True if there were no errors, False otherwise

    """
    ok = True
    while proc_dict:
        for fp, proc in list(proc_dict.items()):
            rc = proc.poll()
            if rc is None:
                continue
            if rc == 0:
                try:
                    os.unlink(fp)
                except OSError as e:
                    logging.warning("OS error(%s): %s", e.errno, e.strerror)
            else:
                ok = False
                logging.error("%r did not encrypt correctly.", fp)
                sys.exit(1)
            del proc_dict[fp]
        if len(proc_dict) < max_live_proc:
            break
        time.sleep(0.1)
    return ok


def decrypt_directory_files(encr_dir, nice=None, max_proc=None, password_file=None, regex=None):
    """
    Decrypts every encrypted file under encr_dir, at any depth. The GPG process
    will be niced if nice is true. max_prox limits the number of concurrent
    decryption processes that can run at any given time.

    Files that are decrypted are then unlinked from the file system.

    Returns True if there were no errors, False otherwise

    """
    _setup_cfgs()
    enc_procs = {}

    # Because we import this module in other scripts, we need to set the
    # nice, and max_proc to the values in the config file if they are
    # not passed in as arguments.

    if nice is None:
        nice = cfg.get('encryption nice')
    if max_proc is None:
        max_proc = cfg.get('max encryption processes')

    if password_file:
        with open(password_file) as filen:
            passphrase = filen.readline().split('\n')[0]
    else:
        passphrase = _get_passphrase()
    all_ok = True
    for file_path in _all_files_in_dir(encr_dir, regex):
        if not file_path.endswith('.gpg'):
            continue
        p = _start_gpg_subp(file_path, nice=nice, decrypt=True)
        p.stdin.write(passphrase.encode())
        p.stdin.close()
        enc_procs[file_path] = p
        ok = _prune_finished_procs(enc_procs, max_proc)
        all_ok = all_ok and ok
    ok = _prune_finished_procs(enc_procs)
    all_ok = all_ok and ok
    return all_ok


def decrypt_dir(path, password_file=None, logger=None):
    """Encrypt directory using GPG."""

    if logger:
        logger.info('Decrypting backup...')
        logger.info('Running on: %s', path)
    if password_file:
        if not decrypt_directory_files(encr_dir=path, password_file=password_file):
            msg = 'Decryption failed.'
            raise BackupError(msg)
    else:
        if not decrypt_directory_files(encr_dir=path):
            msg = 'Decryption failed.'
            raise BackupError(msg)

    if logger:
        logger.info('OK Decryption complete.')


def parse_weekday_from_str(date_str):
    """Get weekday from datetime string"""
    weekday = None
    if re.search(BACKUP_DIR_REGEX['X'], date_str):
        weekday = datetime.datetime.strptime(date_str[:10], '%Y-%m-%d').isoweekday()
    elif re.search(BACKUP_DIR_REGEX['M'], date_str):
        weekday = datetime.datetime.strptime(date_str, '%Y%m%d').isoweekday()

    return weekday

def rchown(dir_path=None, uid=-1, gid=-1):
    """recursive chown"""

    if dir_path == '/':
        return False

    os.chown(dir_path, uid, gid)
    for root, dirs, files in os.walk(dir_path):
        for dname in dirs:
            os.chown(os.path.join(root, dname), uid, gid)
        for fname in files:
            os.chown(os.path.join(root, fname), uid, gid)

    return True

class LocalConfig:
    """Local configuration class for backup/restore processes."""

    default_nowrite_timeout = 1800  # 30 minutes
    default_purge_days = 30

    def __init__(self, cfg_path: Path) -> None:
        """Initialize LocalConfig and populate configuration from the specified YAML file.

        :param cfg_path: Path to the configuration file.
        """
        self.server_data_list: list[dict[str, Any]] = []
        self.base: dict[str, Any] = {}
        self.cfg_path = Path(cfg_path)
        self.populated = False
        self.raw_cfg_data: dict[str, Any] = {}
        self._populate_cfg()

    def _populate_cfg(self) -> None:
        """Populate the configuration from the YAML file."""
        try:
            with self.cfg_path.open("r") as cfg_file:
                cfg_file_contents = cfg_file.read()
                data = yaml.safe_load(cfg_file_contents)
        except Exception:
            logging.exception("Could not read config file %r", self.cfg_path)
            return

        self.raw_cfg_data = data

        default_server = {
            "PORT": 3306,
            "NOWRITE_TIMEOUT": LocalConfig.default_nowrite_timeout,
            "BINLOG_PURGE_DAYS": LocalConfig.default_purge_days,
        }
        default_server.update(data["ALL_SERVERS"])
        self.base = default_server.copy()

        for server in data["SERVER_LIST"]:
            if (
                "HOST" in server
                and isinstance(server["HOST"], str)
                and server["HOST"].count(":") > 1
            ):
                logging.warning("Unsupported host format %s", server["HOST"])
                continue
            server_data = default_server.copy()
            server_data.update(server)
            self.server_data_list.append(server_data)
        self.populated = True

class LockInUse(Exception):
    """Error for active locks"""


class LockFile:
    """
    Lockfile management

     Be very careful about changing the format of the lock file.
     Adding values should be fine but, be careful in accessing them.
     Make sure that the value not being there will not crash the program.
     Removing values is not a good idea but, if it has to
     be done you should remove them in an iterative process.  ie.:
     Week #1 stop the default lock file from writing them and
     make sure the code functions with or without the value
     Week #3 remove references to the old value and
     make sure that all processes have been restarted
    """

    def __init__(self, lock_fname, timeout=300):
        self.lock_fname = lock_fname
        self.timeout = timeout
        self.lock_time = time.time()
        self.cur_pid = os.getpid()
        self.cur_all_cpu_time = self._get_all_cpu_time(self.cur_pid)
        self.lock_file_data = None

    def get_lock(self):
        """
        Acquire a lock

        :raises: LockInUse when a lock is already active
        """
        if not self._is_lock_free():
            msg = 'Could not acquire lock file'
            logging.debug(msg)
            raise LockInUse(msg)
        self._write_lock_file()

    def get_lock_or_exit(self):
        """
        Acquire a lock, or exit
        """
        try:
            self.get_lock()
        except LockInUse:
            sys.exit(-1)

    def free_lock(self):
        """
        Release a lock
        """
        # TODO: check what happens if this is called when the lock is not held
        if os.path.isfile(self.lock_fname):
            os.unlink(self.lock_fname)

    def update_lock(self):
        """
        Update the lock metadata
        """
        self.lock_time = time.time()
        self._write_lock_file()

    def _is_lock_free(self):
        """
        Check if a lock is free

        :return: lock status
        :rtype: bool
        """
        lock_free = False
        if not os.path.isfile(self.lock_fname):
            lock_free = True
        elif not self._is_process_running():
            self.free_lock()
            lock_free = True
        return lock_free

    def _is_process_running(self):
        """
        Check for a lock's owner process

        :return: is the lock's owner still running
        :rtype: bool
        """
        proc_running = False
        self._read_lock_file()
        self.lock_time = time.time()
        if os.path.isdir('/proc/%d' % self.lock_file_data['PID']):
            pid_cmdline = self._get_process_cmdline(self.lock_file_data['PID'])
            lockfile_cmdline = self.lock_file_data.get('CMD_LINE').encode('utf-8')
            if lockfile_cmdline is not None and lockfile_cmdline != pid_cmdline:
                # The pid is being re-used by another process.
                proc_running = False
            elif (self.lock_file_data['UPDATE_TIME'] + self.timeout) > self.lock_time:
                proc_running = True
            else:
                old_cpu_time = self.lock_file_data['ALL_CPU_TIME']
                cur_cpu_time = self._get_all_cpu_time(self.lock_file_data['PID'])
                if len(old_cpu_time) != len(cur_cpu_time):
                    proc_running = True
                else:
                    old_pids = list(old_cpu_time.keys())
                    cur_pids = list(cur_cpu_time.keys())
                    old_pids.sort()
                    cur_pids.sort()
                    for i, j in enumerate(old_pids):
                        if j != cur_pids[i]:
                            proc_running = True
                            break
                        if old_cpu_time[j] < cur_cpu_time[cur_pids[i]]:
                            proc_running = True
                            break
                    if proc_running:
                        # Update the current CPU TIME in the lock file
                        self._update_cpu_time()
                if not proc_running:
                    # kill the old process
                    msg = 'Killing hung process %s' % self.lock_file_data['PID']
                    logging.error(msg)
                    os.kill(int(self.lock_file_data['PID']), signal.SIGKILL)
                    for cpid in self._get_child_pids(self.lock_file_data['PID']):
                        msg = 'Killing hung child process %s' % cpid
                        logging.error(msg)
                        os.kill(int(cpid), signal.SIGKILL)
        return proc_running

    def _read_lock_file(self):
        """
        Read a lockfile

        :raises: Exception on error
        """
        try:
            with open(self.lock_fname, 'rb') as lock_fstream:
                self.lock_file_data = json.loads(lock_fstream.read().decode())
        except Exception:
            self.free_lock()
            raise

    def _update_cpu_time(self):
        """
        Update the CPU time for the lock
        """
        with open(self.lock_fname, 'rb') as lock_fstream:
            existing_lock_file_data = json.loads(lock_fstream.read().decode())
        existing_lock_file_data['ALL_CPU_TIME'] = self._get_all_cpu_time(existing_lock_file_data['PID']) # pylint: disable=line-too-long
        existing_lock_file_data['UPDATE_TIME'] = time.time()
        tmp_fname = self.lock_fname + '.update_tmp'
        with open(tmp_fname, 'wb') as tmp_fstream:
            tmp_fstream.write(json.dumps(existing_lock_file_data).encode('utf-8'))
        os.rename(tmp_fname, self.lock_fname)

    def _write_lock_file(self):
        """
        Write out the lockfile metadata
        """
        self.lock_time = time.time()
        self.cur_all_cpu_time = self._get_all_cpu_time(self.cur_pid)
        lock_data = {
            'CMD': ' '.join(sys.argv),
            'PID': self.cur_pid,
            'UPDATE_TIME': self.lock_time,
            'ALL_CPU_TIME': self.cur_all_cpu_time,
            'CMD_LINE': self._get_process_cmdline(self.cur_pid).decode()
        }
        tmp_fname = self.lock_fname + '.tmp'
        with open(tmp_fname, 'wb') as tmp_fstream:
            tmp_fstream.write(json.dumps(lock_data).encode('utf-8'))
        os.rename(tmp_fname, self.lock_fname)

    def _get_all_cpu_time(self, pid):
        """
        Check the total CPU time

        :param pid: process ID
        :type pid: int
        :return: mapping of processes and CPU time
        :rtype: dict
        """
        ret = {str(pid):self._get_process_cpu_time(pid)}
        for cpid in self._get_child_pids(pid):
            ret.update(self._get_all_cpu_time(cpid))
        return ret

    @staticmethod
    def _get_process_cpu_time(pid):
        """
        Get the CPU time for a process

        :param pid: process ID
        :type pid: int
        :return: process CPU time
        :rtype: int
        """
        with open('/proc/%d/stat' % pid, 'rb') as stat_fstream:
            stat_data = stat_fstream.read()
        stat_list = stat_data.split()
        return int(stat_list[PROC_STAT_UTIME_IDX]) + int(stat_list[PROC_STAT_STIME_IDX])

    @staticmethod
    def _get_process_cmdline(pid):
        """
        Return the value stored in /proc/<pid>/cmdline or None if there is an error
        """
        cmdline_fp = '/proc/{0:d}/cmdline'.format(pid)
        try:
            with open(cmdline_fp, 'rb') as cmdline_f:
                command_line = cmdline_f.read()
        except Exception:
            logging.debug('could not read command line file for pid %r', pid, exc_info=True)
            command_line = None
        return command_line

    @staticmethod
    def _get_child_pids(pid):
        """
        Get all child process IDs

        :param pid: process ID
        :type pid: int
        :return: child process IDs
        :rtype: list
        """
        child_pids = []
        for fname in os.listdir('/proc'):
            try:
                if fname.isdigit() and os.path.isdir(os.path.join('/proc', fname)):
                    if os.path.isfile(os.path.join('/proc', fname, 'stat')):
                        with open(os.path.join('/proc', fname, 'stat'), 'rb') as stat_fstream:
                            stat_data = stat_fstream.read()
                        stat_list = stat_data.split()
                        if int(stat_list[PROC_STAT_PPID_IDX]) == pid:
                            child_pids.append(int(stat_list[PROC_STAT_PID_IDX]))
            except Exception:
                pass  # This is to account for processes that have ended since the listdir()
        return child_pids


class BaseBackup(object):
    """Base class for shared functionality across backup and restore."""

    def __init__(self, server_data, backup_code, logger=None):
        self.server_data = server_data
        self.backup_code = backup_code
        self.backup_textfile_collector_dir = self.server_data.get('BACKUP_TEXTFILE_COLLECTOR_DIR',
                                                                  BACKUP_TEXTFILE_COLLECTOR_DIR)
        self.alias = self.server_data.get('ALIAS')
        self.report_options = {}
        self.cdba_report = {}
        self.logging_dir = server_data.get('LOGGING_DIR', DEFAULT_LOGGING_DIR)
        self.backup_uuid = None

        if isinstance(logger, logging.Logger):
            self.logger = logger
        else:
                self.logger = logging_setup(self.logging_dir, 'restore.log')

        # Compression
        self.compress = server_data.get('COMPRESS', True)
        self.compression_algorithm = server_data.get('COMPRESSION_ALGORITHM',
                                                     COMPRESSION_ALGORITHMS[self.backup_code][0])
        if self.compress:
            self.check_compression_algorithm(self.compression_algorithm)

        # Dynamically set
        self.is_slave = False
        self.last_backup_dir = ''

    @property
    def backup_uuid(self):
        if hasattr(self, '_backup_uuid'):
            return self._backup_uuid
        return None

    @backup_uuid.setter
    def backup_uuid(self, value):
        if hasattr(self, '_backup_uuid'):
            self.logger.debug('backup_uuid is already set')
            raise UserWarning('backup_uuid is already set')
        if isinstance(value, uuid.UUID):
            self._backup_uuid = value
        else:
            self._backup_uuid = uuid.uuid4()

    @backup_uuid.deleter
    def backup_uuid(self):
        self.logger.debug('backup_uuid cannot be deleted')
        raise NotImplementedError('backup_uuid cannot be deleted')

    def get_policy(self):
        """Retrieve the notification policy"""
        policy = self.server_data.get("POLICY")
        if policy in VALID_POLICIES:
            self.logger.debug("Detected notification policy as %s", policy)
            return policy
        self.logger.error("Invalid policy detected: %s", policy)
        return None

    def check_compression_algorithm(self, algorithm):
        """Check if an algorithm is usable
        :raises: BackupError if the algorithm is not compatible
        """
        if not self.compress:
            self.logger.debug('Compression is disabled, skipping check')
        if algorithm in COMPRESSION_ALGORITHMS[self.backup_code]:
            self.logger.debug('Algorithm %s accepted for backup type %s', algorithm, self.backup_code)
            return
        raise BackupError('algorithm %s is not one of %s' % (algorithm, COMPRESSION_ALGORITHMS[self.backup_code]))

    def compression_matches_ext(self, path):
        """Check if the file extension of a path matches the configured algorithm"""
        stripped_path = path
        for ext in ['.xbcrypt', '.gpg']:
            stripped_path = stripped_path.replace(ext, '')
        return stripped_path.endswith({
            '': stripped_path,
            'gzip': '.gz',
            'lz4': '.lz4',
            'quicklz': '.qp',
            'zstd': '.zst',
        }.get(self.compression_algorithm))

    def get_compression_ext(self):
        """Get the expected file extension for compression"""
        return {
                'gzip': '.gz',
                'lz4': '.lz4',
                'quicklz': '.qp',
                'zstd': '.zst',
        }.get(self.compression_algorithm)

    def get_compression_tool(self):
        """Get the compression tool path"""
        return {
            'gzip': GZIP_BIN,
            'lz4': LZ4_BIN,
            'quicklz': QPRESS_BIN,
            'zstd': ZSTD_BIN,
        }.get(self.compression_algorithm)

    def notify(self, status, output, send_event=True):
        """Send notifications."""
        # Truncate long output, e.g. when stderr is too long.
        if len(output) > 300:
            output = '{}...'.format(output[:300])

        if isinstance(self, Backup) and self.is_slave:
            output = 'Host %s. %s' % (self.alias, output)

        self.report_options['end_time'] = time.strftime(DATETIME_FORMAT, time.gmtime())

        if status == 0:
            self.textfile_collector_notify(0)
            if "OK no new binlogs to upload" in output:
                self.textfile_collector_write_status(backup_status=status, upload=True)
        else:
            self.textfile_collector_notify(1)

        if status == STATUS_OK:
            self.report_options['status'] = 'success'
            if isinstance(self, Backup) and self.backup_code in ['M', 'X'] and self.last_backup_dir:
                self.report_options['options']['local_path'] = self.last_backup_dir
                self.report_options['size_mb'] = get_dir_size(self.last_backup_dir, 'mb')

        self.cdba_report['hosts'].append(self.report_options)

    # check if the dir is exist
    def check_textcollector_dir(self, collector_file):
        # Check if Textfile Collector dir exist
        backup_textfile_collector_dir = os.path.dirname(collector_file)
        if not os.path.isdir(backup_textfile_collector_dir):
            self.logger.warning('Textfile Collector directory {} does not exist.'.format(backup_textfile_collector_dir))
            return False

        return True

    # write backup notification
    def textfile_collector_write_status(self, backup_status, backup_code=None, alias=None, upload=None):
        """Reporting the status of a backup or a restore."""
        # msp_backup_status{type=xtrabackup, alias=alias1} 0|1
        # msp_backup_last_report_ts{type=xtrabackup, alias=alias1} 1231122341
        backup_type = BACKUP_TYPES[backup_code] if backup_code else BACKUP_TYPES[self.backup_code]
        if not alias:
            alias = self.alias

        if isinstance(self, Restore):
            backup_restore = "restore"
        elif upload:
            backup_restore = "upload"
        else:
            backup_restore = "backup"

        if self.check_textcollector_dir(self.backup_textfile_collector_dir):
            collector_file = "{}{}.{}.{}.prom".format(
                self.backup_textfile_collector_dir,
                backup_restore,
                backup_type,
                alias)

            try:
                if (backup_status == -1 and not os.path.isfile(collector_file)) or backup_status != -1:
                    # Construct the common part of the metrics text
                    metrics_text = (
                        '# HELP msp_{backup_restore}_status The status of the job\n'
                        '# TYPE msp_{backup_restore}_status Untyped\n'
                        '# HELP msp_{backup_restore}_last_report_ts The Last Report Time\n'
                        '# TYPE msp_{backup_restore}_last_report_ts Untyped\n'
                        'msp_{backup_restore}_status{{type="{backup_type}", alias="{alias}",'
                        'encryption="{encryption}", backup_id="{backup_id}",'
                        ' start_time="{start_time}", end_time="{end_time}"'.format(
                            backup_restore=backup_restore,
                            backup_type=backup_type,
                            alias=alias,
                            encryption=self.report_options.get('encryption', None),
                            backup_id=self.backup_uuid,
                            start_time=self.report_options.get('start_time', None),
                            end_time=self.report_options.get('end_time', None)
                        )
                    )

                    # Add conditional parts based on backup_type and backup_restore
                    if backup_type != 'Binlogs' and backup_restore != 'restore':
                        metrics_text += ', backup_size="{size}"'.format(
                            size=get_dir_size(self.last_backup_dir, 'bytes') if self.last_backup_dir else 0
                        )

                    # Complete metrics_text with backup_status
                    metrics_text += '}} {backup_status}\n'.format(backup_status=backup_status)

                    last_metrics_text_line = (
                        'msp_{backup_restore}_last_report_ts{{type="{backup_type}", alias="{alias}", '
                        'backup_id="{backup_id}"}} {time}\n'.format(
                            backup_restore=backup_restore,
                            backup_type=backup_type,
                            alias=alias,
                            backup_id=self.backup_uuid,
                            time=int(time.time())
                        )
                    )

                    # Append last report timestamp line to metrics_text
                    metrics_text += last_metrics_text_line

                    with open(collector_file, "w") as outfile:
                        outfile.write(metrics_text)
            except AttributeError as err:
                self.logger.warning(err, exc_info=True)

    def textfile_collector_write_enable(self, backup_type, alias, backup_enabled, job_type):
        """Adding the enabled backup types to the textfile collector."""
        if self.check_textcollector_dir(self.backup_textfile_collector_dir):
            collector_file = "{}{}.{}.{}.{}.prom".format(
                self.backup_textfile_collector_dir,
                "driver",
                job_type,
                BACKUP_TYPES[backup_type],
                alias)
            with open(collector_file, "w") as outfile:
                outfile.write(
                    '# HELP msp_{job_type}_enabled The status of the cron\n'
                    '# TYPE msp_{job_type}_enabled Untyped\n'.format(job_type=job_type)
                )
                outfile.write('msp_{job_type}_enabled{{type="{type}", alias="{alias}"}} {backup_enabled}\n'.format(
                    job_type=job_type,
                    type=BACKUP_TYPES[backup_type],
                    alias=alias,
                    backup_enabled=backup_enabled)
                )

    def textfile_collector_job_enabled(self, backup_type, alias, backup_enabled, job_type):
        """Recording if backup drive is started and backup types are enabled."""
        self.textfile_collector_write_enable(backup_type, alias, backup_enabled, job_type)

    def textfile_collector_notify(self, backup_status):
        self.textfile_collector_write_status(backup_status)
class Backup(BaseBackup):  # pylint: disable=too-many-instance-attributes

    """Common class for all backup types."""

    def __init__(self, server_data, backup_code, native_upload=False, logger=None):
