    def copy_back(self):

        if self.backup_is_incremental:
            dest = self.incremental_dest_path
        else:
            if os.path.isdir(self.datadir):
                if self.from_commandline:
                    if os.listdir(self.datadir):
                        msg = "datadir %s is not empty" % self.datadir
                        raise BackupError(msg)
                else:
                    try:
                        shutil.rmtree(self.datadir)
                    except Exception as e:
                        msg = "Cleaning datadir failed: %s" % e
                        raise BackupError(msg)
            else:
                msg = "Datadir %s does not exists" % self.datadir
                raise BackupError(msg)
            dest = self.datadir

        if self.is_stream:
            self.stream_copy(self.backup_source.split(':')[1], dest)
        elif ':' in self.backup_source:
            if self.backup_source.startswith('s3:'):
                self.s3_copy(os.path.join(self.backup_source, ""),
                             dest,
                             self.xb_log_file
                            )
            elif self.backup_source.startswith('gs:'):
                self.gs_copy(os.path.join(self.backup_source, ""),
                             dest,
                             self.xb_log_file
                            )
            else:
                self.rsync_copy(os.path.join(self.backup_source, ""),
                                dest,
                                self.xb_log_file
                               )
        else:
            self.local_copy(os.path.join(self.backup_source, ""),
                            dest
                           )

        self.logger.info('OK Copy Back complete.')

    def stream_copy(self, source, destination):

        rchown(destination, pwd.getpwnam(self.ssh_user).pw_uid, pwd.getpwnam(self.ssh_user).pw_gid)

        if self.xtrabackup_bin_cmd == "innobackupex":
            stream_cmd = 'ssh -tt -o PasswordAuthentication=no -o StrictHostKeyChecking=no ' \
                         '-i /home/{}/.ssh/{} {}@{} -p {} "set -o pipefail; sudo /usr/bin/innobackupex  ' \
                         '/tmp --slave-info --kill-long-queries-timeout=10 --kill-long-query-type=select ' \
                         '--stream=xbstream | ssh -o PasswordAuthentication=no -o StrictHostKeyChecking=no {}@{} ' \
                         '-p {} "xbstream -x -C {}""' \
                .format(self.ssh_user,
                        self.ssh_key,
                        self.ssh_user,
                        source,
                        self.ssh_port,
                        self.ssh_user,
                        self._get_own_ssh_remote_addr(source),
                        self.ssh_port,
                        destination)
        else:
            stream_cmd = 'ssh -tt -o PasswordAuthentication=no -o StrictHostKeyChecking=no ' \
                         '-i /home/{}/.ssh/{} {}@{} -p {} "set -o pipefail; sudo /usr/bin/{}  ' \
                         '--backup --slave-info --kill-long-queries-timeout=10 --kill-long-query-type=select ' \
                         '--stream=xbstream | ssh -o PasswordAuthentication=no -o StrictHostKeyChecking=no {}@{} ' \
                         '-p {} "xbstream -x -C {}""' \
                .format(self.ssh_user,
                        self.ssh_key,
                        self.ssh_user,
                        source,
                        self.ssh_port,
                        self.xtrabackup_bin_cmd,
                        self.ssh_user,
                        self._get_own_ssh_remote_addr(source),
                        self.ssh_port,
                        destination)
        self.logger.info('Running: %s', stream_cmd)
        xb_log_stream = open(self.xb_log_file, 'a')
        proc = subprocess.Popen(stream_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=True)
        proc.communicate()
        if proc.returncode != 0:
            msg = 'Stream failed.'
            raise BackupError(msg)

