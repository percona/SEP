        self.ssh_user = server_data.get('SSH_USER', 'percona')
        self.ssh_port = server_data.get('SSH_PORT', '22')
        self.ssh_key = server_data.get('SSH_KEY', 'id_rsa')
        self.pre_script = server_data.get('PRE_SCRIPT')
        self.post_script = server_data.get('POST_SCRIPT')
        self.xtrabackup_bin_cmd = server_data.get('XTRABACKUP_BIN_CMD', "innobackupex")
        self.s3_tool = server_data.get('S3_TOOL', 's3cmd')
        self.keyring_file_data = server_data.get('KEYRING_FILE_DATA')

        logging_dir = server_data.get('LOGGING_DIR', DEFAULT_LOGGING_DIR)

        self.skip_databases = []
        self.include_databases = []

        self.report_options = {
            'host': self.alias,
            'backup_type': self.backup_code,
            'slave_from_master': self.slave_from_master,
            'start_time': time.strftime(DATETIME_FORMAT, time.gmtime()),
            'end_time': '',
            'run_checksum': self.run_checksum,
            'options': {}
        }
        self.cdba_report = {
            'type': BACKUP_TYPES[self.backup_code],
            'hosts': [],
            'event': 'restore'
        }
        if os.path.basename(self.backup_source) == 'latest':
            if self.backup_source.startswith('s3://'):
                self.backup_source = self._s3_get_path_from_latest()
            elif self.backup_source.startswith('gs://'):
                self.backup_source = self._gs_get_path_from_latest()
            else:
                self.backup_source = self._symlink_to_real()

        self.logger = logging_setup(logging_dir, 'restore.log')

    def _symlink_to_real(self):
        """ get real path from symlink """
        if ':' in self.backup_source:
            host, path = self.backup_source.split(':')
            rl_cmd = 'ssh -p %s -l %s -i /home/%s/.ssh/id_rsa %s readlink -n %s' \
                     % (self.ssh_port, self.ssh_user, self.ssh_user, host, path)
        else:
            rl_cmd = 'readlink -n %s' % self.backup_source

        proc = subprocess.Popen(rl_cmd, stdout=subprocess.PIPE, shell=True)
        real_dir, _ = proc.communicate()
        real_dir = real_dir.decode('utf-8').strip()
        if real_dir:
            return self.backup_source.replace('latest', real_dir)

    def _clean_after_restore(self, local_path):
        """Remove files after restore OK"""
        if self.backup_code in ['B', 'M']:
            shutil.rmtree(local_path)
        elif self.backup_code == 'X':
            os.remove(os.path.join(local_path, 'xtrabackup_logfile'))

    @staticmethod
    def _mysql_client_q_from_file(filename, target_host="localhost", target_port=3306):
        """
        Execute MySQL queries from file using mysql client.
        """
        if os.path.isfile(filename):

            if target_host == "localhost":
                cmd = '/usr/bin/mysql'
            else:
                cmd = '/usr/bin/mysql -h %s -P %s' % (target_host, target_port)
            try:
                with open(filename, 'r') as file_desc:
                    cmd_proc = subprocess.Popen(cmd,
                                                stdout=subprocess.PIPE,
                                                stderr=subprocess.PIPE,
                                                shell=True,
                                                stdin=file_desc)
            except OSError as err:
                msg = 'Error trying to run SQL file %s, Err: %s' % (filename, err)
                raise BackupError(msg)
            _, err = cmd_proc.communicate()
            if cmd_proc.returncode != 0:
                msg = '%s script failure: %s' % (filename, err)
                raise BackupError(msg)
        else:
            msg = 'Script hook file %s does not exists' % filename
            raise BackupError(msg)

    def _run_script(self, pre_post, target_host="localhost", target_port=3306):
        """ Run pre and post scripts """
        if pre_post == 'PRE':
            script_path = self.pre_script
        elif pre_post == 'POST':
            script_path = self.post_script
        else:
            msg = 'Invalid _run_script function call: pre_post != PRE || POST'
            raise BackupError(msg)

        if script_path.endswith('.sql'):
            # Run sql script against mysql
            self._mysql_client_q_from_file(script_path, target_host, target_port)
        else:
            # Run script with subprocess.Popen
            hook_cmd = shlex.split(script_path)
            try:
                hook_proc = subprocess.Popen(hook_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            except OSError as err:
                msg = 'Error trying to run %s, Err: %s' % (script_path, err)
                raise BackupError(msg)

            _, err = hook_proc.communicate()
            if hook_proc.returncode != 0:
                msg = '%s script failure: %s' % (pre_post, err)
                raise BackupError(msg)

    def _gs_get_path_from_latest(self):
        latest_dir = '/tmp/percona_backup_latest'
        latest_local_file_path = os.path.join(latest_dir, 'latest')
        if os.path.isdir(latest_dir):
            shutil.rmtree(latest_dir)
        try:
            os.mkdir(latest_dir)
        except:
            msg = 'Can not create tmp dir for latest file.'
            raise BackupError(msg)

        gs_cmd = [GSUTIL_BIN, 'cp', self.backup_source, latest_local_file_path]
        gs_proc = subprocess.Popen(gs_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = gs_proc.communicate()
        if gs_proc.returncode != 0:
            msg = 'GS latest file download failed. Error: %s' % (err,)
            raise BackupError(msg)

        with open(latest_local_file_path, 'r') as fname:
            latest_backup_source = fname.read().rstrip()

        if 'gs://' in latest_backup_source:
            return latest_backup_source
        else:
            msg = 'GS latest file content is an invalid path. Error: %s' % (err,)
            raise BackupError(msg)

    def _s3_get_path_from_latest(self):
        latest_dir = '/tmp/percona_backup_latest'
        latest_local_file_path = os.path.join(latest_dir, 'latest')
        if os.path.isdir(latest_dir):
            shutil.rmtree(latest_dir)
        try:
            os.mkdir(latest_dir)
        except:
            msg = 'Can not create tmp dir for latest file.'
            raise BackupError(msg)

        # using sync as get was failing PLAT-446
        s3_cmd = [PYTHON_BIN, S3CMD_BIN, 'sync', self.backup_source, latest_local_file_path]
        s3_proc = subprocess.Popen(s3_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = s3_proc.communicate()
        if s3_proc.returncode != 0:
            msg = 'S3 latest file download failed. Error: %s' % (err,)
            raise BackupError(msg)

        with open(latest_local_file_path, 'r') as fname:
            latest_backup_source = fname.read().rstrip()

        if 's3://' in latest_backup_source:
            return latest_backup_source
        else:
            msg = 'S3 latest file content is an invalid path. Error: %s' % (err,)
            raise BackupError(msg)

    def _wait_for_catchup(self):

        sbm = -1
        while sbm != 0:
            result = None
            for word in ['NONBLOCKING', 'NOLOCK', '']:
                try:
                    result = self._query_mysql('SHOW SLAVE STATUS %s' % (word,))
                except ProgrammingError:
                    pass
                else:
                    break

            if result and result['Seconds_Behind_Master'] is not None:
                sbm = result['Seconds_Behind_Master']
                if sbm == 0:
                    self.logger.info('MySQL slave is up to date.')
                else:
                    self.logger.info('MySQL slave is %s seconds behind.', sbm)
                    time.sleep(5)
            else:
                self.logger.info('MySQL slave is broken.')
                return False

        return True

    def _query_mysql(self, sql, fetchall=False, host=None, port=None, args=None):
        """Execute MySQL query.

        It fetches one record by default unless fetchall=True is passed.
        """
        host = host if host else self.host
        port = port if port else self.port

        try:

            conn = MySQLdb.connect(read_default_file=self.defaults_cnf_file,
                                   host=host,
                                   port=port,
                                   cursorclass=MySQLdb.cursors.DictCursor)
            cursor = conn.cursor()
            cursor.execute(sql, [] if not args else args)
        except (OperationalError, InternalError) as err:
            msg = 'Error running query "%s": %s' % (sql, err)
            raise BackupError(msg)

        if fetchall:
            result = cursor.fetchall()
        else:
            result = cursor.fetchone()

        return result

    def _is_running_slave(self):
        """Returns true if slave is running.

        It should have a numeric value of Seconds_Behind_Master.
        Also we leverage lock-free SHOW SLAVE STATUS.
        """
        result = None
        for word in ['NONBLOCKING', 'NOLOCK', '']:
            try:
                result = self._query_mysql('SHOW SLAVE STATUS %s' % (word,))
            except ProgrammingError:
                pass
            else:
                break

        if result and result['Slave_IO_Running'] == 'Yes':
            self.logger.info('MySQL slave is running.')
            return True

        return False

    def checksum_run(self):
        """Run checksum on the master"""
        ptc_command = ['pt-table-checksum', '--no-check-binlog-format']
        ptc_command.append('--host=%s' % self.master_ip)

        if self.pt_checksum_extra_args:
            ptc_command.extend(self.pt_checksum_extra_args.split(' '))

        self.logger.info('Running: %s', ' '.join(ptc_command))
        proc = subprocess.Popen(ptc_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = proc.communicate()
        if err:
            msg = 'Checksum failed: %s' % (err)
            raise BackupError(msg)

    def checksum_check(self):
        """Check checksum diffs"""
        check_query = (
            "SELECT db, tbl, SUM(this_cnt) AS total_rows, COUNT(*) AS chunks "
            "FROM percona.checksums "
            "WHERE ( "
            " master_cnt <> this_cnt "
            " OR master_crc <> this_crc "
            " OR ISNULL(master_crc) <> ISNULL(this_crc)) "
            "GROUP BY db, tbl")
        result = self._query_mysql(check_query)
        return not result

    def rsync_copy(self, source, destination, log_file, **kwargs):
        """ Rsync remote backups """

        # rsync subprocess doesn't work with list so I had to use a string
        info_file = {'X': 'xtrabackup_info', 'M': 'metadata'}
        info_only = kwargs.get('info_only', False)

        if info_only and self.backup_code in info_file:
            exclude_args = '--exclude="*"'
            include_args = '--include="%s*"' % info_file[self.backup_code]
        else:
            exclude_args = ""
            for path in kwargs.get('exclude', []):
                if path.strip():
                    exclude_args += '--exclude="%s.*" ' % path.strip()

            include_args = ""
            for path in kwargs.get('include', []):
                if path.strip():
                    include_args += '--include="%s.*" ' % path.strip()

            if include_args and not exclude_args:
                exclude_args = '--exclude="*"'
                include_args += '--include="metadata*" '

        if os.path.isdir(destination):
            shutil.rmtree(destination)

        rsync_cmd = 'rsync -LAvhr %s %s --rsync-path="sudo rsync" -e "ssh -t -p %s -i /home/%s/.ssh/id_rsa" %s@%s %s' \
                    % (include_args, exclude_args, self.ssh_port, self.ssh_user, self.ssh_user, source, destination)

        self.logger.info('Running: %s', rsync_cmd)
        log_stream = open(log_file, 'a')
        proc = subprocess.Popen(rsync_cmd, stdout=log_stream, stderr=log_stream, shell=True)
        proc.communicate()
        if proc.returncode != 0:
            msg = 'Rsync failed.'
            raise BackupError(msg)

    def gs_copy(self, source, destination, log_file, **kwargs):
        """ Copy files from a GS bucket """

        info_file = {'X': 'xtrabackup_info', 'M': 'metadata'}
        info_only = kwargs.get('info_only', False)

        if info_only and self.backup_code in info_file:
            regex_args = '-x "^(?!.*%s$)"' % info_file[self.backup_code]
        else:
            regex_args = ""

        if os.path.isdir(destination):
            shutil.rmtree(destination)

        os.mkdir(destination)
        destination_dir = os.path.normpath(destination) + os.sep

        download_cmd = '%s rsync -r %s %s %s' \
                       % (GSUTIL_BIN, regex_args, source, destination_dir)

        self.logger.info('Running: %s', download_cmd)
        log_stream = open(log_file, 'a')
        proc = subprocess.Popen(download_cmd, stdout=log_stream, stderr=log_stream, shell=True)
        proc.communicate()
        if proc.returncode != 0:
            msg = 'GS download failed.'
            raise BackupError(msg)

    def s3_copy(self, source, destination, log_file, **kwargs):
        """ Copy files from a S3 bucket """

        info_file = {'X': 'xtrabackup_info', 'M': 'metadata'}
        info_only = kwargs.get('info_only', False)
        files_list = kwargs.get('files_list', False)

        if info_only and self.backup_code in info_file:
            exclude_args = '--exclude="*"'
            include_args = '--include="%s*"' % info_file[self.backup_code]
        elif files_list:
            exclude_args = '--exclude="*"'
            include_args = ''
            try:
                with open(files_list, 'r', encoding=stdout.encoding) as f:
                    for line in f:
                        line = line.strip()
                        if line:
                            include_args += '--include="%s" ' % line
            except Exception as e:
                raise BackupError(f"Error reading files list: {e}")
        else:
            exclude_args = ""
            for path in kwargs.get('exclude', []):
                if path.strip():
                    exclude_args += '--exclude="%s.*" ' % path.strip()

            include_args = ""
            for path in kwargs.get('include', []):
                if path.strip():
                    include_args += '--include="%s.*" ' % path.strip()

            if include_args and not exclude_args:
                exclude_args = '--exclude="*"'
                include_args += '--include="metadata*" '

        if os.path.isdir(destination):
            shutil.rmtree(destination)
            os.mkdir(destination)
        destination_dir = os.path.normpath(destination) + os.sep

        if self.s3_tool == 'awscli':
            download_cmd = '%s s3 sync %s %s %s %s' \
                           % (AWS_BIN, source, destination_dir, exclude_args, include_args)
        else:
            download_cmd = '%s/bin/s3cmd sync %s %s %s %s' \
                           % (INSTALL_DIR, source, destination_dir, exclude_args, include_args)

        self.logger.info('Running: %s', download_cmd)
        log_stream = open(log_file, 'a')
        proc = subprocess.Popen(download_cmd, stdout=log_stream, stderr=log_stream, shell=True)
        proc.communicate()
        if proc.returncode != 0:
            msg = 'S3 download failed.'
            raise BackupError(msg)

    def local_copy(self, source, destination, **kwargs):
        """ Copy local files to destination to be restored """

        info_file = {'X': 'xtrabackup_info', 'M': 'metadata'}
        info_only = kwargs.get('info_only', False)

        if info_only and self.backup_code in info_file:
            files = glob.iglob(os.path.join(source, "%s*" % info_file[self.backup_code]))
            for filen in files:
                try:
                    shutil.copy(filen, destination)
                except Exception as err:
                    msg = "Copy failed: %s" % err
                    raise BackupError(msg)
        else:
            if os.path.isdir(destination):
                shutil.rmtree(destination)
            try:
                if self.include_databases or self.skip_databases:
                    shutil.copytree(source, destination, ignore=self._ignore_databases)
                else:
                    shutil.copytree(source, destination)
            except Exception as err:
                msg = "Copy failed: %s" % err
                raise BackupError(msg)

    def _ignore_databases(self, _, filenames):
        ignored = []
        for filen in filenames:
            if filen == 'metadata':
                continue
            if self.include_databases:
                if not filen.startswith(tuple(self.include_databases)):
                    ignored.append(filen)
            elif self.skip_databases:
                if filen.startswith(tuple(self.skip_databases)):
                    ignored.append(filen)
        return ignored

    @staticmethod
    def is_encrypted(path):
        """ Returns encrytion method
            Possible values:
                - gpg
                - aes
                - False if none
        """

        for _, _, files in os.walk(path):
            for filen in files:
                if filen.endswith(".gpg"):
                    return "gpg"
                elif filen.endswith(".xbcrypt"):
                    return "aes"
            break

        return False

    def decrypt_gpg(self, path):
        """ descrypt gpg files with dir_encrypt """
        decrypt_dir(path, self.gpg_password_file, self.logger)

    @staticmethod
    def is_binlog_compressed(path):
        """
        :return: Returns compression type
        :rtype: str
        """

        for _, _, files in os.walk(path):
            for filen in files:
                if filen.endswith(".gz"):
                    return "gz"
            break

        return False

    def decompress_binlog(self, method, path):
        """
        Decompress the binary logs
        """
        self.logger.info('Decompressing binlogs...')

        if method == 'gz':
            decompress_cmd = ['/usr/bin/gzip', '-dr', path]
        else:
            msg = 'Decompression method not implemented: %s' % (method,)
            raise BackupError(msg)

        self.logger.info('Running: %s', ' '.join(decompress_cmd))
        decompress_proc = subprocess.Popen(decompress_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = decompress_proc.communicate()
        if decompress_proc.returncode != 0:
            msg = 'Decompression failed. Error: %s' % (err,)
            raise BackupError(msg)

        self.logger.info('Decompressing binlogs complete.')

class Restorer(object):  # pylint: disable=too-many-instance-attributes
    """ Parent Restorer Class """
    def __init__(self, options):

        self.logger = None
        self.config_path = options.config_path
        self.backup_type = None
        self.backup_path = None

    def run(self):
        local_cfg = LocalConfig(self.config_path)

        logging_dir = Path(
            local_cfg.raw_cfg_data["ALL_SERVERS"].get(
                "LOGGING_DIR", DEFAULT_LOGGING_DIR
            )
        )
        self.logger = logging_setup(logging_dir, 'restore.log')

        # Get a lock
        lockfile_name = os.path.join(logging_dir, '.lock_restore')
        lock_file = LockFile(lockfile_name, timeout=600)
        lock_file.get_lock_or_exit()

        # Read config if not manual run
        if self.backup_path is None:
            # Obtain server list
            servers = [s for s in local_cfg.server_data_list]

        start_time = time.time()
        self.logger.info('>>>>>>>>>>>>>>>>>> Restore started.')

        rst = None
        for server_data in servers:
            self.backup_type = server_data.get('BACKUP_TYPE')

            if self.backup_type == 'X':
                rst = Xtrabackup(server_data)
            else:
                self.logger.error('No Restores to run.')

            if rst:
                try:
                    rst.run()
                except BackupError as exc:
                    self.logger.error(exc.message)
                    self.logger.error('Restore failed for this host.')
                    rst.notify(STATUS_CRITICAL, exc.message)
                except Exception:
                    self.logger.exception('Unhandled exception occurred.')
                    rst.notify(STATUS_CRITICAL, 'Unhandled exception occurred during restore.')
        time_spent = time.time() - start_time
        self.logger.info('>>>>>>>>>>>>>>>>>> Restore finished. Total duration: %s.',
                         format_seconds_to_hhmmss(time_spent))

        # Release lock
        lock_file.free_lock()

class Xtrabackup(Restore):
    """Restore Xtrabackup for individual server."""

    def __init__(self, server_data):
        """Define server options."""
        # Init common options
        super(Xtrabackup, self).__init__(server_data, 'X')

        self.datadir = server_data.get('DATADIR', None)
        self.kill_mysql = server_data.get('KILL_MYSQL', False)
        self.xtrabackup_aes256_keyfile = server_data.get('XTRABACKUP_AES256_KEYFILE', DEFAULT_CFG_DIR + '/xb_keyfile')
        self.mysql_init_command = server_data.get('MYSQL_INIT_COMMAND', False)  # Deprecated by custom
        self.custom_mysql_init_command = server_data.get('CUSTOM_MYSQL_INIT_COMMAND', False)
        self.prepare_memory = server_data.get('XB_PREPARE_MEMORY', '100M')
        self.xb_parallel = server_data.get('XB_PARALLEL', 0)
        self.from_commandline = server_data.get('FROM_COMMANDLINE', False)
        self.alias = server_data.get('ALIAS', None)
        self.restore_mycnf = server_data.get('RESTORE_MYCNF', False)
        self.skip_incrementals = server_data.get('SKIP_INCREMENTALS', False)
        self.incremental_dest_path = server_data.get('INCREMENTAL_DEST_PATH', '/tmp/pxb_incrementals')
        self.logging_dir = server_data.get('LOGGING_DIR', DEFAULT_LOGGING_DIR)
        self.xtrabackup_restore_args = server_data.get('XTRABACKUP_RESTORE_ARGS')
        self.is_stream = False

        self.logger = logging_setup(self.logging_dir, 'restore.log')
        if self.alias:
            logging_set_host(server_data.get('ALIAS'), 'restore.log')

        # Backward compat
        if not self.custom_mysql_init_command and self.mysql_init_command:
            self.custom_mysql_init_command = self.mysql_init_command

    def run(self):
        """Run Xtrabackup restore process"""

        start_time = time.time()

        self.logger.info(self.continue_replication)
        # set xb binary own log file
        self.xb_log_file = os.path.join(self.logging_dir, 'restore_xtrabackup-%s.log' % (time.strftime('%Y%m%d')))

        if self.pre_script:
            self.logger.info('Running pre restore script: %s', self.pre_script)
            self._run_script('PRE')

        try:
            if self.backup_source.startswith('stream'):
                self.is_stream = True
        except  AttributeError as exc:
            raise BackupError("BACKUP_SOURCE is not defined.") from exc

        # check for incrementals
        incremental_dirs = []
        if not self.skip_incrementals and not self.is_stream:
            incremental_dirs = self.list_incrementals()

        backup_path_list = []
        backup_path_list.append(self.backup_source)

        for incremental in incremental_dirs:
            backup_path_list.append(os.path.join("%s_incrementals" % self.backup_source, incremental))

        restore_iteration = 0
        for this_backup in backup_path_list:

            self.backup_source = this_backup
            if self.is_stream:
                self.backup_is_incremental = False
            else:
                self.backup_info()
            restore_iteration += 1
            self.is_last_restore = len(backup_path_list) == restore_iteration

            if not self.backup_is_incremental:
                # increase open files limit to 1048576
                rlimit = [1048576, 1048576]
                try:
                    resource.setrlimit(resource.RLIMIT_NOFILE, rlimit)
                    self.logger.info('Raised open_file_limit to %s', rlimit)
                except ValueError:
                    self.logger.warn('Unable to raise open_file_limit')

                if not self.datadir:
                    self.get_datadir()

                if self.from_commandline:
                    self.logger.info('Check MySQL running.')
                    if self.signal_mysqld('status'):
                        self.logger.info('MySQL Not running.')
                    else:
                        msg = '''
                        MySQL is running. Please stop it as MySQL must not be running when restoring from command line.
                        '''
                        raise BackupError(msg)
                else:
                    self.logger.info('Stopping mysqld.')
                    self.signal_mysqld('stop')
                    stop_mysql_time = time.time()

                backup_dest = self.datadir
            else:
                backup_dest = self.incremental_dest_path

            self.copy_back()
            copy_time = time.time()

            self.decrypt_decompress(backup_dest)
            if self.restore_mycnf:
                self._restore_cnf_files()
            self.prepare_backup()
            prepare_time = time.time()

        self.chown_datadir()

        self.logger.info('Starting mysqld.')
        self.signal_mysqld('start')

        self._log_binlog_position(backup_dest)

        time_spent = time.time() - start_time
        self.report_options['time_spent_seconds'] = time_spent

        if not self.continue_replication:
            self.logger.info('Reset Slave.')
            self.reset_slave()

        if self.slave_from_master or self.continue_replication:
            self.logger.info('Configuring replication.')
            self.set_slave()
            time.sleep(3)
            if self._is_running_slave():
                self.logger.info('Slave running.')
                if self.wait_for_catchup or self.run_checksum:
                    self.logger.info('Waiting for Slave to catch up.')
                    if not self._wait_for_catchup():
                        self.logger.info('Backup test was NOT OK.')
                        msg = 'Backup Test failed: Slave was not able to catch up with master.'
                        raise BackupError(msg)
                    elif self.run_checksum:
                        self.checksum_run()
                        if self.checksum_check():
                            self.logger.info('No diff found after Checksum.')
                        else:
                            msg = 'Differences found after checksum.'
                            raise BackupError(msg)
            else:
                self.logger.info('Slave IS NOT running.')
                msg = 'Backup Test failed: Slave setup did not work'
                raise BackupError(msg)

        check_time = time.time()

        time_spent = format_seconds_to_hhmmss(time.time() - start_time)
        msg = 'OK Backup testing complete. Duration: %s.' % time_spent
        self.logger.info(msg)

        if self.post_script:
            self.logger.info('Running post restore script: %s', self.post_script)
            self._run_script('POST')

        self.notify(STATUS_OK, msg)

    def _log_binlog_position(self, backup_dest):
        """
        print binlog position from the latest backup files
        - xtrabackup_binlog_info
        - xtrabackup_slave_info
        """

        try:
            with open(os.path.join(backup_dest, 'xtrabackup_binlog_info'), 'r') as rfile:
                data = rfile.read().strip()
        except IOError:
            data = ""

        if data:
            self.logger.info("Binlog position from source: %s", data)

        try:
            with open(os.path.join(backup_dest, 'xtrabackup_slave_info'), 'r') as rfile:
                data = rfile.read().strip()
        except IOError:
            data = ""

        if data:
            self.logger.info("Binlog position from source's master: %s", data)

    def backup_info(self):
        # Check backup exists on source path before doing anything else
        # Copy xtrabackup_info to tmp and run other safe cheks
        if os.path.isdir("/tmp/pxb_info"):
            shutil.rmtree("/tmp/pxb_info")

        os.mkdir("/tmp/pxb_info")

        if ':' in self.backup_source:
            if self.backup_source.startswith('s3:'):
                self.s3_copy(os.path.join(self.backup_source, ""),
                             "/tmp/pxb_info/", self.xb_log_file,
                             info_only=True
                            )
            elif self.backup_source.startswith('gs:'):
                self.gs_copy(os.path.join(self.backup_source, ""),
                             "/tmp/pxb_info/", self.xb_log_file,
                             info_only=True
                            )
            else:
                self.rsync_copy(os.path.join(self.backup_source, ""),
                                "/tmp/pxb_info/",
                                self.xb_log_file,
