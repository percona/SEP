        self.alias = server_data.get('ALIAS', self.host)
        self.port = server_data.get('PORT', 3306)
        self.hostname = str(server_data.get('HOSTNAME', socket.gethostname().split('.')[0]))

        self.cdba_report = {'type': BACKUP_TYPES[self.backup_code],
                            'hosts': [],
                            'api_key': server_data.get('REPORT_API_KEY'),
                            'upload': 0,
                            'event': 'backup'}
        self.cdba_url = server_data.get('REPORT_URL')
        self.check_disk_space = server_data.get('CHECK_DISK_SPACE', True)
        self.defaults_cnf_file = server_data.get('DEFAULTS_FILE', DEFAULT_MYCNF)
        self.hardlink = server_data.get('HARDLINK', True)
        self.post_run_encrypt = server_data.get('POST_RUN_ENCRYPT', False)
        self.only_if_read_only = server_data.get('ONLY_IF_READ_ONLY')
        self.only_if_running_slave = server_data.get('ONLY_IF_RUNNING_SLAVE')
        self.upload_type = server_data.get('UPLOAD')
        self.upload_interval = server_data.get('UPLOAD_INTERVAL', 'weekly')
        self.mycnf_path = server_data.get('MYCNF_PATH')
        self.logging_dir = server_data.get('LOGGING_DIR', DEFAULT_LOGGING_DIR)
        self.all_cnf_files = []
        self.backup_textfile_collector_dir = self.server_data.get(
            'BACKUP_TEXTFILE_COLLECTOR_DIR',
            BACKUP_TEXTFILE_COLLECTOR_DIR
        )

        # set logger if not set
        self.logger = self.logger or logger or logging_setup(self.logging_dir, LOGGING_NAME[self.backup_code])
        logging_set_host(self.alias, LOGGING_NAME[self.backup_code])

        # CDBA report options
        self.report_options = {
            'host': self.alias,
            'status': 'error',
            'start_time': time.strftime(DATETIME_FORMAT, time.gmtime()),
            'end_time': '',
            'size_mb': 0,
            'hl_mb': None,
            'options': {},
            'encryption': 'none'
        }

        # Options for backward-compatibility
        if 'NO_COMPRESS' in server_data:
            self.logger.warning('NO_COMPRESS is deprecated, use opposite COMPRESS option.')
            self.compress = server_data['NO_COMPRESS']

        if server_data.get('UPLOAD_INVERTAL'):
            self.upload_interval = server_data.get('UPLOAD_INVERTAL')
            self.logger.warning('There is a typo in the option name UPLOAD_INVERTAL. Please rename to UPLOAD_INTERVAL')

    def get_default_mycnf(self):
        """return all my.cnf files found
        based on ps or default possible paths
        /etc/my.cnf /etc/mysql/my.cnf /usr/local/etc/my.cnf ~/.my.cnf"""

        possible_files = []
        found_files = []

        result = self._query_mysql('SELECT @@basedir, @@datadir')
        if result['@@basedir']:
            possible_files.append(os.path.join(result['@@basedir'], 'my.cnf'))
            possible_files.append(os.path.join(result['@@datadir'], 'mysqld-auto.cnf'))

        possible_files.append('/etc/my.cnf')
        possible_files.append('/etc/mysql/my.cnf')
        possible_files.append('/usr/local/etc/my.cnf')

        for filen in possible_files:
            if os.path.isfile(filen):
                self.logger.debug("my.cnf file found: %s", filen)
                found_files.append(filen)

        return ",".join(found_files)

    def get_included_config(self, cnf_paths):
        """Create a list of all included cnf files"""
        inc_dirs = []
        for filename in cnf_paths.split(','):
            if not filename in self.all_cnf_files:
                self.all_cnf_files.append(filename)
                for line in open(filename, 'r'):
                    if line.startswith("!includedir"):
                        inc_dirs.append(line.strip().split(" ")[1])
                    elif line.startswith("!include"):
                        self.get_included_config(line.strip().split(" ")[1])
                for inc_dir in inc_dirs:
                    for ffile in os.listdir(inc_dir):
                        if ffile.endswith(".cnf"):
                            self.get_included_config(os.path.join(inc_dir, ffile))

    def backup_mycnf(self, backup_dir):
        """Copy my.cnf file(s) to backup dir"""
        if self.mycnf_path:
            cnf_paths = self.mycnf_path
        else:
            cnf_paths = self.get_default_mycnf()

        if cnf_paths:
            self.get_included_config(cnf_paths)
        else:
            return

        for filename in self.all_cnf_files:
            if os.path.isfile(filename):
                dest_filename = os.path.join(backup_dir, filename.replace("/", "_").strip())
                self.logger.info("Trying to copy %s to %s", filename, dest_filename)
                try:
                    shutil.copy(filename, dest_filename)
                except shutil.Error as err:
                    self.logger.error("%s", str(err))
                except IOError as err:
                    self.logger.error("Error copying %s: %s", filename, str(err))

    def get_datadir(self):
        """returns datadir path"""
        result = self._query_mysql('SELECT @@datadir')
        if result['@@datadir']:
            datadir = result['@@datadir']
        else:
            datadir = '/var/lib/mysql/'
        return datadir

    def backup_certs(self, backup_dir):
        """Copy my.cnf file(s) to backup dir"""
        datadir = self.get_datadir()

        if datadir:
            files = glob.iglob(os.path.join(datadir, "*.pem"))
            for filen in files:
                try:
                    shutil.copy(filen, backup_dir)
                except (shutil.Error, IOError) as err:
                    msg = "Copy of cert files failed: %s" % str(err)
                    self.logger.warning(msg)

    def enable_upload(self, backup_dir):
        """If upload interval permits mark backup for upload by creating uploadme file."""
        intervals = ['daily', 'weekly']
        intervals.extend(list(range(1, 8)))
        if self.upload_interval not in intervals:
            msg = 'Invalid UPLOAD_INTERVAL setting: %s. Should be one of : %s.' % (self.upload_interval, intervals)
            raise BackupError(msg)

        if self.upload_interval != 'daily':
            weekday = self.upload_interval
            if self.upload_interval == 'weekly':
                weekday = 1  # Monday

            # Check if backup_dir name qualifies for upload
            bkp_weekday = parse_weekday_from_str(os.path.basename(backup_dir))
            if not bkp_weekday:
                msg = 'Skipping upload: unknown backup folder format "%s" to determine weekday from it' % (backup_dir,)
                raise BackupError(msg)
            elif bkp_weekday != weekday:
                self.logger.info("Skipping today's upload as weekday %s interval is configured.", weekday)
                return

        uploadme_file = os.path.join(backup_dir, UPLOADME_FILE)
        if self.backup_code == 'H' and not self.host in ['localhost', '127.0.0.1']:
            # Mark remote backup for upload
            # For now only required for MongpDB Cluster HoTBackups
            cmd = 'ssh -tt -q {0} {1} "touch {2}"'.format(SSH_ARGS, self.host, uploadme_file)
            if os.system(cmd) == 0:
                self.logger.info("Remote HotBackup marked for upload.")
        else:
            # Mark for upload
            if not os.path.isfile(uploadme_file):
                open(uploadme_file, 'w').close()
                self.logger.info("Backup marked for upload.")

    def _query_mysql(self, sql, fetchall=False):
        """Execute MySQL query.

        It fetches one record by default unless fetchall=True is passed.
        """
        try:
            conn = MySQLdb.connect(read_default_file=self.defaults_cnf_file,
                                   host=self.host,
                                   port=self.port,
                                   cursorclass=MySQLdb.cursors.DictCursor)
            cursor = conn.cursor()
            cursor.execute(sql)
        except (OperationalError, InternalError) as err:
            msg = 'Error running query "%s": %s' % (sql, err)
            raise BackupError(msg)

        if fetchall:
            result = cursor.fetchall()
        else:
            result = cursor.fetchone()

        return result

    def _is_running_slave(self):
        """Returns true if slave is running.

        It should have a numeric value of Seconds_Behind_Master.
        Also we leverage lock-free SHOW SLAVE STATUS.
        """
        result = None
        for word in ['NONBLOCKING', 'NOLOCK', '']:
            try:
                result = self._query_mysql('SHOW SLAVE STATUS %s' % (word,))
            except ProgrammingError:
                pass
            else:
                break

        if result and result['Slave_IO_Running'] == 'Yes':
            self.logger.info('MySQL slave is running.')
            return True

        return False

    def _is_read_only(self):
        """Returns true if read_only is enabled."""
        result = self._query_mysql('SELECT @@read_only')
        if result['@@read_only'] == 1:
            self.logger.info('MySQL read_only is enabled.')
            return True

        return False

    def _is_pxc(self):
        """Returns true if MySQL is running PXC/Galera cluster."""
        try:
            result = self._query_mysql('SELECT @@wsrep_on')
        except BackupError:
            return False

        if result['@@wsrep_on'] == 1:
            self.logger.info('PXC/Galera cluster detected.')
            return True

        return False

    def _stop_start_slave(self, new_status):
        """Starts or Stops a slave"""
        if self._is_running_slave():
            if new_status == 0:
                try:
                    self._query_mysql('STOP SLAVE SQL_THREAD')
                except BackupError:
                    return False

            if new_status == 1:
                try:
                    self._query_mysql('START SLAVE SQL_THREAD')
                except BackupError:
                    return False
        else:
            return False

        return True

    def _pxc_desync(self, new_status=1):
        """Change wsrep_desync of Galera node.

        Returns true only if wsrep_desync is as requested or changed to it.
        """
        try:
            result = self._query_mysql('SELECT @@wsrep_desync')
        except BackupError:
            return False

        if result['@@wsrep_desync'] != new_status:
            if result['@@wsrep_desync'] == 1:
                recv_queue = self._query_mysql('SHOW GLOBAL STATUS LIKE "wsrep_local_recv_queue"')
                if int(recv_queue['Value']) > 32:
                    logging.warning('Galera node is not synced, queue size is %s', recv_queue['Value'])

            self._query_mysql('SET GLOBAL wsrep_desync = %s' % (new_status,))
            self.logger.info('MySQL wsrep_desync changed to %s', new_status)

        return True


class BackupError(Exception):
    """Typical backup error."""

    def __init__(self, message):
        super(BackupError, self).__init__(self, message)
        self.message = message

class Restore(BaseBackup):  # pylint: disable=too-many-instance-attributes

