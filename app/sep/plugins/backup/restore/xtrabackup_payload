    def set_slave(self):

        if self.continue_replication and self.slave_from_master:
            self.logger.info("Continue and Slave from master are both enabled. "
                             "We are going to set up replication from master.")

        if self.backup_code == 'X':
            xsi = os.path.join(self.datadir, 'xtrabackup_slave_info')
            with open(xsi, 'r') as myfile:
                cm = myfile.readlines()

        try:
            for sql in cm:
                if sql.startswith('CHANGE '):
                    if self.continue_replication and not self.slave_from_master:
                        self.logger.info("Continue replication as backup server did.")
                        res = self._query_mysql('RESET SLAVE')
                        _sql = sql
                    elif self.slave_from_master:
                        _sql = sql.rstrip(';\n') + ', MASTER_HOST = %s, MASTER_USER = %s, MASTER_PASSWORD = %s'
                        _args = (self.master_ip, self.master_user, self.master_password)
                elif sql.startswith('SET GLOBAL gtid_purged'):
                    res = self._query_mysql('RESET MASTER')
                    _sql = sql
                    _args = None
                res = self._query_mysql(_sql, args=_args)
            res = self._query_mysql('START SLAVE')
        except NameError:
            self.logger.warning('Failed to set slave. Verify xtrabackup_slave_info content.')


