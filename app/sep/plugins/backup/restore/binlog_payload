            'start_time': time.strftime(DATETIME_FORMAT, time.gmtime()),
            'end_time': '',
            'run_checksum': self.run_checksum,
            'options': {}
        }
        self.cdba_report = {
            'type': BACKUP_TYPES[self.backup_code],
            'hosts': [],
            'event': 'restore'
        }
        if os.path.basename(self.backup_source) == 'latest':
            if self.backup_source.startswith('s3://'):
                self.backup_source = self._s3_get_path_from_latest()
            elif self.backup_source.startswith('gs://'):
                self.backup_source = self._gs_get_path_from_latest()
            else:
                self.backup_source = self._symlink_to_real()

        self.logger = logging_setup(logging_dir, 'restore.log')

    def _symlink_to_real(self):
        """ get real path from symlink """
        try:
            validate_backup_source_for_shell(self.backup_source)
        except ValueError as exc:
            raise BackupError("Invalid backup_source: %s" % (exc,)) from exc

        rl_cmd = readlink_argv_for_backup_source(
            self.backup_source,
            self.ssh_port,
            self.ssh_user,
        )

        proc = subprocess.Popen(rl_cmd, stdout=subprocess.PIPE)
        real_dir, _ = proc.communicate()
        real_dir = real_dir.decode('utf-8').strip()
        if real_dir:
            return self.backup_source.replace('latest', real_dir)

    def _clean_after_restore(self, local_path):
        """Remove files after restore OK"""
        if self.backup_code in ['B', 'M']:
            shutil.rmtree(local_path)
        elif self.backup_code == 'X':
            os.remove(os.path.join(local_path, 'xtrabackup_logfile'))

    @staticmethod
    def _mysql_client_q_from_file(filename, target_host="localhost", target_port=3306):
        """
        Execute MySQL queries from file using mysql client.
        """
        if os.path.isfile(filename):

            if target_host == "localhost":
                cmd = '/usr/bin/mysql'
            else:
                cmd = '/usr/bin/mysql -h %s -P %s' % (target_host, target_port)
            try:
                with open(filename, 'r') as file_desc:
                    cmd_proc = subprocess.Popen(cmd,
                                                stdout=subprocess.PIPE,
                                                stderr=subprocess.PIPE,
                                                shell=True,
                                                stdin=file_desc)
            except OSError as err:
                msg = 'Error trying to run SQL file %s, Err: %s' % (filename, err)
                raise BackupError(msg)
            _, err = cmd_proc.communicate()
            if cmd_proc.returncode != 0:
                msg = '%s script failure: %s' % (filename, err)
                raise BackupError(msg)
        else:
            msg = 'Script hook file %s does not exists' % filename
            raise BackupError(msg)

    def _run_script(self, pre_post, target_host="localhost", target_port=3306):
        """ Run pre and post scripts """
        if pre_post == 'PRE':
            script_path = self.pre_script
        elif pre_post == 'POST':
            script_path = self.post_script
        else:
            msg = 'Invalid _run_script function call: pre_post != PRE || POST'
            raise BackupError(msg)

        if script_path.endswith('.sql'):
            # Run sql script against mysql
            self._mysql_client_q_from_file(script_path, target_host, target_port)
        else:
            # Run script with subprocess.Popen
            hook_cmd = shlex.split(script_path)
            try:
                hook_proc = subprocess.Popen(hook_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            except OSError as err:
                msg = 'Error trying to run %s, Err: %s' % (script_path, err)
                raise BackupError(msg)

            _, err = hook_proc.communicate()
            if hook_proc.returncode != 0:
                msg = '%s script failure: %s' % (pre_post, err)
                raise BackupError(msg)

    def _gs_get_path_from_latest(self):
        latest_dir = '/tmp/percona_backup_latest'
        latest_local_file_path = os.path.join(latest_dir, 'latest')
        if os.path.isdir(latest_dir):
            shutil.rmtree(latest_dir)
        try:
            os.mkdir(latest_dir)
        except:
            msg = 'Can not create tmp dir for latest file.'
            raise BackupError(msg)

        gs_cmd = [GSUTIL_BIN, 'cp', self.backup_source, latest_local_file_path]
        gs_proc = subprocess.Popen(gs_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = gs_proc.communicate()
        if gs_proc.returncode != 0:
            msg = 'GS latest file download failed. Error: %s' % (err,)
            raise BackupError(msg)

        with open(latest_local_file_path, 'r') as fname:
            latest_backup_source = fname.read().rstrip()

        if 'gs://' in latest_backup_source:
            return latest_backup_source
        else:
            msg = 'GS latest file content is an invalid path. Error: %s' % (err,)
            raise BackupError(msg)

    def _s3_get_path_from_latest(self):
        latest_dir = '/tmp/percona_backup_latest'
        latest_local_file_path = os.path.join(latest_dir, 'latest')
        if os.path.isdir(latest_dir):
            shutil.rmtree(latest_dir)
        try:
            os.mkdir(latest_dir)
        except:
            msg = 'Can not create tmp dir for latest file.'
            raise BackupError(msg)

        # using sync as get was failing PLAT-446
        s3_cmd = [PYTHON_BIN, S3CMD_BIN, 'sync', self.backup_source, latest_local_file_path]
        s3_proc = subprocess.Popen(s3_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = s3_proc.communicate()
        if s3_proc.returncode != 0:
            msg = 'S3 latest file download failed. Error: %s' % (err,)
            raise BackupError(msg)

        with open(latest_local_file_path, 'r') as fname:
            latest_backup_source = fname.read().rstrip()

        if 's3://' in latest_backup_source:
            return latest_backup_source
        else:
            msg = 'S3 latest file content is an invalid path. Error: %s' % (err,)
            raise BackupError(msg)

    def _wait_for_catchup(self):

        sbm = -1
        while sbm != 0:
            result = None
            for word in ['NONBLOCKING', 'NOLOCK', '']:
                try:
                    result = self._query_mysql('SHOW SLAVE STATUS %s' % (word,))
                except ProgrammingError:
                    pass
                else:
                    break

            if result and result['Seconds_Behind_Master'] is not None:
                sbm = result['Seconds_Behind_Master']
                if sbm == 0:
                    self.logger.info('MySQL slave is up to date.')
                else:
                    self.logger.info('MySQL slave is %s seconds behind.', sbm)
                    time.sleep(5)
            else:
                self.logger.info('MySQL slave is broken.')
                return False

        return True

    def _query_mysql(self, sql, fetchall=False, host=None, port=None, args=None):
        """Execute MySQL query.

        It fetches one record by default unless fetchall=True is passed.
        """
        host = host if host else self.host
        port = port if port else self.port

        try:

            conn = MySQLdb.connect(read_default_file=self.defaults_cnf_file,
                                   host=host,
                                   port=port,
                                   cursorclass=MySQLdb.cursors.DictCursor)
            cursor = conn.cursor()
            cursor.execute(sql, [] if not args else args)
        except (OperationalError, InternalError) as err:
            msg = 'Error running query "%s": %s' % (sql, err)
            raise BackupError(msg)

        if fetchall:
            result = cursor.fetchall()
        else:
            result = cursor.fetchone()

        return result

    def _is_running_slave(self):
        """Returns true if slave is running.

        It should have a numeric value of Seconds_Behind_Master.
        Also we leverage lock-free SHOW SLAVE STATUS.
        """
        result = None
        for word in ['NONBLOCKING', 'NOLOCK', '']:
            try:
                result = self._query_mysql('SHOW SLAVE STATUS %s' % (word,))
            except ProgrammingError:
                pass
            else:
                break

        if result and result['Slave_IO_Running'] == 'Yes':
            self.logger.info('MySQL slave is running.')
            return True

        return False

    def checksum_run(self):
        """Run checksum on the master"""
        ptc_command = ['pt-table-checksum', '--no-check-binlog-format']
        ptc_command.append('--host=%s' % self.master_ip)

        if self.pt_checksum_extra_args:
            ptc_command.extend(self.pt_checksum_extra_args.split(' '))

        self.logger.info('Running: %s', ' '.join(ptc_command))
        proc = subprocess.Popen(ptc_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = proc.communicate()
        if err:
            msg = 'Checksum failed: %s' % (err)
            raise BackupError(msg)

    def checksum_check(self):
        """Check checksum diffs"""
        check_query = (
            "SELECT db, tbl, SUM(this_cnt) AS total_rows, COUNT(*) AS chunks "
            "FROM percona.checksums "
            "WHERE ( "
            " master_cnt <> this_cnt "
            " OR master_crc <> this_crc "
            " OR ISNULL(master_crc) <> ISNULL(this_crc)) "
            "GROUP BY db, tbl")
        result = self._query_mysql(check_query)
        return not result

    def rsync_copy(self, source, destination, log_file, **kwargs):
        """ Rsync remote backups """

        try:
            validate_backup_source_for_shell(source)
        except ValueError as exc:
            raise BackupError("Invalid backup_source: %s" % (exc,)) from exc

        info_file = {'X': 'xtrabackup_info', 'M': 'metadata'}
        info_only = kwargs.get('info_only', False)
        files_list = kwargs.get('files_list', [])

        if files_list:
            include_args = []
            for f in files_list:
                f = f.strip()
                if f:
                    include_args.append('--include=%s' % f)
            exclude_args = ['--exclude=*']
        elif info_only and self.backup_code in info_file:
            exclude_args = ['--exclude=*']
            include_args = ['--include=%s*' % info_file[self.backup_code]]
        else:
            exclude_args = []
            for path in kwargs.get('exclude', []):
                if path.strip():
                    exclude_args.append('--exclude=%s.*' % path.strip())

            include_args = []
            for path in kwargs.get('include', []):
                if path.strip():
                    include_args.append('--include=%s.*' % path.strip())

            if include_args and not exclude_args:
                exclude_args = ['--exclude=*']
                include_args.append('--include=metadata*')

        if os.path.isdir(destination):
            shutil.rmtree(destination)

        os.makedirs(destination, exist_ok=True)

        rsync_cmd = rsync_remote_restore_argv(
            include_args=include_args,
            exclude_args=exclude_args,
            ssh_port=self.ssh_port,
            ssh_user=self.ssh_user,
            remote_source=source,
            destination=destination,
        )

        self.logger.info('Running: %s', ' '.join(rsync_cmd))
        log_stream = open(log_file, 'a')
        proc = subprocess.Popen(rsync_cmd, stdout=log_stream, stderr=log_stream)
        proc.communicate()
        if proc.returncode != 0:
            msg = 'Rsync failed.'
            raise BackupError(msg)

    def gs_copy(self, source, destination, log_file, **kwargs):
        """ Copy files from a GS bucket """

        info_file = {'X': 'xtrabackup_info', 'M': 'metadata'}
        info_only = kwargs.get('info_only', False)
        files_list = kwargs.get('files_list', [])

        if files_list:
            escaped_files = [re.escape(f.strip()) for f in files_list if f.strip()]
            files_pattern = '|'.join(escaped_files)
            regex_args = '-x "^(?!.*(%s)$).*"' % files_pattern
        elif info_only and self.backup_code in info_file:
            regex_args = '-x "^(?!.*%s$)"' % info_file[self.backup_code]
        else:
            regex_args = '-x "^(?!((binlog\\.[0-9]{6})$)).*"'

        if os.path.isdir(destination):
            shutil.rmtree(destination)

        os.mkdir(destination)
        destination_dir = os.path.normpath(destination) + os.sep

        download_cmd = '%s -m rsync -r %s %s %s' \
                       % (GSUTIL_BIN, regex_args, source, destination_dir)

        self.logger.info('Running: %s', download_cmd)
        log_stream = open(log_file, 'a')
        proc = subprocess.Popen(download_cmd, stdout=log_stream, stderr=log_stream, shell=True)
        proc.communicate()
        if proc.returncode != 0:
            msg = 'GS download failed.'
            raise BackupError(msg)

    def s3_copy(self, source, destination, log_file, **kwargs):
        """ Copy files from a S3 bucket """

        info_file = {'X': 'xtrabackup_info', 'M': 'metadata'}
        info_only = kwargs.get('info_only', False)
        files_list = kwargs.get('files_list', False)

        if info_only and self.backup_code in info_file:
            exclude_args = '--exclude="*"'
            include_args = '--include="%s*"' % info_file[self.backup_code]
        elif files_list:
            exclude_args = '--exclude="*"'
            include_args = ''
            try:
                for line in files_list:
                    line = line.strip()
                    if line:
                        filename = line.split('/')[-1] if '/' in line else line
                        include_args += '--include="%s" ' % filename
            except Exception as e:
                raise BackupError(f"Error reading files list: {e}")
        else:
            exclude_args = ""
            for path in kwargs.get('exclude', []):
                if path.strip():
                    exclude_args += '--exclude="%s.*" ' % path.strip()

            include_args = ""
            for path in kwargs.get('include', []):
                if path.strip():
                    include_args += '--include="%s.*" ' % path.strip()

            if include_args and not exclude_args:
                exclude_args = '--exclude="*"'
                include_args += '--include="metadata*" '

        if os.path.isdir(destination):
            shutil.rmtree(destination)
            os.mkdir(destination)
        destination_dir = os.path.normpath(destination) + os.sep

        if self.s3_tool == 'awscli':
            download_cmd = '%s s3 sync %s %s %s %s' \
                           % (AWS_BIN, source, destination_dir, exclude_args, include_args)
        else:
            download_cmd = '%s/bin/s3cmd sync %s %s %s %s' \
                           % (INSTALL_DIR, source, destination_dir, exclude_args, include_args)

        self.logger.info('Running: %s', download_cmd)
        log_stream = open(log_file, 'a')
        proc = subprocess.Popen(download_cmd, stdout=log_stream, stderr=log_stream, shell=True)
        proc.communicate()
        if proc.returncode != 0:
            msg = 'S3 download failed.'
            raise BackupError(msg)

    def local_copy(self, source, destination, **kwargs):
        """ Copy local files to destination to be restored """

        info_file = {'X': 'xtrabackup_info', 'M': 'metadata'}
        info_only = kwargs.get('info_only', False)

        if info_only and self.backup_code in info_file:
            files = glob.iglob(os.path.join(source, "%s*" % info_file[self.backup_code]))
            for filen in files:
                try:
                    shutil.copy(filen, destination)
                except Exception as err:
                    msg = "Copy failed: %s" % err
                    raise BackupError(msg)
        else:
            if os.path.isdir(destination):
                shutil.rmtree(destination)
            try:
                if self.include_databases or self.skip_databases:
                    shutil.copytree(source, destination, ignore=self._ignore_databases)
                else:
                    shutil.copytree(source, destination)
            except Exception as err:
                msg = "Copy failed: %s" % err
                raise BackupError(msg)

    def _ignore_databases(self, _, filenames):
        ignored = []
        for filen in filenames:
            if filen == 'metadata':
                continue
            if self.include_databases:
                if not filen.startswith(tuple(self.include_databases)):
                    ignored.append(filen)
            elif self.skip_databases:
                if filen.startswith(tuple(self.skip_databases)):
                    ignored.append(filen)
        return ignored

    @staticmethod
    def is_encrypted(path):
        """ Returns encrytion method
            Possible values:
                - gpg
                - aes
                - False if none
        """

        for _, _, files in os.walk(path):
            for filen in files:
                if filen.endswith(".gpg"):
                    return "gpg"
                elif filen.endswith(".xbcrypt"):
                    return "aes"
            break

        return False

    def decrypt_gpg(self, path):
        """ descrypt gpg files with dir_encrypt """
        decrypt_dir(path, self.gpg_password_file, self.logger)

    @staticmethod
    def is_binlog_compressed(path):
        """
        :return: Returns compression type
        :rtype: str
        """

        for _, _, files in os.walk(path):
            for filen in files:
                if filen.endswith(".gz"):
                    return "gz"
            break

        return False

    def decompress_binlog(self, method, path):
        """
        Decompress the binary logs
        """
        self.logger.info('Decompressing binlogs...')

        if method == 'gz':
            decompress_cmd = ['/usr/bin/gzip', '-dr', path]
        else:
            msg = 'Decompression method not implemented: %s' % (method,)
            raise BackupError(msg)

        self.logger.info('Running: %s', ' '.join(decompress_cmd))
        decompress_proc = subprocess.Popen(decompress_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        _, err = decompress_proc.communicate()
        if decompress_proc.returncode != 0:
            msg = 'Decompression failed. Error: %s' % (err,)
            raise BackupError(msg)

        self.logger.info('Decompressing binlogs complete.')

class Restorer(object):  # pylint: disable=too-many-instance-attributes
    """ Parent Restorer Class """
    def __init__(self, options):

        self.logger = None
        self.config_path = options.config_path
        self.backup_type = None
        self.backup_path = None

    def run(self):
        local_cfg = LocalConfig(self.config_path)

        logging_dir = Path(
            local_cfg.raw_cfg_data["ALL_SERVERS"].get(
                "LOGGING_DIR", DEFAULT_LOGGING_DIR
            )
        )
        self.logger = logging_setup(logging_dir, 'restore.log')

        # Get a lock
        lockfile_name = os.path.join(logging_dir, '.lock_restore')
        lock_file = LockFile(lockfile_name, timeout=600)
        lock_file.get_lock_or_exit()

        # Read config if not manual run
        if self.backup_path is None:
            # Obtain server list
            servers = [s for s in local_cfg.server_data_list]

        start_time = time.time()
        self.logger.info('>>>>>>>>>>>>>>>>>> Restore started.')

        rst = None
        for server_data in servers:
            self.backup_type = server_data.get('BACKUP_TYPE')

            if self.backup_type == 'B':
                rst = Binlog(server_data)
            else:
                self.logger.error('No Restores to run.')

            if rst:
                try:
                    rst.run()
                except BackupError as exc:
                    self.logger.error(exc.message)
                    self.logger.error('Restore failed for this host.')
                    rst.notify(STATUS_CRITICAL, exc.message)
                except Exception:
                    self.logger.exception('Unhandled exception occurred.')
                    rst.notify(STATUS_CRITICAL, 'Unhandled exception occurred during restore.')
        time_spent = time.time() - start_time
        self.logger.info('>>>>>>>>>>>>>>>>>> Restore finished. Total duration: %s.',
                         format_seconds_to_hhmmss(time_spent))

        # Release lock
        lock_file.free_lock()

class Binlog(Restore):
    """Apply binlogs for individual server."""

    def __init__(self, server_data):
        """Define server options."""
        # Init common options
        super(Binlog, self).__init__(server_data, 'B')
        self.from_commandline = server_data.get('FROM_COMMANDLINE', False)
        self.alias = server_data.get('ALIAS', None)

        self.local_path = server_data.get('LOCAL_PATH', '/tmp')
        self.start_file = server_data.get('START_FILE')
        self.start_position = server_data.get('START_POSITION')
        self.stop_file = server_data.get('STOP_FILE')
        self.stop_position = server_data.get('STOP_POSITION')
        self.use_sql_file = server_data.get('USE_SQL_FILE')
        self.binlog_restore_extra_args = server_data.get('BINLOG_RESTORE_EXTRA_ARGS')

        self.local_path = os.path.join(self.local_path, 'restore_binlogs')

        self.logging_dir = server_data.get('LOGGING_DIR', DEFAULT_LOGGING_DIR)
        self.logger = logging_setup(self.logging_dir, 'restore.log')
        self.fd_list = None
        if self.alias:
            logging_set_host(server_data.get('ALIAS'), 'restore.log')

    def run(self):
        """ Copy back and prepare files"""

        start_time = time.time()

        # set mysqlbinlog binary own log file
        self.mb_log_file = os.path.join(self.logging_dir, 'restore_binlogs-%s.log' % (time.strftime('%Y%m%d')))

        self.copy_back()
        encryption = self.is_encrypted(self.local_path)
        if encryption:
            if encryption == 'gpg':
                self.decrypt_gpg(self.local_path)
            else:
                msg = 'Encryption %s not supported for binlogs.' % encryption
                raise BackupError(msg)

        is_binlog_compressed = self.is_binlog_compressed(self.local_path)
        if is_binlog_compressed:
            self.decompress_binlog(is_binlog_compressed, self.local_path)

        latest_file = self._run_mysqlbinlog()
        if latest_file:
            self._print_new_binlog_position(latest_file)
        self._clean_after_restore(self.local_path)

        time_spent = time.time() - start_time
        self.report_options['time_spent_seconds'] = time_spent
        self.notify(STATUS_OK, 'Binlog restore completed.')

    def _print_new_binlog_position(self, latest_file):
        """ get and log new binlog position """

        latest_pos = 0
        if self.use_sql_file:
            tail_cmd = "tail -n500 %s" % os.path.join(self.local_path, 'restore.sql')
        else:
            tail_cmd = "%s %s | tail -n500" % (MYSQLBINLOG_CMD, os.path.join(self.local_path, latest_file))

        tail_proc = subprocess.Popen(tail_cmd, stdout=subprocess.PIPE,stderr=subprocess.PIPE, shell=True)
        line = tail_proc.stdout.readline().decode('utf-8')
        while line:
            match_pos = re.search(r'^#\sat\s([\d]*)$', line)
            if match_pos:
                latest_pos = match_pos.group(1)
            line = tail_proc.stdout.readline().decode('utf-8')

        if latest_pos:
            self.logger.info("New latest binlog position: %s %s", latest_file, latest_pos)
        else:
            self.logger.warn("Unable to find the get latest binlog position")

    def _get_binlog_list(self):
        """ return a sorted list of binlog files """

        files = os.listdir(self.local_path)
        files = [x for x in files if not x.endswith('partial') and x != UPLOADME_FILE]
        files.sort()
        return files

    @staticmethod
    def _get_binlog_index(filename):
        """ returns the index as int of a binlog file """

        try:
            f_index = re.search(r'[^.]*[\.](\d{6})[.\s]*', filename).group(1)
        except (AttributeError) as err:
            msg = 'invalid binlog filename %s' % filename
            raise BackupError(msg)

        return int(f_index)

    def _run_mysqlbinlog(self):
        """MYSQLBINLOG_CMD"""

        start_index = 0
        stop_index = 999999
        b_files_list = self._get_binlog_list()

        binlog_cmd = [MYSQLBINLOG_CMD]

        if self.binlog_restore_extra_args:
            binlog_cmd.extend(shlex.split(self.binlog_restore_extra_args))

        if self.start_position:
            binlog_cmd.append('--start-position=%s' % self.start_position)

        if self.stop_position:
            binlog_cmd.append('--stop-position=%s' % self.stop_position)

        if self.start_file:
            start_file_to_process = self.start_file
            if self.start_file.startswith(('s3://', 'gs://')):
                start_file_to_process = self.start_file.rstrip('/').split('/')[-1]
            elif ':' in self.start_file and not self.start_file.startswith(('s3://', 'gs://')):
                start_file_to_process = self.start_file.split('/')[-1]
            start_index = self._get_binlog_index(start_file_to_process)

        if self.stop_file:
            stop_file_to_process = self.stop_file
            if self.stop_file.startswith(('s3://', 'gs://')):
                stop_file_to_process = self.stop_file.rstrip('/').split('/')[-1]
            elif ':' in self.stop_file and not self.stop_file.startswith(('s3://', 'gs://')):
                stop_file_to_process = self.stop_file.split('/')[-1]
            stop_index = self._get_binlog_index(stop_file_to_process)

        for bfile in b_files_list:
            bfile_index = self._get_binlog_index(bfile)
            if bfile_index > stop_index:
                break
            if bfile_index >= start_index:
                binlog_cmd.append(os.path.join(self.local_path, bfile))
                latest_file = bfile

        if self.use_sql_file:
            binlog_cmd.append('>')
            binlog_cmd.append('%s/restore.sql' % self.local_path)
        else:
            binlog_cmd.append('|')
            binlog_cmd.append('mysql')
            binlog_cmd.append('-Bn')

        self.logger.info('Running: %s', ' '.join(binlog_cmd))
        mb_log_stream = open(self.mb_log_file, 'a')
        proc = subprocess.Popen(' '.join(binlog_cmd), stdout=mb_log_stream, stderr=mb_log_stream, shell=True)
        proc.communicate()
        if proc.returncode != 0:
            mb_log_stream = open(self.mb_log_file, 'r')
            err = mb_log_stream.readlines()[-1]
            msg = 'mysqlbinlog failed: %s For more details, see %s' % (err, self.mb_log_file)
            raise BackupError(msg)

        if self.use_sql_file:
            binlog_cmd = ['cat', '%s/restore.sql' % self.local_path, '|', 'mysql', '-Bn']
            self.logger.info('Running: %s', ' '.join(binlog_cmd))
            proc = subprocess.Popen(' '.join(binlog_cmd), stdout=mb_log_stream, stderr=mb_log_stream, shell=True)
            proc.communicate()
            if proc.returncode != 0:
                mb_log_stream = open(self.mb_log_file, 'r')
                err = mb_log_stream.readlines()[-1]
                msg = 'running sql file failed: %s For more details, see %s' % (err, self.mb_log_file)
                raise BackupError(msg)

        self.logger.info('OK restoring binlogs.')
        return latest_file

    def copy_back(self):
        """
        Copies backup files from a remote source (S3, GS, or rsync) or a local source
        to the local path. For remote sources, it generates a list of files to copy.
        """

        if ':' in self.backup_source:
            files_to_copy = self._create_file_list()
            if self.backup_source.startswith('s3:'):
                source_path = self.backup_source
                self.s3_copy(source_path,
                            self.local_path,
                            self.mb_log_file,
                            files_list=files_to_copy)
            elif self.backup_source.startswith('gs:'):
                source_path = self.backup_source
                self.gs_copy(source_path,
                            self.local_path,
                            self.mb_log_file,
                            files_list=files_to_copy)
            else:
                source_path = self.backup_source if self.backup_source.endswith('/') else self.backup_source + '/'
                self.rsync_copy(source_path,
                                self.local_path,
                                self.mb_log_file,
                                files_list=files_to_copy)
        else:
            self.local_copy(os.path.join(self.backup_source, ""), self.local_path)

        self.logger.info('OK Copy Backup complete.')

    def _create_file_list(self):

        """
        Generates a list of filenames (not full paths) to be copied from the backup source.
        Supports S3, GS, and rsync sources. Returns a list of file names.
        """

        start_file_idx = 0
        if self.start_file:
            start_file_to_process = self.start_file
            if self.start_file.startswith(('s3://', 'gs://')):
                start_file_to_process = self.start_file.rstrip('/').split('/')[-1]
            elif ':' in self.start_file and not self.start_file.startswith(('s3://', 'gs://')):
                start_file_to_process = self.start_file.split('/')[-1]

            if start_file_to_process and start_file_to_process != self.start_file:
                start_file_idx = self._get_binlog_index(start_file_to_process)
            elif start_file_to_process:
                start_file_idx = self._get_binlog_index(self.start_file)

        ls_cmd = []
        source_path = os.path.join(self.backup_source, "")

        if self.s3_tool == 'awscli':
            ls_cmd = [AWS_BIN, 's3', 'ls', source_path]
        elif self.backup_source.startswith('s3:'):
            ls_cmd = [PYTHON_BIN, S3CMD_BIN, 'ls', source_path]
        elif self.backup_source.startswith('gs:'):
            ls_cmd = [GSUTIL_BIN, 'ls', source_path]
        else:
            try:
                host, path = self.backup_source.split(':', 1)
                ls_cmd = 'ssh -t -p %s -i /home/%s/.ssh/id_rsa %s@%s ls -1 %s' % (self.ssh_port, self.ssh_user, self.ssh_user, host, path)
            except ValueError:
                self.logger.error("Invalid rsync source format: %s", self.backup_source)
                return None
        try:
            if isinstance(ls_cmd, str):
                ls_proc = subprocess.Popen(ls_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=True)
            else:
                ls_proc = subprocess.Popen(ls_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            stdout, stderr = ls_proc.communicate()
        except OSError as e:
            cmd_str = ls_cmd if isinstance(ls_cmd, str) else ' '.join(ls_cmd)
            self.logger.error("Error executing command %s: %s", cmd_str, e)
            return None
        if stderr:
            self.logger.warning("Error while listing files: %s", stderr.decode(sys.stdout.encoding, errors='ignore'))
        files = []
        for line in stdout.decode(sys.stdout.encoding, errors='ignore').splitlines():
            line = line.strip()
            filename = None
            if line.startswith("gs://"):
                filename = line.rstrip('/').split('/')[-1]
            elif line.startswith("s3://"):
                filename = line.rstrip('/').split('/')[-1]
            else:
                parts = line.split()
                if len(parts) >= 4:
                    filename = parts[3] if not parts[3].startswith('/') else parts[3].split('/')[-1]
                elif len(parts) >= 1:
                    filename = parts[0].split('/')[-1] if '/' in parts[0] else parts[0]

            if filename and not filename.endswith('/') and 'binlog' in filename.lower():
                try:
                    if self._get_binlog_index(filename) >= start_file_idx:
                        files.append(filename)
                except BackupError:
                    continue

        if not files:
            self.logger.warning("No files found to copy from: %s", self.backup_source)
        return files
def main():
    """Main"""
    preflight_check()
    options = parse_args()

    restore_runner = Restorer(options)
    restore_runner.run()

def parse_args():
    """Parse Arguments"""
    parser = argparse.ArgumentParser()
    parser.add_argument('--config-path',
                        help='File name of the YAML config'
                    )
    options = parser.parse_args()
    return options

if __name__ == "__main__":
    main()
