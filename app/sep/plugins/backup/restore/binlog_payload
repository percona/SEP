def validate_backup_source_for_shell(value: str) -> None:
    if not value:
        return
    if "\n" in value or "\r" in value:
        raise ValueError("backup_source must not contain newline characters")
    bad = FORBIDDEN_SHELL_METACHARS.intersection(value)
    if bad:
        raise ValueError(
            "backup_source contains disallowed shell metacharacters; remove special characters from the backup source field"
        )


def readlink_argv_for_backup_source(
    backup_source: str,
    ssh_port: int,
    ssh_user: str,
    ssh_identity_path: Optional[str] = None,
) -> List[str]:
    identity = ssh_identity_path or f"/home/{ssh_user}/.ssh/id_rsa"
    if ":" in backup_source:
        host, path = backup_source.split(":", 1)
        return [
            "ssh",
            "-p",
            str(ssh_port),
            "-l",
            ssh_user,
            "-i",
            identity,
            host,
            "readlink",
            "-n",
            "--",
            path,
        ]
    return ["readlink", "-n", "--", backup_source]


def rsync_remote_restore_argv(
    *,
    include_args: List[str],
    exclude_args: List[str],
    ssh_port: int,
    ssh_user: str,
    remote_source: str,
    destination: str,
    ssh_identity_path: Optional[str] = None,
) -> List[str]:
    identity = ssh_identity_path or f"/home/{ssh_user}/.ssh/id_rsa"
    identity_quoted = shlex.quote(identity)
    rsh = f"ssh -t -p {ssh_port} -i {identity_quoted}"
    remote_spec = f"{ssh_user}@{remote_source}"
    return [
        "rsync",
        "-LAvhr",
        *include_args,
        *exclude_args,
        "--rsync-path=sudo rsync",
        "-e",
        rsh,
        remote_spec,
        destination,
    ]


