""" PBM Logical Payload """

import subprocess
import os
import sys

def pbm_creds():
    """ PBM Credentials """
    envhome = os.environ['HOME']
    command_creds = ['cat', f'{envhome}/.mongodb_uri']
    try:
        result = subprocess.run(command_creds,
                                stdout=subprocess.PIPE,
                                check=True)
    except subprocess.CalledProcessError:
        sys.exit(1)

    return result.stdout.decode().strip()

def pbm():
    """ PBM Logical Payload """

    mongodb_uri = pbm_creds()
    cmd = ['pbm', '--mongodb-uri', mongodb_uri, 'backup', '--type', 'logical']

    try:
        proc = subprocess.Popen(cmd)
        proc.wait()
        ret_code = proc.poll()
        if ret_code != 0:
            sys.exit(ret_code)

    except subprocess.CalledProcessError as err:
        print(f"Command failed with error: {err}")
        sys.exit(1)

pbm()
