""" PBM Config Payload """

import subprocess
import os
import sys


def _creds_path():
    """ Path to MongoDB URI credentials file """
    path = os.environ.get('PBM_CREDENTIALS_PATH')
    if path:
        return path
    envhome = os.environ.get('HOME')
    if not envhome:
        print("PBM credentials path not set (PBM_CREDENTIALS_PATH) and HOME is unset", file=sys.stderr)
        sys.exit(1)
    return f'{envhome}/.mongodb_uri'


def pbm_creds():
    """ PBM Credentials """
    creds_path = _creds_path()
    try:
        with open(creds_path, 'r', encoding='utf-8') as fpt:
            return fpt.read().strip()
    except Exception:
        sys.exit(1)

def pbm():
    """ PBM Config Payload """

    taskdir = os.environ['NOMAD_TASK_DIR']
    #if os.path.basename(taskdir) == 'local':
    #    taskdir = os.path.dirname(taskdir)

    os.environ['PBM_MONGODB_URI'] = pbm_creds()

    config_file = f'{taskdir}/script_config'
    cmd = ['pbm',
           'config',
           '--file',
           config_file
           ]

    try:
        proc = subprocess.Popen(cmd)
        proc.wait()
        ret_code = proc.poll()
        if ret_code != 0:
            sys.exit(ret_code)

    except subprocess.CalledProcessError as err:
        print(f"Command failed with error: {err}")
        sys.exit(1)

pbm()
