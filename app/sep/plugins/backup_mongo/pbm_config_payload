""" PBM Config Payload """

import subprocess
import os
import sys
import yaml


SEP_ONLY_CONFIG_KEYS = frozenset({
    'credentials_path', 'credentialsPath'
})


def _config_for_pbm(config):
    """ Return config dict with SEP-only keys removed, for use with pbm config --file """
    if not config:
        return {}
    return {
        k: v for k, v in config.items()
        if k not in SEP_ONLY_CONFIG_KEYS and v is not None
    }


def _creds_path():
    """ Path to MongoDB URI credentials file """
    config_yaml = os.environ.get('NOMAD_META_CONFIG')
    if config_yaml:
        try:
            config = yaml.safe_load(config_yaml)
            if config:
                path = config.get('credentials_path')
                if path:
                    return path
        except yaml.YAMLError as err:
            print(f'Failed to parse NOMAD_META_CONFIG as YAML: {err}. Falling back to HOME-based credentials path.', file=sys.stderr)
    envhome = os.environ.get('HOME')
    if not envhome:
        print('PBM credentials path not set (credentials_path in backup config) and HOME is unset', file=sys.stderr)
        sys.exit(1)
    return f'{envhome}/.mongodb_uri'


def pbm_creds():
    """ PBM Credentials """
    creds_path = _creds_path()
    try:
        with open(creds_path, 'r', encoding='utf-8') as fpt:
            return fpt.read().strip()
    except FileNotFoundError as err:
        print(f'Credentials file not found: {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)
    except PermissionError as err:
        print(f'Permission denied reading credentials file {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)
    except OSError as err:
        print(f'Error reading credentials file {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)
    except Exception as err:
        print(f'Error reading credentials file {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)

def pbm():
    """ PBM Config Payload """

    taskdir = os.environ['NOMAD_TASK_DIR']
    #if os.path.basename(taskdir) == 'local':
    #    taskdir = os.path.dirname(taskdir)

    os.environ['PBM_MONGODB_URI'] = pbm_creds()

    # Write PBM config file (full config minus SEP-only keys like credentials_path).
    # Always create the file so "pbm config --file" never sees a missing path; use {}
    # when config is absent or contains only SEP-only keys (e.g. credentials_path).
    config_yaml = os.environ.get('NOMAD_META_CONFIG')
    config_file = f'{taskdir}/script_config'
    pbm_config = {}
    if config_yaml:
        try:
            config = yaml.safe_load(config_yaml)
            if config is not None:
                pbm_config = _config_for_pbm(config)
        except Exception as e:
            print(f'Failed to parse backup config YAML, using empty PBM config: {e}', file=sys.stderr)
    with open(config_file, 'w', encoding='utf-8') as f:
        yaml.dump(
            pbm_config,
            f,
            default_flow_style=False,
            allow_unicode=True,
        )
    cmd = ['pbm',
           'config',
           '--file',
           config_file,
           ]

    try:
        proc = subprocess.Popen(cmd)
        proc.wait()
        ret_code = proc.poll()
        if ret_code != 0:
            sys.exit(ret_code)

    except OSError as err:
        print(f'Failed to run pbm: {err}', file=sys.stderr)
        sys.exit(1)

pbm()
