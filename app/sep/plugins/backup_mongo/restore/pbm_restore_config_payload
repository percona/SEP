""" PBM Restore Config Payload """

import subprocess
import os
import sys
import yaml

def pbm_creds():
    """ PBM Credentials """
    envhome = os.environ['HOME']
    creds_path = f'{envhome}/.mongodb_uri'
    try:
        with open(creds_path, 'r', encoding='utf-8') as fpt:
            creds = fpt.read().strip()
    except Exception:
        sys.exit(1)

    return creds

def pbm():
    """ PBM Restore Config Payload """

    taskdir = os.environ['NOMAD_TASK_DIR']
    config_file = f'{taskdir}/script_config'

    os.environ['PBM_MONGODB_URI'] = pbm_creds()

    # Load configuration
    with open(config_file, 'r', encoding='utf-8') as f:
        config = yaml.safe_load(f)

    # Get restore configuration
    restore_config = config.get('RESTORE', {})

    # Update restore section in config if restore options are provided
    if restore_config:
        # Update restore section in config
        if 'restore' not in config:
            config['restore'] = {}

        # Set restore options
        if restore_config.get('batchSize'):
            config['restore']['batchSize'] = restore_config['batchSize']
        if restore_config.get('numInsertionWorkers'):
            config['restore']['numInsertionWorkers'] = restore_config['numInsertionWorkers']
        if restore_config.get('numParallelCollections'):
            config['restore']['numParallelCollections'] = restore_config['numParallelCollections']
        if restore_config.get('numDownloadWorkers'):
            config['restore']['numDownloadWorkers'] = restore_config['numDownloadWorkers']
        if restore_config.get('maxDownloadBufferMb'):
            config['restore']['maxDownloadBufferMb'] = restore_config['maxDownloadBufferMb']
        if restore_config.get('downloadChunkMb'):
            config['restore']['downloadChunkMb'] = restore_config['downloadChunkMb']
        if restore_config.get('mongodLocation'):
            config['restore']['mongodLocation'] = restore_config['mongodLocation']
        if restore_config.get('mongodLocationMap'):
            config['restore']['mongodLocationMap'] = restore_config['mongodLocationMap']

        # Write updated config back to script_config
        with open(config_file, 'w', encoding='utf-8') as f:
            yaml.dump(config, f, default_flow_style=False)

    # Sync config using pbm config command (like pbm_config_payload)
    config_cmd = ['pbm', 'config', '--file', config_file]
    try:
        proc = subprocess.Popen(config_cmd)
        proc.wait()
        ret_code = proc.poll()
        if ret_code != 0:
            sys.exit(ret_code)
    except subprocess.CalledProcessError as err:
        print(f"Command failed with error: {err}")
        sys.exit(1)

    # Get current PBM config to verify storage is configured (backup source)
    pbm_config_cmd = ['pbm', 'config']
    try:
        proc = subprocess.Popen(pbm_config_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        stdout, stderr = proc.communicate()
        if proc.returncode != 0:
            print(f"Error getting PBM config: {stderr.decode()}")
            sys.exit(1)

        # Parse PBM config output to verify storage is configured
        pbm_config = yaml.safe_load(stdout.decode())
        storage = pbm_config.get('storage', {})

        if not storage:
            print("Error: Storage is not configured in PBM")
            sys.exit(1)

        storage_type = storage.get('type')
        if not storage_type:
            print("Error: Storage type is not configured")
            sys.exit(1)

        # Verify storage-specific configuration exists
        if storage_type == 'filesystem':
            if not storage.get('filesystem', {}).get('path'):
                print("Error: Filesystem storage path is not configured")
                sys.exit(1)
        elif storage_type == 's3':
            s3_config = storage.get('s3', {})
            if not s3_config.get('bucket'):
                print("Error: S3 bucket is not configured")
                sys.exit(1)

        print(f"Storage configured: {storage_type}")

    except Exception as err:
        print(f"Error parsing PBM config: {err}")
        sys.exit(1)

pbm()
