""" PBM Logical Restore Payload """

import subprocess
import os
import sys
import yaml


def _creds_path_from_config(config):
    """ Path to MongoDB URI credentials file from config dict """
    if config:
        path = config.get('credentials_path')
        if path:
            return path
    envhome = os.environ.get('HOME')
    if not envhome:
        print('PBM credentials path not set (credentials_path in restore config) and HOME is unset', file=sys.stderr)
        sys.exit(1)
    return f'{envhome}/.mongodb_uri'


def pbm_creds(config):
    """ PBM Credentials """
    creds_path = _creds_path_from_config(config)
    try:
        with open(creds_path, 'r', encoding='utf-8') as fpt:
            return fpt.read().strip()
    except FileNotFoundError as err:
        print(f'Credentials file not found: {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)
    except PermissionError as err:
        print(f'Permission denied reading credentials file {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)
    except OSError as err:
        print(f'Error reading credentials file {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)
    except Exception as err:
        print(f'Error reading credentials file {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)


def pbm():
    """ PBM Logical Restore Payload """

    taskdir = os.environ['NOMAD_TASK_DIR']
    config_file = f'{taskdir}/script_config'

    # Load configuration
    with open(config_file, 'r', encoding='utf-8') as f:
        config = yaml.safe_load(f)

    os.environ['PBM_MONGODB_URI'] = pbm_creds(config)

    # Get backup name from config (backup timestamp/name to restore) - PBM format
    backup_name = config.get('backupSource')

    if not backup_name:
        print("Error: BACKUP_SOURCE (backup name) is required")
        sys.exit(1)

    # Build restore command
    cmd = ['pbm', 'restore', backup_name, '--wait']

    proc = subprocess.Popen(cmd)
    proc.wait()
    ret_code = proc.poll()
    if ret_code != 0:
        sys.exit(ret_code)

pbm()
