"""MUM Python payload to interact with MongoDB via PyMongo.

Supported actions (via --config file containing JSON):
- {"action":"list_users"}
- {"action":"create_user", "username":"...", "password":"...",
   "roles":["readWrite","dbAdmin"] or [{"role":"readWrite","db":"admin"}, ...],
   "db":"admin"}
- {"action":"update_user", "username":"...", "password":"optional",
   "roles":[...], "db":"admin"}
- {"action":"delete_user", "username":"...", "db":"admin"}

When no config is provided, defaults to list_users.
The script connects using a MongoDB connection string from MONGODB_URI
or, if not provided, "~/.mongodb_uri", and prints JSON to stdout.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import socket
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional

from bson import json_util
from pymongo import MongoClient
from pymongo.errors import PyMongoError


def sanitize_error_message(error_message: str) -> str:
    """Redact credential-like values from exception text."""
    redacted_message = re.sub(
        r"(?i)(password|passwd|pwd)\s*[:=]\s*[^,\s]+",
        r"\1=***",
        error_message,
    )
    redacted_message = re.sub(
        r"(?i)(mongodb(?:\+srv)?://[^:/\s]+:)([^@/\s]+)@",
        r"\1***@",
        redacted_message,
    )
    return redacted_message


def _normalize_mongo_host(host: str) -> str:
    """Return 127.0.0.1 when host resolves to a loopback address.

    Debian-family systems often map the machine's own hostname to 127.0.1.1 in
    /etc/hosts, but mongod typically binds to 127.0.0.0 (not 127.0.1.1).
    Using 127.0.0.0 directly avoids the resulting ECONNREFUSED.
    """
    try:
        addr = socket.gethostbyname(host)
        if addr.startswith("127."):
            return "127.0.0.1"
    except Exception:
        pass
    return host


def _uri_from_mongo_alias() -> Optional[str]:
    """Parse the 'mongo' shell alias from /etc/profile and build a MongoDB URI.

    The alias is written by Ansible in the form:
        alias mongo='mongosh admin -u <user> -p <pwd> --port <port> --host <host>'
    Returns a URI string or None if the alias cannot be found/parsed.
    """
    try:
        profile = Path("/etc/profile").read_text(encoding="utf-8")
    except Exception:
        return None

    for line in profile.splitlines():
        stripped = line.strip()
        if not stripped.startswith("alias mongo="):
            continue
        # Strip alias mongo=' ... ' or alias mongo=" ... "
        body = re.sub(r"^alias mongo=['\"](.+)['\"]$", r"\1", stripped)
        user = re.search(r"-u\s+(\S+)", body)
        pwd  = re.search(r"-p\s+(\S+)", body)
        host = re.search(r"--host\s+(\S+)", body)
        port = re.search(r"--port\s+(\d+)", body)
        if user and pwd and host:
            from urllib.parse import quote_plus
            p = port.group(1) if port else "27017"
            resolved_host = _normalize_mongo_host(host.group(1))
            return (
                f"mongodb://{quote_plus(user.group(1))}:{quote_plus(pwd.group(1))}"
                f"@{resolved_host}:{p}/admin"
            )
    return None


def mum_creds() -> str:
    """Load MongoDB URI from env, ~/.mongodb_uri, or the 'mongo' shell alias.

    Exits with code 1 if no usable URI source is available.
    """
    env_uri = os.environ.get("MONGODB_URI", "").strip()
    if env_uri:
        return env_uri

    creds_path_obj = Path.home() / ".mongodb_uri"
    creds_path = str(creds_path_obj)
    try:
        with open(creds_path_obj, "r", encoding="utf-8") as fpt:
            creds = fpt.read().strip()
        if not creds:
            raise ValueError("Empty MongoDB URI")
        return creds
    except FileNotFoundError:
        pass
    except Exception as exc:  # noqa: BLE001
        print(f"Failed to read MongoDB URI from {creds_path}: {exc}", file=sys.stderr)

    alias_uri = _uri_from_mongo_alias()
    if alias_uri:
        return alias_uri

    print(
        "No MongoDB URI found: set MONGODB_URI, create ~/.mongodb_uri, "
        "or define an 'alias mongo=...' with -u/-p/--host in /etc/profile.",
        file=sys.stderr,
    )
    sys.exit(1)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="MUM MongoDB operations")
    parser.add_argument(
        "--config",
        help="Path to config file containing JSON (provided by task runner)",
        default=None,
    )
    return parser.parse_args()


def load_config(config_path: Optional[str]) -> Dict[str, Any]:
    if not config_path:
        return {}
    cfg_path = Path(config_path)
    try:
        with cfg_path.open("r", encoding="utf-8") as cfg:
            content = cfg.read()
        # Expect JSON (the runner writes exactly what UI sends)
        return json.loads(content) if content.strip() else {}
    except Exception as exc:  # noqa: BLE001
        print(f"Failed to read config file {config_path}: {exc}", file=sys.stderr)
        return {}
    finally:
        try:
            cfg_path.unlink()
        except FileNotFoundError:
            pass
        except Exception as exc:  # noqa: BLE001
            print(
                f"Failed to remove config file {config_path}: {exc}",
                file=sys.stderr,
            )


def list_roles(db) -> None:  # type: ignore[no-untyped-def]
    """Return all custom roles from every database with their privileges (deduplicated)."""
    all_roles: List[Dict[str, Any]] = []
    seen: set = set()

    try:
        db_names = [info["name"] for info in db.client.list_databases()]
    except Exception:
        db_names = ["admin"]

    for db_name in db_names:
        target = db.client.get_database(db_name)
        try:
            result: Dict[str, Any] = target.command(
                {"rolesInfo": 1, "showPrivileges": True}
            )
        except Exception:
            continue
        for r in result.get("roles", []):
            key = (r.get("role"), r.get("db"))
            if key not in seen:
                seen.add(key)
                all_roles.append(dict(r, isBuiltin=bool(r.get("isBuiltin", False))))

    all_roles.sort(key=lambda r: (r.get("db", ""), r.get("role", "")))
    print(json_util.dumps(all_roles, indent=2))


def list_users(db) -> None:  # type: ignore[no-untyped-def]
    # Mimic `db.getUsers()` using the usersInfo command within the selected DB
    cmd: Dict[str, Any] = {"usersInfo": {"forAllDBs": True}, "showPrivileges": False}
    result: Dict[str, Any] = db.command(cmd)
    users = result.get("users", [])
    print(json_util.dumps(users, indent=2))


def normalize_roles(raw_roles: Any, default_db: str) -> List[Dict[str, str]]:
    roles_out: List[Dict[str, str]] = []
    if isinstance(raw_roles, list):
        for item in raw_roles:
            if isinstance(item, str):
                roles_out.append({"role": item, "db": default_db})
            elif isinstance(item, dict) and "role" in item:
                role_db = item.get("db") or default_db
                roles_out.append({"role": str(item["role"]), "db": str(role_db)})
    return roles_out


def create_user(db, config: Dict[str, Any]) -> None:  # type: ignore[no-untyped-def]
    username = config.get("username")
    password = config.pop("password", None)
    db_name = config.get("db", "admin")
    roles = normalize_roles(config.get("roles", []), db_name)
    if not username or not password:
        print(json_util.dumps({"ok": False, "error": "username and password are required"}))
        sys.exit(1)

    # Switch to the database where the user should be created
    target_db = db.client.get_database(db_name)
    result = target_db.command({
        "createUser": username,
        "pwd": password,
        "roles": roles,
    })
    password = None
    # Print minimal JSON confirmation (do not echo password)
    print(json_util.dumps({"ok": True, "result": result, "user": username, "db": db_name}))


def update_user(db, config: Dict[str, Any]) -> None:  # type: ignore[no-untyped-def]
    """Update a user's password and/or roles within a specific database.

    Expected config keys:
    - username (required)
    - password (optional)
    - roles (optional; list of strings or list of role dicts)
    - db (optional; defaults to 'admin')
    """
    username = config.get("username")
    if not username:
        print(json_util.dumps({"ok": False, "error": "username is required"}))
        sys.exit(1)

    db_name = config.get("db", "admin")
    pwd = config.pop("password", None)
    roles_cfg = config.get("roles")

    cmd: Dict[str, Any] = {"updateUser": username}
    if isinstance(pwd, str) and pwd:
        cmd["pwd"] = pwd
    if roles_cfg is not None:
        # Normalize roles only when provided; omit otherwise to leave unchanged
        cmd["roles"] = normalize_roles(roles_cfg, db_name)

    target_db = db.client.get_database(db_name)
    result = target_db.command(cmd)
    pwd = None
    print(json_util.dumps({"ok": True, "result": result, "user": username, "db": db_name}))


def delete_user(db, config: Dict[str, Any]) -> None:  # type: ignore[no-untyped-def]
    """Delete a MongoDB user from a specific database.

    Expected config keys:
    - username (required)
    - db (optional; defaults to 'admin')
    """
    username = config.get("username")
    if not username:
        print(json_util.dumps({"ok": False, "error": "username is required"}))
        sys.exit(1)

    db_name = config.get("db", "admin")
    target_db = db.client.get_database(db_name)
    result = target_db.command({"dropUser": username})
    print(json_util.dumps({"ok": True, "result": result, "user": username, "db": db_name}))


def delete_role(db, config: Dict[str, Any]) -> None:  # type: ignore[no-untyped-def]
    """Drop a custom MongoDB role from a specific database.

    Expected config keys:
    - role (required): role name
    - db (optional; defaults to 'admin'): database that owns the role
    """
    role_name = config.get("role")
    if not role_name:
        print(json_util.dumps({"ok": False, "error": "role name is required"}))
        sys.exit(1)

    db_name = config.get("db", "admin")
    target_db = db.client.get_database(db_name)
    result = target_db.command({"dropRole": role_name})
    print(json_util.dumps({"ok": True, "result": result, "role": role_name, "db": db_name}))


def update_role(db, config: Dict[str, Any]) -> None:  # type: ignore[no-untyped-def]
    """Update privileges and inherited roles for an existing custom MongoDB role.

    Expected config keys:
    - role (required): role name
    - db (optional; defaults to 'admin'): database that owns the role
    - privileges (optional): replacement list of {resource, actions} dicts
    - inheritedRoles (optional): replacement list of role strings or {role, db} dicts
    """
    role_name = config.get("role")
    if not role_name:
        print(json_util.dumps({"ok": False, "error": "role name is required"}))
        sys.exit(1)

    db_name = config.get("db", "admin")
    privileges = config.get("privileges", [])
    inherited = normalize_roles(config.get("inheritedRoles", []), db_name)

    target_db = db.client.get_database(db_name)
    result = target_db.command({
        "updateRole": role_name,
        "privileges": privileges,
        "roles": inherited,
    })
    print(json_util.dumps({"ok": True, "result": result, "role": role_name, "db": db_name}))


def create_role(db, config: Dict[str, Any]) -> None:  # type: ignore[no-untyped-def]
    """Create a custom MongoDB role.

    Expected config keys:
    - role (required): role name
    - db (optional; defaults to 'admin'): database that owns the role
    - privileges (optional): list of {resource, actions} dicts
    - inheritedRoles (optional): list of role name strings or {role, db} dicts
    """
    role_name = config.get("role")
    if not role_name:
        print(json_util.dumps({"ok": False, "error": "role name is required"}))
        sys.exit(1)

    db_name = config.get("db", "admin")
    privileges = config.get("privileges", [])
    inherited = normalize_roles(config.get("inheritedRoles", []), db_name)

    target_db = db.client.get_database(db_name)
    result = target_db.command({
        "createRole": role_name,
        "privileges": privileges,
        "roles": inherited,
    })
    print(json_util.dumps({"ok": True, "result": result, "role": role_name, "db": db_name}))


def mum() -> None:
    """Connect to MongoDB and perform an action based on config."""
    uri = mum_creds()

    args = parse_args()
    config = load_config(args.config)
    action = (config.get("action") if isinstance(config, dict) else None) or "list_users"

    client = None
    try:
        client = MongoClient(uri, serverSelectionTimeoutMS=5000)
        # Default DB for commands; may switch based on action
        db = client.get_database("admin")

        if action == "list_roles":
            list_roles(db)
        elif action == "delete_role":
            delete_role(db, config)
        elif action == "update_role":
            update_role(db, config)
        elif action == "create_role":
            create_role(db, config)
        elif action == "create_user":
            create_user(db, config)
        elif action == "update_user":
            update_user(db, config)
        elif action == "delete_user":
            delete_user(db, config)
        else:
            list_users(db)
    except PyMongoError as exc:
        print(
            f"MongoDB error: {sanitize_error_message(str(exc))}",
            file=sys.stderr,
        )
        sys.exit(1)
    except Exception as exc:  # noqa: BLE001
        print(
            f"Unexpected error: {sanitize_error_message(str(exc))}",
            file=sys.stderr,
        )
        sys.exit(1)
    finally:
        if client is not None:
            try:
                client.close()
            except Exception:
                pass


# Execute immediately when the script is run by the task engine
mum()