class RsyncUploadProvider:
    """Rsync folder to another location."""

    def __init__(self, settings: dict[str, Any], level: int) -> None:
        """Initialize RsyncUploadProvider.

        :param settings: Backup/server settings.
        :param level: Logging level.
        :raises BackupError: If RSYNC_PATH not set or rsync not installed.
        """
        host = settings.get("HOST", "localhost")
        self.alias = settings.get("ALIAS", host)
        self.rsync_dir = settings.get("RSYNC_PATH")
        self.backup_type = settings.get("BACKUP_TYPE")
        self.upload_quiet = settings.get("UPLOAD_QUIET", False)
        if self.rsync_dir is None:
            msg = "RSYNC_PATH is not set."
            raise BackupError(msg)

        logging_dir = Path(settings.get("LOGGING_DIR", DEFAULT_LOGGING_DIR))
        log_name = "rsync-{}-{}-{}.log".format(
            self.alias, self.backup_type, time.strftime("%Y%m%d")
        )
        log_file = logging_dir / log_name
        self.log_stream = log_file.open("a")
        self.logger = upload_logging_setup(logging_dir, log_name, self.alias, level)

    def upload(self, source_dir: str, dest_dir: str) -> str:
        """Rsync files from source dir to target directory.

        :param source_dir: Local source directory.
        :param dest_dir: Remote/target directory structure.
        :return: Destination path.
        :raises BackupError: If rsync fails.
        """
        if not Path(RSYNC_BIN).exists():
            msg = f"Missing {RSYNC_BIN}. Install rsync package."
            raise BackupError(msg)

        if "_incrementals" in dest_dir:
            _, inc_dir_name = dest_dir.rsplit("/", 1)
            dest_path = str(Path(self.rsync_dir) / inc_dir_name / "")
        else:
            dest_path = str(Path(self.rsync_dir) / "")

        cmd = [
            RSYNC_BIN,
            "-aH" if self.upload_quiet else "-avH",
            "--numeric-ids",
            "--no-owner",
            "--no-group",
            source_dir,
            dest_path,
        ]
        self.logger.info("Starting rsync...")
        self.logger.info("Running: %s", " ".join(cmd))
        proc = subprocess.Popen(cmd, stdout=self.log_stream, stderr=subprocess.PIPE)
        _, err = proc.communicate()
        if proc.returncode != 0:
            msg = f"Rsync failed. Error: {err}"
            raise BackupError(msg)

        return dest_path


class S3UploadProvider:
    """Upload to Amazon S3 bucket using boto3."""

    def __init__(self, settings: dict[str, Any], level: int) -> None:
        """Initialize S3UploadProvider.

        :param settings: Backup/server settings.
        :param level: Logging level.
        :raises BackupError: If S3_BUCKET not set.
        """
        host = settings.get("HOST", "localhost")
        self.alias = settings.get("ALIAS", host)
        self.s3_bucket = settings.get("S3_BUCKET")
        self.fake_s3_upload = settings.get("FAKE_S3_UPLOAD")
        self.s3_limit_rate = settings.get("S3_LIMIT_RATE")
        self.s3_storage_class = settings.get("S3_STORAGE_CLASS", "STANDARD")
        self.backup_type = settings.get("BACKUP_TYPE")
        self.skip_s3_safety_check = settings.get("SKIP_S3_SAFETY_CHECK", False)
        self.upload_quiet = settings.get("UPLOAD_QUIET", False)
        self.logging_dir = Path(settings.get("LOGGING_DIR", DEFAULT_LOGGING_DIR))

        if self.s3_bucket is None:
            msg = "S3_BUCKET is not set."
            raise BackupError(msg)

        log_file = (
            self.logging_dir
            / "s3cmd-{}-{}-{}.log".format(self.alias, self.backup_type, time.strftime("%Y%m%d"))
        )
        self.log_stream = log_file.open("a")
        self.logger = upload_logging_setup(self.logging_dir, log_file.name, self.alias, level)

        bucket_str = self.s3_bucket
        if bucket_str.startswith("s3://"):
            bucket_str = bucket_str[5:]
        parts = bucket_str.split("/", 1)
        self.bucket_name = parts[0]
        self.bucket_prefix = parts[1] if len(parts) > 1 else ""

        self.s3 = boto3.client("s3")

    def _check_bucket_safety(self) -> None:
        """Check whether the S3 bucket is safe by verifying public access block settings.

        :raises BackupError: If the bucket is found to be unsafe.
        """
        if self.skip_s3_safety_check:
            self.logger.info("Skipping S3 bucket safety check as requested.")
            return

        self.logger.info("Checking S3 bucket safety...")
        try:
            resp = self.s3.get_public_access_block(Bucket=self.bucket_name)
            public_block = resp.get("PublicAccessBlockConfiguration", {})
            if not all(public_block.get(k, True) for k in public_block):
                msg = "Unsafe S3 bucket: public access is allowed!"
                raise BackupError(msg)
        except ClientError as e:
            self.logger.warning("Could not check S3 bucket safety: %s", e)
        self.logger.info("OK S3 bucket looks to be safe or safety check skipped.")

    def upload(self, source_dir: str, dest_dir: str) -> str:
        """Upload directory to S3.

        :param source_dir: Local source directory.
        :param dest_dir: Destination path (relative) on S3.
        :return: S3 URI of the uploaded backup.
        :raises BackupError: If S3 upload fails.
        """
        if not self.skip_s3_safety_check:
            self._check_bucket_safety()

        full_prefix = str(Path(self.bucket_prefix) / dest_dir)
        if not full_prefix.endswith("/"):
            full_prefix += "/"

        if self.fake_s3_upload:
            self.logger.warning("*** Fake S3 upload in action ***")
            return f"s3://{self.bucket_name}/{full_prefix}"

        self.logger.info("Uploading backup...")
        source_path = Path(source_dir)
        for root, _dirs, files in os.walk(str(source_path)):
            for file_ in files:
                local_path = Path(root) / file_
                relative_path = local_path.relative_to(source_path)
                key = str(Path(full_prefix) / relative_path)

                extra_args = {
                    "StorageClass": self.s3_storage_class,
                    "ServerSideEncryption": "AES256",
                }

                if not self.upload_quiet:
                    self.logger.info(
                        "Uploading %s to s3://%s/%s", local_path, self.bucket_name, key
                    )
                try:
                    self.s3.upload_file(
                        str(local_path), self.bucket_name, key, ExtraArgs=extra_args
                    )
                except ClientError as e:
                    raise BackupError(f"S3 upload failed: {e}") from None

        if self.backup_type not in ["B", "O"] and not (
            self.backup_type == "X" and "_incrementals" in dest_dir
        ):
            latest_key = str(Path(full_prefix).parent / "latest")
            try:
                tmp_dir = Path("/tmp/percona_backup_latest")
                tmp_dir.mkdir(parents=True, exist_ok=True)
                latest_local_path = tmp_dir / "latest"
                with latest_local_path.open("w") as fn:
                    fn.write(f"s3://{self.bucket_name}/{full_prefix}")

                self.s3.upload_file(
                    str(latest_local_path),
                    self.bucket_name,
                    latest_key,
                    ExtraArgs={
                        "StorageClass": self.s3_storage_class,
                        "ServerSideEncryption": "AES256",
                    },
                )
            except Exception as e:
                self.logger.warning("S3 latest file upload failed: %s", e)

        return f"s3://{self.bucket_name}/{full_prefix}"

class GSUploadProvider:
    """Google Cloud Storage upload."""

    def __init__(self, settings: dict[str, Any], level: int) -> None:
        """Initialize GSUploadProvider.

        :param settings: Backup/server settings.
        :param level: Logging level.
        :raises BackupError: If GS_BUCKET not set.
        """
        host = settings.get("HOST", "localhost")
        self.alias = settings.get("ALIAS", host)
        self.gs_bucket = settings.get("GS_BUCKET")
        self.backup_type = settings.get('BACKUP_TYPE')
        self.upload_quiet = settings.get("UPLOAD_QUIET", False)
        if self.gs_bucket is None:
            msg = 'GS_BUCKET is not set.'
            raise BackupError(msg)

        logging_dir = settings.get('LOGGING_DIR', DEFAULT_LOGGING_DIR)
        os.makedirs(logging_dir, exist_ok=True)
        log_name = 'gcloud-storage-%s-%s-%s.log' % (
            self.alias, self.backup_type, time.strftime('%Y%m%d'),
        )
        log_file = os.path.join(logging_dir, log_name)
        self.log_stream = open(log_file, 'a')
        self.logger = upload_logging_setup(logging_dir, log_name, self.alias, level)

        bucket_str = self.gs_bucket
        if bucket_str.startswith("gs://"):
            bucket_str = bucket_str[5:]
        parts = bucket_str.split("/", 1)
        self.bucket_name = parts[0]
        self.bucket_prefix = parts[1] if len(parts) > 1 else ""

    def upload(self, source_dir: str, dest_dir: str) -> str:
        """Upload directory to GS.

        :param source_dir: Local source directory.
        :param dest_dir: Destination path (relative) on GS.
        :return: GS URI of the uploaded backup.
        :raises BackupError: If GS upload fails.
        """
        source_path = Path(source_dir)
        full_prefix = (
            str(Path(self.bucket_prefix) / dest_dir)
            if self.bucket_prefix else dest_dir
        )
        dest_path = f"gs://{self.bucket_name}/{full_prefix}"
        gs_cmd = [GCLOUD_BIN, 'storage', 'rsync', '-r', str(source_path), dest_path]
        if self.upload_quiet:
            gs_cmd.append("--verbosity=error")
        self.logger.info('Uploading backup...')
        self.logger.info('Running: %s', ' '.join(gs_cmd))

        proc = subprocess.Popen(gs_cmd, stdout=self.log_stream, stderr=subprocess.PIPE)
        _, err = proc.communicate()
        if proc.returncode != 0:
            msg = f"GS upload failed. Error: {err}"
            raise BackupError(msg)

        if self.backup_type not in ["B", "O"] and not (
            self.backup_type == "X" and "_incrementals" in dest_dir
        ):
            with tempfile.NamedTemporaryFile("w", delete=False) as tmpf:
                tmpf.write(dest_path)
                tmpf.flush()
                latest_file_local_path = tmpf.name
            try:
                latest_file_remote_dir = (
                       f"gs://{self.bucket_name}/{Path(full_prefix).parent}/latest"
                )
                gs_cmd = [GCLOUD_BIN, 'storage', 'cp', latest_file_local_path, latest_file_remote_dir]
                proc = subprocess.Popen(gs_cmd, stdout=self.log_stream, stderr=subprocess.PIPE)
                _, err = proc.communicate()
                if proc.returncode != 0:
                    msg = f"GS upload failed. Error: {err}"
                    raise BackupError(msg)
            finally:
                if Path(latest_file_local_path).exists():
                    Path(latest_file_local_path).unlink()

        return dest_path

class MyDumperRunner(multiprocessing.Process):
    """Mydumper multiprocessing class to run backups in parallel."""

    def __init__(
        self,
        config_path: Path,
        *args: Any,
        **kwargs: Any,
    ) -> None:
        """Initialize MyDumperRunner.

        :param config_path: Path to the configuration file.
        """
        super().__init__(*args, **kwargs)
        self.config_path = config_path
        self.logger = None

    def run(self) -> None:
        """Run the MyDumperRunner: iterate over servers and run MyDumper backups."""
        local_cfg = LocalConfig(self.config_path)

        logging_dir = Path(
            local_cfg.raw_cfg_data["ALL_SERVERS"].get(
                "LOGGING_DIR", DEFAULT_LOGGING_DIR
            )
        )

        servers = local_cfg.server_data_list
        settings = servers[0]
        if settings.get("DEBUG") or local_cfg.raw_cfg_data["ALL_SERVERS"].get("DEBUG"):
            self.logger = logging_setup(logging_dir, LOGGING_NAME, logging.DEBUG)
        if self.logger is None:
            self.logger = logging_setup(logging_dir, LOGGING_NAME)

        start_time = time.time()
        self.logger.info(">>>>>>>>>>>>>>>>>> Backup started.")
        self.logger.info("Total servers: %s", len(servers))

        for server_data in servers:
            alias = server_data.get("ALIAS", server_data.get("HOST", "localhost"))
            # Get a lock per server with alias in the lockfile name
            lockfile_name = os.path.join(logging_dir, f".lock_mydumper_{alias}")
            lock = FileLock(lockfile_name, timeout=600)

            try:
                self.logger.info("Acquiring lock for %s", alias)
                should_exit = False
                with lock:
                    bkp = MyDumper(server_data, logger=self.logger)
                    try:
                        bkp.textfile_collector_write_status(BackupNotifyStatus.OK, backup_running=1)
                        bkp.run()
                        bkp.textfile_collector_write_status(BackupNotifyStatus.OK, backup_running=0)
                    except BackupError as exc:
                        self.logger.exception(exc.message)
                        self.logger.exception("Backup failed for this host.")
                        bkp.notify(BackupNotifyStatus.CRITICAL, exc.message)
                        bkp.textfile_collector_write_status(BackupNotifyStatus.CRITICAL, backup_running=0)
                        should_exit = True
                    except Exception:
                        self.logger.exception("Unhandled exception occurred.")
                        bkp.notify(BackupNotifyStatus.CRITICAL, "Unhandled exception occurred.")
                        bkp.textfile_collector_write_status(BackupNotifyStatus.CRITICAL, backup_running=0)
                        should_exit = True

                    logging_set_host(None, LOGGING_NAME)

                if should_exit:
                    sys.exit(1)
            except Timeout:
                self.logger.warning("Another instance of mydumper backup for %s currently holds the lock.", alias)
                sys.exit(1)

        time_spent = format_seconds_to_hhmmss(time.time() - start_time)
        self.logger.info(
            ">>>>>>>>>>>>>>>>>> Backup finished. Total duration: %s.", time_spent
        )


class MyDumper(Backup):
    """Run MyDumper for an individual server."""

    def __init__(self, server_data: dict[str, Any], logger: logging.Logger) -> None:
        """Initialize MyDumper backup class for a given server.

        :param server_data: Server configuration and runtime data.
        :type server_data: dict[str, Any]
        :param logger: Optional logger instance.
        :type logger: logging.Logger, optional
        """
        super().__init__(server_data, "M", logger=logger)

        #Mark the backup as enabled in the textfile collector
        self.textfile_collector_write_enable(self.alias, True, "backup")

        self.daily_purge: int = server_data.get("MYDUMPER_DAILY_PURGE", 7)
        self.weekly_purge: int = server_data.get("MYDUMPER_WEEKLY_PURGE", 4)
        self.mydumper_for_schemas: bool = server_data.get("MYDUMPER_SCHEMAS", True)
        self.mydumper_dump_triggers: bool = server_data.get(
            "MYDUMPER_DUMP_TRIGGERS", True
        )
        self.desync_pxc: bool = server_data.get("MYDUMPER_DESYNC_PXC", False)
        self.less_locking: bool = server_data.get("MYDUMPER_LESS_LOCKING", False)
        self.updated_since: int = server_data.get("MYDUMPER_UPDATED_SINCE", 0)
        self.mydumper_extra_args: str | None = server_data.get("MYDUMPER_EXTRA_ARGS")
        self.mydumper_verbose: int = server_data.get("MYDUMPER_VERBOSE", 3)
        self.use_ftwrl_guardian: bool = server_data.get("USE_FTWRL_GUARDIAN", True)
        self.mydumper_use_numa: bool = server_data.get("MYDUMPER_USE_NUMA", False)

        self.server_setting: dict[str, Any] = server_data
        self.s3_bucket: str | None = server_data.get("MYDUMPER_S3_BUCKET")
        self.s3_daily: bool = server_data.get("MYDUMPER_S3_DAILY", False)
        self.s3_encrypt: bool = server_data.get("MYDUMPER_ENCRYPT_S3", True)
        self.encrypt_using_tmpdir: bool = server_data.get(
            "MYDUMPER_USE_TMPDIR_FOR_ENC_S3UPLOAD", False
        )

        # Set report options
        self.report_options["options"] = {
            "dailies": self.daily_purge,
            "weeklies": self.weekly_purge,
        }

        # Paths
        self.today_str = time.strftime("%Y%m%d")
        yesterday_str = (datetime.datetime.now() - datetime.timedelta(days=1)).strftime(
            "%Y%m%d"
        )
        self.backup_server_dir = (
            (Path(server_data["BACKUP_DIR"]) / "mydumper" / self.alias)
            .expanduser()
            .resolve()
        )
        self.backup_dir = self.backup_server_dir / self.today_str
        self.latest_link = self.backup_server_dir / "latest"
        self.prev_backup_dir = self.backup_server_dir / yesterday_str
        self.last_backup_dir = self.backup_dir

        self.prev_encrypted = False
        self.cache_md5 = False
        self.valid_prev_backup_dir = None

    def run(self) -> None:
        """Start the backup for the individual server."""
        start_time = time.time()

        if self.only_if_running_replica:
            self.is_replica = self._is_running_replica()
            if not self.is_replica:
                self.logger.info("Not running replica, ignoring this host.")
                return

        if self.only_if_read_only:
            self.is_replica = self._is_read_only()
            if not self.is_replica:
                self.logger.info("Not read_only, ignoring this host.")
                return

        self.backup_dir.mkdir(parents=True, exist_ok=True)

        if self.check_disk_space:
            is_free, msg = is_free_space(
                self.backup_server_dir,
                self.logger,
                double_space_needed=self.encrypt_using_tmpdir,
            )
            if not is_free:
                raise BackupError(msg)

        # Check mydumper version for schemas support
        if self.mydumper_for_schemas:
            version = self._get_version()
            self.logger.info('Using mydumper %s for schemas', version)

        if not self.mydumper_for_schemas:
            raise BackupError("MYDUMPER_SCHEMAS has been disabled, please enable it")

        # Run actual backup
        self._run_backup_cmd()

        # Update latest link
        if self.latest_link.is_symlink():
            self.latest_link.unlink()
        self.latest_link.symlink_to(self.today_str)

        # Purge old backups
        self._purge_old_backups()

        # Encrypt backup or hardlink to save space
        if self.post_run_encrypt:
            self.report_options["encryption"] = "gpg"
            self.logger.info("Post-run backup encryption is enabled.")
            encrypt_dir(self.backup_dir, self.logger, **self.dir_encrypt_config)
        else:
            self._save_disk_space()

        # Upload if needed
        upload_providers = {
            "rsync": RsyncUploadProvider,
            "s3": S3UploadProvider,
            "gsutil": GSUploadProvider,
        }
        upload_destination = None
        for upload_type in sorted(self.upload_type):
            self.enable_upload(self.backup_dir)
            provider = upload_providers.get(upload_type)
            if provider is None:
                self.logger.warning("Unsupported upload type: %r", upload_type)
                continue
            uploader = MyDumperUpload(
                upload_type=upload_type,
                upload_provider=provider,
                settings=self.server_setting,
                logger=self.logger,
            )
            uploader.run()
            remote_path = uploader.report_options.get("options", {}).get("remote_path")
            if remote_path:
                upload_destination = remote_path

        time_spent = format_seconds_to_hhmmss(time.time() - start_time)
        size_bytes = get_dir_size(self.backup_dir)
        size_text = humanize_bytes(size_bytes)
        msg = f"OK Backup complete. Duration: {time_spent}. Size: {size_text}."
        self.logger.info(msg)
        self.notify(BackupNotifyStatus.OK, msg)

        if self.last_backup_dir and Path(self.last_backup_dir).is_dir():
            try:
                _write_run_result(
                    str(self.last_backup_dir), size_bytes, upload_destination
                )
            except Exception:
                self.logger.exception("Failed to write the run-result file.")

    def _save_disk_space(self) -> None:
        """Hardlink backups to save disk space if conditions allow."""
        if (
            self.s3_bucket
            and self.s3_encrypt
            and self.hardlink
            and not self.encrypt_using_tmpdir
        ):
            if self.s3_daily:
                # Daily upload
                self.cache_md5 = True
                self.prev_encrypted = True
            else:
                # Weekly upload
                weekday = datetime.datetime.today().isoweekday()
                if weekday == 1:
                    # Monday
                    self.hardlink = False
                elif weekday == 2:
                    # Tuesday
                    twodaysago = (
                        datetime.datetime.now() - datetime.timedelta(days=2)
                    ).strftime("%Y%m%d")
                    self.prev_backup_dir = self.backup_server_dir / twodaysago

        # Check if previous backup is encrypted
        if self.prev_backup_dir.is_dir():
            self.prev_encrypted = is_encrypted_dir(self.prev_backup_dir, self.logger)
            if self.prev_encrypted:
                self.logger.info(
                    "Disabling today's hardlinking: previous backup is encrypted"
                )

        # Validate previous backups for updated_since option
        if self.updated_since > 0:
            self._validate_updated_since()

        # Hardlink not updated tables if updated_since is set
        if self.updated_since and self.valid_prev_backup_dir:
            self.logger.info("Hardlinking not dumped tables...")
            ret_code, ret_info = hardlink_listed_files(
                self.valid_prev_backup_dir,
                self.backup_dir,
                compress=self.compress,
                encrypted=self.s3_daily and self.s3_encrypt,
            )
            if ret_code != 0:
                msg = f"Error: files for table {ret_info} not found"
                raise BackupError(msg)
            self.logger.info("Hardlinking of not dumped tables complete.")

        if not self.hardlink:
            return

        if not self.prev_backup_dir.is_dir() or self.prev_encrypted:
            self.logger.info("Checksumming backup...")
            get_dir_dict(self.backup_dir, md5=self.cache_md5)
            self.logger.info("OK Checksum complete.")
        else:
            self.logger.info("Hardlinking backups...")
            get_dir_dict(self.backup_dir, md5=self.cache_md5)
            hl_files = hardlink_dirs(
                self.prev_backup_dir, self.backup_dir, encrypted=self.prev_encrypted
            )
            bytes_saved = sum(file_data[1] for file_data in hl_files.values())
            self.report_options["hl_mb"] = round(bytes_saved / 1024 / 1024)
            self.logger.info(
                "OK Hardlinking complete: %d MB saved.",
                round(bytes_saved / 1024 / 1024),
            )

    def _validate_updated_since(self) -> None:
        """Validate previous backups that can be used with mydumper's --updated-since option."""
        for i in range(1, self.updated_since):
            dayago = (datetime.datetime.now() - datetime.timedelta(days=i)).strftime(
                "%Y%m%d"
            )
            check_backup_dir = self.backup_server_dir / dayago
            if self.s3_daily and self.s3_encrypt:
                if (check_backup_dir / f"{MYDUMPER_METADATA}.gpg").is_file():
                    self.valid_prev_backup_dir = str(check_backup_dir)
                    break
            elif (check_backup_dir / MYDUMPER_METADATA).is_file():
                self.valid_prev_backup_dir = str(check_backup_dir)
                break

        if self.valid_prev_backup_dir is None:
            self.logger.warning(
                "Disabling mydumper's updated_since option: no valid previous backup"
            )
            self.updated_since = 0

    def _run_backup_cmd(self) -> None:
        """Run the mydumper backup command."""
        is_pxc = False
        try:
            # Check for PXC
            if self.desync_pxc:
                is_pxc = self._is_pxc()

            # Desync PXC node
            if is_pxc:
                self._pxc_desync(new_status=1)

            mydumper_cmd = []
            if self.mydumper_use_numa:
                mydumper_cmd.extend(["/bin/numactl", "--interleave=all"])

            default_args = [
                f"--defaults-file={self.defaults_cnf_file}",
                f"--outputdir={self.backup_dir}",
                f"--verbose={self.mydumper_verbose}",
                f"--host={self.host}",
                f"--port={self.port}",
                "--kill-long-queries",
                "--chunk-filesize=5120",
                "--build-empty-files",
            ]

            mydumper_cmd.append(MYDUMPER_BIN)

            if self.mydumper_extra_args:
                mydumper_cmd.extend(self.mydumper_extra_args.split(" "))

            mydumper_cmd.extend(default_args)

            if self.mydumper_for_schemas:
                mydumper_cmd.extend(["--events", "--routines"])
                if self.mydumper_dump_triggers:
                    mydumper_cmd.append("--triggers")
            else:
                mydumper_cmd.append("--no-schemas")

            if self.compress:
                mydumper_cmd.append("--compress")
                mydumper_cmd.append(self.compression_algorithm.upper())

            if self.updated_since > 0:
                mydumper_cmd.append(f"--updated-since={self.updated_since}")

            if self.less_locking:
                mydumper_cmd.append("--less-locking")

            md_log_file = (
                self.logging_dir / f"mydumper-{self.alias}-{self.today_str}.log"
            )
            self.logger.info("Backup data...")
            self.logger.info("Running: %s", " ".join(map(str, mydumper_cmd)))

            with md_log_file.open("a") as md_log_stream:
                proc = subprocess.Popen(
                    mydumper_cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
                )
                if proc.stdout:
                    for line in proc.stdout:
                        line_decoded = line.decode()
                        sys.stdout.write(line_decoded)
                        md_log_stream.write(line_decoded)
                proc.wait()

            ret_code = proc.returncode
            while ret_code is None:
                if self.use_ftwrl_guardian:
                    ftwrl_guardian({"HOST": self.host, "PORT": self.port}, self.logger)
                ret_code = proc.poll()

            if ret_code != 0:
                with md_log_file.open("r") as md_log_stream:
                    lines = md_log_stream.readlines()
                err = lines[-1] if lines else "Unknown error"
                if self.post_run_encrypt:
                    # remove failed backups if post encrypt is enabled
                    shutil.rmtree(self.backup_dir)
                msg = f"Mydumper failed ({ret_code}): {err} For more details, see {md_log_file}"
                raise BackupError(msg)

            self.logger.info("OK Mydumper complete.")
        finally:
            # Resync PXC node
            if is_pxc:
                for _ in range(6):
                    if self._pxc_desync(new_status=0):
                        break
                    self.logger.info("Sleeping 10 secs to re-try syncing Galera node.")
                    time.sleep(10)
                else:
                    self.logger.error("Galera node left desynced.")

    def _list_backups(self, path: Path) -> list[str]:
        """Get a list of directories with existing backups.

        :param path: Path to the server backup directory.
        :return: Sorted list of backup directory names.
        """
        dname_re = re.compile("^[0-9]{8}$")
        return sorted(
            [
                dname
                for dname in os.listdir(path)
                if (path / dname).is_dir() and dname_re.search(dname)
            ]
        )

    def _purge_old_backups(self) -> int:
        """Purge old backups, keeping a specified number of daily and weekly backups.

        :return: Number of purged directories.
        """
        self.logger.info("Purging old backups...")
        dir_list = self._list_backups(self.backup_server_dir)
        dir_map = {dname: 0 for dname in dir_list}

        # Weeklies iteration (keep certain Mondays)
        weekly_age = self.weekly_purge
        for i in sorted(dir_map.keys(), reverse=True):
            wkday = datetime.datetime.strptime(i, "%Y%m%d").date().isoweekday()
            if wkday == 1:
                if weekly_age > 0:
                    weekly_age -= 1
                    dir_map[i] = 2  # Mark to not delete
                else:
                    dir_map[i] = 1  # Mark to delete

        saved_weeklies = [k for k, v in dir_map.items() if v == 2]
        if saved_weeklies:
            self.logger.info(
                "Keeping weeklies (max %s): %s",
                self.weekly_purge,
                ",".join(sorted(saved_weeklies, reverse=True)),
            )

        # Dailies iteration
        daily_age = self.daily_purge
        for i in sorted(dir_map.keys(), reverse=True):
            if daily_age > 0:
                daily_age -= 1
                # Mark to not delete if not weekly
                if dir_map[i] != 2:
                    dir_map[i] = 0
            elif dir_map[i] != 2:
                dir_map[i] = 1  # Mark to delete

        saved_dailies = [k for k, v in dir_map.items() if v == 0]
        if saved_dailies:
            self.logger.info(
                "Keeping dailies (max %s): %s",
                self.daily_purge,
                ",".join(sorted(saved_dailies, reverse=True)),
            )

        # Purging
        purge_dir_list = [k for k, v in dir_map.items() if v == 1]
        purges = 0
        for dir_ in sorted(purge_dir_list):
            shutil.rmtree(self.backup_server_dir / dir_)
            self.logger.info("* Dir %s removed.", dir_)
            purges += 1

        self.logger.info("OK %s dirs purged.", purges)
        return purges

    def _get_version(self) -> str | None:
        """Extract MyDumper version.

        :return: MyDumper version string or None.
        """
        cmd = [MYDUMPER_BIN, "--version"]
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, _ = proc.communicate()
        if proc.returncode == 0:
            match = re.search(r"mydumper v?([\w\.]+)(-[0-9]{1,2})*[;,]", out.decode())
            if match:
                return match.group(1)

        self.logger.warning("Error getting mydumper version")
        return None


