def ftwrl_guardian(
    server_data: dict[str, Any],
    logger: logging.Logger,
) -> str | None:
    """Guard against race conditions in MyDumper by killing blocking SELECT queries
    if a FLUSH TABLES WITH READ LOCK (FTWRL) is detected.

    :param server_data: MySQL server connection data.
    :param logger: Logger instance to log activities.
    :param sleep_time: Time to sleep before checking processes.
    :param check_metadata: Check for table metadata lock if True.
    :return: Error message if an error occurred, otherwise None.
    """
    time.sleep(1)

    re_ftwrl = re.compile(r"FLUSH TABLES WITH READ LOCK", flags=re.IGNORECASE)
    re_read = re.compile("SELECT", flags=re.IGNORECASE)
    re_state = re.compile("Waiting", flags=re.IGNORECASE)

    try:
        conn = pymysql.connect(
            read_default_file=server_data.get("DEFAULTS_FILE", DEFAULT_MYCNF),
            host=server_data["HOST"],
            port=int(server_data.get("PORT", 3306)),
        )
    except Error as err:
        error_code = err.args[0] if isinstance(err.args[0], int) else 0
        error_message = (
            err.args[1]
            if len(err.args) > 1 and isinstance(err.args[1], str)
            else str(err)
        )
        return f"ftwrl_guardian error [{error_code}]: {error_message}"

    with conn:
        with conn.cursor() as curs:
            curs.execute("SHOW PROCESSLIST")
            res = curs.fetchall()

        ftwrl = None
        metadata_lock = None
        dprocess = None
        for row_res in res:
            if not ftwrl and not metadata_lock:
                if row_res[7]:
                    ftwrl = re_ftwrl.search(str(row_res[7]))
                dprocess = row_res
            else:
                break

        if not ftwrl and not metadata_lock:
            return None

        out = {
            "Detected": {
                "PID": f"{dprocess[0]}",
                "User": dprocess[1],
                "Host": dprocess[2],
                "Schema": dprocess[3],
                "Command": dprocess[4],
                "Time": f"{dprocess[5]}",
                "State": dprocess[6],
                "Info": dprocess[7],
            }
        }
        if logger:
            logger.info(out)

        with conn.cursor() as curs:
            for row_kill in res:
                row_kill = list(row_kill)
                if row_kill[6] is None:
                    row_kill[6] = ""
                if row_kill[7] is None:
                    row_kill[7] = ""

                if (
                    row_kill[4] in ("Query", "Execute")
                    and row_kill[5] > 0
                    and not re_state.search(str(row_kill[6]))
                    and re_read.search(str(row_kill[7]))
                ):
                    out = {
                        "Killing": {
                            "PID": f"{row_kill[0]}",
                            "User": row_kill[1],
                            "Host": row_kill[2],
                            "Schema": row_kill[3],
                            "Command": row_kill[4],
                            "Time": f"{row_kill[5]}",
                            "State": row_kill[6],
                            "Info": row_kill[7],
                        }
                    }
                    if logger:
                        logger.info(out)
                    with suppress(OperationalError, InternalError):
                        curs.execute(f"KILL {row_kill[0]}")

    return None


def md5sum_file(fpath: Path) -> str:
    """Calculate the MD5 checksum of a file.

    :param fpath: Path to the file.
    :return: MD5 checksum as a hex string.
    """
    d = hashlib.md5()
    with fpath.open("rb") as f:
        buf = f.read(8192)
        while buf:
            d.update(buf)
            buf = f.read(8192)
    return d.hexdigest()


def get_dir_dict(
    path: Path, json_cache_file: Path | None = None, *, md5: bool = False
) -> dict[str, dict[str, Any]]:
    """Create a dictionary of files in a directory, including inode, size, and optional MD5.

    :param path: Directory path.
    :param md5: Whether to compute MD5 checksums.
    :param json_cache_file: Path to a JSON cache file to store results.
    :return: Dictionary with file info keyed by relative file path.
    """
    if json_cache_file is None:
        json_cache_file = path / MD5SUM_FILE
    ret = {}

    for p in path.rglob("*"):
        if p.is_file() and not p.name.endswith(".gpg") and p.name != MD5SUM_FILE:
            stat_data = p.stat()
            rel_path = str(p.relative_to(path))
            file_md5 = md5sum_file(p) if md5 else None
            ret[rel_path] = {
                "inode": stat_data.st_ino,
                "size": stat_data.st_size,
                "md5": file_md5,
            }

    write_dict(ret, json_cache_file)
    return ret


def load_dir_dict(dir_path: Path) -> dict[str, dict[str, Any]]:
    """Load a directory dictionary from a JSON file if it exists, otherwise create it.

    :param dir_path: Directory path.
    :return: Directory dictionary.
    """
    json_cache_file = dir_path / MD5SUM_FILE

    if not json_cache_file.is_file():
        get_dir_dict(dir_path, json_cache_file)

    with json_cache_file.open("r") as f:
        return json.load(f)


def write_dict(dictionary: dict[Any, Any], json_file: Path) -> None:
    """Write a dictionary to a JSON file.

    :param dictionary: Dictionary to write.
    :param json_file: Path to output JSON file.
    """
    with json_file.open("w") as f:
        json.dump(dictionary, f)


def hardlink_dirs(
    src_dir: Path, dest_dir: Path, *, encrypted: bool = False
) -> dict[str, tuple[int, int]]:
    """Hardlink matching files from src_dir to dest_dir if size and MD5 match.

    :param src_dir: Source directory.
    :param dest_dir: Destination directory.
    :param encrypted: Whether the files are encrypted.
    :return: Dictionary of hardlinked files with their inode and size.
    """
    ret = {}
    dir1 = load_dir_dict(src_dir)
    dir2 = load_dir_dict(dest_dir)

    for file in list(dir1.keys()):
        if file in dir2:
            md51 = dir1[file]["md5"]
            inode1 = dir1[file]["inode"]
            size1 = dir1[file]["size"]

            md52 = dir2[file]["md5"]
            inode2 = dir2[file]["inode"]
            size2 = dir2[file]["size"]

            if size1 and size2 and size1 == size2 and inode1 != inode2:
                file1 = src_dir / file
                file2 = dest_dir / file
                if encrypted:
                    file1_enc = file1.with_suffix(file1.suffix + ".gpg")
                    link_name = file2.with_suffix(file2.suffix + ".gpg")
                    if md51 is None:
                        md51 = md5sum_file(file1_enc)
                    if md52 is None:
                        md52 = md5sum_file(file2)
                    if md51 == md52:
                        if file2.is_file():
                            file2.unlink()
                        if link_name.is_file():
                            link_name.unlink()
                        os.link(str(file1_enc), str(link_name))
                        ret[file] = (int(inode1), int(size1))
                else:
                    if md51 is None:
                        md51 = md5sum_file(file1)
                    if md52 is None:
                        md52 = md5sum_file(file2)
                    if md51 == md52:
                        if file2.is_file():
                            file2.unlink()
                        os.link(str(file1), str(file2))
                        ret[file] = (int(inode1), int(size1))

            dir1[file] = {"inode": inode1, "size": size1, "md5": md51}

    json_cache_file = src_dir / MD5SUM_FILE
    write_dict(dir1, json_cache_file)
    return ret


def hardlink_listed_files(
    src_dir: Path,
    dest_dir: Path,
    *,
    compress: bool,
    encrypted: bool = False,
) -> tuple[int, str]:
    """Hardlink files listed in `dest_dir/file_wlist` from `src_dir`.

    :param src_dir: Source directory.
    :param dest_dir: Destination directory.
    :param compress: Whether the files are compressed.
    :param encrypted: Whether the files are encrypted.
    :param file_wlist: Filename containing the list of files.
    :return: (Status code, message). 0 means success.
    """
    files_file = dest_dir / "not_updated_tables"
    if files_file.is_file():
        ext = ".sql"
        if compress:
            ext += ".gz"
        if encrypted:
            ext += ".gpg"

        with files_file.open("r") as f:
            os.chdir(src_dir)
            for line in f:
                f_name = line.strip()
                src_exist = False
                for fthl in src_dir.glob(f_name + "*" + ext):
                    dest_file = dest_dir / fthl.name
                    if dest_file.is_file():
                        dest_file.unlink()
                    os.link(str(fthl), str(dest_file))
                    src_exist = True
                if not src_exist:
                    return 1, f_name
    return 0, "Ok"


def get_dir_size(start_path: Path) -> int:
    """Get the disk usage of a directory in bytes.

    Returns 0 if the path does not exist.
    """
    if not start_path.exists():
        return 0
    try:
        total_size = start_path.stat().st_blocks * ST_BLOCKS_SIZE
    except OSError:
        return 0
    try:
        for file in start_path.rglob("*"):
            if not file.is_symlink():
                total_size += file.stat().st_blocks * ST_BLOCKS_SIZE
    except Exception as e:
        logging.warning(
            "Error traversing directory %s: %s", start_path, e, exc_info=True
        )
    return total_size


def _write_run_result(
    backup_dir: str, size_bytes: int, upload_destination: str | None
) -> None:
    """Write the run-result JSON file for a produced backup.

    The path is relative to the run's working directory, which the ``run-python``
    job spec pins to the task's output-files directory — the location SEP reads
    results back from.  Written to a sibling temp file and renamed so a reader
    never observes a partial write.

    :param backup_dir: The resolved backup directory on the remote host.
    :param size_bytes: The backup size in bytes.
    :param upload_destination: The remote upload path, or ``None`` when the
        backup was not uploaded.
    """
    payload = {
        "backup_dir": backup_dir,
        "size_bytes": size_bytes,
        "upload_destination": upload_destination,
    }
    tmp_path = RUN_RESULT_FILENAME + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as result_file:
        json.dump(payload, result_file, separators=(",", ":"))
    os.replace(tmp_path, RUN_RESULT_FILENAME)


def humanize_bytes(size: int) -> str:
    for unit in ["", "Ki", "Mi", "Gi", "Ti", "Pi", "Ei", "Zi"]:
        if abs(size) < 1024:
            return f"{size:3.1f} {unit}B"
        size /= 1024
    return f"{size:.1f} YiB"


def logging_setup(
    logging_dir: Path, log_name: str, level: int = logging.INFO
) -> logging.Logger:
    """Set up and return a configured logger.

    :param logging_dir: Directory for log files.
    :param log_name: Name of the log file.
    :param level: Logging level.
    :return: Configured logger instance.
    """
    os.umask(0o007)
    real_logging_dir = logging_dir.expanduser().resolve()

    if not real_logging_dir.is_dir():
        real_logging_dir.mkdir(parents=True, exist_ok=True)

    try:
        test_file = real_logging_dir / ".write_test"
        test_file.touch()
        test_file.unlink()
    except OSError:
        print(f"Logging directory {logging_dir} is not writable.")
        sys.exit(4)

    for handler in logging.root.handlers[:]:
        logging.root.removeHandler(handler)

    name = log_name.replace(".log", "")
    logger = logging.getLogger(name)
    log_file = real_logging_dir / log_name

    if not any(
        isinstance(h, logging.FileHandler)
        and getattr(h, "baseFilename", None) == str(log_file)
        for h in logger.handlers
    ):
        file_handler = logging.FileHandler(str(log_file))
        file_formatter = logging.Formatter(LOGGING_FORMAT)
        file_handler.setFormatter(file_formatter)
        logger.addHandler(file_handler)

    if not any(
        isinstance(h, logging.StreamHandler) and h.stream == sys.stdout
        for h in logger.handlers
    ):
        stream_handler = logging.StreamHandler(sys.stdout)
        if level <= logging.DEBUG:
            stream_formatter = logging.Formatter(LOGGING_FORMAT_DEBUG)
        else:
            stream_formatter = logging.Formatter(LOGGING_FORMAT)
        stream_handler.setFormatter(stream_formatter)
        logger.addHandler(stream_handler)

    logger.setLevel(level)
    logging_set_host(None, name)
    return logger


def logging_set_host(alias: str | None, log_name: str) -> None:
    """Prepend a server alias to the logging messages until unset.

    :param alias: Alias to prepend.
    :param log_name: Logger name.
    """

    class ContextFilter(logging.Filter):
        def filter(self, record: logging.LogRecord) -> bool:
            record.alias = f"[{alias}] " if alias else ""
            return True

    log_name = log_name.replace(".log", "")
    logging.getLogger(log_name).addFilter(ContextFilter())


def upload_logging_setup(
    logging_dir: str | Path,
    log_name: str,
    alias: str | None = None,
    level: int = logging.INFO,
) -> logging.Logger:
    """Return a logger dedicated to upload messages with ``propagate=False``.

    Idempotent: if a FileHandler for this log file already exists on the
    named logger, return as-is. This matters because the binlog puller
    loop and per-day provider log names cause this to be called repeatedly
    with the same name; without the guard each call would stack another
    FileHandler and another ContextFilter.
    """
    real_logging_dir = Path(logging_dir).expanduser().resolve()
    real_logging_dir.mkdir(parents=True, exist_ok=True)
    name = log_name.replace(".log", "")
    logger = logging.getLogger(name)
    logger.propagate = False
    log_file = str(real_logging_dir / log_name)
    if any(
        isinstance(existing_handler, logging.FileHandler)
        and getattr(existing_handler, "baseFilename", None) == log_file
        for existing_handler in logger.handlers
    ):
        return logger
    file_handler = logging.FileHandler(log_file)
    file_handler.setFormatter(logging.Formatter(LOGGING_FORMAT))
    logger.addHandler(file_handler)
    logger.setLevel(level)
    logging_set_host(alias, name)
    return logger


def format_seconds_to_hhmmss(seconds: float) -> str:
    """Format seconds into HH:MM:SS format.

    :param seconds: Number of seconds.
    :return: Formatted time string.
    """
    seconds = round(seconds)
    hours = seconds // 3600
    seconds %= 3600
    minutes = seconds // 60
    seconds %= 60
    return f"{hours:02d}:{minutes:02d}:{seconds:02d}"


def get_free_space(dir_path: Path, *, pct: bool = False) -> float:
    """Get free space in MB or percent of a filesystem.

    :param dir_path: Directory path.
    :param pct: If True, return free space as a percentage.
    :return: Free space in MB or percent.
    """
    stat = os.statvfs(dir_path)
    free_mb = stat.f_bavail * stat.f_bsize / BYTES_PER_MB
    if pct:
        total_mb = stat.f_blocks * stat.f_bsize / BYTES_PER_MB
        free_mb = free_mb * 100 / total_mb
    return free_mb


def get_max_subdir_size(start_path: Path) -> int:
    """Get the maximum size among all subdirectories of a given path.

    :param start_path: Directory path.
    :return: Maximum subdirectory size in the given unit.
    """
    return max(get_dir_size(file) for file in start_path.glob("*") if file.is_dir())


def is_free_space(
    dir_path: Path,
    logger: logging.Logger,
    *,
    double_space_needed: bool = False,
) -> tuple[bool, str]:
    """Check if there is enough disk space for the backup.

    :param dir_path: Directory path to check.
    :param logger: Logger instance.
    :param double_space_needed: If True, require double space.
    :return: (space_ok, message) tuple.
    """
    space_ok = True
    output = ""

    free_mb = get_free_space(dir_path)
    max_backup_size = get_max_subdir_size(dir_path) / BYTES_PER_MB
    ratio = 2 if double_space_needed else 1
    max_size = int(max_backup_size * ratio * 1.1) if max_backup_size > 0 else 0

    if free_mb < max_size:
        space_ok = False
        output = f"Not enough disk space: free {free_mb:.2f} Mb, needed {max_size} Mb"
    elif logger:
        logger.info("Disk space OK: free %.2f Mb, needed %d Mb.", free_mb, max_size)

    return space_ok, output


def encrypt_dir(path: Path, logger: logging.Logger, **cfg: Any) -> None:
    """Encrypt a directory using GPG.

    :param path: Directory path to encrypt.
    :param logger: Logger instance.
    :param cfg: Additional encryption configuration arguments.
    :raises BackupError: If encryption fails or verification fails.
    """
    logger.info("Encrypting backup...")
    logger.info("Running on: %s", path)

    dir_encrypt = DirectoryEncryptor(cfg_path=DIR_ENCRYPT_CFG_PATH, **cfg)
    if not dir_encrypt.encrypt_dir(encr_dir=path):
        raise BackupError("Encryption failed.")

    if not is_encrypted_dir(path, logger):
        raise BackupError("Something wrong, there are still unencrypted files!")

    logger.info("OK Encryption complete and verified.")


def is_encrypted_dir(path: Path, logger: logging.Logger) -> bool:
    """Check if all files in the directory are encrypted.

    :param path: Directory path.
    :param logger: Logger instance.
    :return: True if all files are encrypted, False otherwise.
    :raises BackupError: If GPG encounters a critical error (e.g., missing keys).
    """
    for file_path in path.rglob("*"):
        if not file_path.is_file() or file_path.name in EXCLUDE_FILES:
            continue

        if not file_path.name.endswith(".gpg"):
            return False

        cmd = [
            GPG_BIN,
            "--batch",
            "--list-only",
            "--status-fd",
            "1",
            "--decrypt",
            str(file_path),
        ]

        try:
            result = subprocess.run(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=30,
            )
        except subprocess.TimeoutExpired:
            if logger:
                logger.error("GPG command timed out for file: %s", file_path.name)
            raise BackupError(
                f"GPG encryption verification timed out for {file_path.name}"
            )

        if result.returncode == 0:
            continue

        stdout_bytes = result.stdout or b""
        err_bytes = result.stderr or b""
        err_str = err_bytes.decode("utf-8", errors="replace")
        stdout_str = stdout_bytes.decode("utf-8", errors="replace")

        if b"[GNUPG:] NODATA" in stdout_bytes:
            if logger:
                logger.error(
                    'File "%s" has .gpg extension but is not encrypted (NODATA). Status: %s, Error: %s',
                    file_path.name,
                    stdout_str,
                    err_str,
                )
            return False

        if any(pattern in err_bytes for pattern in GPG_NOT_ENCRYPTED_PATTERNS):
            if logger:
                logger.error(
                    'File "%s" has .gpg extension but is not encrypted. Status: %s, Error: %s',
                    file_path.name,
                    stdout_str,
                    err_str,
                )
            return False

        critical_status_found = any(
            status_code in stdout_bytes for status_code in GPG_CRITICAL_STATUS_CODES
        )

        critical_stderr_found = any(
            pattern in err_bytes for pattern in GPG_CRITICAL_ERROR_PATTERNS
        )

        if critical_status_found or critical_stderr_found:
            if logger:
                logger.error("Running: %s", " ".join(cmd))
                logger.error(
                    'Critical GPG error verifying encryption of file "%s". Status: %s, Error: %s',
                    file_path.name,
                    stdout_str,
                    err_str,
                )
            raise BackupError(
                f"GPG encryption verification failed for {file_path.name}. "
                "This usually indicates missing GPG keys or GPG configuration issues. "
                f"Status: {stdout_str}, Error: {err_str}"
            )

        if logger:
            logger.warning(
                'Unexpected GPG error for file "%s". Status: %s, Error: %s',
                file_path.name,
                stdout_str,
                err_str,
            )
        return False

    return True


def preflight_check() -> None:
    """Perform checks prior to running backups."""
    if not sys.version_info >= (3, 8):
        print(f"ERROR: python 3.8+ required. Your version: {sys.version_info}.\n")
        sys.exit(4)


def main() -> None:
    """Run main program."""
    options = parse_args()
    preflight_check()
    mydumper_runner = MyDumperRunner(options.config)
    mydumper_runner.run()


def parse_args() -> argparse.Namespace:
    """Parse command line arguments.

    :return: Parsed arguments namespace.
    """
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "-c", "--config", type=Path, help="File name of the YAML config"
    )
    return parser.parse_args()


class DirectoryEncryptor:
    """Handle encryption of files in a directory using GPG.

    :param cfg_path: Path to the configuration file.
    :type cfg_path: Path
    :ivar config: A dictionary holding configuration options such as encryption
        recipient, GPG binary path, encryption home directory, and concurrency limits.
    :vartype config: dict
    """

    def __init__(self, cfg_path: Path, **cfg) -> None:
        self.config = {}
        self._setup_cfgs(cfg_path)
        self.config.update(cfg)

    def _setup_cfgs(self, cfg_path: Path) -> None:
        """Load configuration from the specified path, or set defaults if not found.

        Also checks if pinentry-mode is supported by the configured GPG binary.
        """
        if cfg_path.exists():
            try:
                with cfg_path.open(encoding="utf-8") as cfg_f:
                    self.config = yaml.safe_load(cfg_f) or {}
            except (FileNotFoundError, yaml.YAMLError):
                self._set_default_config()
        else:
            self._set_default_config()

        gpg_bin = self.config.get("gpg bin", "/usr/bin/gpg")

    def _set_default_config(self) -> None:
        """Set default configuration values."""
        self.config = {
            "encryption recipient": "directory.encryption@percona.com",
            "encryption home dir": "~/.gnupg",
            "max encryption processes": 5,
            "encryption nice": False,
            "gpg bin": "/usr/bin/gpg",
            "encryption file filter": "",
        }

    def _start_gpg_subp(
        self,
        filename: str,
        recipient: str = "",
        *,
        nice: bool = False,
    ) -> subprocess.Popen:
        """Start and return a GPG encryption (or decryption) subprocess.

        :param filename: The input file to encrypt or decrypt.
        :type filename: str
        :param recipient: The GPG recipient if encrypting, ignored if decrypting.
        :type recipient: str
        :param nice: If True, start the process with `nice`.
        :type nice: bool
        :return: The subprocess.Popen object representing the started GPG process.
        :rtype: subprocess.Popen
        """
        gpg_bin = self.config["gpg bin"]
        home_dir = self.config.get("encryption home dir", "")
        output_filename = filename + ".gpg"
        stdin = None
        cmd = [
            gpg_bin,
            "--batch",
            "--yes",
            "--encrypt",
            "--always-trust",
            "--quiet",
            f"--recipient={recipient}",
            f"--output={output_filename}",
            filename,
        ]

        if nice:
            cmd.insert(0, "nice")
        if home_dir:
            cmd.insert(-1, f"--homedir={home_dir}")
        return subprocess.Popen(cmd, stdin=stdin)

    def _prune_finished_procs(
        self, proc_dict: dict[str, subprocess.Popen], max_live_proc: int = 0
    ) -> bool:
        """Check the dictionary of active processes for those that have finished.

        Once a process finishes:
        - If exit code is 0, the original file is unlinked.
        - If exit code is non-zero, logs an error and exits the program with status 1.

        Prunes finished processes from the dictionary.

        :param proc_dict: A dictionary of {filename: Popen} representing running
            encryption processes.
        :type proc_dict: dict[str, subprocess.Popen]
        :param max_live_proc: The maximum number of processes allowed before waiting.
        :type max_live_proc: int
        :return: True if no errors were encountered, False otherwise.
        :rtype: bool
        """
        ok = True
        while proc_dict:
            for fp, proc in list(proc_dict.items()):
                rc = proc.poll()
                if rc is None:
                    continue
                if rc == 0:
                    with suppress(OSError):
                        Path(fp).unlink()
                else:
                    ok = False
                    logging.error("%r did not encrypt correctly.", fp)
                    sys.exit(1)
                del proc_dict[fp]
            if len(proc_dict) < max_live_proc:
                break
            time.sleep(0.1)
        return ok

    def encrypt_dir(
        self,
        encr_dir: Path,
    ) -> bool:
        """Encrypt all regular files under `encr_dir` using GPG.

        If `recipient`, `nice`, and `max_proc` are not provided, the values are taken
        from the configuration file. If a file is successfully encrypted, the original
        file is removed.

        :param encr_dir: The directory path containing files to be encrypted.
        :type encr_dir: str
        :return: True if all files were encrypted successfully, False otherwise.
        :rtype: bool
        """
        recipient = self.config.get("encryption recipient", "directory.encryption@percona.com")
        nice = bool(self.config.get("encryption nice", False))
        max_proc = int(self.config.get("max encryption processes", 5))

        enc_procs = {}
        all_ok = True

        exclude_names = {
            "md5sum",
            ".uploadme",
            "xtrabackup_info",
            "xtrabackup_checkpoints",
        }

        for file_path in encr_dir.rglob("*"):
            if (
                not file_path.is_file()
                or file_path.name.endswith(".gpg")
                or file_path.name in exclude_names
            ):
                continue

            p = self._start_gpg_subp(str(file_path), recipient=recipient, nice=nice)
            enc_procs[file_path] = p
            ok = self._prune_finished_procs(enc_procs, max_proc)
            all_ok = all_ok and ok

        ok = self._prune_finished_procs(enc_procs)
        return all_ok and ok


class BaseBackup:
    """Base class for shared functionality across backup and restore operations."""

    def __init__(
        self,
        server_data: dict[str, Any],
        backup_code: str,
        logger: logging.Logger | None = None,
    ) -> None:
        """Initialize the BaseBackup object.

        :param server_data: Dictionary of server configuration and runtime data.
        :param backup_code: Backup code indicating the type of backup.
        :param logger: Optional logger instance to use.
        """
        self.server_data = server_data
        self.backup_code = backup_code
        self.backup_textfile_collector_dir = Path(
            self.server_data.get(
                "BACKUP_TEXTFILE_COLLECTOR_DIR", BACKUP_TEXTFILE_COLLECTOR_DIR
            )
        )
        self.alias = self.server_data.get("ALIAS")
        self.report_options: dict[str, Any] = {}
        self.logging_dir = Path(
            self.server_data.get("LOGGING_DIR", DEFAULT_LOGGING_DIR)
        )
        self.logger = logger

        self.compress = self.server_data.get("COMPRESS", True)
        self.compression_algorithm = self.server_data.get(
            "COMPRESSION_ALGORITHM", DEFAULT_COMPRESSION_ALGORITHM
        )
        if self.compress:
            self.check_compression_algorithm(self.compression_algorithm)

        # Dynamically set
        self.is_replica = False
        self.last_backup_dir = None

    def check_compression_algorithm(self, algorithm: str) -> None:
        """Check if the given compression algorithm is compatible with the backup type.

        :param algorithm: Compression algorithm name.
        :raises BackupError: If the algorithm is not compatible.
        """
        if not self.compress:
            self.logger.debug("Compression is disabled, skipping check")
            return
        if algorithm in AVAILABLE_COMPRESSION_ALGORITHMS:
            self.logger.debug(
                "Algorithm %s accepted for backup type %s", algorithm, self.backup_code
            )
            return
        raise BackupError(
            f"algorithm {algorithm} is not one of {AVAILABLE_COMPRESSION_ALGORITHMS}"
        )

    def notify(self, status: BackupNotifyStatus, output: str) -> None:
        """Send notifications about backup or restore operations.

        :param status: Operation status code.
        :param output: Operation output or message.
        """
        if len(output) > 300:
            output = f"{output[:300]}..."

        if isinstance(self, Backup) and self.is_replica:
            output = f"Host {self.alias}. {output}"

        self.report_options["end_time"] = time.strftime(DATETIME_FORMAT, time.gmtime())

        if status == BackupNotifyStatus.OK:
            self.textfile_collector_notify(0)
            if "OK no new binlogs to upload" in output:
                self.textfile_collector_write_status(status, MSPAction.UPLOAD)
        else:
            self.textfile_collector_notify(1)

    def check_textcollector_dir(self) -> bool:
        """Check if the textfile collector directory exists.

        :return: True if directory exists, False otherwise.
        """
        backup_textfile_collector_dir = self.backup_textfile_collector_dir.parent
        if not backup_textfile_collector_dir.is_dir():
            self.logger.warning(
                "Textfile Collector directory %s does not exist.",
                backup_textfile_collector_dir,
            )
            return False
        return True

    def textfile_collector_write_status(
        self,
        backup_status: int,
        msp_action: MSPAction = MSPAction.BACKUP,
        backup_running: int | None = None,
    ) -> None:
        """Write backup status to textfile collector for Prometheus.

        :param backup_status: Backup status code.
        :param msp_action: MSP action (BACKUP or UPLOAD).
        :param backup_running: Whether backup is running (0 or 1).
        """
        if not self.check_textcollector_dir():
            return

        collector_file = (
            self.backup_textfile_collector_dir
            / f"{msp_action.value}.{BACKUP_TYPE}.{self.alias}.prom"
        )

        encryption_val = self.report_options.get("encryption", "")
        start_time_val = str(self.report_options.get("start_time", ""))
        end_time_val = str(self.report_options.get("end_time", ""))

        metrics_text = (
            f"# HELP msp_{msp_action.value}_status The status of the job\n"
            f"# TYPE msp_{msp_action.value}_status Untyped\n"
            f"# HELP msp_{msp_action.value}_last_report_ts The Last Report Time\n"
            f"# TYPE msp_{msp_action.value}_last_report_ts Untyped\n"
        )

        # Add backup_running metric help if provided
        if backup_running is not None and msp_action == MSPAction.BACKUP:
            metrics_text += (
                f"# HELP msp_{msp_action.value}_running The status of the backup job\n"
                f"# TYPE msp_{msp_action.value}_running Untyped\n"
            )

        metrics_text += (
            f'msp_{msp_action.value}_status{{type="{BACKUP_TYPE}", alias="{self.alias}", encryption="{encryption_val}", '
            f'backup_id="", start_time="{start_time_val}", end_time="{end_time_val}"'
        )

        size_bytes = (
            get_dir_size(self.last_backup_dir)
            if self.last_backup_dir is not None
            else 0
        )
        metrics_text += f', backup_size="{size_bytes}"'

        metrics_text += f"}} {backup_status}\n"
        metrics_text += f'msp_{msp_action.value}_last_report_ts{{type="{BACKUP_TYPE}", alias="{self.alias}", backup_id=""}} {int(time.time())}\n'

        if backup_running is not None and msp_action == MSPAction.BACKUP:
            metrics_text += f'msp_{msp_action.value}_running{{type="{BACKUP_TYPE}", alias="{self.alias}"}} {backup_running}\n'

        with collector_file.open("w") as outfile:
            outfile.write(metrics_text)

    def textfile_collector_notify(self, backup_status: int) -> None:
        """Notify status via textfile collector.

        :param backup_status: Backup status code.
        """
        self.textfile_collector_write_status(backup_status)

    def textfile_collector_write_enable(
        self, alias: str, backup_enabled: bool, job_type: str
    ) -> None:
        """Add the enabled backup types to the textfile collector.

        :param alias: Host alias.
        :param backup_enabled: Whether the backup type is enabled.
        :param job_type: Job type name.
        """
        if not self.check_textcollector_dir():
            return

        collector_file = (
            self.backup_textfile_collector_dir
            / f"driver.{job_type}.{BACKUP_TYPE}.{alias}.prom"
        )

        with collector_file.open("w") as outfile:
            outfile.write(
                f"# HELP msp_{job_type}_enabled The status of the cron\n"
                f"# TYPE msp_{job_type}_enabled Untyped\n"
            )
            outfile.write(
                f'msp_{job_type}_enabled{{type="{BACKUP_TYPE}", alias="{alias}"}} '
                f"{1 if backup_enabled else 0}\n"
            )


class Backup(BaseBackup):
    """Common class for all backup types."""

    def __init__(
        self,
        server_data: dict[str, Any],
        backup_code: str,
        logger: logging.Logger,
    ) -> None:
        """Initialize the Backup object with server data and backup code.

        :param server_data: Server configuration and data.
        :param backup_code: Backup code string.
        :param logger: Optional logger instance.
        """
        self.backup_code = backup_code
        super().__init__(server_data, backup_code, logger)
        self.host = server_data.get("HOST", "localhost")
        self.alias = server_data.get("ALIAS", self.host)
        self.port = server_data.get("PORT", 3306)
        self.hostname = str(
            server_data.get("HOSTNAME", socket.gethostname().split(".")[0])
        )
        self.check_disk_space = server_data.get("CHECK_DISK_SPACE", True)
        self.defaults_cnf_file = server_data.get("DEFAULTS_FILE", DEFAULT_MYCNF)
        self.hardlink = server_data.get("HARDLINK", True)
        self.dir_encrypt_config = server_data.get("DIR_ENCRYPT_CONFIG", {})
        self.post_run_encrypt = server_data.get("POST_RUN_ENCRYPT", False)
        self.only_if_read_only = server_data.get("ONLY_IF_READ_ONLY")
        self.only_if_running_replica = server_data.get("ONLY_IF_RUNNING_REPLICA")
        self.upload_type = server_data.get("UPLOAD", set())
        if isinstance(self.upload_type, str):
            self.upload_type = {self.upload_type}
        self.upload_interval = server_data.get("UPLOAD_INTERVAL", "weekly")
        self.all_cnf_files = []
        self.backup_textfile_collector_dir = Path(
            self.server_data.get(
                "BACKUP_TEXTFILE_COLLECTOR_DIR", BACKUP_TEXTFILE_COLLECTOR_DIR
            )
        )

        self.logger = (
            self.logger
            or logger
            or logging_setup(self.logging_dir, BACKUP_TYPE.lower() + ".log")
        )
        logging_set_host(self.alias, BACKUP_TYPE.lower() + ".log")

        self.report_options = {
            "host": self.alias,
            "status": "error",
            "start_time": time.strftime(DATETIME_FORMAT, time.gmtime()),
            "end_time": "",
            "size_mb": 0,
            "hl_mb": None,
            "options": {},
            "encryption": "none",
        }

    def enable_upload(self, backup_dir: Path) -> None:
        """If upload interval permits, mark backup for upload by creating the UPLOADME_FILE.

        :param backup_dir: Path to the backup directory.
        """
        uploadme_path = backup_dir / UPLOADME_FILE
        if not uploadme_path.is_file():
            uploadme_path.touch()
            self.logger.info("Backup marked for upload.")
            # enable textfile collector metric
            self.textfile_collector_write_enable(self.alias, True, "upload")

    def _query_mysql(self, sql: str) -> Any:
        """Execute a MySQL query and return the result.

        :param sql: SQL query string.
        :return: Fetched result.
        :raises BackupError: If query fails.
        """
        try:
            conn = pymysql.connect(
                read_default_file=self.defaults_cnf_file,
                host=self.host,
                port=self.port,
                cursorclass=pymysql.cursors.DictCursor,
            )
            with conn, conn.cursor() as cursor:
                cursor.execute(sql)
                return cursor.fetchone()
        except (OperationalError, InternalError) as err:
            msg = f'Error running query "{sql}": {err}'
            raise BackupError(msg) from err

    def _is_running_replica(self) -> bool:
        """Check if MySQL replica is running.

        Supports both legacy `SHOW SLAVE STATUS` and newer `SHOW REPLICA STATUS` (MySQL 8.0.22+).

        :return: True if replica is running, False otherwise.
        """
        result = None
        # Try newer MySQL syntax first
        for query in ["SHOW REPLICA STATUS", "SHOW SLAVE STATUS"]:
            for suffix in [" NONBLOCKING", " NOLOCK", ""]:
                try:
                    result = self._query_mysql(f"{query}{suffix}")
                except ProgrammingError:
                    continue
                if result:
                    break
            if result:
                break

        if result and result.get("Replica_IO_Running", result.get("Slave_IO_Running")) == "Yes":
            self.logger.info("MySQL replication is running.")
            return True

        return False

    def _is_read_only(self) -> bool:
        """Check if MySQL is read-only.

        :return: True if read_only=1, False otherwise.
        """
        result = self._query_mysql("SELECT @@read_only")
        if result["@@read_only"] == 1:
            self.logger.info("MySQL read_only is enabled.")
            return True
        return False

    def _is_pxc(self) -> bool:
        """Check if MySQL is running PXC/Galera cluster.

        :return: True if wsrep_on=1, False otherwise.
        """
        try:
            result = self._query_mysql("SELECT @@wsrep_on")
        except BackupError:
            return False

        if result["@@wsrep_on"] == 1:
            self.logger.info("PXC/Galera cluster detected.")
            return True
        return False

    def _pxc_desync(self, new_status: int = 1) -> bool:
        """Change wsrep_desync of a Galera node.

        :param new_status: Desired wsrep_desync status (0 or 1).
        :return: True if wsrep_desync changed or already in desired state, False otherwise.
        """
        try:
            result = self._query_mysql("SELECT @@wsrep_desync")
        except BackupError:
            return False

        if result["@@wsrep_desync"] != new_status:
            if result["@@wsrep_desync"] == 1:
                recv_queue = self._query_mysql(
                    'SHOW GLOBAL STATUS LIKE "wsrep_local_recv_queue"'
                )
                if int(recv_queue["Value"]) > 32:
                    logging.warning(
                        "Galera node is not synced, queue size is %s",
                        recv_queue["Value"],
                    )

            self._query_mysql(f"SET GLOBAL wsrep_desync = {new_status}")
            self.logger.info("MySQL wsrep_desync changed to %s", new_status)

        return True


class BackupError(Exception):
    """Typical backup error."""

    def __init__(self, message) -> None:
        super().__init__(self, message)
        self.message = message


class LocalConfig:
    """Local configuration class for backup/restore processes."""

    default_nowrite_timeout = 1800  # 30 minutes
    default_purge_days = 30

    def __init__(self, cfg_path: Path) -> None:
        """Initialize LocalConfig and populate configuration from the specified YAML file.

        :param cfg_path: Path to the configuration file.
        """
        self.server_data_list: list[dict[str, Any]] = []
        self.base: dict[str, Any] = {}
        self.cfg_path = Path(cfg_path)
        self.populated = False
        self.raw_cfg_data: dict[str, Any] = {}
        self._populate_cfg()

    def _populate_cfg(self) -> None:
        """Populate the configuration from the YAML file."""
        try:
            with self.cfg_path.open("r") as cfg_file:
                cfg_file_contents = cfg_file.read()
                data = yaml.safe_load(cfg_file_contents)
        except Exception:
            logging.exception("Could not read config file %r", self.cfg_path)
            return

        self.raw_cfg_data = data

        default_server = {
            "PORT": 3306,
            "NOWRITE_TIMEOUT": LocalConfig.default_nowrite_timeout,
            "BINLOG_PURGE_DAYS": LocalConfig.default_purge_days,
        }
        default_server.update(data["ALL_SERVERS"])
        self.base = default_server.copy()

        for server in data["SERVER_LIST"]:
            if (
                "HOST" in server
                and isinstance(server["HOST"], str)
                and server["HOST"].count(":") > 1
            ):
                logging.warning("Unsupported host format %s", server["HOST"])
                continue
            server_data = default_server.copy()
            server_data.update(server)
            self.server_data_list.append(server_data)
        self.populated = True


class Upload(Backup):
    """Parent class for all specific uploaders.
    Provides a run method to execute uploading.
    """

    def __init__(
        self,
        upload_type: str,
        upload_provider: Any,
        settings: dict[str, Any],
        logger: logging.Logger,
    ) -> None:
        """Initialize the Upload object.

        :param upload_type: Type of upload (e.g., "S3", "Rsync","GS").
        :param upload_provider: Class handling the specific upload method.
        :param settings: Server/backup settings.
        :param logger: Logger instance.
        """
        backup_code = settings["BACKUP_TYPE"]
        super().__init__(settings, backup_code, logger)
        self.upload_type = upload_type
        self.logger = upload_logging_setup(
            self.logging_dir, "upload-mydumper.log", self.alias, logger.level
        )
        self.upload_provider = upload_provider(settings, self.logger.level)
        self.last_uploaded_number = 0
        self.last_to_upload_number = 0
        log_path = self.logging_dir / "upload-mydumper.log"
        self.log_stream = log_path.open("a")
        self.backup_type = BACKUP_TYPE
        self.encrypt = settings.get("ENCRYPT", True)
        self.encrypt_using_tmpdir = settings.get("ENCRYPT_USING_TMPDIR", False)
        self.post_run_encrypt = settings.get("POST_RUN_ENCRYPT", False)

        if self.post_run_encrypt or not self.encrypt:
            self.encrypt_using_tmpdir = False

        self.report_options["options"] = {
            "upload_to": self.upload_type,
            "encrypt": self.encrypt or self.post_run_encrypt,
        }

        if self.encrypt or self.post_run_encrypt:
            self.report_options["encryption"] = "gpg"

        root_backup_dir = settings["BACKUP_DIR"]
        root_backup_path = Path(root_backup_dir)

        self.relative_backup_path = Path("mydumper") / self.alias
        self.full_backup_path = root_backup_path / self.relative_backup_path
        self.tmpdir_for_enc_upload = (
            root_backup_path / "_tmpdir_for_enc_upload" / self.relative_backup_path
        )

        self.paths = []

    def _collect_paths(self) -> None:
        """If there are backups to upload, add them to the upload list.
        Otherwise, with empty self.paths, the upload will be skipped.
        """
        for datedir in self.full_backup_path.iterdir():
            if datedir.is_dir():
                conditions_to_upload = [
                    re.search(BACKUP_DIR_REGEX, datedir.name),
                    (datedir / UPLOADME_FILE).is_file(),
                ]
                if all(conditions_to_upload):
                    self.paths.append(
                        {
                            "source": str(datedir),
                            "rel_destination": str(
                                self.relative_backup_path / datedir.name
                            ),
                            "tmpdir": str(self.tmpdir_for_enc_upload / datedir.name),
                        }
                    )

    def _copy_to_tmpdir(self) -> None:
        """Copy backup to a temporary directory for encryption prior to upload, if enabled."""
        if not self.encrypt_using_tmpdir:
            return

        self.logger.info("Copying backup to tmpdir for encryption...")
        for path in self.paths:
            tmpdir = Path(path["tmpdir"])
            if tmpdir.is_dir():
                shutil.rmtree(tmpdir)
                self.logger.info("Removed old tmpdir %s", tmpdir)

            source_path = Path(path["source"])
            self.logger.info(
                "Checking available disk space to copy %s ...", source_path
            )
            bkp_size = get_dir_size(source_path) / BYTES_PER_MB
            tmpdir_base = tmpdir
            while not tmpdir_base.is_dir():
                tmpdir_base = tmpdir_base.parent
            free_size = get_free_space(tmpdir_base)
            self.logger.info("Backup size: %sMB free space: %sMB", bkp_size, free_size)
            if free_size > bkp_size * 1.1:
                shutil.copytree(source_path, tmpdir)
            else:
                msg = "No free space to use tmp dir for encryption."
                raise BackupError(msg)

        self.logger.info("OK Copy complete.")

    def _encrypt(self) -> None:
        """Encrypt backup directories prior to upload if encryption is enabled."""
        if not (self.encrypt or self.post_run_encrypt):
            self.logger.warning("UPLOADING UNENCRYPTED BACKUP!!!")
            return

        for path in self.paths:
            dir_ = Path(path["tmpdir"] if self.encrypt_using_tmpdir else path["source"])
            encrypt_dir(dir_, self.logger, **self.dir_encrypt_config)

    def _upload(self) -> None:
        """Upload backups to the remote destination using the provided upload provider."""
        for path in self.paths:
            dir_ = path["tmpdir"] if self.encrypt_using_tmpdir else path["source"]
            dest_path = self.upload_provider.upload(dir_, path["rel_destination"])
            self.report_options["options"]["remote_path"] = dest_path
            self._mark_as_uploaded(Path(path["source"]))

    def _mark_as_uploaded(self, dir_: Path) -> None:
        """Mark the backup as uploaded by removing or updating the UPLOADME_FILE.

        :param dir_: Path to the backup directory.
        """
        uploadme_file = dir_ / UPLOADME_FILE
        if self.backup_code in ["B", "O"]:
            with uploadme_file.open("w+") as file_:
                file_.write(str(self.last_to_upload_number))
        elif uploadme_file.is_file():
            uploadme_file.unlink(missing_ok=True)

    def _cleanup(self) -> None:
        """Purge temporary directories used for encryption if enabled."""
        if not self.encrypt_using_tmpdir:
            return

        for path in self.paths:
            tmpdir = Path(path["tmpdir"])
            if tmpdir.is_dir():
                shutil.rmtree(tmpdir)
                self.logger.info("Removed tmpdir %s", tmpdir)

    def run(self) -> str:
        """Execute the upload process.

        :return: Status message of the upload process.
        """
        if self.full_backup_path.is_dir():
            self._collect_paths()

        if not self.paths:
            self.logger.debug("Nothing to upload of %s backup.", self.backup_type)
            return "OK no new binlogs to upload." if self.backup_code == "B" else ""

        start_time = time.time()
        self.logger.info(
            "Starting %s upload of %s backup: %s",
            self.upload_type,
            self.backup_type.lower(),
            ", ".join([p["source"] for p in self.paths]),
        )

        self.textfile_collector_write_status(-1, MSPAction.UPLOAD)

        self._copy_to_tmpdir()
        self._encrypt()
        self._upload()
        self._cleanup()

        time_spent = format_seconds_to_hhmmss(time.time() - start_time)
        msg = f"OK {self.upload_type} upload complete. Duration: {time_spent}."
        self.logger.info(msg)
        self.textfile_collector_write_status(0, MSPAction.UPLOAD)

        return msg


