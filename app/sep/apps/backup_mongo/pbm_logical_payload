""" PBM Logical Payload """

import subprocess
import os
import sys
import yaml


def _creds_path():
    """ Path to MongoDB URI credentials file """
    config_yaml = os.environ.get('NOMAD_META_CONFIG')
    if config_yaml:
        try:
            config = yaml.safe_load(config_yaml)
            if isinstance(config, dict):
                path = config.get('credentials_path')
                if path:
                    return path
        except yaml.YAMLError as err:
            print(f'Failed to parse NOMAD_META_CONFIG as YAML: {err}. Falling back to HOME-based credentials path.', file=sys.stderr)
    envhome = os.environ.get('HOME')
    if not envhome:
        print('PBM credentials path not set (credentials_path in backup config) and HOME is unset', file=sys.stderr)
        sys.exit(1)
    return f'{envhome}/.mongodb_uri'


def pbm_creds():
    """ PBM Credentials """
    creds_path = _creds_path()
    try:
        with open(creds_path, 'r', encoding='utf-8') as fpt:
            return fpt.read().strip()
    except FileNotFoundError as err:
        print(f'Credentials file not found: {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)
    except PermissionError as err:
        print(f'Permission denied reading credentials file {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)
    except OSError as err:
        print(f'Error reading credentials file {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)
    except Exception as err:
        print(f'Error reading credentials file {creds_path}: {err}', file=sys.stderr)
        sys.exit(1)


def _load_config():
    """ Return NOMAD_META_CONFIG parsed as a dict, or {} when absent/invalid/non-mapping.

    A present-but-unparseable or non-mapping config logs to stderr and yields {} so the
    backup still runs on PBM's default compression rather than aborting.
    """
    config_yaml = os.environ.get('NOMAD_META_CONFIG')
    if not config_yaml:
        return {}
    try:
        config = yaml.safe_load(config_yaml)
    except yaml.YAMLError as err:
        print(f'Failed to parse NOMAD_META_CONFIG as YAML: {err}. Proceeding without compression flags.', file=sys.stderr)
        return {}
    if isinstance(config, dict):
        return config
    print('NOMAD_META_CONFIG did not parse to a mapping. Proceeding without compression flags.', file=sys.stderr)
    return {}


def _compression_flags(config):
    """ Build pbm backup --compression / --compression-level flags from the backup config.

    Returns [] when no compression is configured so PBM keeps its own default.
    --compression-level is only emitted alongside --compression.
    """
    backup = config.get('backup') or {}
    compression = backup.get('compression')
    if not compression:
        return []
    flags = ['--compression', str(compression)]
    level = backup.get('compressionLevel')
    if level is not None:
        flags += ['--compression-level', str(level)]
    return flags


def pbm():
    """ PBM Logical Payload """

    os.environ['PBM_MONGODB_URI'] = pbm_creds()
    config = _load_config()
    cmd = ['pbm', 'backup', '--type', 'logical', '--wait'] + _compression_flags(config)

    try:
        proc = subprocess.Popen(cmd)
        proc.wait()
        ret_code = proc.poll()
        if ret_code != 0:
            sys.exit(ret_code)

    except OSError as err:
        print(f'Failed to run pbm: {err}', file=sys.stderr)
        sys.exit(1)

pbm()
