"""Build the run-python spec for the << display_name >> app."""

from app.core.utils.path import payload_uri
from app.sep.apps.<< name >>.models import << class_prefix >>Form
from app.sep.apps.framework.spec import ResolvedEntities, RunPythonSpec


def build_<< name >>_spec(
    form: << class_prefix >>Form, _resolved: ResolvedEntities
) -> RunPythonSpec:
    """Build the run-python spec from the validated form.

    The framework's ``assemble_envelope`` fills ``target`` (the ``HostRef``
    executor), ``_service_name``, and the connectivity keys around this spec; here
    we own the serialized ``config`` the payload reads and the pip ``requirements``
    it runs under. Replace ``requirements`` with the payload's pip dependencies and
    adjust ``config`` to the shape the ``payload`` script expects; the ``payload``
    file copied beside this module is the entrypoint.

    :param form: The validated create form.
    :param _resolved: The entities resolved from the form's reference fields, part
        of the framework's ``(form, resolved) -> RunPythonSpec`` builder contract.
    :return: The run-python spec consumed by ``assemble_envelope``.
    """
    return RunPythonSpec(
        config=form.model_dump_json(),
        requirements="",
        payload=payload_uri(__file__, "payload"),
    )
