<style>

    .hidden {
        overflow: hidden;
        transition: opacity 0.5s ease, max-height 0.5s ease;
        opacity: 0;
        max-height: 0;
        pointer-events: none;
        display: none;
    }

    .visible {
        opacity: 1;
        max-height: 1000px; /* Large enough to show all content */
        pointer-events: auto;
        display: flex;
    }

    /* Smaller containers might have less content, adjust accordingly if needed */
    #myloader_container,
    #xtrabackup_container,
    #s3_container,
    #rsync_container {
        overflow: hidden;
        transition: opacity 0.5s ease, max-height 0.5s ease;
        opacity: 0;
        max-height: 0;
    }

    #myloader_container.visible,
    #xtrabackup_container.visible,
    #s3_container.visible,
    #rsync_container.visible {
        opacity: 1;
        max-height: 1000px;
    }

    #s3_container.visible,
    #rsync_container.visible{
        display: block;
    }


    button {
        margin-top: 1em;
        margin-right: 1em;
    }

    .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 1em;
        align-items: center;
    }

    .checkbox-group label {
        display: inline-flex;
        align-items: center;
        gap: 0.25em;
        margin-top: 0;
    }

    .checkbox-group input {
        margin-top: 0 !important;
    }
    fieldset + fieldset {
        margin: 1em 0;
    }
</style>
<form id="create-restore-form"
      class="create-restore-form window"
      method="post"
      action=""
      data-confirm-message="Are you sure you want to create this restore task?">
    <dialog id="modalCreateTask"
            aria-modal="true"
            aria-labelledby="modalCreateTaskTitle"
            data-modal="target"
            class="large">
        <header>
            <h3 id="modalCreateTaskTitle" class="h5 title">Configure a restore task</h3>
        </header>
        <section>
            <input type="hidden" name="csrf-token" value="{{ csrf_token }}" />
            <fieldset>
                <legend>Main Options</legend>
                <br>
                <fieldset>
                    <legend>Executor Host</legend>
                    {% set hostname_title = "Select the hostname of the target system for task execution." %}
                    <div class="select">
                        <label for="hostname" title="{{ hostname_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">Select Executor Host:</span>
                            {% if executor_hosts|length == 1 %}
                                {% set single_host = executor_hosts[0] %}
                                <select id="hostname" name="hostname" title="{{ hostname_title }}" disabled>
                                    <option value="{{ single_host.value }}" selected>{{ single_host.label }}</option>
                                </select>
                                <input type="hidden" name="hostname" value="{{ single_host.value }}">
                            {% else %}
                                <select id="hostname" name="hostname" title="{{ hostname_title }}" required>
                                    <option value="" selected>Select a host</option>
                                    {% for host in executor_hosts %}<option value="{{ host.value }}">{{ host.label }}</option>{% endfor %}
                                </select>
                            {% endif %}
                        </label>
                    </div>
                </fieldset>
                <fieldset>
                    <legend>Basic Task Information</legend>
                    <br>
                    {% set task_name_title = "Type the name of task to be created." %}
                    <label for="task_name" title="{{ task_name_title }}">
                        Task Name:
                        <input type="text"
                               id="task_name"
                               name="task_name"
                               class="validate"
                               required
                               placeholder="Enter a unique task name" />
                    </label>
                    <br>
                    <br>
                    {% set backup_type_title = "Select the type of restore: MyLoader or XtraBackup." %}
                    <div class="select">
                        <label for="backup_type" title="{{ backup_type_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">Restore Type:</span>
                            <select id="backup_type" name="backup_type" required>
                                <option value="">Select a restore type</option>
                                <option value="M">MyLoader</option>
                                <option value="X">Xtrabackup</option>
                                <option value="B">Binlog</option>
                            </select>
                        </label>
                    </div>
                </fieldset>
                <fieldset>
                    <legend>General Restore Configuration</legend>
                    <br>
                    {% set backup_source_title = "Type the path or identifier of the backup source to restore from. Examples: 192.168.88.10:/backup/xtrabackup/backup-gascan/latest, s3://dummy/binlogs/primary, s3://dummy/mydumper/backup-gascan/latest" %}
                    <label for="backup_source" title="{{ backup_source_title }}">
                        Backup Source:
                        <input type="text"
                               id="backup_source"
                               name="backup_source"
                               style="width: 25em"
                               required
                               placeholder="127.0.0.1:/backup/xtrabackup/backup-gascan/latest" />
                    </label>
                    <br>
                    <br>
                    {% set logging_dir_title = "Type the directory where log files will be stored for restore operations." %}
                    <label for="logging_dir" title="{{ logging_dir_title }}">
                        Logging Directory (optional):
                        <input type="text"
                               id="logging_dir"
                               name="logging_dir"
                               placeholder="/path/to/logs" />
                    </label>
                    <br>
                    <br>
                    {% set port_title = "Type the MySQL port number used to connect to the target database (default is 3306)." %}
                    <label for="port" title="{{ port_title }}">
                        Port:
                        <input type="number" id="port" name="port" value="3306" placeholder="3306" />
                    </label>
                    <br>
                    <br>
                    {% set custom_mysql_init_commad_title = "the path to the defaults file containing preset configuration values for the backup process." %}
                    <label for="custom_mysql_init_commad"
                           title="{{ custom_mysql_init_commad_title }}">
                        Custom MySQL Init Command (optional):
                        <input type="text"
                               id="custom_mysql_init_commad"
                               name="custom_mysql_init_commad"
                               placeholder="/etc/init.d/mysql" />
                    </label>
                    <br>
                    <br>
                    {% set ssh_user_title = "Type the SSH username to connect to the target host for restore operations (e.g., 'percona')." %}
                    <label for="ssh_user" title="{{ ssh_user_title }}">
                        SSH User:
                        <input type="text" id="ssh_user" name="ssh_user" placeholder="percona" />
                    </label>
                    <br>
                    <br>
                    {% set ssh_port_title = "Type the SSH port number used to connect to the target host (default is 22)." %}
                    <label for="ssh_port" title="{{ ssh_port_title }}">
                        SSH Port:
                        <input type="number"
                               id="ssh_port"
                               name="ssh_port"
                               value="22"
                               placeholder="22" />
                    </label>
                    <br>
                    <br>
                    {% set ssh_key_title = "Type the path to the SSH private key file for authentication (optional). Leave blank to use default key." %}
                    <label for="ssh_key" title="{{ ssh_key_title }}">
                        SSH Key:
                        <input type="text" id="ssh_key" name="ssh_key" placeholder="" />
                    </label>
                    <br>
                    <br>
                    {% set s3_tool_title = "Select the tool to use for uploading backups to S3 storage (e.g., S3 CMD or AWS CLI)." %}
                    <div class="select">
                        <label for="s3_tool" title="{{ s3_tool_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">S3 Tool:</span>
                            <select id="s3_tool" name="s3_tool" required>
                                <option value="">Select a S3 Tool type</option>
                                <option selected value="s3cmd">S3 CMD</option>
                                <option value="awscli">AWS CLI</option>
                            </select>
                        </label>
                    </div>
                    <br>
                    {% set gpg_password_file_title = "Type the path to the file containing the GPG password for encrypting or decrypting backups (optional)." %}
                    <label for="gpg_password_file" title="{{ gpg_password_file_title }}">
                        GPG Password File:
                        <input type="text"
                               id="gpg_password_file"
                               name="gpg_password_file"
                               placeholder="" />
                    </label>
                    <br>
                    <br>
                </fieldset>
                <fieldset id="myloader_container" style="flex-direction: column; gap: 1em">
                    <legend>Myloader Configuration</legend>
                    {% set service_id_title = "Select the destination database service where the restore will be applied." %}
                    <div class="select">
                        <label for="service_id" title="{{ service_id_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">Destination Database</span>
                            {% if services|length == 1 %}
                                {% set single_service = services[0] %}
                                <select id="service_id" name="service_id" disabled>
                                    <option value="{{ single_service.id }}" selected>{{ single_service.name }}</option>
                                </select>
                                <input type="hidden" name="service_id" value="{{ single_service.id }}">
                            {% else %}
                                <select id="service_id" name="service_id" required>
                                    <option value="" selected>Select a destination database</option>
                                    {% for service in services %}
                                        <option value="{{ service.id }}">{{ service.name }} ({{ service.node_id }})</option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </label>
                    </div>
                    <div class="select">
                        {% set schema_id_title = "Select the destination schema within the database for the restore operation." %}
                        <label for="schema_id" title="{{ schema_id_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">Destination Schema</span>
                            <select id="schema_id"
                                    name="schema_id"
                                    title="{{ schema_id_title }}"
                                    disabled></select>
                        </label>
                    </div>
                    {% set local_path_title = "Type the local path where the backup files are stored or will be restored to (optional)." %}
                    <label for="local_path" title="{{ local_path_title }}">
                        Local Path:
                        <input type="text" id="local_path" name="local_path" placeholder="" />
                    </label>
                    {% set overwrite_tables_title = "Enable this option to overwrite existing tables during the restore process." %}
                    <label class="checkbox"
                           for="overwrite_tables"
                           title="{{ overwrite_tables_title }}">
                        <input type="checkbox"
                               id="overwrite_tables"
                               name="overwrite_tables"
                               value="1"
                               checked />
                        <div class="checkmark">
                            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                            <span class="material-symbols-outlined checked">check_box</span>
                        </div>
                        <span class="label">Overwrite Tables</span>
                    </label>
                    {% set myloader_extra_args_title = "Type any additional command-line arguments for MyLoader to customize the restore process (optional)." %}
                    <label for="myloader_extra_args" title="{{ myloader_extra_args_title }}">
                        MyLoader Extra Args:
                        <input type="text"
                               id="myloader_extra_args"
                               name="myloader_extra_args"
                               placeholder="" />
                    </label>
                    {% set skip_databases_title = "Type a comma-separated list of databases to skip during the restore (optional)." %}
                    <label for="skip_databases" title="{{ skip_databases_title }}">
                        Skip Databases:
                        <input type="text" id="skip_databases" name="skip_databases" placeholder="" />
                    </label>
                    {% set include_databases_title = "Type a comma-separated list of databases to include in the restore (optional)." %}
                    <label for="include_databases" title="{{ include_databases_title }}">
                        Include Databases:
                        <input type="text"
                               id="include_databases"
                               name="include_databases"
                               placeholder="" />
                    </label>
                    {% set pre_script_title = "Type the path to a script to run before the restore process begins (optional)." %}
                    <label for="pre_script" title="{{ pre_script_title }}">
                        Pre Script:
                        <input type="text" id="pre_script" name="pre_script" placeholder="" />
                    </label>
                    {% set post_title = "Type the path to a script to run after the restore process completes (optional)." %}
                    <label for="post" title="{{ post_title }}">
                        Post Script:
                        <input type="text" id="post" name="post" placeholder="" />
                    </label>
                    {% set myloader_threads_title = "Set the number of days after which old backups will be automatically deleted." %}
                    <label for="myloader_threads" title="{{ myloader_threads_title }}">
                        MyLoader Threads:
                        <input type="number"
                               id="myloader_threads"
                               name="myloader_threads"
                               value="4"
                               placeholder="e.g. 4" />
                    </label>
                </fieldset>
                <fieldset id="xtrabackup_container" style="flex-direction: column; gap: 1em">
                    <legend>Xtrabackup Configuration</legend>
                    <div class="checkbox-group">
                        {% set skip_incrementals_title = "Skip incremental backups during restore process. Useful when you want to restore only the base backup." %}
                        <label class="checkbox"
                               for="skip_incrementals"
                               title="{{ skip_incrementals_title }}">
                            <input type="checkbox"
                                   id="skip_incrementals"
                                   name="skip_incrementals"
                                   value="1" />
                            <div class="checkmark">
                                <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                                <span class="material-symbols-outlined checked">check_box</span>
                            </div>
                            <span class="label">Skip Incrementals</span>
                        </label>
                        {% set kill_mysql_title = "Automatically stop MySQL service before restore and start it after restore is complete." %}
                        <label class="checkbox" for="kill_mysql" title="{{ kill_mysql_title }}">
                            <input type="checkbox" id="kill_mysql" name="kill_mysql" value="1" />
                            <div class="checkmark">
                                <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                                <span class="material-symbols-outlined checked">check_box</span>
                            </div>
                            <span class="label">Kill MySQL</span>
                        </label>
                        {% set restore_mycnf_title = "Restore MySQL configuration file (my.cnf) along with the data backup." %}
                        <label class="checkbox"
                               for="restore_mycnf"
                               title="{{ restore_mycnf_title }}">
                            <input type="checkbox" id="restore_mycnf" name="restore_mycnf" value="1" />
                            <div class="checkmark">
                                <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                                <span class="material-symbols-outlined checked">check_box</span>
                            </div>
                            <span class="label">Restore MyCNF</span>
                        </label>
                    </div>
                    {% set datadir_title = "Specify the MySQL data directory where the backup will be restored. Default is usually /var/lib/mysql." %}
                    <label for="datadir" title="{{ datadir_title }}">
                        Data Dir:
                        <input type="text" id="datadir" name="datadir" placeholder="" required />
                    </label>
                    {% set xb_prepare_memory_title = "Amount of memory (in MB) to use for xtrabackup prepare operation. Higher values can speed up the prepare process." %}
                    <label for="xb_prepare_memory" title="{{ xb_prepare_memory_title }}">
                        XtraBackup Prepare Memory:
                        <input type="text"
                               id="xb_prepare_memory"
                               name="xb_prepare_memory"
                               placeholder="" />
                    </label>
                    {% set xb_parallel_title = "Number of threads to use for parallel operations during backup restore. Higher values can improve performance but require more system resources." %}
                    <label for="xb_parallel" title="{{ xb_parallel_title }}">
                        XtraBackup Parallel:
                        <input type="number" id="xb_parallel" name="xb_parallel" />
                    </label>
                    {% set xtrabackup_bin_cmd_title = "Select the backup tool to use for restore: InnoBackupPex (legacy), XtraBackup (recommended), or MariaDB Backup." %}
                    <div class="select">
                        <label for="xtrabackup_bin_cmd" title="{{ xtrabackup_bin_cmd_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">XtraBackup Bin Command:</span>
                            <select id="xtrabackup_bin_cmd" name="xtrabackup_bin_cmd" required>
                                <option value="">Select a Command type</option>
                                <option selected value="innobackupex">InnoBackupPex</option>
                                <option value="xtrabackup">XtraBackup</option>
                                <option value="mariadb-backup">MariaDB Backup</option>
                            </select>
                        </label>
                    </div>
                    {% set incremental_dest_path_title = "Path where incremental backups will be stored during the restore process." %}
                    <label for="incremental_dest_path" title="{{ incremental_dest_path_title }}">
                        Incremental Destination Path:
                        <input type="text"
                               id="incremental_dest_path"
                               name="incremental_dest_path"
                               placeholder="" />
                    </label>
                    {% set xtrabackup_restore_args_title = "Additional command-line arguments to pass to xtrabackup during restore operation." %}
                    <label for="xtrabackup_restore_args"
                           title="{{ xtrabackup_restore_args_title }}">
                        Xtrabackup Restore Args:
                        <input type="text"
                               id="xtrabackup_restore_args"
                               name="xtrabackup_restore_args"
                               placeholder="" />
                    </label>
                    {% set keyring_file_data_title = "Path to the keyring file containing encryption keys for encrypted backups." %}
                    <label for="keyring_file_data" title="{{ keyring_file_data_title }}">
                        KeyRing File Data:
                        <input type="text"
                               id="keyring_file_data"
                               name="keyring_file_data"
                               placeholder="" />
                    </label>
                    {% set xtrabackup_aes256_keyfile_title = "Path to the AES256 key file used for encrypted backups." %}
                    <label for="xtrabackup_aes256_keyfile"
                           title="{{ xtrabackup_aes256_keyfile_title }}">
                        AES256 Key File:
                        <input type="text"
                               id="xtrabackup_aes256_keyfile"
                               name="xtrabackup_aes256_keyfile"
                               placeholder="" />
                    </label>
                    <div class="checkbox-group">
                        {% set slave_from_master_title = "Configure the restored instance as a replica of the specified source server." %}
                        <label class="checkbox"
                               for="slave_from_master"
                               title="{{ slave_from_master_title }}">
                            <input type="checkbox"
                                   id="slave_from_master"
                                   name="slave_from_master"
                                   value="1" />
                            <div class="checkmark">
                                <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                                <span class="material-symbols-outlined checked">check_box</span>
                            </div>
                            <span class="label">Replica from Source</span>
                        </label>
                        {% set wait_for_catchup_title = "Wait for the replica to catch up with the source after restore is complete." %}
                        <label class="checkbox"
                               for="wait_for_catchup"
                               title="{{ wait_for_catchup_title }}">
                            <input type="checkbox"
                                   id="wait_for_catchup"
                                   name="wait_for_catchup"
                                   value="1" />
                            <div class="checkmark">
                                <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                                <span class="material-symbols-outlined checked">check_box</span>
                            </div>
                            <span class="label">Wait for Catchup</span>
                        </label>
                    </div>
                    {% set master_ip_title = "IP address of the source server to replicate from." %}
                    <label for="master_ip" title="{{ master_ip_title }}">
                        Source IP:
                        <input type="text" id="master_ip" name="master_ip" placeholder="" />
                    </label>
                    {% set master_port_title = "Port number of the source server (default is 3306)." %}
                    <label for="master_port" title="{{ master_port_title }}">
                        Source Port:
                        <input type="number" id="master_port" name="master_port" />
                    </label>
                    {% set master_user_title = "Username for connecting to the source server." %}
                    <label for="master_user" title="{{ master_user_title }}">
                        Source User:
                        <input type="text" id="master_user" name="master_user" placeholder="" />
                    </label>
                    {% set master_password_title = "Password for the source user account." %}
                    <label for="master_password" title="{{ master_password_title }}">
                        Source Password:
                        <input type="text"
                               id="master_password"
                               name="master_password"
                               placeholder="" />
                    </label>
                </fieldset>
                <fieldset id="binlog_container" style="flex-direction: column; gap: 1em">
                    <legend>Binlog Configuration</legend>
                    {% set start_file_title = "Specify the name of the first binary log file to start the restore from (e.g., binlog.000030)." %}
                    <label for="start_file" title="{{ start_file_title }}">
                        Start File:
                        <input type="text"
                               id="start_file"
                               name="start_file"
                               placeholder="e.g. binlog.000030" />
                    </label>
                    {% set start_position_title = "Specify the position within the start file where the restore should begin (e.g., 157)." %}
                    <label for="start_position" title="{{ start_position_title }}">
                        Start Position:
                        <input type="number"
                               id="start_position"
                               name="start_position"
                               value=""
                               placeholder="e.g. 157" />
                    </label>
                    {% set stop_file_title = "Specify the name of the last binary log file to stop the restore at (e.g., binlog.000031)." %}
                    <label for="stop_file" title="{{ stop_file_title }}">
                        Stop File:
                        <input type="text"
                               id="stop_file"
                               name="stop_file"
                               placeholder="e.g. binlog.000031" />
                    </label>
                    {% set stop_position_title = "Specify the position within the stop file where the restore should end (e.g., 2995)." %}
                    <label for="stop_position" title="{{ stop_position_title }}">
                        Stop Position:
                        <input type="number"
                               id="stop_position"
                               name="stop_position"
                               value=""
                               placeholder="e.g. 2995" />
                    </label>
                    {% set use_sql_file_title = "Specify the path to a SQL file containing additional SQL statements to execute during the restore process." %}
                    <label for="use_sql_file" title="{{ use_sql_file_title }}">
                        Use SQL File:
                        <input type="text" id="use_sql_file" name="use_sql_file" placeholder="" />
                    </label>
                    {% set binlog_restore_extra_args_title = "Specify additional mysqlbinlog command-line arguments (e.g.,--stop-datetime=\"YYYY-MM-DD HH:MM:SS\")." %}
                    <label for="binlog_restore_extra_args"
                           title="{{ binlog_restore_extra_args_title }}">
                        Extra Arguments (optional):
                        <input type="text"
                               id="binlog_restore_extra_args"
                               name="binlog_restore_extra_args"
                               placeholder="--stop-datetime='YYYY-MM-DD HH:MM:SS'" />
                    </label>
                </fieldset>
            </fieldset>
        </section>
        <footer>
            <button type="button" class="text large" data-modal-close>
                Cancel<sup>ESC</sup>
            </button>
            <button type="submit" class="contained large submitButton" disabled>Create</button>
        </footer>
    </dialog>
</form>
<script src="{{ url_for('static', path='/js/schema-selector.js') }}"
        nonce="{{ request.state.csp_nonce }}"></script>
<script type="text/javascript" nonce="{{ request.state.csp_nonce }}">
    const backupTypeSelect = document.getElementById('backup_type');
    const myloaderContainer = document.getElementById('myloader_container');
    const xtrabackupContainer = document.getElementById('xtrabackup_container');
    const binlogContainer = document.getElementById('binlog_container');

    const serviceSelect = document.getElementById('service_id');
    const schemaSelect = document.getElementById('schema_id');
    const form = document.getElementById('create-restore-form');
    const createButton = form.querySelector('button[type="submit"]');

    serviceSelect.addEventListener('change', async function() {
        var serviceId = this.value;
        if (serviceId && serviceId !== '-1') {
            var schemas = await fetchSchemas(serviceId);
            populateSelect(schemaSelect, schemas, {placeholder: 'Not selected', emptyPlaceholder: 'No schema'});
        } else {
            populateSelect(schemaSelect, [], {emptyPlaceholder: 'No schema'});
        }
    });

    function disableAllMyloaderFields(disabled) {
        myloaderContainer.querySelectorAll('input, select').forEach(el => el.disabled = disabled);
        serviceSelect.removeAttribute('required');
    }

    function disableAllXtrabackupFields(disabled) {
        xtrabackupContainer.querySelectorAll('input, select').forEach(el => el.disabled = disabled);
        serviceSelect.setAttribute('required', '');
    }

    function disableAllBinlogFields(disabled) {
        binlogContainer.querySelectorAll('input, select').forEach(el => el.disabled = disabled);
        serviceSelect.setAttribute('required', '');
    }

    function showContainer(container, show) {
        if (show) {
            container.classList.add('visible');
            container.classList.remove('hidden');
        } else {
            container.classList.add('hidden');
            container.classList.remove('visible');
        }
    }

    function updateCreateButtonState() {
        createButton.disabled = !form.checkValidity();
    }

    function updateBackupTypeUI() {
        const restoreType = backupTypeSelect.value;
        console.log("restoreType")
        if (restoreType === 'M') {
            // Show myloader, hide xtrabackup and binlog
            showContainer(myloaderContainer, true);
            disableAllMyloaderFields(false);

            showContainer(xtrabackupContainer, false);
            disableAllXtrabackupFields(true);

            showContainer(binlogContainer, false);
            disableAllBinlogFields(true);
        } else if (restoreType === 'X') {
            // Show xtrabackup, hide myloader and binlog
            showContainer(xtrabackupContainer, true);
            disableAllXtrabackupFields(false);

            showContainer(myloaderContainer, false);
            disableAllMyloaderFields(true);

            showContainer(binlogContainer, false);
            disableAllBinlogFields(true);
        } else if (restoreType === 'B') {
            showContainer(binlogContainer, true);
            disableAllBinlogFields(false);

            showContainer(myloaderContainer, false);
            disableAllMyloaderFields(true);

            showContainer(xtrabackupContainer, false);
            disableAllXtrabackupFields(true);
        }
        else {
            // No selection
            showContainer(myloaderContainer, false);
            disableAllMyloaderFields(true);

            showContainer(xtrabackupContainer, false);
            disableAllXtrabackupFields(true);

            showContainer(binlogContainer, false);
            disableAllBinlogFields(true);
        }
    }

    backupTypeSelect.addEventListener('change', updateBackupTypeUI);
    // Initialize
    ['input', 'change'].forEach(event => form.addEventListener(event, updateCreateButtonState));

    window.addEventListener('DOMContentLoaded', async function () {
    updateBackupTypeUI();
    if (serviceSelect.options.length === 1) {
        var singleHost = serviceSelect.options[0].value;
        var schemas = await fetchSchemas(singleHost);
        populateSelect(schemaSelect, schemas, {placeholder: 'Not selected', emptyPlaceholder: 'No schema'});
        updateCreateButtonState();
    }
    });
</script>
