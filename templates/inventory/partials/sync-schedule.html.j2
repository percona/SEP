<section class="inventory-sync-schedule">
    <h3>Inventory Sync Schedule</h3>
    {% if sync_schedules %}
        <ul class="schedule-list">
            {% for sync_schedule in sync_schedules %}
                {% set syncer_qualified = (sync_schedule.execute_request.meta or {}).get('syncer') if sync_schedule.execute_request else None %}
                {% set ns = namespace(syncer_label='All syncers') %}
                {% if syncer_qualified %}
                    {% set ns.syncer_label = syncer_qualified %}
                    {% for available in available_syncers %}
                        {% if available.name == syncer_qualified %}
                            {% set ns.syncer_label = available.display_name %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
                <li class="schedule-row" data-schedule-id="{{ sync_schedule.id }}">
                    <p>
                        <strong>{{ ns.syncer_label }}</strong>
                        —
                        {% if sync_schedule.crontab %}
                            <span title="{{ sync_schedule.crontab.timezone }}">
                                Cron: <strong>{{ sync_schedule.period }}</strong>
                                ({{ sync_schedule.crontab.timezone }})
                            </span>
                        {% else %}
                            <strong>{{ sync_schedule.period }}</strong>
                        {% endif %}
                        {% if not sync_schedule.enabled %}<em>(disabled)</em>{% endif %}
                        {% if sync_schedule.start_time %}
                            · Starts at: <span class="relativeTime">{{ sync_schedule.start_time }}</span>
                        {% endif %}
                        {% if sync_schedule.next_run_at %}
                            · Next run: <span class="relativeTime">{{ sync_schedule.next_run_at }}</span>
                        {% endif %}
                        {% if sync_schedule.last_run_at %}
                            · Last run: <span class="relativeTime">{{ sync_schedule.last_run_at }}</span>
                        {% endif %}
                    </p>
                    <div class="schedule-actions"
                         style="display:flex;
                                gap:0.5em;
                                align-items:center">
                        <button type="button"
                                class="contained schedule-edit-toggle"
                                data-target="schedule-edit-{{ sync_schedule.id }}">Edit Schedule</button>
                        <form method="post"
                              action="{{ url_for('periodic_task_update', periodic_task_id=sync_schedule.id) }}"
                              style="display:inline">
                            <input type="hidden" name="csrf-token" value="{{ csrf_token }}" />
                            <input type="hidden"
                                   name="enabled"
                                   value="{{ 'false' if sync_schedule.enabled else 'true' }}">
                            <button type="submit" class="contained">
                                {% if sync_schedule.enabled %}
                                    Disable
                                {% else %}
                                    Enable
                                {% endif %}
                            </button>
                        </form>
                        <form method="post"
                              action="{{ url_for('periodic_task_delete', periodic_task_id=sync_schedule.id) }}"
                              class="confirmable-form"
                              data-confirm-message="Clear this {{ ns.syncer_label }} inventory-sync schedule?"
                              style="display:inline">
                            <input type="hidden" name="csrf-token" value="{{ csrf_token }}" />
                            <button type="submit" class="contained submitButton">Clear Schedule</button>
                        </form>
                    </div>
                    <div id="schedule-edit-{{ sync_schedule.id }}"
                         class="schedule-edit-container"
                         style="display:none">{% include "inventory/partials/sync-schedule-edit-form.html.j2" %}</div>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>No schedule configured.</p>
    {% endif %}
    <details class="schedule-attach">
        <summary>Attach a schedule</summary>
        <div class="schedule-edit-container">
            {% with sync_schedule = none %}
                {% include "inventory/partials/sync-schedule-edit-form.html.j2" %}
            {% endwith %}
        </div>
    </details>
</section>
<script src="{{ url_for('static', path='/js/cron-validation.js') }}"
        nonce="{{ request.state.csp_nonce }}"></script>
<script type="text/javascript" nonce="{{ request.state.csp_nonce }}">
    (function () {
        document.querySelectorAll(
            '.inventory-sync-schedule .schedule-edit-toggle'
        ).forEach(function (toggleBtn) {
            const targetId = toggleBtn.dataset.target;
            const container = document.getElementById(targetId);
            if (container) {
                toggleBtn.addEventListener('click', function () {
                    container.style.display =
                        container.style.display === 'none' ? 'block' : 'none';
                });
            }
        });
        document.querySelectorAll(
            '.inventory-sync-schedule .schedule-edit-container'
        ).forEach(function (container) {
            container.querySelectorAll(
                'input[name="schedule_mode"]'
            ).forEach(function (input) {
                input.addEventListener('change', function () {
                    container.querySelectorAll(
                        '[data-mode]'
                    ).forEach(function (el) {
                        const isActive = el.dataset.mode === input.value;
                        el.style.display = isActive ? 'block' : 'none';
                        el.querySelectorAll('input, select').forEach(function (field) {
                            field.disabled = !isActive;
                        });
                        el.querySelectorAll(
                            'input[name="interval_every"], input[name="cron_expression"]'
                        ).forEach(function (field) {
                            if (isActive) {
                                field.setAttribute('required', '');
                            } else {
                                field.removeAttribute('required');
                            }
                        });
                    });
                });
            });
            const cronInput = container.querySelector(
                'input[name="cron_expression"]'
            );
            if (cronInput) {
                cronInput.addEventListener('input', function () {
                    cronInput.setCustomValidity('');
                });
            }
            const form = container.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (event) {
                    const input = form.querySelector('input[name="cron_expression"]');
                    if (!input || input.disabled || !input.value) {
                        return;
                    }
                    if (!window.cronValidation
                        || !window.cronValidation.isCronExpressionValid(input.value)) {
                        event.preventDefault();
                        input.setCustomValidity(
                            'Enter five space-separated cron fields with valid characters and non-zero step values.'
                        );
                        input.reportValidity();
                    } else {
                        input.setCustomValidity('');
                    }
                });
            }
        });
    })();
</script>
