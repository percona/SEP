{% if sync_schedule %}
    <div class="sync-status">
        <span class="material-symbols-outlined">schedule</span>
        <span>
            Scheduled sync:
            {% if sync_schedule.enabled %}
                <strong>{{ sync_schedule.period }}</strong>
            {% else %}
                <em>disabled</em>
            {% endif %}
        </span>
        {% if sync_schedule.last_run_at %}
            <span>
                | Last run: <span class="relativeTime">{{ sync_schedule.last_run_at }}</span>
            </span>
        {% endif %}
        <a href="{{ url_for('tasks_detail', task_name='inventory-sync') }}"
           title="View task details">
            <span class="material-symbols-outlined">open_in_new</span>
        </a>
    </div>
{% endif %}
