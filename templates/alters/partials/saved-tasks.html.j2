{% if tasks %}
    {#
<!-- Debug output -->
    <div style="background: var(--surfaceElevation1); padding: 10px; margin: 10px 0; border: 1px solid var(--lineDivider);">
        <h4>Debug - Task Data:</h4>
        {% for task in tasks %}
            <div style="margin-bottom: 20px;">
                <strong>Task {{ loop.index }}:</strong>
                <pre style="white-space: pre-wrap;">{{ task | tojson(indent=2) }}</pre>
            </div>
        {% endfor %}
    </div>
    <!-- End debug output -->
#}
<table data-table="saved-tasks">
    <thead>
        <tr>
            <th aria-label="Click to sort alphanumerically" data-tooltip="1000">Name</th>
            <th aria-label="Click to sort alphanumerically" data-tooltip="1000">Host</th>
            <th aria-label="Click to sort alphanumerically" data-tooltip="1000">Table</th>
            <th aria-label="Click to sort alphanumerically" data-tooltip="1000">Created by</th>
            <th aria-label="Click to sort alphanumerically" data-tooltip="1000">Last Updated by</th>
            <th data-sortable="false" data-searchable="false" class="options">Options</th>
        </tr>
    </thead>
    <tbody>
        {% for task in tasks %}
            {% if not task.parent %}
                <tr id="{{ task.name }}">
                    <td>
                        <a href="{{ url_for('alters_detail', task_name=task.name) }}">{{ task.name }}</a>
                    </td>
                    <td class="code">{{ task.hostname }}</td>
                    <td class="code">{{ task.table }}</td>
                    <td>{{ user_id_to_username.get(task["created_by"], task["created_by"]) or '' }}</td>
                    <td>{{ user_id_to_username.get(task["last_updated_by"], task["last_updated_by"]) or '' }}</td>
                    <td class="options">{% include "tasks/partials/saved-tasks-actions-column-alters.html.j2" %}</td>
                </tr>
            {% endif %}
        {% endfor %}
    </tbody>
</table>
{% include "tasks/partials/scheduled-execution-dialog.html.j2" %}
{% else %}
<!-- Remember to add a more meaningful and helpful empty state message here, to help users recover and get back on track -->
<span>No data</span>
{% endif %}
