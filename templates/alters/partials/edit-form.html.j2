<style>
    fieldset {
        width: 95%;
        justify-content: flex-start;
        padding-top: 5px;
        padding-bottom: 5px;
        margin-bottom: 0.5em;
    }

    .field {
        flex: 0 0 48%;
        box-sizing: border-box;
        padding: 5px;
        display: flex;
        align-items: center;
    }

    fieldset:has(> .field:nth-of-type(1):nth-last-of-type(1))>.field {
        flex: 0 0 48%;
    }

    .field label {
        width: 135px;
        margin-right: 10px;
    }

    .field input,
    .field select {
        flex: 1;
    }

    label+select,
    label+input {
        vertical-align: middle;
        margin-right: 0px;
    }

    label:has(+ select),
    label:has(+ input) {
        display: inline-flex;
        align-items: center;
        margin-right: 0px !important;
        width: 130px;
    }

    .selection-panel,
    .result-panel {
        background-color: #fff;
        padding-left: 20px;
        padding-right: 20px;
        border-radius: 5px;
    }

    #toggleCreateTable {
        padding: 10px 20px;
    }

    #createTableOutput {
        background-color: #272822;
        color: #f8f8f2;
        padding: 15px;
        border-radius: 5px;
        overflow-x: auto;
        max-height: 1000px;
        font-family: monospace;
        line-height: 1.4em;
        white-space: pre-wrap;
    }

    #statusMessage {
        margin-top: 20px;
    }

    #statusMessage.success {
        color: green;
    }

    #statusMessage.error {
        color: red;
    }

    #result-panel {
        overflow: hidden;
        transition: opacity 0.5s ease, max-height 0.5s ease;
        opacity: 1;
        max-height: 1000px;
    }

    #result-panel.fade {
        opacity: 0;
        max-height: 0;
        pointer-events: none;
    }

    input[type="checkbox"] {
        flex: none;
        margin-right: 0.5em;
    }

    pre {
        white-space: break-spaces;
    }

    {{ syntax_highlight_css(style="monokai") }}
</style>
<form id="edit-task-form"
      class="edit-task-form window"
      method="post"
      action="{{ url_for('alters_update', task_name=task.name) }}"
      data-confirm-message='Are you sure you want to edit task "{{ task.name }}"?'>
    <dialog id="modalEditTask"
            aria-modal="true"
            aria-labelledby="modalEditTaskTitle"
            data-modal="target"
            class="large">
        <header>
            <h3 id="modalEditTaskTitle" class="h5 title">Edit task</h3>
        </header>
        <section>
            <p>
                You are about to edit the task <strong id="modalTaskName"></strong>.
            </p>
            <div>
                <fieldset>
                    <legend>Executor Host</legend>
                    <br>
                    <div class="select">
                        {% set hostname_title = "Select the hostname of the target system for task execution." %}
                        <label for="hostname" title="{{ hostname_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">Select host</span>
                            {% set executor_hosts = executor_hosts | list %}
                            {% if executor_hosts|length == 1 %}
                                {% set single_service = executor_hosts[0] %}
                                <select id="hostname" name="hostname" title="{{ hostname_title }}" disabled>
                                    <option value="{{ single_service }}" selected>{{ single_service }}</option>
                                </select>
                                <input type="hidden" name="hostname" value="{{ single_service }}">
                            {% else %}
                                <select id="hostname" name="hostname" title="{{ hostname_title }}">
                                    {% for executor_host in executor_hosts %}
                                        <option value="{{ executor_host }}"
                                                {% if executor_host == task['hostname'] %}selected{% endif %}>
                                            {{ executor_host }}
                                        </option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </label>
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <legend>Change details</legend>
                    <br>
                    <div class="field">
                        {% set task_name_title = "Type the name of task to be created." %}
                        <label for="task_name" title="{{ task_name_title }}">Task name</label>
                        <input type="text"
                               id="task_name"
                               name="task_name"
                               class="validate"
                               required
                               title="{{ task_name_title }}"
                               value="{{ task.name }}"
                               placeholder="Enter a unique task name">
                    </div>
                    <br>
                    <div class="select">
                        {% set service_id_title = "Select the database host from the inventory to connect to." %}
                        <label for="service_id" title="{{ service_id_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">Database host</span>
                            {% if services|length > 0 %}
                                {% set matched_service_list = [] %}
                                {% for service in services %}
                                    {% if task["service_host"] == service.node.address and task["service_port"] == service.port %}
                                        {% do matched_service_list.append(1) %}
                                    {% endif %}
                                {% endfor %}
                                <select id="service_id"
                                        name="service_id"
                                        title="{{ service_id_title }}"
                                        required>
                                    <option value=""
                                            {% if matched_service_list|length > 0 %}{% else %}selected{% endif %}>
                                        Select a database host
                                    </option>
                                    {% if matched_service_list|length == 0 %}
                                        <option value="-1" selected>Unknown({{ task["service_host"] }}:{{ task["service_port"] }})</option>
                                    {% endif %}
                                    {% for service in services %}
                                        {% set is_selected = task["service_host"] == service.node.address and task["service_port"] == service.port %}
                                        <option value="{{ service.id }}" {% if is_selected %}selected{% endif %}>
                                            {{ service.name }} ({{ service.node_id }})
                                        </option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </label>
                    </div>
                    <br>
                </fieldset>
                <br>
                <fieldset style="margin-bottom: 0;">
                    <legend>Data</legend>
                    <br>
                    <div class="field">
                        <label for="use_manual_input"
                               title="Toggle to manually type schema and table even if inventory exists.">
                            Manual input
                        </label>
                        <label class="checkbox" style="width: auto;">
                            <input type="checkbox" id="use_manual_input" name="use_manual_input" />
                            <div class="checkmark">
                                <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                                <span class="material-symbols-outlined checked">check_box</span>
                            </div>
                            <span class="label">Type schema/table</span>
                        </label>
                    </div>
                    <br>
                    <div class="select">
                        {% set schema_id_title = "Select the database schema on which the task will operate." %}
                        <label for="schema_id" title="{{ schema_id_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">Schema</span>
                            <select id="schema_id"
                                    name="schema_id"
                                    title="{{ schema_id_title }}"
                                    disabled>
                                <option value="">Select a schema</option>
                            </select>
                        </label>
                    </div>
                    <div class="field" id="schema_name_field" style="display:none;">
                        <label for="schema_name" title="Type the database schema name.">Schema</label>
                        <input type="text"
                               id="schema_name"
                               name="schema_name"
                               class="validate"
                               value="{{ task.schema_name }}"
                               placeholder="database_name" />
                    </div>
                    <br>
                    <div class="select">
                        {% set table_id_title = "Select the table within the schema to be altered." %}
                        <label for="table_id" title="{{ table_id_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">Table</span>
                            <select id="table_id" name="table_id" title="{{ table_id_title }}" disabled>
                                <option value="">Select a table</option>
                            </select>
                        </label>
                    </div>
                    <div class="field" id="table_name_field" style="display:none;">
                        <label for="table_name" title="Type the table name.">Table</label>
                        <input type="text"
                               id="table_name"
                               name="table_name"
                               class="validate"
                               value="{{ task.table_name }}"
                               placeholder="table_name" />
                    </div>
                    <br>
                </fieldset>
                <br>
                <fieldset style="padding-top: 0; padding-bottom: 0;">
                    <div id="result-panel" class="fade" style="width: 98%">
                        <pre id="createTableOutput" class="hidden"></pre>
                        <div id="statusMessage"></div>
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <div class="field">
                        {% set alter_title = "Specify schema modifications (excluding ALTER TABLE keywords). Separate multiple modifications with commas." %}
                        <label for="alter" title="{{ alter_title }}">Alter</label>
                        <input type="text"
                               id="alter"
                               name="alter"
                               class="validate"
                               size="70"
                               title="{{ alter_title }}"
                               value="{{ task.alter }}"
                               placeholder="ADD COLUMN new_col INT, DROP COLUMN old_col"
                               required />
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <legend>Advanced options</legend>
                    <br>
                    <div class="select">
                        {% set recursion_method_title = "Select the method for handling recursion to discover replicas (e.g., processlist, hosts, dsn)." %}
                        <label for="recursion_method" title="{{ recursion_method_title }}">
                            <span class="material-symbols-outlined">arrow_drop_down</span>
                            <span class="label">Recursion method</span>
                            <select id="recursion_method"
                                    name="recursion_method"
                                    title="{{ recursion_method_title }}">
                                <option value="processlist"
                                        {% if task.recursion_method == "processlist" %}selected{% endif %}>
                                    processlist
                                </option>
                                <option value="host"
                                        {% if task.recursion_method == "host" %}selected{% endif %}>host</option>
                                <option value="dsn"
                                        {% if task.recursion_method == "dsn" %}selected{% endif %}>dsn</option>
                                <option value="none"
                                        {% if task.recursion_method == "none" %}selected{% endif %}>none</option>
                            </select>
                        </label>
                    </div>
                    <br>
                    <div class="field">
                        {% set dsn_table_title = "Type the DSN to use for the recursion method when set to 'dsn'. Format: D=database,t=table (e.g., D=percona,t=dsns) or full DSN with host: h=HOST,D=database,t=table" %}
                        <label for="dsn_table" title="{{ dsn_table_title }}">DSN</label>
                        <input type="text"
                               id="dsn_table"
                               name="dsn_table"
                               class="validate"
                               value="{{ task.dsn_table }}"
                               placeholder="D=percona,t=dsns"
                               title="{{ dsn_table_title }}" />
                    </div>
                    <br>
                </fieldset>
                <br>
                <fieldset>
                    <div class="field">
                        {% set pause_file_title = "Type a file path. Execution will pause while this file exists." %}
                        <label for="pause_file" title="{{ pause_file_title }}">Pause file</label>
                        <input type="text"
                               id="pause_file"
                               name="pause_file"
                               class="validate"
                               title="{{ pause_file_title }}"
                               value="{{ task.pause_file }}"
                               placeholder="/tmp/pause_file.txt" />
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <div class="field">
                        {% set new_table_name_title = "Type the new table name before it is swapped. Use %T to include the original table name." %}
                        <label for="new_table_name" title="{{ new_table_name_title }}">New Table Name</label>
                        <input type="text"
                               id="new_table_name"
                               name="new_table_name"
                               class="validate"
                               size="30"
                               title="{{ new_table_name_title }}"
                               value="{{ task.new_table_name }}"
                               placeholder=" %T_new_table" />
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <label class="checkbox">
                        {% set print_arg_title = "Enable to print SQL statements to STDOUT. Useful for reviewing executed statements, especially with --dry-run." %}
                        <input type="checkbox"
                               id="print_arg"
                               name="print_arg"
                               class="validate"
                               {% if task.print_arg %}checked{% endif %}
                               title="{{ print_arg_title }}" />
                        <div class="checkmark">
                            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                            <span class="material-symbols-outlined checked">check_box</span>
                        </div>
                        <span class="label">Print</span>
                    </label>
                    <div class="field">
                        {% set progress_title = "Type progress report settings. Use a comma-separated value: the first part defines the type (percentage, time, or iterations), and the second part specifies the frequency (percentage, seconds, or iterations)." %}
                        <label for="progress" title="{{ progress_title }}">Progress</label>
                        <input type="text"
                               id="progress"
                               name="progress"
                               class="validate"
                               size="15"
                               value="{{ task.progress }}"
                               title="{{ progress_title }}"
                               placeholder="time,30 or percentage,10" />
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <label class="checkbox">
                        {% set no_swap_tables_title = "Enable to simulate the process without making the swap. Disable to swap the original table with the new altered table." %}
                        <input type="checkbox"
                               id="no_swap_tables"
                               name="no_swap_tables"
                               class="validate"
                               {% if task.no_swap_tables %}checked{% endif %}
                               title="{{ no_swap_tables_title }}" />
                        <div class="checkmark">
                            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                            <span class="material-symbols-outlined checked">check_box</span>
                        </div>
                        <span class="label">no-swap-tables</span>
                    </label>
                    <label class="checkbox">
                        {% set no_drop_old_table_title = "Enable to keep the original table after the swap. Disable to drop the original table after it is renamed." %}
                        <input type="checkbox"
                               id="no_drop_old_table"
                               name="no_drop_old_table"
                               class="validate"
                               {% if task.no_drop_old_table %}checked{% endif %}
                               title="{{ no_drop_old_table_title }}" />
                        <div class="checkmark">
                            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                            <span class="material-symbols-outlined checked">check_box</span>
                        </div>
                        <span class="label">no-drop-old-table</span>
                    </label>
                    <label class="checkbox">
                        {% set no_drop_new_table_title = "Enable to keep the new table without modifying the original. Disable to drop the new table if copying the original table fails." %}
                        <input type="checkbox"
                               id="no_drop_new_table"
                               name="no_drop_new_table"
                               class="validate"
                               {% if task.no_drop_new_table %}checked{% endif %}
                               title="{{ no_drop_new_table_title }}" />
                        <div class="checkmark">
                            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                            <span class="material-symbols-outlined checked">check_box</span>
                        </div>
                        <span class="label">no-drop-new-table</span>
                    </label>
                    <label class="checkbox">
                        {% set no_drop_triggers_title = "Enabling forces the tool to keep the old table (no-drop-old-table). Disable to drop triggers on the old table." %}
                        <input type="checkbox"
                               id="no_drop_triggers"
                               name="no_drop_triggers"
                               class="validate"
                               {% if task.no_drop_triggers %}checked{% endif %}
                               title="{{ no_drop_triggers_title }}" />
                        <div class="checkmark">
                            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                            <span class="material-symbols-outlined checked">check_box</span>
                        </div>
                        <span class="label">no-drop-triggers</span>
                    </label>
                </fieldset>
                <br>
                <fieldset>
                    <div class="field">
                        {% set tries_title = "Type the number of retries and wait times for critical operations in the format: operation:tries:wait. Defaults: create_triggers:10:1, drop_triggers:10:1, copy_rows:10:0.25." %}
                        <label for="tries" title="{{ tries_title }}">Tries</label>
                        <input type="text"
                               id="tries"
                               name="tries"
                               class="validate"
                               value="{{ task.tries }}"
                               placeholder="create_triggers:10000:1,drop_triggers:10000:1,copy_rows:10000:1"
                               size="70"
                               title="{{ tries_title }}" />
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <div class="field">
                        {% set set_vars_titlie = "Set MySQL variables as a comma-separated list of variable=value pairs. Defaults: wait_timeout=10000, innodb_lock_wait_timeout=1, lock_wait_timeout=60." %}
                        <label for="set_vars" title="{{ set_vars_titlie }}">Set Vars</label>
                        <input type="text"
                               id="set_vars"
                               name="set_vars"
                               class="validate"
                               title="{{ set_vars_titlie }}"
                               value="{{ task.set_vars }}"
                               placeholder="transaction_isolation='READ-COMMITTED',lock_wait_timeout=5"
                               size="70" />
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <div class="field">
                        {% set critical_load_title = "Type a comma-separated list of MySQL status variables and thresholds to monitor. The tool will abort if the load exceeds these thresholds." %}
                        <label for="critical_load" title="{{ critical_load_title }}">Critical Load</label>
                        <input type="text"
                               id="critical_load"
                               name="critical_load"
                               class="validate"
                               title="{{ critical_load_title }}"
                               value="{{ task.critical_load }}"
                               placeholder="Threads_running=99999,Connections=200"
                               size="30" />
                    </div>
                    <div class="field">
                        {% set max_load_title = "Type a comma-separated list of MySQL load thresholds to pause operation if exceeded. Default: Threads_running=25." %}
                        <label for="max_load" title="{{ max_load_title }}">Max Load</label>
                        <input type="text"
                               id="max_load"
                               name="max_load"
                               class="validate"
                               title="{{ max_load_title }}"
                               value="{{ task.max_load }}"
                               placeholder="Threads_running=30,Threads_connected=120"
                               size="30" />
                    </div>
                    <div class="field">
                        {% set max_flow_ctl_title = "Check average time cluster spent pausing for Flow Control and make tool pause if it goes over the percentage indicated in the option.." %}
                        <label for="max_flow_ctl" title="{{ max_flow_ctl_title }}">Max Flow Control</label>
                        <input type="text"
                               id="max_flow_ctl"
                               name="max_flow_ctl"
                               class="validate"
                               title="{{ max_flow_ctl_title }}"
                               value="{{ task.max_flow_ctl }}"
                               size="30" />
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <div class="field">
                        {% set chunk_time_title = "Set the target execution time (in seconds) for each data-copy query. Default: 0.5 seconds." %}
                        <label for="chunk_time" title="{{ chunk_time_title }}">Chunk Time</label>
                        <input type="text"
                               id="chunk_time"
                               name="chunk_time"
                               class="validate"
                               title="{{ chunk_time_title }}"
                               value="{{ task.chunk_time }}"
                               placeholder="0.5"
                               size="5" />
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <div class="field">
                        {% set max_lag_title = "Set the maximum allowed replica lag before pausing data copy. Default: 1s." %}
                        <label for="max_lag" title="{{ max_lag_title }}">Max Lag</label>
                        <input type="text"
                               id="max_lag"
                               name="max_lag"
                               class="validate"
                               title="{{ max_lag_title }}"
                               value="{{ task.max_lag }}"
                               placeholder="150"
                               size="5" />
                    </div>
                </fieldset>
                <br>
                <fieldset>
                    <legend>Extra Arguments</legend>
                    <br>
                    <div class="field">
                        {% set extra_args_title = "Additional command-line arguments to append to the pt-online-schema-change command. For example: --where='id > 1000' or --null-to-not-null" %}
                        <label for="extra_args" title="{{ extra_args_title }}">Extra Args</label>
                        <input type="text"
                               id="extra_args"
                               name="extra_args"
                               class="validate"
                               title="{{ extra_args_title }}"
                               value="{{ task.extra_args }}"
                               placeholder="--where='id > 1000'"
                               size="70" />
                    </div>
                </fieldset>
                <br>
                {% include "tasks/partials/create-form-alert-on-failure-input.html.j2" %}
            </div>
        </section>
        <footer>
            <button type="button" class="text large" data-modal-close>
                Cancel<sup>ESC</sup>
            </button>
            <button id="modalEditTaskSubmitButton"
                    type="submit"
                    disabled
                    class="contained large submitButton">Edit</button>
        </footer>
    </dialog>
    <input type="hidden" name="csrf-token" value="{{ csrf_token }}" />
</form>
{% set source_data = { "schema": task['schema_name'], "table": task['table_name']} %}
<script src="{{ url_for('static', path='/js/schema-selector.js') }}"
        nonce="{{ request.state.csp_nonce }}"></script>
<script type="text/javascript" nonce="{{ request.state.csp_nonce }}">
    var serviceSchemas = {};
    const source_data = {{ source_data | tojson }};
    var tableDetailsCache = {};
    const matched = {
        serviceId: null,
        schemaId: null,
        tableId: null,
      };
    const connectToSelect = document.getElementById('service_id');
    const schemaSelect = document.getElementById('schema_id');
    const tableSelect = document.getElementById('table_id');
    const schemaNameInput = document.getElementById('schema_name');
    const tableNameInput = document.getElementById('table_name');
    const schemaNameField = document.getElementById('schema_name_field');
    const tableNameField = document.getElementById('table_name_field');
    const manualInputToggle = document.getElementById('use_manual_input');
    const createTableOutput = document.getElementById('createTableOutput');
    const statusMessage = document.getElementById('statusMessage');
    const resultPanel = document.getElementById('result-panel');
    const form = document.getElementById('edit-task-form');
    const editButton = form.querySelector('button[type="submit"]');

    let selectedService = null;
    let selectedSchema = null;
    let selectedTable = null;
    let useManualInput = false;

    async function populateSchemas(serviceId) {
        schemaSelect.disabled = true;
        populateSelect(schemaSelect, [], {placeholder: "Select a schema"});
        tableSelect.disabled = true;
        populateSelect(tableSelect, [], {placeholder: "Select a table"});
        selectedSchema = null;
        selectedTable = null;
        createTableOutput.classList.add('hidden');
        resultPanel.classList.add('fade');
        statusMessage.textContent = '';

        if (!serviceId) {
            setManualInput(true, true);
            return;
        }

        var schemas = serviceSchemas[serviceId];
        if (!schemas) {
            var items = await fetchSchemas(serviceId);
            if (items.length === 0) {
                setManualInput(true, true);
                return;
            }
            schemas = {};
            for (var i = 0; i < items.length; i++) {
                schemas[items[i].id] = {name: items[i].name, tables: {}};
            }
            serviceSchemas[serviceId] = schemas;
        }

        var entries = Object.entries(schemas);
        if (entries.length > 0) {
            setManualInput(false, true);
            var schemaItems = [];
            for (var j = 0; j < entries.length; j++) {
                schemaItems.push({id: entries[j][0], name: entries[j][1].name});
            }
            populateSelect(schemaSelect, schemaItems, {placeholder: "Select a schema"});
            if (serviceId === matched.serviceId && matched.schemaId) {
                schemaSelect.value = matched.schemaId;
                selectedSchema = matched.schemaId;
                await populateTables(serviceId, matched.schemaId);
                return;
            }
            if (entries.length === 1) {
                schemaSelect.value = entries[0][0];
                schemaSelect.disabled = true;
                schemaSelect.insertAdjacentHTML("afterend", '<input id="schema_id_hidden" type="hidden" name="schema_id" value="' + schemaSelect.value + '">');
                selectedSchema = entries[0][0];
                await populateTables(serviceId, entries[0][0]);
            }
        } else {
            setManualInput(true, true);
        }
    }

    async function populateTables(serviceId, schemaId) {
        tableSelect.disabled = true;
        populateSelect(tableSelect, [], {placeholder: "Select a table"});
        selectedTable = null;
        createTableOutput.classList.add('hidden');
        resultPanel.classList.add('fade');
        statusMessage.textContent = '';

        if (!schemaId) return;

        var cached = serviceSchemas[serviceId] && serviceSchemas[serviceId][schemaId];
        var tables = cached ? cached.tables : null;
        if (!tables || Object.keys(tables).length === 0) {
            if (schemaId === "-1") return;
            var items = await fetchTables(schemaId);
            if (items.length === 0) return;
            tables = {};
            for (var i = 0; i < items.length; i++) {
                tables[items[i].id] = {name: items[i].name, id: items[i].id};
            }
            if (serviceSchemas[serviceId] && serviceSchemas[serviceId][schemaId]) {
                serviceSchemas[serviceId][schemaId].tables = tables;
            }
        }

        var entries = Object.entries(tables);
        if (entries.length > 0) {
            var tableItems = [];
            for (var j = 0; j < entries.length; j++) {
                tableItems.push({id: entries[j][0], name: entries[j][1].name});
            }
            populateSelect(tableSelect, tableItems, {placeholder: "Select a table"});
            if (schemaId == matched.schemaId && matched.tableId) {
                tableSelect.value = matched.tableId;
                selectedTable = matched.tableId;
                await fetchCreateTableStatement(matched.tableId);
                return;
            }
            if (entries.length === 1) {
                tableSelect.value = entries[0][0];
                tableSelect.disabled = true;
                tableSelect.insertAdjacentHTML("afterend", '<input id="table_id_hidden" type="hidden" name="table_id" value="' + tableSelect.value + '">');
                selectedTable = entries[0][0];
                await fetchCreateTableStatement(entries[0][0]);
            }
        }
    }

    function updateEditButtonState() {
        if (useManualInput) {
            schemaNameInput.required = true;
            tableNameInput.required = true;
            schemaSelect.required = false;
            tableSelect.required = false;
        } else {
            schemaNameInput.required = false;
            tableNameInput.required = false;
            schemaSelect.required = true;
            tableSelect.required = true;
        }
        const selectElementValues = [
            connectToSelect.value,
            schemaSelect.value,
            tableSelect.value
        ];

        const hasInvalidValue = selectElementValues.includes("-1");
        editButton.disabled = !form.checkValidity() || (!useManualInput && hasInvalidValue);
    }

    async function checkTypedSchemaTable() {
        var typedSchema = (schemaNameInput.value || '').trim();
        var typedTable = (tableNameInput.value || '').trim();

        createTableOutput.classList.add('hidden');
        statusMessage.classList.remove('success', 'error');
        statusMessage.textContent = '';

        if (!typedSchema || !typedTable) {
            resultPanel.classList.add('fade');
            return;
        }

        if (!selectedService) {
            resultPanel.classList.remove('fade');
            statusMessage.classList.remove('success', 'error');
            statusMessage.classList.add('error');
            statusMessage.textContent = 'Using typed schema/table. Table structure and PK details are not available.';
            return;
        }

        var schemas = serviceSchemas[selectedService];
        if (!schemas) {
            var schemaItems = await fetchSchemas(selectedService);
            if (schemaItems.length === 0) {
                resultPanel.classList.remove('fade');
                statusMessage.classList.add('error');
                statusMessage.textContent = 'Using typed schema/table. Table structure and PK details are not available.';
                return;
            }
            schemas = {};
            for (var i = 0; i < schemaItems.length; i++) {
                schemas[schemaItems[i].id] = {name: schemaItems[i].name, tables: {}};
            }
            serviceSchemas[selectedService] = schemas;
        }

        var schemaFound = false;
        var tableFound = false;
        var foundTableId = null;
        var foundSchemaId = null;

        var schemaEntries = Object.entries(schemas);
        for (var s = 0; s < schemaEntries.length; s++) {
            if (schemaEntries[s][1].name === typedSchema) {
                schemaFound = true;
                foundSchemaId = schemaEntries[s][0];
                var tables = schemaEntries[s][1].tables || {};
                if (Object.keys(tables).length === 0 && foundSchemaId !== "-1") {
                    var tableItems = await fetchTables(foundSchemaId);
                    for (var t = 0; t < tableItems.length; t++) {
                        tables[tableItems[t].id] = {name: tableItems[t].name, id: tableItems[t].id};
                    }
                    schemaEntries[s][1].tables = tables;
                }
                var tableEntries = Object.entries(tables);
                for (var u = 0; u < tableEntries.length; u++) {
                    if (tableEntries[u][1].name === typedTable) {
                        tableFound = true;
                        foundTableId = tableEntries[u][0];
                        break;
                    }
                }
                break;
            }
        }

        resultPanel.classList.remove('fade');

        if (!schemaFound) {
            statusMessage.classList.remove('success', 'error');
            statusMessage.classList.add('error');
            statusMessage.textContent = 'Schema "' + typedSchema + '" not found in database. Table structure and PK details are not available.';
        } else if (!tableFound) {
            statusMessage.classList.remove('success', 'error');
            statusMessage.classList.add('error');
            statusMessage.textContent = 'Table "' + typedTable + '" not found in database for schema "' + typedSchema + '". Table structure and PK details are not available.';
        } else if (foundTableId && foundTableId !== "-1") {
            fetchCreateTableStatement(foundTableId);
        } else {
            statusMessage.classList.remove('success', 'error');
            statusMessage.classList.add('error');
            statusMessage.textContent = 'Table "' + typedTable + '" not found in database for schema "' + typedSchema + '". Table structure and PK details are not available.';
        }
    }

    async function fetchCreateTableStatement(tableId) {
        if (useManualInput && !tableId) {
            checkTypedSchemaTable();
            return;
        }
        if (!tableId || tableId === "-1") {
            return;
        }
        if (selectedService && tableId) {
            if (tableDetailsCache[tableId]) {
                const tableData = tableDetailsCache[tableId];
                displayCreateTable(tableData.create);
                resultPanel.classList.remove("fade");
                analyzeTableStructure(tableData);
                return;
            }

            createTableOutput.innerHTML = 'Loading table details...';
            createTableOutput.classList.remove('hidden');
            resultPanel.classList.remove("fade");
            statusMessage.textContent = '';

            try {
                const response = await fetch(`/alters/table/${tableId}/details?syntax_highlight_style=monokai`);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const tableData = await response.json();

                tableDetailsCache[tableId] = tableData;

                displayCreateTable(tableData.create);
                analyzeTableStructure(tableData);
            } catch (error) {
                console.error('Error fetching table details:', error);
                createTableOutput.innerHTML = 'Error loading table details. Please try again.';
                statusMessage.textContent = '';
            }
        }
    }

    function displayCreateTable(sql) {
        createTableOutput.innerHTML = sql;
        createTableOutput.classList.remove('hidden');
    }

    function analyzeTableStructure(tableData) {
        const keys = tableData.keys || {};

        const primaryKey = Object.values(keys).find(key => key.type === 'PRIMARY');
        const uniqueKeys = Object.entries(keys)
            .filter(([keyName, key]) => key.type === 'INDEX' && key.unique)
            .map(([keyName]) => keyName);

        statusMessage.classList.remove('success', 'error');

        if (primaryKey || uniqueKeys.length > 0) {
            statusMessage.classList.add('success');
            let message = '✅ This table has ';

            if (primaryKey) {
                const primaryColumns = primaryKey.columns.join(', ');
                message += `a PRIMARY key (${primaryColumns})`;
            }

            if (primaryKey && uniqueKeys.length > 0) {
                message += ' and ';
            }

            if (uniqueKeys.length > 0) {
                if (uniqueKeys.length === 1) {
                    message += `a UNIQUE key (${uniqueKeys[0]})`;
                } else {
                    message += `UNIQUE keys (${uniqueKeys.join(', ')})`;
                }
            }

            message += '.';
            statusMessage.innerHTML = message;
        } else {
            statusMessage.classList.add('error');
            statusMessage.innerHTML = '❌ This table does not have a PRIMARY or UNIQUE key.';
        }
    }

    async function initSource() {
        var selectedServiceId = connectToSelect.value;
        if (selectedServiceId === "-1") {
            serviceSchemas["-1"] = {
                "-1": {
                    name: "Unknown schema: " + source_data.schema,
                    tables: {
                        "-1": {
                            name: "Unknown table: " + source_data.table,
                            id: "-1"
                        }
                    }
                }
            };
            matched.serviceId = "-1";
            matched.schemaId = "-1";
            matched.tableId = "-1";
            return;
        }

        matched.serviceId = selectedServiceId;

        var schemas = serviceSchemas[selectedServiceId];
        if (!schemas) {
            var schemaItems = await fetchSchemas(selectedServiceId);
            schemas = {};
            for (var i = 0; i < schemaItems.length; i++) {
                schemas[schemaItems[i].id] = {name: schemaItems[i].name, tables: {}};
            }
            serviceSchemas[selectedServiceId] = schemas;
        }

        var matchedSchema = null;
        var matchedSchemaKey = null;

        var schemaKeys = Object.keys(schemas);
        for (var s = 0; s < schemaKeys.length; s++) {
            if (schemas[schemaKeys[s]].name === source_data.schema) {
                matchedSchema = schemas[schemaKeys[s]];
                matchedSchemaKey = schemaKeys[s];
                break;
            }
        }

        if (matchedSchema) {
            matched.schemaId = matchedSchemaKey;

            var tables = matchedSchema.tables;
            if (Object.keys(tables).length === 0 && matchedSchemaKey !== "-1") {
                var tableItems = await fetchTables(matchedSchemaKey);
                for (var t = 0; t < tableItems.length; t++) {
                    tables[tableItems[t].id] = {name: tableItems[t].name, id: tableItems[t].id};
                }
                matchedSchema.tables = tables;
            }

            var tableNames = Object.values(tables).map(function(tb) { return tb.name; });
            var tableIds = Object.keys(tables);

            if (tableNames.indexOf(source_data.table) !== -1) {
                for (var k = 0; k < tableIds.length; k++) {
                    if (tables[tableIds[k]].name === source_data.table) {
                        matched.tableId = tableIds[k];
                        break;
                    }
                }
            } else {
                matchedSchema.tables["-1"] = {
                    name: "Unknown table: " + source_data.table,
                    id: "-1"
                };
                matched.tableId = "-1";
            }
        } else {
            schemas["-1"] = {
                name: "Unknown schema: " + source_data.schema,
                tables: {
                    "-1": {
                        name: "Unknown table: " + source_data.table,
                        id: "-1"
                    }
                }
            };
            matched.schemaId = "-1";
            matched.tableId = "-1";
            serviceSchemas[selectedServiceId] = schemas;
        }
    }

    connectToSelect.addEventListener('change', async function() {
        var hiddenSchemaInput = document.getElementById("schema_id_hidden");
        if (hiddenSchemaInput && hiddenSchemaInput.parentNode) {
            hiddenSchemaInput.parentNode.removeChild(hiddenSchemaInput);
        }
        selectedService = this.value;
        await populateSchemas(selectedService);
    });

    schemaSelect.addEventListener('change', async function() {
        var hiddenTableInput = document.getElementById("table_id_hidden");
        if (hiddenTableInput && hiddenTableInput.parentNode) {
            hiddenTableInput.parentNode.removeChild(hiddenTableInput);
        }
        selectedSchema = this.value;
        await populateTables(connectToSelect.value, selectedSchema);
    });

    tableSelect.addEventListener('change', async function() {
        selectedTable = this.value;
        if (selectedTable) {
            await fetchCreateTableStatement(selectedTable);
        } else {
            createTableOutput.classList.add('hidden');
            statusMessage.textContent = '';
            resultPanel.classList.add("fade")
        }
    });

    function setManualInput(enabled, forceToggleChecked) {
        useManualInput = enabled;
        if (forceToggleChecked) {
            manualInputToggle.checked = enabled;
        }
        schemaNameField.style.display = enabled ? 'flex' : 'none';
        tableNameField.style.display = enabled ? 'flex' : 'none';
        if (enabled) {
            schemaSelect.value = "";
            tableSelect.value = "";
            schemaSelect.disabled = true;
            tableSelect.disabled = true;
            var schemaHidden = document.getElementById("schema_id_hidden");
            if (schemaHidden) schemaHidden.remove();
            var tableHidden = document.getElementById("table_id_hidden");
            if (tableHidden) tableHidden.remove();
            checkTypedSchemaTable();
        } else {
            schemaSelect.disabled = false;
            tableSelect.disabled = true;
            createTableOutput.classList.add('hidden');
            statusMessage.textContent = '';
            resultPanel.classList.add('fade');
        }
        updateEditButtonState();
    }

    manualInputToggle.addEventListener('change', function() {
        setManualInput(this.checked, false);
    });

    schemaNameInput.addEventListener('input', async function() {
        if (useManualInput) {
            await checkTypedSchemaTable();
        }
    });

    tableNameInput.addEventListener('input', async function() {
        if (useManualInput) {
            await checkTypedSchemaTable();
        }
    });

    ['input', 'change'].forEach(event => form.addEventListener(event, updateEditButtonState));

    window.addEventListener('DOMContentLoaded', async function() {
        await initSource();
        if (connectToSelect.options.length != 0) {
            var singleHost = connectToSelect.value;
            selectedService = singleHost;
            await populateSchemas(singleHost);
        }
        if (matched.schemaId === "-1" || matched.tableId === "-1") {
            setManualInput(true, true);
        }
        updateEditButtonState();
    });
</script>
