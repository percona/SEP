{% extends "base.html.j2" %}
{% block title %}
    Home Dashboard
{% endblock title %}
{% block main %}
    <link rel="stylesheet"
          href="{{ url_for('static', path='/css/homepage.css') }}">
    {% if history or running_tasks %}
        <link rel="stylesheet" href="{{ url_for('static', path='/css/logs.css') }}">
    {% endif %}
    {% if periodic_tasks %}
        <link rel="stylesheet"
              href="{{ url_for('static', path='/css/scheduled.css') }}">
        <link rel="stylesheet"
              href="{{ url_for('static', path='/css/vendor/select2.min.css') }}">
    {% endif %}
    <section id="running-tasks">
        <h2>Running</h2>
        {% include "homepage/running-tasks.html.j2" %}
    </section>
    <section id="pending-tasks">
        <h2>Pending</h2>
        {% include "homepage/pending-tasks.html.j2" %}
    </section>
    <section id="periodic-tasks">
        <h2>Periodic Tasks</h2>
        {% include "homepage/scheduled-tasks.html.j2" %}
    </section>
    {% include "inventory/partials/inventory-metrics.html.j2" %}
    {% include "tasks/partials/host-metrics.html.j2" %}
{% endblock main %}
{% block behaviours_optimized_extra %}
    <script src="{{ url_for('static', path='/js/relativeTime.js') }}"
            nonce="{{ request.state.csp_nonce }}"></script>
    {% if history_tasks or running_tasks %}
        <script src="{{ url_for('static', path='/js/logs.js') }}"
                nonce="{{ request.state.csp_nonce }}"></script>
    {% endif %}
{% endblock behaviours_optimized_extra %}
