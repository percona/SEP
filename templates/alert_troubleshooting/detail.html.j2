{% extends "base.html.j2" %}
{% block title -%}
    Troubleshooting — {{ alert_info.label }}
{%- endblock title %}
{% block style %}
    <link rel="stylesheet"
          href="{{ url_for('static', path='/css/alert-troubleshooting.css') }}">
{% endblock style %}
{% block main %}
    <h2>
        <span class="material-symbols-outlined" style="vertical-align: middle">troubleshoot</span>
        {{ alert_info.label }}
    </h2>
    <section class="at-host-selector">
        <label for="atSharedHost">Executor Host</label>
        <select id="atSharedHost" class="at-host-select" required>
            <option value="" disabled selected>Select host…</option>
            {% for host in executor_hosts %}<option value="{{ host.value }}">{{ host.label }}</option>{% endfor %}
        </select>
    </section>
    {% if snippets %}
        <div class="at-snippet-cards" data-base-uri="{{ base_uri }}">
            {% for snippet in snippets %}
                {% include "alert_troubleshooting/partials/snippet-card.html.j2" %}
            {% endfor %}
        </div>
    {% else %}
        <p class="at-empty-state">No snippets are associated with this alert.</p>
    {% endif %}
{% endblock main %}
{% block behaviours_optimized_extra %}
    <script src="{{ url_for('static', path='/js/info-tooltip.js') }}"
            nonce="{{ request.state.csp_nonce }}"></script>
    <script src="{{ url_for('static', path='/js/troubleshooting-detail.js') }}"
            nonce="{{ request.state.csp_nonce }}"></script>
{% endblock behaviours_optimized_extra %}
