{# djlint:off J018 #}
{% set form_id = "snippetForm-" ~ snippet.filename | replace(".", "-") | replace("/", "-") %}
{% set execute_url = base_uri ~ "/execute/" ~ snippet.filename %}
{# djlint:on #}
<div class="at-snippet-card"
     data-snippet-filename="{{ snippet.filename }}">
    <div class="at-snippet-header">
        <h3 class="at-snippet-title">{{ snippet.title }}</h3>
        {% if snippet.description %}<p class="at-snippet-desc">{{ snippet.description }}</p>{% endif %}
    </div>
    <div class="at-snippet-form">
        {% if snippet.is_approved and snippet.can_execute %}
            {{ snippet.to_form(form_action=execute_url, form_id=form_id) | safe }}
            <script nonce="{{ request.state.csp_nonce }}">
                if (window.initInfoTooltips) {
                    window.initInfoTooltips(document.getElementById('{{ form_id }}'));
                }
            </script>
        {% elif snippet.is_approved %}
            <span class="at-disabled-warning">
                <span class="material-symbols-outlined">warning</span>
                Execution is disabled
                {%- if snippet.execution_interpreter is none -%}
                    : no interpreter configured
                {%- endif -%}
            </span>
        {% else %}
            <span class="at-disabled-warning">
                <span class="material-symbols-outlined">unpublished</span>
                Snippet is not approved
            </span>
        {% endif %}
    </div>
    <div class="at-output-area" style="display: none">
        <span class="at-output-label">STDOUT</span>
        <pre class="at-output-pre"></pre>
    </div>
</div>
