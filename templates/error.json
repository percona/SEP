{% extends "base.json" %}

{% block message %}
    {% from sep.core.utils import format_error_heading, format_error_message %}
    {% set template_data = data.get("template_data", {}) %}
    {% set user = data.get("user") %}
    {% if isinstance(user, dict) and user["isAdmin"] %}
        {% set trace = template_data.get("trace", []) %}
    {% else %}
        {% set trace = [] %}
    {% end %}
{
    "heading": {{ json_encode(format_error_heading(template_data)) }},
    "message": {{ json_encode(format_error_message(template_data)) }},
    "trace": {{ json_encode(trace) }}
}
{% end %}
