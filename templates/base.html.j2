            <defs>
            <linearGradient id="a" x1="6.26" x2="46.88" y1="41.494" y2="19.218" gradientUnits="userSpaceOnUse">
            <stop stop-color="#FC3519" />
            <stop offset="1" stop-color="#F0D136" />
            </linearGradient>
            </defs>
            </symbol>
            <symbol id="githubLogo">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M47.857 0C21.393 0 0 21.551 0 48.213 0 69.525 13.707 87.565 32.723 93.95c2.378.48 3.249-1.038 3.249-2.314 0-1.118-.079-4.949-.079-8.94-13.312 2.873-16.085-5.748-16.085-5.748-2.14-5.588-5.31-7.024-5.31-7.024-4.356-2.953.318-2.953.318-2.953 4.834.32 7.37 4.949 7.37 4.949 4.278 7.343 11.171 5.268 13.944 3.99.396-3.113 1.665-5.268 3.012-6.465-10.618-1.117-21.79-5.268-21.79-23.787 0-5.268 1.9-9.579 4.912-12.93-.475-1.198-2.14-6.148.476-12.773 0 0 4.041-1.277 13.152 4.95a46.01 46.01 0 0 1 11.965-1.598c4.04 0 8.16.56 11.964 1.597 9.112-6.226 13.153-4.949 13.153-4.949 2.615 6.625.95 11.575.475 12.772 3.09 3.352 4.913 7.663 4.913 12.93 0 18.52-11.172 22.59-21.869 23.788 1.744 1.517 3.248 4.39 3.248 8.94 0 6.465-.078 11.654-.078 13.25 0 1.277.872 2.795 3.248 2.316 19.016-6.387 32.724-24.426 32.724-45.738C95.713 21.55 74.24 0 47.857 0Z" />
            </symbol>
        </svg>
        <!-- Top navigation bar to help the user understand what's being rendered -->
        <header class="topnav">
            {% block home %}
                <a class="app-logo" href="{{ url_for('read_root') }}">
                    <svg viewBox="0 0 212 50">
                        <title>Percona</title>
                        <use xlink:href="#perconaLogo" />
                    </svg>
                    <span class="label">Services Enablement Platform</span>
                    <span class="label acronym">SEP</span>
                </a>
            {% endblock home %}
            {% block header %}
                <!-- User preferences -->
                <nav class="app-nav" aria-label="User's menu and preferences">
                    <div class="menu">
                        <button class="icon medium trigger"
                                aria-label="User menu"
                                aria-haspopup="true"
                                aria-expanded="false"
                                aria-controls="userMenu">
                            <span class="material-symbols-outlined">account_circle</span>
                        </button>
                        <div id="userMenu" class="content" aria-hidden="true">
                            <ul role="menu">
                                {% if user is defined and user.is_admin %}
                                    <li role="none">
                                        <a href="{{ casdoor_url }}"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           role="menuitem"
                                           class="list-item">
                                            <span class="label">Manage account (Casdoor)</span>
                                            <span class="material-symbols-outlined">north_east</span>
                                        </a>
                                    </li>
                                {% endif %}
                                <li role="none">
                                    <a class="list-item theme-change dark" role="menuitem">
                                        <span class="label">Change to Dark Mode</span>
                                        <span class="material-symbols-outlined">dark_mode</span>
                                    </a>
                                    <a class="list-item theme-change light" role="menuitem">
                                        <span class="label">Change to Light Mode</span>
                                        <span class="material-symbols-outlined">light_mode</span>
                                    </a>
                                </li>
                            </ul>
                            <ul role="menu">
                                <li role="none">
                                    <button form="logoutForm" type="submit" class="list-item" role="menuitem">
                                        <span class="label">Sign out</span>
                                        <span class="material-symbols-outlined">logout</span>
                                    </button>
                                    <form id="logoutForm"
                                          action="{{ url_for('logout') }}"
                                          method="post"
                                          aria-hidden="true">
                                        <input type="hidden" name="csrf-token" value="{{ csrf_token }}">
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
                <!-- Breadcrumbs to help the user understand where they are on the app -->
                {# {% block breadcrumbs %}
        <nav class="app-breadcrumbs" aria-label="Breadcrumbs-like navigation">
            <a href="{{ url_for('read_root') }}">Dashboard</a>
            <span class="separator material-symbols-outlined">chevron_right</span>
            <span class="self">{{ self.title() }}</span>
        </nav>
{% endblock breadcrumbs %} #}
            {% endblock header %}
        </header>
        <div class="sidebar-layout">
            <!-- Sidebar navigation menu to help the user choose a plugin/functionality of the app -->
            {% block sidebar %}
                {% include "menus/partials/sidebar.html.j2" %}
            {% endblock sidebar %}
            <!-- A vertical divider defined in CSS -->
            <div class="vr" role="presentation"></div>
            <div class="app-content">
                <main>
                    <!-- Messages -->
                    {% set messages = get_messages(request) %}
                    {% if messages %}
                        <div id="messages">
                            {% for msg in messages %}
                                <div class="message{% if msg.sticky %} sticky{% endif %}"
                                     data-level="{{ msg.level.name.lower() }}">
                                    <span class="message-text">{{ msg.text }}</span>
                                    <button type="button" class="close-button icons material-symbols-outlined">close</button>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                    <!-- Confirmation modal -->
                    {% include "confirm_modal.html.j2" %}
                    <!-- Sticky Header -->
                    <div class="sticky-header">
                        {% block sticky %}
                        {% endblock sticky %}
                    </div>
                    <!-- Content for the feature -->
                    <div>
                        {% block main %}
                            <!-- Remember to add a more meaningful and helpful empty state message here, to help users recover and get back on track -->
                            <p>Nothing to see here, move along.</p>
                        {% endblock main %}
                    </div>
                </main>
            </div>
        </div>
        <!-- Scripting zone -->
        {% block behaviours_optimized %}
            <script src="{{ url_for('static', path='/js/vendor/jquery-3.7.1.min.js') }}"
                    nonce="{{ request.state.csp_nonce }}"></script>
            <script src="{{ url_for('static', path='/js/vendor/floating-ui.core.umd.min.js') }}"
                    nonce="{{ request.state.csp_nonce }}"></script>
            <script src="{{ url_for('static', path='/js/vendor/floating-ui.dom.umd.min.js') }}"
                    nonce="{{ request.state.csp_nonce }}"></script>
            <script src="{{ url_for('static', path='/js/vendor/moment.js') }}"
                    nonce="{{ request.state.csp_nonce }}"></script>
            <script src="{{ url_for('static', path='/js/vendor/simple-datatables.js') }}"
                    nonce="{{ request.state.csp_nonce }}"></script>
            <script src="{{ url_for('static', path='/js/messages.js') }}"
                    nonce="{{ request.state.csp_nonce }}"></script>
            <script src="{{ url_for('static', path='/js/app.js') }}"
                    nonce="{{ request.state.csp_nonce }}"></script>
            <script nonce="{{ request.state.csp_nonce }}">
                $('.submitNextForm').click(function() {
                    $(this).next('form').submit();
                });
            </script>
            {% block behaviours_optimized_extra %}
            {% endblock behaviours_optimized_extra %}
        {% endblock behaviours_optimized %}
    </body>
</html>
