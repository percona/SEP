<html lang="en">
    <head>
        <!-- Metas and accessibilities -->
        {# djlint:off #}
    <title>{% block title %}New page{% endblock title %} — Services Enablement Platform</title>
        {# djlint:on #}
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="description" content="Percona Services Enablement Platform">
        <meta name="keywords" content="Percona,Services,SEP,Database,MySQL">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block meta %}
        {% endblock meta %}
        <!-- References -->
        <link rel="shortcut icon"
              type="image/x-icon"
              href="{{ url_for('static', path='/img/percona-fav.svg') }}" />
        <link rel="stylesheet"
              href="{{ url_for('static', path='/css/simple-datatables-style.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', path='/css/base.css') }}">
        <link rel="stylesheet"
              href="{{ url_for('static', path='/css/messages.css') }}">
        {% block style %}
        {% endblock style %}
        {% block behaviours %}
        {% endblock behaviours %}
    </head>
    <body data-theme="light">
        <!-- Adding SVGs here to use/reuse elsewhere -->
        <svg class="svg-island" style="display:none">
            <symbol id="perconaLogo">
            <path id="wordmark" d="M68.154 29.297H64.55v6.451h-4.745v-21.51h8.817c5.147 0 8.26 3.04 8.26 7.436v.059c0 4.979-3.881 7.559-8.721 7.559l-.006.005Zm3.912-7.528c0-2.12-1.478-3.257-3.853-3.257h-3.67v6.573h3.759c2.376 0 3.759-1.415 3.759-3.257v-.059h.005ZM79.53 14.239h16.276v4.212H84.248v4.366h10.17v4.213h-10.17v4.519H95.96v4.212H79.53V14.238ZM112.771 35.75l-4.622-6.882h-3.729v6.882h-4.745V14.239h9.863c5.088 0 8.137 2.674 8.137 7.099v.058c0 3.471-1.878 5.656-4.621 6.67l5.27 7.682h-5.555l.002.002Zm.095-14.165c0-2.026-1.42-3.075-3.729-3.075h-4.715v6.176h4.81c2.311 0 3.634-1.232 3.634-3.04v-.06ZM131.279 36.325c-6.432 0-11.211-4.95-11.211-11.214v-.06c0-6.197 4.683-11.272 11.403-11.272 4.121 0 6.593 1.367 8.623 3.361l-3.06 3.517c-1.689-1.529-3.402-2.46-5.593-2.46-3.683 0-6.343 3.052-6.343 6.79v.06c0 3.738 2.593 6.848 6.343 6.848 2.497 0 4.03-.997 5.749-2.556l3.06 3.082c-2.252 2.4-4.749 3.893-8.965 3.893l-.006.01ZM152.946 36.325c-6.749 0-11.59-5.015-11.59-11.214v-.06c0-6.197 4.905-11.272 11.648-11.272 6.744 0 11.59 5.015 11.59 11.213v.06c0 6.198-4.905 11.273-11.648 11.273Zm6.623-11.272c0-3.738-2.749-6.848-6.623-6.848-3.875 0-6.558 3.051-6.558 6.79v.06c0 3.738 2.75 6.847 6.624 6.847 3.874 0 6.557-3.05 6.557-6.789v-.06ZM190.724 35.767l10.618-21.988 10.617 21.99h-5.324l-5.293-10.943-5.274 10.943h-5.344v-.002ZM188.758 14.246v22.08l-16.192-13.074v12.479h-5.037V13.779l16.192 13.023V14.246h5.037Z" />
