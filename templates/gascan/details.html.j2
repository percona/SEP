{% extends "base.html.j2" %}
{% block title -%}
    Gascan - {{ task.name }}
{%- endblock title %}
{% block style %}
    <style>
        label+input[type=text] {
            display: block
        }

        table form {
            display: inline-block
        }

        table button {
            width: 2.2rem;
            height: 2.2rem
        }
    </style>
    <link rel="stylesheet"
          href="{{ url_for('static', path='/css/saved.css') }}">
    {% if history or running_tasks %}
        <link rel="stylesheet" href="{{ url_for('static', path='/css/logs.css') }}">
    {% endif %}
    <link rel="stylesheet"
          href="{{ url_for('static', path='/css/chain-builder.css') }}">
{% endblock style %}
{% block behaviours_optimized_extra %}
    <script src="{{ url_for('static', path='/js/relativeTime.js') }}"
            nonce="{{ request.state.csp_nonce }}"></script>
    <script src="{{ url_for('static', path='/js/saved.js') }}"
            nonce="{{ request.state.csp_nonce }}"></script>
    {% if history or running_tasks %}
        <script src="{{ url_for('static', path='/js/logs.js') }}"
                nonce="{{ request.state.csp_nonce }}"></script>
    {% endif %}
    <script src="{{ url_for('static', path='/js/chain-builder.js') }}"
            nonce="{{ request.state.csp_nonce }}"></script>
{% endblock behaviours_optimized_extra %}
{% block main %}
    <h2>Overview</h2>
    <table data-table>
        <thead>
            <tr>
                <th>Hostname</th>
                <th>Playbook</th>
                <th>Limit</th>
                <th>Override</th>
                <th>Created at</th>
                <th>Updated at</th>
                <th>Created by</th>
                <th>Last Updated by</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{ task.hostname }}</td>
                <td>{{ task.playbook }}</td>
                <td>{{ task.limit }}</td>
                <td>{{ task.override }}</td>
                <td class="relativeTime">{{ task.created_at }}</td>
                <td class="relativeTime">{{ task.updated_at }}</td>
                <td>{{ user_id_to_username.get(task["created_by"], task["created_by"]) or '' }}</td>
                <td>{{ user_id_to_username.get(task["last_updated_by"], task["last_updated_by"]) or '' }}</td>
            </tr>
        </tbody>
    </table>
    {% include "tasks/partials/run-python-form.html.j2" %}
    {% include "gascan/partials/edit-form.html.j2" %}
    {% if running_tasks %}
        <section id="running-tasks">
            <h2>Running</h2>
            {% include "tasks/partials/running-tasks.html.j2" %}
        </section>
    {% endif %}
    <section>
        <h2>Execution</h2>
        <br>
        <h5>Command</h5>
        <pre><code>{{ task.cmd }}</code></pre>
        <h5>Parameters</h5>
        <table>
            <tbody>
                {% for k, v in task.meta.items() %}
                    {% if not k.startswith('_') %}
                        <tr>
                            <th>{{ k }}</th>
                            <td><code>{{ v }}</code></td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </section>
    <br>
    <br>
    <section>
        <h2>Stats</h2>
        {% if stats and stats.total %}
            <table data-table>
                <caption>Aggregated statistics for {{ task.name }}</caption>
                <thead>
                    <tr>
                        <th>Executions</th>
                        <th>Succeeded</th>
                        <th>Failed</th>
                        <th>Last Finished</th>
                        <th>
                            Avg Duration (<abbr title="seconds">s</abbr>)
                        </th>
                        <th>
                            Last Duration (<abbr>s</abbr>)
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ stats.total }}</td>
                        <td>{{ stats.status.pass }}</td>
                        <td>{{ stats.status.fail }}</td>
                        <td class="relativeTime">{{ stats.last_finished_at }}</td>
                        <td>{{ stats.duration.average_seconds or 0|round(3) }}</td>
                        <td>{{ stats.duration.last_seconds or 0|round(3) }}</td>
                    </tr>
                </tbody>
            </table>
        {% else %}
            <p>No data</p>
        {% endif %}
    </section>
    <br>
    <br>
    {% set pending_tasks = history|selectattr("status", "equalto", "pending")|list %}
    {% if pending_tasks %}
        <section id="pending-tasks">
            <h2>Pending</h2>
            {% include "tasks/partials/pending-tasks.html.j2" %}
        </section>
        <br>
        <br>
    {% endif %}
    <section>
        <h2>History</h2>
        {% set history_tasks = history %}
        {% include "tasks/partials/completed-tasks.html.j2" %}
    </section>
{% endblock main %}
