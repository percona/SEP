{% extends "base.html.j2" %}
{% block title -%}
    Snippets - {{ snippet.title }}
{%- endblock title %}
{% block style %}
    <link rel="stylesheet"
          href="{{ url_for('static', path='/css/snippets-details.css') }}">
    {% if history_tasks or running_tasks %}
        <link rel="stylesheet" href="{{ url_for('static', path='/css/logs.css') }}">
    {% endif %}
    {% if snippet_preview %}<style>{{ syntax_highlight_css() }}</style>{% endif %}
{% endblock style %}
{% block behaviours_optimized_extra %}
    <script src="{{ url_for('static', path='/js/relativeTime.js') }}"
            nonce="{{ request.state.csp_nonce }}"></script>
    <script nonce="{{ request.state.csp_nonce }}">
        $('.code pre').scroll(function () {
            $('.linenos pre').scrollTop($(this).scrollTop());
        });
    </script>
    <script src="{{ url_for('static', path='/js/snippets.js') }}"
            nonce="{{ request.state.csp_nonce }}"></script>
    {% if snippet.is_approved %}
        <script src="{{ url_for('static', path='/js/info-tooltip.js') }}"
                nonce="{{ request.state.csp_nonce }}"></script>
    {% endif %}
    {% if history_tasks or running_tasks %}
        <script src="{{ url_for('static', path='/js/logs.js') }}"
                nonce="{{ request.state.csp_nonce }}"></script>
    {% endif %}
{% endblock behaviours_optimized_extra %}
{% block main %}
    <h2>Snippet - {{ snippet.title }}</h2>
    <dl>
        <dt>Filename</dt>
        <dd>
            <pre>{{ snippet.filename }}</pre>
        </dd>
        {% if snippet.description %}
            <dt>Description</dt>
            <dd>
                {{ snippet.description }}
            </dd>
        {% endif %}
        <dt>Interpreter</dt>
        {% if snippet.execution_interpreter is none -%}
            <dd class="snippetDisabledWarning">
                No interpreter is configured for extension '{{ snippet.path.suffix.lower() }}' and MIME type '{{ snippet.mime_type }}'
            </dd>
        {% else -%}
            <dd>
                <pre>{{ snippet.execution_interpreter }}</pre>
            </dd>
        {% endif %}
        <dt class="sudo{{ snippet.sudo.name|capitalize }}">Sudo</dt>
        <dd class="sudo{{ snippet.sudo.name|capitalize }}">
            {{ snippet.sudo.name|capitalize }}
        </dd>
        <dt>Created at</dt>
        <dd class="relativeTime">
            {{ snippet.created_at|utc_isoformat }}
        </dd>
        <dt>Size</dt>
        <dd title="{{ snippet.size }} bytes">
            {{ snippet.size|humanize_bytes }}
        </dd>
        <dt>Status</dt>
        {% if snippet.is_approved -%}
            <dd class="iconTextLine relativeTime"
                data-relative-date-value="{{ snippet.approved_at|utc_isoformat }}"
                data-relative-date-title-prefix="Approved ">
                <span>Approved at {{ snippet.approved_at|utc_isoformat }}</span> <i class="material-symbols-outlined unselectable"
    style="color: var(--successMain)">check_circle</i>
            </dd>
        {%- else -%}
            {%- set download_before_approval = snippet_preview.is_truncated or not (snippet_preview.content or snippet_preview.preamble or snippet_preview.frontmatter) -%}
            <dd class="iconTextLine">
                <span>Not approved</span> <i class="material-symbols-outlined unselectable"
    style="color: var(--textDisabled)">unpublished</i>
            </dd>
        {%- endif -%}
        <dt>Reason</dt>
        <dd>
            {{ snippet.reason }}
        </dd>
    </dl>
    <section id="actions">
        {% include "snippets/partials/download-approve.html.j2" %}
    </section>
    {% if running_tasks %}
        <section id="running-tasks">
            <h2>Running</h2>
            {% include "tasks/partials/running-tasks.html.j2" %}
        </section>
    {% endif %}
    <section id="snippetPreview">
        <h3>
            Preview
            {% if snippet_preview and snippet_preview.is_truncated %}
                <span title="File is too large to preview. Please download the snippet to inspect its full contents."
                      style="border-bottom: 1px dotted var(--lineDividerStrong)">(partial)</span>
            {% endif %}
        </h3>
        {% if snippet_preview -%}
            {% if snippet_preview.frontmatter -%}
                {%- set last_line = snippet_preview.code_linenostart + snippet_preview.content.splitlines()|length - 1 -%}
                {%- set linenos_chars = last_line|string|length -%}
                <div class="highlight-wrapper"
                     style="--linenos-width: {{ linenos_chars }}ch">
                    {% if snippet_preview.preamble -%}
                        {{ snippet_preview.preamble|syntax_highlight(style="monokai", stripall=False, linenos=True, wrapcode=True) |safe }}
                    {%- endif %}
                    <details class="frontmatter-toggle">
                        <summary>▶ frontmatter ({{ snippet_preview.frontmatter_line_count }} lines)</summary>
                        {{ snippet_preview.frontmatter|syntax_highlight(style="monokai", stripall=False, linenos=True, wrapcode=True, linenostart=snippet_preview.preamble_line_count + 1) |safe }}
                    </details>
                    {% if snippet_preview.content -%}
                        {{ snippet_preview.content|syntax_highlight(style="monokai", stripall=False, linenos=True, wrapcode=True, linenostart=snippet_preview.code_linenostart) |safe }}
                    {%- endif %}
                </div>
            {% else -%}
                {{ snippet_preview.content|syntax_highlight(style="monokai", linenos=True, wrapcode=True) |safe }}
            {%- endif %}
            {% if snippet_preview.is_truncated -%}
                <p class="iconTextLine">
                    <i class="material-symbols-outlined unselectable"
                       style="color: var(--warningMain)">warning</i> <span>File is too large to preview. Please <a class="downloadSnippet"
    href="{{ url_for('snippets_files', path=snippet.filename) }}"
    data-snippet-filename="{{ snippet.filename }}"
    download>download the snippet</a> to inspect its full contents.</span>
                </p>
            {%- endif -%}
        {%- else -%}
            No preview available. Please <a class="downloadSnippet"
    href="{{ url_for('snippets_files', path=snippet.filename) }}"
    data-snippet-filename="{{ snippet.filename }}"
    download>download the snippet</a> to inspect its contents.
        {%- endif -%}
    </section>
    {% if snippet.is_approved -%}
        <section>
            <h3>Execute Snippet</h3>
            {% if not snippet.can_execute %}
                <span class="snippetDisabledWarning">Execution is disabled
                    {%- if snippet.validated_parameters.errors -%}
                        : snippet has invalid parameters
                    {%- elif snippet.execution_interpreter is none -%}
                        : no interpreter is configured for extension '{{ snippet.path.suffix.lower() }}' and MIME type '{{ snippet.mime_type }}'
                    {%- endif -%}
                </span>
            {% endif %}
            {{ snippet.to_form(executor_hosts) | safe }}
            <script nonce="{{ request.state.csp_nonce }}">
                if (window.initInfoTooltips) {
                    window.initInfoTooltips(document.getElementById('snippetExecuteForm'));
                }
            </script>
        </section>
    {% endif -%}
    {% if history_tasks %}
        <section>
            <h2>History</h2>
            {% include "tasks/partials/completed-tasks.html.j2" %}
        </section>
    {% endif %}
{% endblock main %}
