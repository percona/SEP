<a class="downloadSnippet"
   href="{{ url_for('snippets_files', path=snippet.filename) }}"
   data-snippet-filename="{{ snippet.filename }}"
   download>
    <button title="Download snippet" class="material-symbols-outlined">download</button>
</a>
{% if user.is_admin -%}
    {%- if snippet.is_approved -%}
        {%- set action_route = "snippets_remove_approval" -%}
        {%- set action_verb = "remove the approval of" -%}
        {%- set icon = "remove_done" -%}
    {%- else -%}
        {%- set action_route = "snippets_approve" -%}
        {%- set action_verb = "approve" -%}
        {%- set icon = "done_all" -%}
    {%- endif -%}
    {%- set submit_title = action_verb.capitalize() ~ " snippet" -%}
    <form id="{{ snippet.filename }}-approval"
          method="post"
          class="confirmable-form"
          data-confirm-message='Are you sure you want to {{ action_verb }} snippet "{{ snippet.filename }}"?'
          action="{{ url_for(action_route, snippet_filename=snippet.filename) }}">
        <input type="hidden" name="csrf-token" value="{{ csrf_token }}" />
        <button {% if download_before_approval %}disabled title="Please download and inspect the full snippet before approving it" data-next-title="{{ submit_title }}"{% else %}title="{{ submit_title }}"{% endif %}
                type="submit"
                class="material-symbols-outlined approval-button submitButton">{{ icon }}</button>
    </form>
{%- endif %}
