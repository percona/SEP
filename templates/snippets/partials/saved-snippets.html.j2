{% if snippets %}
    {% set has_unapproved = snippets | rejectattr('is_approved') | list | length > 0 %}
    {% set show_batch_ui = user.is_admin and has_unapproved %}
    {% if show_batch_ui %}
        <form id="snippetsBulkApproveForm"
              method="post"
              action="{{ url_for('snippets_approve_batch') }}"
              class="confirmable-form"
              data-confirm-message="Approve selected snippets? They will be approved WITHOUT being downloaded first — the per-row download-before-approve guard is bypassed for batch approval.">
            <input type="hidden" name="csrf-token" value="{{ csrf_token }}" />
        </form>
        <div id="snippetsBulkBar" class="bulk-actions-bar" hidden>
            <button type="submit"
                    form="snippetsBulkApproveForm"
                    class="submitButton approval-button"
                    title="Approve selected snippets">
                <span class="material-symbols-outlined">done_all</span>
                Approve selected
            </button>
        </div>
    {% endif %}
    <table class="snippets-tbl">
        <thead>
            <tr>
                {% if show_batch_ui %}
                    <th style="width: 30px;">
                        <label class="checkbox">
                            <input type="checkbox"
                                   id="selectAllSnippets"
                                   aria-label="Select all unapproved snippets" />
                            <div class="checkmark">
                                <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                                <span class="material-symbols-outlined checked">check_box</span>
                            </div>
                        </label>
                    </th>
                {% endif %}
                <th style="width: 30px;"></th>
                <th>Filename</th>
                <th class="snippet-description-col">Description</th>
                <th>Size</th>
                <th>Added at</th>
                <th>Reason</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for snippet in snippets %}
                <tr id="{{ snippet.filename }}"
                    {% if snippet.is_approved %}class="relativeTime" data-relative-date-value="{{ snippet.approved_at|utc_isoformat }}" data-relative-date-title-prefix="Approved "{% else %}title="Not approved"{% endif %}>
                    {% if show_batch_ui %}
                        <td>
                            {% if not snippet.is_approved %}
                                <label class="checkbox">
                                    <input type="checkbox"
                                           class="snippetCheckbox"
                                           name="filenames"
                                           value="{{ snippet.filename }}"
                                           form="snippetsBulkApproveForm"
                                           aria-label="Select snippet {{ snippet.filename }}" />
                                    <div class="checkmark">
                                        <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                                        <span class="material-symbols-outlined checked">check_box</span>
                                    </div>
                                </label>
                            {% endif %}
                        </td>
                    {% endif %}
                    <td class="approval-icon-cell">
                        {% if snippet.is_approved %}
                            <i class="material-symbols-outlined unselectable"
                               style="color: var(--successMain)">check_circle</i>
                        {% else %}
                            {%- set download_before_approval = True -%}
                            <i class="material-symbols-outlined unselectable"
                               style="color: var(--textDisabled)">unpublished</i>
                        {% endif %}
                    </td>
                    <td>{{ snippet.filename }}</td>
                    <td class="snippet-description-col" title="{{ snippet.description }}">{{ snippet.description|truncate(120) }}</td>
                    <td>{{ snippet.size|humanize_bytes }}</td>
                    <td class="relativeTime">{{ snippet.created_at|utc_isoformat }}</td>
                    <td>{{ snippet.reason }}</td>
                    <td class="actions-cell">
                        <div class="info-delete-container flex">
                            <a href="{{ snippet.filename }}" id="{{ snippet.filename }}-info">
                                <button title="Detail" class="material-symbols-outlined info-button">info</button>
                            </a>
                            {% include "snippets/partials/download-approve.html.j2" %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <p>No data</p>
{% endif %}
