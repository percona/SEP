<style>
    fieldset {
        width: 95%;
        justify-content: flex-start;
        padding-top: 5px;
        padding-bottom: 5px;
        margin-bottom: 0.5em;
    }

    .field {
        flex: 0 0 48%;
        box-sizing: border-box;
        padding: 5px;
        display: flex;
        align-items: center;
    }

    fieldset:has(> .field:nth-of-type(1):nth-last-of-type(1))>.field {
        flex: 0 0 48%;
    }

    .field label {
        width: 135px;
        margin-right: 10px;
    }

    .field input,
    .field select {
        flex: 1;
    }

    label+select,
    label+input {
        vertical-align: middle;
        margin-right: 0px;
    }

    label:has(+ select),
    label:has(+ input) {
        display: inline-flex;
        align-items: center;
        margin-right: 0px !important;
        width: 130px;
    }

    input[type="checkbox"] {
        flex: none;
        margin-right: 0.5em;
    }

    fieldset + fieldset {
        margin: 1em 0;
    }
    fieldset > * {
        margin: 0.25em 0 1em;
    }
    select {
        min-width: 200px;
    }
</style>
<form id="edit-task-form"
      class="edit-task-form window"
      method="post"
      action="{{ url_for('checksums_update', task_name=task.name) }}"
      data-confirm-message='Are you sure you want to edit task "{{ task.name }}"?'>
    <dialog id="modalEditTask"
            aria-modal="true"
            aria-labelledby="modalEditTaskTitle"
            data-modal="target"
            class="large">
        <header>
            <h3 id="modalEditTaskTitle" class="h5 title">Edit task</h3>
        </header>
        <section>
            <p>
                You are about to edit the task <strong id="modalTaskName"></strong>.
            </p>
            <div>
                <fieldset>
                    <legend style="margin-bottom: 0.8em;">Main options</legend>
                    <fieldset>
                        <legend>Executor Host</legend>
                        <div class="select">
                            {% set hostname_title = "Select the hostname of the target system for task execution." %}
                            <label for="hostname" title="{{ hostname_title }}">
                                <span class="material-symbols-outlined">arrow_drop_down</span>
                                <span class="label">Select host</span>
                                {% if executor_hosts|length == 1 %}
                                    {% set single_host = executor_hosts[0] %}
                                    <select id="hostname" name="hostname" title="{{ hostname_title }}" disabled>
                                        <option value="{{ single_host.value }}" selected>{{ single_host.label }}</option>
                                    </select>
                                    <input type="hidden" name="hostname" value="{{ single_host.value }}">
                                {% else %}
                                    <select id="hostname" name="hostname" title="{{ hostname_title }}">
                                        {% for host in executor_hosts %}
                                            <option value="{{ host.value }}"
                                                    {% if host.value == task['hostname'] %}selected{% endif %}>
                                                {{ host.label }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                {% endif %}
                            </label>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>Checksum details</legend>
                        <div class="field">
                            {% set task_name_title = "Type the name of task to be created." %}
                            <label for="task_name" title="{{ task_name_title }}">Task name</label>
                            <input type="text"
                                   id="task_name"
                                   name="task_name"
                                   class="validate"
                                   required
                                   title="{{ task_name_title }}"
                                   value="{{ task.name }}"
                                   placeholder="Enter a unique task name">
                        </div>
                        <div class="select">
                            {% set service_id_title = "Select the database host from the inventory to connect to." %}
                            <label for="service_id" title="{{ service_id_title }}">
                                <span class="material-symbols-outlined">arrow_drop_down</span>
                                <span class="label">Database host</span>
                                {% if services|length > 0 %}
                                    {% set matched_service_list = [] %}
                                    {% for service in services %}
                                        {% if task["service_host"] == service.node.address and task["service_port"] == service.port %}
                                            {% do matched_service_list.append(1) %}
                                        {% endif %}
                                    {% endfor %}
                                    <select id="service_id"
                                            name="service_id"
                                            title="{{ service_id_title }}"
                                            required>
                                        <option value=""
                                                {% if matched_service_list|length > 0 %}{% else %}selected{% endif %}>
                                            Select a database host
                                        </option>
                                        {% if matched_service_list|length == 0 %}
                                            <option value="-1" selected>Unknown({{ task["service_host"] }}:{{ task["service_port"] }})</option>
                                        {% endif %}
                                        {% for service in services %}
                                            {% set is_selected = task["service_host"] == service.node.address and task["service_port"] == service.port %}
                                            <option value="{{ service.id }}" {% if is_selected %}selected{% endif %}>
                                                {{ service.name }} ({{ service.node_id }})
                                            </option>
                                        {% endfor %}
                                    </select>
                                {% endif %}
                            </label>
                        </div>
                    </fieldset>
                    <fieldset style="margin-bottom: 0;">
                        <legend>Data</legend>
                        <div class="field">
                            {% set databases_title = "Comma-separated database names to checksum." %}
                            <label for="databases" title="{{ databases_title }}">Databases</label>
                            <input type="text"
                                   id="databases"
                                   name="databases"
                                   class="validate"
                                   title="{{ databases_title }}"
                                   value="{{ task.databases }}"
                                   placeholder="db1,db2" />
                        </div>
                        <div class="field">
                            {% set tables_title = "Comma-separated tables in schema.table format." %}
                            <label for="tables" title="{{ tables_title }}">Tables</label>
                            <input type="text"
                                   id="tables"
                                   name="tables"
                                   class="validate"
                                   title="{{ tables_title }}"
                                   value="{{ task.tables }}"
                                   placeholder="db1.tbl1,db1.tbl2" />
                        </div>
                        {% set extra_args_title = "Optional additional pt-table-checksum arguments." %}
                        <label for="extra_args" title="{{ extra_args_title }}">
                            Extra args
                            <input type="text"
                                   id="extra_args"
                                   name="extra_args"
                                   class="validate"
                                   value="{{ task.extra_args }}"
                                   placeholder="--chunk-time=1"
                                   style="width: 25em" />
                        </label>
                        <br>
                    </fieldset>
                    <br>
                </fieldset>
                <fieldset>
                    <legend>Flags</legend>
                    <label class="checkbox">
                        <input type="checkbox"
                               id="binary_index"
                               name="binary_index"
                               class="validate"
                               {% if task.binary_index %}checked{% endif %} />
                        <div class="checkmark">
                            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                            <span class="material-symbols-outlined checked">check_box</span>
                        </div>
                        <span class="label">Binary Index</span>
                    </label>
                    <label class="checkbox">
                        <input type="checkbox"
                               id="explain_arg"
                               name="explain_arg"
                               class="validate"
                               {% if task.explain_arg %}checked{% endif %} />
                        <div class="checkmark">
                            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                            <span class="material-symbols-outlined checked">check_box</span>
                        </div>
                        <span class="label">Explain</span>
                    </label>
                    <label class="checkbox">
                        <input type="checkbox"
                               id="fail_on_stopped_replication"
                               name="fail_on_stopped_replication"
                               class="validate"
                               {% if task.fail_on_stopped_replication %}checked{% endif %} />
                        <div class="checkmark">
                            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                            <span class="material-symbols-outlined checked">check_box</span>
                        </div>
                        <span class="label">Fail on stopped replication</span>
                    </label>
                    <label class="checkbox">
                        <input type="checkbox"
                               id="truncate_replicate_table"
                               name="truncate_replicate_table"
                               class="validate"
                               {% if task.truncate_replicate_table %}checked{% endif %} />
                        <div class="checkmark">
                            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                            <span class="material-symbols-outlined checked">check_box</span>
                        </div>
                        <span class="label">Truncate replicate table</span>
                    </label>
                </fieldset>
                <fieldset>
                    <legend>Advanced options</legend>
                    <fieldset>
                        <legend>Recursion Method</legend>
                        <div class="select">
                            <label for="recursion_method">
                                <span class="material-symbols-outlined">arrow_drop_down</span>
                                <span class="label">Recursion method</span>
                                <select id="recursion_method" name="recursion_method">
                                    <option value="" {% if task.recursion_method == "" %}selected{% endif %}>default</option>
                                    <option value="processlist"
                                            {% if task.recursion_method == "processlist" %}selected{% endif %}>
                                        processlist
                                    </option>
                                    <option value="hosts"
                                            {% if task.recursion_method == "hosts" %}selected{% endif %}>hosts</option>
                                    <option value="dsn"
                                            {% if task.recursion_method == "dsn" %}selected{% endif %}>dsn</option>
                                    <option value="none"
                                            {% if task.recursion_method == "none" %}selected{% endif %}>none</option>
                                </select>
                            </label>
                        </div>
                        <div class="field">
                            <label for="dsn_table">DSN Table</label>
                            <input type="text"
                                   id="dsn_table"
                                   name="dsn_table"
                                   class="validate"
                                   value="{%- if task.recursion_method == 'dsn' -%}{{ (task.dsn_table | default('', true) | trim) or 'D=percona,t=dsns' }}{%- endif -%}"
                                   placeholder="D=percona,t=dsns" />
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>Customization</legend>
                        <div class="field">
                            <label for="pause_file">Pause file</label>
                            <input type="text"
                                   id="pause_file"
                                   name="pause_file"
                                   class="validate"
                                   value="{{ task.pause_file }}" />
                        </div>
                        <div class="field">
                            <label for="progress">Progress</label>
                            <input type="text"
                                   id="progress"
                                   name="progress"
                                   class="validate"
                                   size="15"
                                   value="{{ task.progress or 'time,10' }}" />
                        </div>
                        <div class="field">
                            <label for="set_vars">Set Vars</label>
                            <input type="text"
                                   id="set_vars"
                                   name="set_vars"
                                   class="validate"
                                   value="{{ task.set_vars or 'transaction_isolation=READ-COMMITTED,lock_wait_timeout=5' }}"
                                   size="60" />
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>Performance</legend>
                        <div class="field">
                            <label for="max_load">Max Load</label>
                            <input type="text"
                                   id="max_load"
                                   name="max_load"
                                   class="validate"
                                   value="{{ task.max_load or 'Threads_running=50' }}"
                                   size="30" />
                        </div>
                        <div class="field">
                            <label for="chunk_time">Chunk Time</label>
                            <input type="text"
                                   id="chunk_time"
                                   name="chunk_time"
                                   class="validate"
                                   value="{{ task.chunk_time or '0.5' }}"
                                   size="5" />
                        </div>
                        <div class="field">
                            <label for="max_lag">Max Lag</label>
                            <input type="text"
                                   id="max_lag"
                                   name="max_lag"
                                   class="validate"
                                   value="{{ task.max_lag or '150' }}"
                                   size="5" />
                        </div>
                    </fieldset>
                </fieldset>
                {% include "tasks/partials/create-form-alert-on-failure-input.html.j2" %}
            </div>
        </section>
        <footer>
            <button type="button" class="text large" data-modal-close>
                Cancel<sup>ESC</sup>
            </button>
            <button id="modalEditTaskSubmitButton"
                    type="submit"
                    disabled
                    class="contained large submitButton">Edit</button>
        </footer>
    </dialog>
    <input type="hidden" name="csrf-token" value="{{ csrf_token }}" />
</form>
<script type="text/javascript" nonce="{{ request.state.csp_nonce }}">
    const form = document.getElementById('edit-task-form');
    const editButton = form.querySelector('button[type="submit"]');
    const recursion_method = document.getElementById('recursion_method');
    const dsn_table = document.getElementById('dsn_table');
    const explain_arg = document.getElementById('explain_arg');
    const truncate_replicate_table = document.getElementById('truncate_replicate_table');

    function updateEditButtonState() {
        editButton.disabled = !form.checkValidity();
    }

    recursion_method.addEventListener('change', function () {
        if (this.value === 'dsn') {
            if (!dsn_table.value.trim()) {
                dsn_table.value = 'D=percona,t=dsns';
            }
        } else {
            dsn_table.value = '';
        }
    });

    explain_arg.addEventListener('change', function () {
        if (this.checked) {
            truncate_replicate_table.checked = false;
            truncate_replicate_table.disabled = true;
        } else {
            truncate_replicate_table.disabled = false;
        }
    });

    truncate_replicate_table.addEventListener('change', function () {
        if (this.checked) {
            explain_arg.checked = false;
            explain_arg.disabled = true;
        } else {
            explain_arg.disabled = false;
        }
    });

    ['input', 'change'].forEach(event => form.addEventListener(event, updateEditButtonState));

    window.addEventListener('DOMContentLoaded', function () {
        updateEditButtonState();
    });
</script>
