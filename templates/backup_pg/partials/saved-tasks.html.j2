{% if tasks %}
    <table data-table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Host</th>
                <th>Type</th>
                <th>Upload</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for task in tasks %}
                <tr id="{{ task.name }}">
                    <td>
                        <a href="{{ url_for('pg_backups_detail', task_name=task.name) }}">{{ task.name }}</a>
                        {% include "tasks/partials/connectivity-warning-icon.html.j2" %}
                    </td>
                    <td>{{ task.host }} ({{ task.port }})</td>
                    <td>{{ task.backup_type }}</td>
                    <td>{{ task.upload }}</td>
                    <td class="options">{% include "tasks/partials/saved-tasks-actions-column.html.j2" %}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "tasks/partials/scheduled-execution-dialog.html.j2" %}
{% else %}
    <p>No data</p>
{% endif %}
