<style>

    .hidden {
        overflow: hidden;
        transition: opacity 0.5s ease, max-height 0.5s ease;
        opacity: 0;
        max-height: 0;
        pointer-events: none;
        display: none;
    }

    .visible {
        opacity: 1;
        max-height: 1000px; /* Large enough to show all content */
        pointer-events: auto;
        display: flex;
    }

    button {
        margin-top: 1em;
        margin-right: 1em;
    }

    .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 1em;
        align-items: center;
    }

    .checkbox-group label {
        display: inline-flex;
        align-items: center;
        gap: 0.25em;
        margin-top: 0;
    }

    .checkbox-group input {
        margin-top: 0 !important;
    }
    fieldset + fieldset {
        margin: 1em 0;
    }
</style>
<form action="" id="create_form" method="post" class="{{ form_class }}">
    <input type="hidden" name="csrf-token" value="{{ csrf_token }}" />
    <input type="hidden" name="backup_type" value="P" />
    <fieldset>
        <legend>Main Options</legend>
        <br>
        <fieldset>
            <legend>Executor Host</legend>
            {% set hostname_title = "Select the hostname of the target system for task execution." %}
            <div class="select">
                <label for="hostname" title="{{ hostname_title }}">
                    <span class="material-symbols-outlined">arrow_drop_down</span>
                    <span class="label">Select Executor Host:</span>
                    {% if executor_hosts|length == 1 %}
                        {% set single_host = executor_hosts[0] %}
                        <select id="hostname" name="hostname" title="{{ hostname_title }}" disabled>
                            <option value="{{ single_host.value }}" selected>{{ single_host.label }}</option>
                        </select>
                        <input type="hidden" name="hostname" value="{{ single_host.value }}">
                    {% else %}
                        <select id="hostname" name="hostname" title="{{ hostname_title }}" required>
                            <option value="" selected>Select a host</option>
                            {% for host in executor_hosts %}<option value="{{ host.value }}">{{ host.label }}</option>{% endfor %}
                        </select>
                    {% endif %}
                </label>
            </div>
        </fieldset>
        <fieldset>
            <legend>Basic Task Information</legend>
            <br>
            {% set task_name_title = "Type the name of task to be created." %}
            <label for="task_name" title="{{ task_name_title }}">
                Task Name:
                <input type="text"
                       id="task_name"
                       name="task_name"
                       class="validate"
                       required
                       placeholder="Enter a unique task name" />
            </label>
            <br>
            <br>
            {% set service_id_title = "Select the database host from the inventory to connect to." %}
            <div class="select">
                <label for="service_id" title="{{ service_id_title }}">
                    <span class="material-symbols-outlined">arrow_drop_down</span>
                    <span class="label">Select a Database Host:</span>
                    {% if services|length == 1 %}
                        {% set single_service = services[0] %}
                        <select id="service_id" name="service_id" disabled>
                            <option value="{{ single_service.id }}" selected>{{ single_service.name }}</option>
                        </select>
                        <input type="hidden" name="service_id" value="{{ single_service.id }}">
                    {% else %}
                        <select id="service_id" name="service_id" required>
                            <option value="" selected>Select a database host</option>
                            {% for service in services %}
                                <option value="{{ service.id }}">{{ service.name }} ({{ service.node_id }})</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </label>
            </div>
            <br>
        </fieldset>
    </fieldset>
    <fieldset>
        <legend>General Backup Configuration</legend>
        {% set backup_dir_title = "Type the directory where backup files will be stored." %}
        <label for="backup_dir" title="{{ backup_dir_title }}">
            Backup Directory:
            <input type="text"
                   id="backup_dir"
                   name="backup_dir"
                   placeholder="/path/to/backups"
                   required>
        </label>
        <br>
        <br>
        {% set logging_dir_title = "Type the directory where log files will be stored for backup operations." %}
        <label for="logging_dir" title="{{ logging_dir_title }}">
            Logging Directory (optional):
            <input type="text"
                   id="logging_dir"
                   name="logging_dir"
                   placeholder="/path/to/logs" />
        </label>
        <br>
        <br>
        {% set compression_algorithm_title = "Select the type of compression algorithm" %}
        <div class="select"
             style="display:none"
             id="compression_algorithm_wrapper">
            <label for="compression_algorithm" title="{{ compression_algorithm_title }}">
                <span class="material-symbols-outlined">arrow_drop_down</span>
                <span class="label">Compression Algorithm:</span>
                <select id="compression_algorithm" name="compression_algorithm"></select>
            </label>
        </div>
    </fieldset>
    <fieldset id="pgbackrest_container" style="flex-direction: column; gap: 1em">
        <legend>PgBackRest Configuration</legend>
        {% set pgbackrest_bin_title = "The path to the pgbackrest binary." %}
        <label for="pgbackrest_bin" title="{{ pgbackrest_bin_title }}">
            PgBackRest Binary Path:
            <input type="text"
                   id="pgbackrest_bin"
                   name="pgbackrest_bin"
                   value="/usr/bin/pgbackrest"
                   placeholder="/usr/bin/pgbackrest" />
        </label>
        <br>
        <br>
        {% set pgbackrest_config_file_title = "The path to the pgbackrest configuration file." %}
        <label for="pgbackrest_config_file"
               title="{{ pgbackrest_config_file_title }}">
            PgBackRest Config File Path:
            <input type="text"
                   id="pgbackrest_config_file"
                   name="pgbackrest_config_file"
                   value="/etc/pgbackrest.conf"
                   placeholder="/etc/pgbackrest.conf" />
        </label>
        <br>
        <br>
        {% set pgbackrest_backup_type_title = "incr is default, use diff for differential." %}
        <div class="select">
            <label for="pgbackrest_backup_type"
                   title="{{ pgbackrest_backup_type_title }}">
                <span class="material-symbols-outlined">arrow_drop_down</span>
                <span class="label">Backup Type:</span>
                <select id="pgbackrest_backup_type" name="pgbackrest_backup_type">
                    <option value="incr">Incremental</option>
                    <option value="diff">Differential</option>
                </select>
            </label>
        </div>
        {% set pgbackrest_datadir_title = "The path to the PostgreSQL datadir." %}
        <label for="pgbackrest_datadir" title="{{ pgbackrest_datadir_title }}">
            PostgreSQL Datadir Path:
            <input type="text"
                   id="pgbackrest_datadir"
                   name="pgbackrest_datadir"
                   placeholder="/var/lib/pgsql/12/data/" />
        </label>
        <br>
        <br>
        {% set pgbackrest_retention_full_title = "The number of full backups to retain." %}
        <label for="pgbackrest_retention_full"
               title="{{ pgbackrest_retention_full_title }}">
            Retention Full:
            <input type="number"
                   id="pgbackrest_retention_full"
                   name="pgbackrest_retention_full"
                   placeholder="e.g. 2" />
        </label>
        <br>
        <br>
        {% set pgbackrest_retention_archive_title = "The number of archive backups to retain." %}
        <label for="pgbackrest_retention_archive"
               title="{{ pgbackrest_retention_archive_title }}">
            Retention Archive:
            <input type="number"
                   id="pgbackrest_retention_archive"
                   name="pgbackrest_retention_archive"
                   placeholder="e.g. 1" />
        </label>
        <br>
        <br>
        {% set pgbackrest_incremental_cycle_title = "The frequency of incremental backups." %}
        <div class="select">
            <label for="pgbackrest_incremental_cycle"
                   title="{{ pgbackrest_incremental_cycle_title }}">
                <span class="material-symbols-outlined">arrow_drop_down</span>
                <span class="label">Incremental Cycle:</span>
                <select id="pgbackrest_incremental_cycle" name="pgbackrest_incremental_cycle">
                    <option value="">Select one</option>
                    <option value="daily">daily</option>
                    <option value="1">weekly on Monday</option>
                    <option value="2">weekly on Tuesday</option>
                    <option value="3">weekly on Wednesday</option>
                    <option value="4">weekly on Thursday</option>
                    <option value="5">weekly on Friday</option>
                    <option value="6">weekly on Saturday</option>
                    <option value="7">weekly on Sunday</option>
                </select>
            </label>
        </div>
        {% set pgbackrest_process_max_title = "The maximum number of processes to use for the backup." %}
        <label for="pgbackrest_process_max"
               title="{{ pgbackrest_process_max_title }}">
            Process Max:
            <input type="number"
                   id="pgbackrest_process_max"
                   name="pgbackrest_process_max"
                   placeholder="e.g.4" />
        </label>
        <br>
        <br>
        {% set pgbackrest_repo_title = "The repository to use for the backup." %}
        <label for="pgbackrest_repo" title="{{ pgbackrest_repo_title }}">
            Repository:
            <input type="number"
                   id="pgbackrest_repo"
                   name="pgbackrest_repo"
                   placeholder="e.g. 1" />
        </label>
        <br>
        <br>
        {% set pgbackrest_aes256_passfile_title = "The path to the AES-256 encryption key file for securing backups." %}
        <label for="pgbackrest_aes256_passfile"
               title="{{ pgbackrest_aes256_passfile_title }}">
            AES256 Passfile Path:
            <input type="text"
                   id="pgbackrest_aes256_passfile"
                   name="pgbackrest_aes256_passfile"
                   placeholder="e.g. ~/.config/percona/pgbackrest/pg_passfile" />
        </label>
    </fieldset>
    {% include "tasks/partials/create-form-alert-on-failure-input.html.j2" %}
    {% include "tasks/partials/create-form-connectivity-check-input.html.j2" %}
    <div style="display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 0.25em">
        <button class="contained large" type="submit">Create</button>
        <button class="text large" type="reset">Reset</button>
    </div>
</form>
<script type="text/javascript" nonce="{{ request.state.csp_nonce }}">
    function updateCreateButtonState() {
        createButton.disabled = !form.checkValidity();
    }

    // Event listeners
    ['input', 'change'].forEach(event => form.addEventListener(event, updateCreateButtonState));

    // Initialize
    window.addEventListener('DOMContentLoaded', function() {
        updateCreateButtonState();
    });

</script>
