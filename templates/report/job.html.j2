{% extends "base.html.j2" %}
{% block title -%}
    {{ job_title }}
{%- endblock title %}
{% block style %}
    <link rel="stylesheet"
          href="{{ url_for('static', path='/css/report.css') }}">
{% endblock style %}
{% block main %}
    <section class="report-layout">
        <header class="report-header">
            <h1>{{ job_title }}</h1>
            <p class="subtitle">{{ job_description }}</p>
        </header>
        <section class="report-section">
            <p id="report-job-status">Queued.</p>
            <p>
                <a id="report-job-download"
                   class="btn contained large"
                   href="{{ download_url or '#' }}"
                   hidden>Download PDF</a>
                <a href="{{ back_url }}" class="btn outlined large">Back to Report</a>
            </p>
        </section>
    </section>
{% endblock main %}
{% block behaviours_optimized_extra %}
    <script nonce="{{ request.state.csp_nonce }}">
        const pollUrl = {{ poll_url | tojson }};
        const downloadUrl = {{ download_url | tojson }};
        const successMessage = {{ success_message | tojson }};
        const statusEl = document.getElementById("report-job-status");
        const downloadEl = document.getElementById("report-job-download");

        async function pollReportJob() {
            const response = await fetch(pollUrl, { credentials: "same-origin" });
            if (!response.ok) {
                statusEl.textContent = "Unable to check report job status.";
                return;
            }
            const job = await response.json();
            if (job.status === "success") {
                statusEl.textContent = successMessage;
                if (downloadUrl) {
                    downloadEl.hidden = false;
                }
                return;
            }
            if (job.status === "failure" || job.status === "revoked") {
                statusEl.textContent = job.error || "Report job failed.";
                return;
            }
            if (job.status !== "pending" && job.status !== "received" && job.status !== "started" && job.status !== "retry") {
                statusEl.textContent = job.error || "Report job ended unexpectedly.";
                return;
            }
            statusEl.textContent = `Report job ${job.status}.`;
            window.setTimeout(pollReportJob, 2000);
        }

        pollReportJob();
    </script>
{% endblock behaviours_optimized_extra %}
