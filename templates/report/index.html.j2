{% extends "base.html.j2" %}
{% block title -%}
    Health & Security Report
{%- endblock title %}
{% block style %}
    <link rel="stylesheet"
          href="{{ url_for('static', path='/css/report.css') }}">
{% endblock style %}
{% block main %}
    <div class="report-layout">
        <h2>Health &amp; Security Report</h2>
        <p>
            Generate a comprehensive report of the database health, alerts,
            backups, disk usage, service uptime, and inventory from PMM.
        </p>
        {% if not pmm_configured %}
            <div class="message" data-level="warning">
                <span class="message-text">
                    PMM is not configured. Please set the PMM endpoint and API key
                    in the application settings.
                </span>
            </div>
        {% else %}
            <form method="post"
                  action="{{ request.url_for('report_generate') }}"
                  class="report-form">
                <input type="hidden" name="csrf-token" value="{{ csrf_token }}">
                <fieldset>
                    <legend>Report Period</legend>
                    <div class="form-row">
                        <label for="since">From</label>
                        <select name="since" id="since">
                            <option value="now-1d">Last 24 hours</option>
                            <option value="now-3d">Last 3 days</option>
                            <option value="now-7d" selected>Last 7 days</option>
                            <option value="now-14d">Last 14 days</option>
                            <option value="now-30d">Last 30 days</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <label for="until">To</label>
                        <select name="until" id="until">
                            <option value="now" selected>now</option>
                            <option value="now-1d">1 day ago</option>
                            <option value="now-3d">3 days ago</option>
                            <option value="now-7d">7 days ago</option>
                        </select>
                    </div>
                </fieldset>
                <fieldset>
                    <legend>Options</legend>
                    <div class="form-row">
                        <label class="checkbox">
                            <input type="checkbox" name="full" id="full" value="true">
                            <div class="checkmark">
                                <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                                <span class="material-symbols-outlined checked">check_box</span>
                            </div>
                            <span class="label">Full report - show all check results and full
                                backup history instead of only failures/summaries</span>
                        </label>
                    </div>
                    <div class="form-row">
                        <label class="checkbox">
                            <input type="checkbox" name="refresh" id="refresh" value="true">
                            <div class="checkmark">
                                <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
                                <span class="material-symbols-outlined checked">check_box</span>
                            </div>
                            <span class="label">Refresh - force a refresh of advisor checks
                                before fetching results</span>
                        </label>
                    </div>
                </fieldset>
                <div class="form-actions">
                    <button type="submit" class="contained large">Generate Report</button>
                    <button type="button"
                            class="outlined large"
                            onclick="window.open('{{ request.url_for('report_generate_json') }}', '_blank', 'noopener,noreferrer')">Download as JSON</button>
                </div>
            </form>
        {% endif %}
    </div>
{% endblock main %}
