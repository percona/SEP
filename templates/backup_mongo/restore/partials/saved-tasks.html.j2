{% if tasks %}
    {#
    <!-- Debug output -->
        <div style="background: #f5f5f5; padding: 10px; margin: 10px 0; border: 1px solid #ddd;">
            <h4>Debug - Task Data:</h4>
            {% for task in tasks %}
                <div style="margin-bottom: 20px;">
                    <strong>Task {{ loop.index }}:</strong>
                    <pre style="white-space: pre-wrap;">{{ task | tojson(indent=2) }}</pre>
                </div>
            {% endfor %}
        </div>
        <!-- End debug output -->
#}
<table data-table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Target</th>
            <th>Created at</th>
            <th>Created by</th>
            <th>Last Updated by</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for task in tasks %}
            {% if not task.parent %}
                <tr id="{{ task.name }}">
                    <td>
                        <a href="{{ url_for('pbm_restores_detail', task_name=task.name) }}">{{ task.name }}</a>
                    </td>
                    <td>{{ task.target }}</td>
                    <td>{{ task.created_at }}</td>
                    <td>{{ user_id_to_username.get(task["created_by"], task["created_by"]) or '' }}</td>
                    <td>{{ user_id_to_username.get(task["last_updated_by"], task["last_updated_by"]) or '' }}</td>
                    <td class="options">{% include "tasks/partials/saved-tasks-actions-column.html.j2" %}</td>
                </tr>
            {% endif %}
        {% endfor %}
    </tbody>
</table>
<!--
        {% include "tasks/partials/scheduled-execution-dialog.html.j2" %}
-->
{% else %}
<p>No data</p>
{% endif %}
