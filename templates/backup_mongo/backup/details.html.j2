    <br>
    <br>
    {% set pending_tasks = history|selectattr("status", "equalto", "pending")|list %}
    {% if pending_tasks %}
        <section id="pending-tasks">
            <h2>Pending</h2>
            {% include "tasks/partials/pending-tasks.html.j2" %}
        </section>
        <br>
        <br>
    {% endif %}
    {% if history_logical %}
        <section>
            <h2>Logical Backup Runs</h2>
            {% set history_tasks = history_logical %}
            {% include "tasks/partials/completed-tasks.html.j2" %}
        </section>
        <br>
        <br>
    {% endif %}
    {% if history_physical %}
        <section>
            <h2>Physical Backup Runs</h2>
            {% set history_tasks = history_physical %}
            {% include "tasks/partials/completed-tasks.html.j2" %}
        </section>
        <br>
        <br>
    {% endif %}
    <section>
        <h2>Config Sync</h2>
        {% set history_tasks = history %}
        {% include "tasks/partials/completed-tasks.html.j2" %}
    </section>
{% endblock main %}
