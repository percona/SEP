            <option value="minio">MinIO</option>
            <option value="gcp">GCP</option>
        </select>
        <div id="s3_region_field">
            <label id="s3_region_label" for="s3_region">Region:</label>
            <input type="text" id="s3_region" name="storage_s3_region">
        </div>
        <div id="s3_bucket_field">
            <label for="s3_bucket">Bucket Name:</label>
            <input type="text" id="s3_bucket" name="storage_s3_bucket">
        </div>
        <div id="s3_endpoint_url_field">
            <label id="s3_endpoint_url_label" for="s3_endpoint_url">Endpoint URL:</label>
            <input type="text" id="s3_endpoint_url" name="storage_s3_endpoint_url">
        </div>
        <div id="s3_prefix_field">
            <label id="s3_prefix_label" for="s3_prefix">Prefix (Optional):</label>
            <input type="text" id="s3_prefix" name="storage_s3_prefix">
        </div>
