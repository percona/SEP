<fieldset>
    <legend>2. Point-in-Time Recovery (PITR) Configuration</legend>
    <label class="checkbox" for="pitr_enabled">
        <span class="label">Enable PITR:</span>
        <input type="checkbox" id="pitr_enabled" name="pitr_enabled">
        <div class="checkmark">
            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
            <span class="material-symbols-outlined checked">check_box</span>
        </div>
    </label>
    <label for="pitr_oplog_span_min">Oplog Span (Minutes):</label>
    <input type="number" id="pitr_oplog_span_min" name="pitr_oplog_span_min">
    <label for="pitr_compression">Compression:</label>
    <select id="pitr_compression" name="pitr_compression">
        <option value="gzip">gzip</option>
        <option value="snappy">snappy</option>
        <option value="lz4">lz4</option>
        <option value="s2">s2</option>
        <option value="pgzip">pgzip</option>
        <option value="zstd">zstd</option>
    </select>
</fieldset>
<fieldset>
    <legend>3. Backup Options</legend>
    {% set backup_priority_title = "Node priority mapping for backups in YAML format. Example: \"localhost:28019\": 2.5" %}
    <label for="backup_priority" title="{{ backup_priority_title }}">
        Node Priority (YAML format, Optional):
        <textarea id="backup_priority"
                  name="backup_priority"
                  rows="4"
                  placeholder='Example: "localhost:28019": 2.5 "localhost:27018": 2.5 "localhost:27020": 2.0 "localhost:27017": 0.1'></textarea>
    </label>
    <br>
    <br>
    {% set backup_compression_title = "Compression method for backup snapshots. Default: s2" %}
    <label for="backup_compression" title="{{ backup_compression_title }}">
        Backup Compression:
        <select id="backup_compression" name="backup_compression">
            <option value="">Select compression method (default: s2)</option>
            <option value="gzip">gzip</option>
            <option value="snappy">snappy</option>
            <option value="lz4">lz4</option>
            <option value="s2">s2</option>
            <option value="pgzip">pgzip</option>
            <option value="zstd">zstd</option>
        </select>
    </label>
    <br>
    <br>
    {% set backup_compression_level_title = "Compression level. Default depends on compression method. For zstd: 1-4 (default 2), for lz4: 1-16 (default 1), for gzip/pgzip: -1 to 9 (default -1)" %}
    <label for="backup_compression_level"
           title="{{ backup_compression_level_title }}">
        Backup Compression Level (Optional):
        <input type="number"
               id="backup_compression_level"
               name="backup_compression_level"
               placeholder="Leave empty for default" />
    </label>
    <br>
    <br>
    {% set backup_timeouts_starting_status_title = "Wait time (in seconds) for PBM to start backups. Default: 33" %}
    <label for="backup_timeouts_starting_status"
           title="{{ backup_timeouts_starting_status_title }}">
        Starting Status Timeout (Seconds, Optional):
        <input type="number"
               id="backup_timeouts_starting_status"
               name="backup_timeouts_starting_status"
               placeholder="Default: 33" />
    </label>
    <br>
    <br>
    {% set backup_oplog_span_min_title = "Duration (in minutes) of oplog slices saved with logical backup snapshot. Default: same as pitr.oplogSpanMin (10 minutes)" %}
    <label for="backup_oplog_span_min" title="{{ backup_oplog_span_min_title }}">
        Oplog Span (Minutes, Optional):
        <input type="number"
               id="backup_oplog_span_min"
               name="backup_oplog_span_min"
               step="0.1"
               placeholder="Default: same as PITR oplogSpanMin" />
    </label>
    <br>
    <br>
    {% set backup_num_parallel_collections_title = "Number of parallel collections to process during logical backup. Default: number of CPU cores / 2" %}
    <label for="backup_num_parallel_collections"
           title="{{ backup_num_parallel_collections_title }}">
        Parallel Collections for Logical Backup (Optional):
        <input type="number"
               id="backup_num_parallel_collections"
               name="backup_num_parallel_collections"
               placeholder="Default: CPU cores / 2" />
    </label>
    {% set backup_namespaces_title = "Optional comma-separated db.collection or db.* list for selective logical/physical backups (pbm backup --ns)" %}
    <label for="backup_namespaces" title="{{ backup_namespaces_title }}">
        Namespaces (selective):
        <input type="text"
               id="backup_namespaces"
               name="backup_namespaces"
               placeholder="db1.*,db2.coll" />
    </label>
    <label class="checkbox"
           for="backup_with_users_and_roles"
           title="Pass --with-users-and-roles; valid only with database-level db.* namespaces">
        <span class="label">Include users and roles:</span>
        <input type="checkbox"
               id="backup_with_users_and_roles"
               name="backup_with_users_and_roles">
        <div class="checkmark">
            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
            <span class="material-symbols-outlined checked">check_box</span>
        </div>
    </label>
</fieldset>
