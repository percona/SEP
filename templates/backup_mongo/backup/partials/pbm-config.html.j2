<style>
    textarea {
        width: 100%;
        min-width: 400px;
        font-family: monospace;
        font-size: 0.9em;
        padding: 0.5em;
        border: 1px solid #ccc;
        border-radius: 4px;
    }
</style>
<h5>PBM Configuration</h5>
<input type="hidden" name="backup_config" value="{}">
<fieldset>
    <legend>1. Storage Configuration</legend>
    <div id="storage_configuration">
        <label for="storage_type">Storage Type:</label>
        <select id="storage_type" name="storage_type">
            <option value="s3">S3-compatible Storage</option>
            <option value="filesystem">Filesystem</option>
            <!-- out of scope
            <option value="azure">Azure Blob Storage</option>
            -->
        </select>
    </div>
    <div id="s3_options" style="display: none;">
        <label for="s3_provider">S3 Provider:</label>
        <select id="s3_provider" name="backup_config.storage.s3.provider">
