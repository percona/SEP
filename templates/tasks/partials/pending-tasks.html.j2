{% if pending_tasks %}
    <table data-table="pending-tasks">
        <thead>
            <tr>
                <th>Name</th>
                <th>Host</th>
                <th>Created at</th>
                <th>ETA</th>
                <th>Executed by</th>
                <th>Options</th>
            </tr>
        </thead>
        <tbody>
            {% for task in pending_tasks %}
                {% set task_name = task["task"]["name"] %}
                <tr>
                    <td>{{ task_name }}</td>
                    <td>{{ task['execution_request']['target'] }}</td>
                    <td class="relativeTime">{{ task['created_at'] }}</td>
                    {% set eta = task['execution_request'].get('eta') %}
                    <td {% if eta %}class="relativeTime"{% endif %}>{{ eta }}</td>
                    <td>{{ user_id_to_username.get(task.executed_by, task.executed_by) or '' }}</td>
                    <td>
                        <a href="{{ task_name }}">
                            <span class="material-symbols-outlined">visibility</span>
                        </a>
                        <a href="#" class="submitNextForm">
                            <span class="material-symbols-outlined">cancel</span>
                        </a>
                        <form action="{{ url_for('stop_task_execution', task_history_id=task['id']) }}"
                              method="post"
                              style="display:none">
                            <input type="hidden" name="csrf-token" value="{{ csrf_token }}">
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <!-- Remember to add a more meaningful and helpful empty state message here, to help users recover and get back on track -->
    <span>No data</span>
{% endif %}
