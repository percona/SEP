<fieldset>
    <label class="checkbox"
           title="Run a connectivity check against the target when the task is created. Uncheck to skip.">
        <input type="checkbox"
               id="check_connectivity"
               name="check_connectivity"
               {% if connectivity_check_default %}checked{% endif %}>
        <div class="checkmark">
            <span class="material-symbols-outlined unchecked">check_box_outline_blank</span>
            <span class="material-symbols-outlined checked">check_box</span>
        </div>
        <span class="label">Check connectivity</span>
    </label>
</fieldset>
