{
  "name": "@sep/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sep/shell dev",
    "build": "pnpm -r --filter '@sep/*' run build",
    "preview": "pnpm --filter @sep/shell preview",
    "lint": "oxlint --config oxlintrc.json .",
    "lint:fix": "oxlint --config oxlintrc.json --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r type-check",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @sep/e2e test:e2e",
    "test:e2e:ui": "pnpm --filter @sep/e2e test:e2e:ui",
    "test:e2e:headed": "pnpm --filter @sep/e2e test:e2e:headed",
    "storybook": "pnpm --filter @sep/framework storybook",
    "build-storybook": "pnpm --filter @sep/framework build-storybook"
  },
  "devDependencies": {
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.5.3"
}
