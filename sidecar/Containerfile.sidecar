###########
# BUILDER #
###########

FROM localhost/sep:builder AS builder

#########
# FINAL #
#########

# Consolidated SEP side-car: the five SEP services plus a bundled Valkey broker
# under one supervisord. No frontend SPA — the UI is served by PMM.
FROM docker.io/library/python:3.11.14-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        g++ \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        fontconfig \
        fonts-dejavu \
        shared-mime-info && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 sep && \
    useradd --gid sep --shell /usr/sbin/nologin --home-dir /home/sep --uid 1001 --create-home sep

ENV HOME=/home/sep
ENV APP_HOME=$HOME/app
RUN install -d -o 1001 -g 1001 -m 0750 $APP_HOME
WORKDIR $APP_HOME

# netcat backs the migration wait-loops in supervisord.conf
RUN apt-get update && \
    apt-get install -y --no-install-recommends netcat-openbsd && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/sep/wheels /wheels
COPY --from=builder /usr/src/sep/requirements.txt .
RUN pip install --no-cache-dir wheel
RUN pip install --no-cache-dir /wheels/*

# Bundled Valkey broker: the server, plus the cli the healthcheck pings
COPY --from=docker.io/valkey/valkey:8-bookworm \
    /usr/local/bin/valkey-server /usr/local/bin/valkey-cli /usr/local/bin/

# Container process manager; pinned here rather than in poetry.lock because the
# standalone image shares that lock and does not use supervisord
RUN pip install --no-cache-dir supervisor==4.3.0

# Side-car runtime inputs; alembic.ini backs the migration one-shots
COPY --chown=0:1001 --chmod=440 ./alembic.ini .
COPY --chown=0:1001 --chmod=440 ./sidecar/supervisord.conf ./supervisord.conf
COPY --chown=0:1001 --chmod=550 ./sidecar/healthcheck.sh ./healthcheck.sh
COPY --chown=0:1001 --chmod=550 ./sidecar/entrypoint.sh ./entrypoint.sh

ADD --chown=0:1001 --chmod=440 bundle.tgz $APP_HOME

# PMM feature-build variant (branch `pmm`): only the inventory, mysql_backups,
# atw and snippets apps ship — every other app package is stripped from the
# bundle so it cannot be activated. Two import-only stubs survive because
# app.sep.main and the settings routes import them unconditionally:
# alerts/config.py and dipper/constants.py; their package __init__ files are
# emptied so importing them no longer drags in the removed app modules. The
# stripped alerts migrations leave alembic.ini's version_locations with their
# scripts (atw, the only other app-owned migration branch, stays).
RUN cd $APP_HOME/app/sep/apps && \
    rm -rf alert_troubleshooting alters archives backup_mongo backup_pg \
        checksums mysql_summary report tasks topology && \
    find alerts -mindepth 1 -maxdepth 1 ! -name '__init__.py' ! -name 'config.py' -exec rm -rf {} + && \
    find dipper -mindepth 1 -maxdepth 1 ! -name '__init__.py' ! -name 'constants.py' -exec rm -rf {} + && \
    : > alerts/__init__.py && \
    : > dipper/__init__.py && \
    sed -i 's|:%(here)s/app/sep/apps/alerts/migrations/versions||' $APP_HOME/alembic.ini && \
    chown 0:1001 $APP_HOME/alembic.ini

# No compose file injects this for the side-car, so the loader would otherwise
# fall back to the development defaults
ENV FASTAPI_ENV=production_docker

# Every program's stdout is a supervisord pipe, not a tty, so unbuffer it to
# keep `docker logs` complete when a program dies
ENV PYTHONUNBUFFERED=1

RUN chmod -R u+X,g+X $APP_HOME

USER sep

HEALTHCHECK --interval=15s --timeout=15s --start-period=150s --retries=5 \
    CMD ["/home/sep/app/healthcheck.sh"]

ENTRYPOINT ["/home/sep/app/entrypoint.sh"]
