###########
# BUILDER #
###########

FROM localhost/sep:builder AS builder

#########
# FINAL #
#########

# Consolidated SEP side-car: the five SEP services plus a bundled Valkey broker
# under one supervisord. No frontend SPA — the UI is served by PMM.
FROM docker.io/library/python:3.11.16-slim

RUN groupadd --gid 1001 sep && \
    useradd --gid sep --shell /usr/sbin/nologin --home-dir /home/sep --uid 1001 --create-home sep

ENV HOME=/home/sep
ENV APP_HOME=$HOME/app
RUN install -d -o 1001 -g 1001 -m 0750 $APP_HOME
WORKDIR $APP_HOME

# SEP-owned writable state, owner-only: the minted Grafana token lives here. See
# sidecar/README.md for why a deployment mounts a volume over it.
RUN install -d -o 1001 -g 1001 -m 0700 $HOME/state

# netcat backs the migration wait-loops in supervisord.conf. The upgrade is
# paired with the base pin rather than trusted to it: the pinned tag still
# ships util-linux 2.41-5, whose fix Debian published as 2.41.5-0+deb13u1
# after the tag was cut.
#
# No rendering libraries are installed. libpango-1.0-0, libpangoft2-1.0-0,
# fontconfig, fonts-dejavu and shared-mime-info must return if `report` is
# ever added to sidecar/settings.yaml's SEP.APPS: app/sep/apps/report/service.py
# imports weasyprint at module scope, and this image strips that package
# instead of backing it.
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends netcat-openbsd && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/sep/wheels /wheels
COPY --from=builder /usr/src/sep/requirements.txt .
RUN pip install --no-cache-dir /wheels/*

# Bundled Valkey broker: the server, plus the cli the healthcheck pings
COPY --from=docker.io/valkey/valkey:8-bookworm \
    /usr/local/bin/valkey-server /usr/local/bin/valkey-cli /usr/local/bin/

# Container process manager; pinned here rather than in poetry.lock because the
# standalone image shares that lock and does not use supervisord
RUN pip install --no-cache-dir supervisor==4.3.0

# Side-car runtime inputs; alembic.ini backs the migration one-shots
COPY --chown=0:1001 --chmod=440 ./alembic.ini .
COPY --chown=0:1001 --chmod=440 ./sidecar/supervisord.conf ./supervisord.conf
COPY --chown=0:1001 --chmod=550 ./sidecar/healthcheck.sh ./healthcheck.sh
COPY --chown=0:1001 --chmod=550 ./sidecar/entrypoint.sh ./entrypoint.sh
# Sourced by entrypoint.sh, never executed, hence 440 rather than 550
COPY --chown=0:1001 --chmod=440 ./sidecar/settings-env.sh ./settings-env.sh
# Run through the interpreter and never executed directly -- grafana_service_account.py
# by entrypoint.sh, wait_for_api.py by supervisord's celery-beat command -- so 440
# for the same reason. Copied explicitly because bundle.tgz carries app/ and
# snippets/ only -- no sidecar/ helper reaches the runtime image on its own.
COPY --chown=0:1001 --chmod=440 ./sidecar/grafana_service_account.py ./grafana_service_account.py
COPY --chown=0:1001 --chmod=440 ./sidecar/wait_for_api.py ./wait_for_api.py

ADD --chown=0:1001 --chmod=440 bundle.tgz $APP_HOME

# The baked embedded profile. Copied after the bundle so it stays authoritative
# even if `make pack` ever starts shipping a settings.yaml; a bind mount at this
# path still replaces it wholesale.
COPY --chown=0:1001 --chmod=440 ./sidecar/settings.yaml ./settings.yaml

# Strip every app package the baked profile does not activate. The retained set
# is derived from settings.yaml and named nowhere in this recipe.
ARG SEP_RESTRICT_APPS=0
COPY --chown=0:0 --chmod=400 ./sidecar/restrict_apps.py /tmp/restrict_apps.py
RUN if [ "$SEP_RESTRICT_APPS" = "1" ]; then \
        python /tmp/restrict_apps.py settings.yaml app/sep/apps; \
    fi && \
    rm -f /tmp/restrict_apps.py

# No compose file injects this for the side-car, so the loader would otherwise
# fall back to the development defaults
ENV FASTAPI_ENV=production_docker

# Every program's stdout is a supervisord pipe, not a tty, so unbuffer it to
# keep `docker logs` complete when a program dies
ENV PYTHONUNBUFFERED=1

RUN chmod -R u+X,g+X $APP_HOME

USER sep

HEALTHCHECK --interval=15s --timeout=15s --start-period=150s --retries=5 \
    CMD ["/home/sep/app/healthcheck.sh"]

ENTRYPOINT ["/home/sep/app/entrypoint.sh"]
